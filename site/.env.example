# =============================================================================
# West Chester Preschool — environment variables (template)
# =============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# In production, set the same vars in the Cloudflare project settings.
#
# PUBLIC_ vars are inlined into the built HTML at build time, so only put
# values here that are OK to be publicly visible (like the Google tag id).
# Server-only secrets (Sanity read token, the family-hub password/session
# secret) will be added later WITHOUT the PUBLIC_ prefix.
# =============================================================================

# Google Ads conversion tag id. Leave blank to disable tracking (e.g. previews).
PUBLIC_GADS_ID="AW-16817798038"

# Search-console / Bing site-verification token for the <meta> tag in <head>.
PUBLIC_GSC_VERIFICATION=""

# Cloudflare Web Analytics beacon token (dash -> Analytics -> Web Analytics ->
# add the site -> copy the token). Free, cookieless. Blank = no beacon.
PUBLIC_CF_BEACON_TOKEN=""

# Turnstile anti-spam site key - renders the widget on the contact forms.
# Pair with the TURNSTILE_SECRET_KEY Worker secret. Blank = dormant (honeypot
# only). See docs/FORMS.md.
PUBLIC_TURNSTILE_SITE_KEY=""
