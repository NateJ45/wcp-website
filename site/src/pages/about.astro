---
/* ============================================================================
   About page  (real copy, pulled directly from the live site's /about page)
   ============================================================================
   Photos are the real ones used on the live site: the About hero, and the two
   staff headshots (mapped to Lisa/Erin by their real cross-page reuse pattern
   — 3L7A4007 also appears on the live Pre-K page, 3L7A4018 on Twos + Threes,
   matching Lisa's Pre-K assignment and Erin's Twos/Threes assignment).
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Callout from '@/components/Callout.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { getStaff, toParagraphs, getPageHero } from '@/lib/cms';

// Hero eyebrow/title/lead are edited in Sanity (Pages → Page copy → "about").
const hero = await getPageHero('about');

import aboutHero from '@/assets/photos/about-hero.jpg';
import lisaCortez from '@/assets/staff/lisa-cortez.jpg';
import erinSchmerr from '@/assets/staff/erin-schmerr.jpg';

// Teacher names/roles/bios are edited once in Sanity (Staff) and read here, so
// they stay consistent with the class pages and virtual tour.
const lisa = await getStaff('staff-lisa');
const erin = await getStaff('staff-erin');
const lisaBio = toParagraphs(lisa?.bio);
const erinBio = toParagraphs(erin?.bio);

const approach = [
  {
    icon: 'palette',
    chip: 'orange' as const,
    title: 'Learning should feel like play',
    body: "Children learn best through hands-on exploration. Our curriculum is based on Ohio's Early Learning Content Standards and delivered through crafts, music, games, stories, science, and outdoor time.",
  },
  {
    icon: 'sprout',
    chip: 'green' as const,
    title: 'Social skills come first',
    body: 'Before letters and numbers, we focus on independence, creativity, self-esteem, and how to treat other people. These are the foundations that make everything else possible.',
  },
  {
    icon: 'heart-handshake',
    chip: 'sky' as const,
    title: 'Parents belong in the classroom',
    body: 'When parents are present and involved, children feel more secure and school feels less foreign. The co-op model keeps parents close during the years it matters most.',
  },
];

const facilities = [
  {
    icon: 'school',
    chip: 'orange' as const,
    value: '2',
    title: 'Dedicated classrooms',
    body: 'Each classroom is designed for hands-on learning, creativity, and small group interaction.',
  },
  {
    icon: 'dumbbell',
    chip: 'sky' as const,
    value: '1',
    title: 'Full gymnasium',
    body: 'Kids get access to a full gym for movement activities, indoor play, and physical development.',
  },
  {
    icon: 'trees',
    chip: 'green' as const,
    value: '1',
    title: 'Expansive outdoor area',
    body: 'A large playground and open field give kids fresh air and space to run, explore, and play every single day.',
  },
];
---

<BaseLayout
  title="About — West Chester Preschool"
  description="Built by parents, run by community. West Chester Preschool has been a cornerstone of West Chester, Ohio for over 55 years — a parent-run cooperative preschool for children ages 2-5."
>
  <Hero
    eyebrow={hero?.eyebrow ?? `Founded ${site.founded} · West Chester, Ohio`}
    title={hero?.heroTitle ?? 'Built by parents. Run by community.'}
    lead={hero?.lead ??
      `West Chester Preschool has been a cornerstone of this community for over 55 years. We are a parent-run cooperative preschool for children ages 2-5, and there is nothing else quite like us in Cincinnati.`}
    image={aboutHero}
    imageAlt="A black-and-white photo of children playing in a West Chester Preschool classroom"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Your Child</Button>
      <Button href="/co-op-life" variant="outline-white" size="lg">How the Co-op Works</Button>
    </Fragment>
  </Hero>

  {/* Our Story */}
  <Section bg="white" labelledby="our-story">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <SectionHeader
        eyebrow="Our Story"
        title="Over 55 years and still going strong."
        titleId="our-story"
      />
      <p class="mt-4 text-lg leading-relaxed text-ink">
        West Chester Preschool was founded in {site.founded}, originally known as West Chester
        Cooperative Nursery School, by a group of local parents who believed they could build
        something better together.
      </p>
      <p class="mt-4 leading-relaxed text-ink">
        That spirit has never changed. Today WCP is still entirely parent-run. Our teachers are the
        only paid staff. Every other role, administration, fundraising, classroom support,
        maintenance, event planning, is handled by the families enrolled.
      </p>
      <p class="mt-4 leading-relaxed text-ink">
        It sounds like a lot. Families who join almost always say the same thing: it gives back far
        more than it asks.
      </p>
    </div>
  </Section>

  {/* Our Approach */}
  <Section bg="grey" labelledby="our-approach">
    <SectionHeader
      eyebrow="Our Approach"
      title="What we believe about early childhood"
      titleId="our-approach"
      lead="Every decision we make comes back to these principles."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        approach.map((a) => (
          <FeatureCard as="li" icon={a.icon} chip={a.chip} title={a.title}>
            {a.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  {/* Our Teachers */}
  <Section bg="white" labelledby="our-teachers">
    <SectionHeader
      eyebrow="Our Teachers"
      title="The people your child will love"
      titleId="our-teachers"
      lead="Our teachers are certified early childhood professionals with years of experience. They set the tone for everything that happens at WCP."
    />
    <ul class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
      <li>
        <TeacherCard
          photo={lisaCortez}
          name={lisa ? [lisa.honorific, lisa.name].filter(Boolean).join(' ') : 'Ms. Lisa Cortez'}
          role={lisa?.role ?? 'Pre-K · 10 years at WCP'}
          email={lisa?.email ?? site.teachers.lisa}
        >
          {
            lisaBio.length > 0 ? (
              lisaBio.map((p) => <p class="mt-2 first:mt-0">{p}</p>)
            ) : (
              <p>
                Lisa brings creativity, curiosity, and genuine warmth to every session. Her
                classroom is built around hands-on activities that develop social skills, early
                literacy, math, science, and the arts. Her youngest child is also WCP alumni.
              </p>
            )
          }
        </TeacherCard>
      </li>
      <li>
        <TeacherCard
          photo={erinSchmerr}
          name={erin ? [erin.honorific, erin.name].filter(Boolean).join(' ') : 'Ms. Erin Schmerr'}
          role={erin?.role ?? 'Threes and Twos · 3 years at WCP'}
          email={erin?.email ?? site.teachers.erin}
        >
          {
            erinBio.length > 0 ? (
              erinBio.map((p) => <p class="mt-2 first:mt-0">{p}</p>)
            ) : (
              <p>
                Erin is a Cincinnati native with nearly 20 years in education, social work, and
                childcare. She came to WCP as a parent, fell in love with the school, and never
                left. She also runs a photography business in her spare time.
              </p>
            )
          }
        </TeacherCard>
      </li>
    </ul>
  </Section>

  {/* Our Facilities */}
  <Section bg="grey" labelledby="our-facilities">
    <SectionHeader
      eyebrow="Our Facilities"
      title="A space built for little learners"
      titleId="our-facilities"
    />
    <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center leading-relaxed text-ink" data-reveal>
      WCP is located inside Crestview Presbyterian Church at {site.address.street},{' '}
      {site.address.city}
      {site.address.state}
      {site.address.zip}. We are not a religious school, we simply rent a wonderful space from great
      neighbors.
    </p>
    <ul class="grid gap-6 sm:grid-cols-3">
      {
        facilities.map((f) => (
          <li>
            <FeatureCard icon={f.icon} chip={f.chip} title={f.title}>
              <span class="font-display text-3xl text-heading">{f.value}</span>
              <span class="mt-1 block">{f.body}</span>
            </FeatureCard>
          </li>
        ))
      }
    </ul>
    <Callout tone="sky" class="mx-auto mt-8 max-w-2xl">
      Got questions before you decide? Our FAQ covers everything from potty training to co-op jobs
      to what happens on a helper day.
      <a href="/faq" class="ml-1 font-bold text-heading underline underline-offset-2"
        >Read the FAQ</a
      >.
    </Callout>
  </Section>

  <CtaBanner
    title="Ready to see it in person?"
    lead="Meet the teachers, walk through the classrooms, and let your child spend some time in the space."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Schedule a Tour</Button>
    </Fragment>
    <Fragment slot="note">Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</BaseLayout>
