---
/* ============================================================================
   Contact page (minimal — full contact form comes with the form handler phase)
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';

const phoneDigits = site.phone.replace(/[^\d]/g, '');
---

<BaseLayout
  title="Contact — West Chester Preschool"
  description="Get in touch with West Chester Preschool. Call, email, or visit us at 9463 Cincinnati Columbus Rd, West Chester, OH."
>
  <Hero
    eyebrow="Get In Touch"
    title="We would love to hear from you."
    lead="Call, email, or stop by. We are a parent-run school and we actually reply."
  >
    <Fragment slot="actions">
      <Button href={`tel:${phoneDigits}`} variant="accent" size="lg">Call {site.phone}</Button>
      <Button href={`mailto:${site.email.general}`} variant="outline-white" size="lg">Email Us</Button>
    </Fragment>
  </Hero>

  <Section bg="grey" label="Contact details">
    <div class="mx-auto grid max-w-3xl gap-8 sm:grid-cols-2">
      <div data-reveal>
        <h2 class="text-navy">Reach us</h2>
        <dl class="mt-4 space-y-3 text-ink">
          <div>
            <dt class="text-sm font-bold uppercase tracking-wide text-sky-ink">Phone</dt>
            <dd><a href={`tel:${phoneDigits}`} class="text-navy underline">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-wide text-sky-ink">Email</dt>
            <dd><a href={`mailto:${site.email.general}`} class="text-navy underline">{site.email.general}</a></dd>
          </div>
        </dl>
      </div>
      <div data-reveal>
        <h2 class="text-navy">Visit</h2>
        <address class="mt-4 not-italic leading-relaxed text-ink">
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}<br />
          <span class="text-ink-muted">Inside Crestview Presbyterian Church</span>
        </address>
        <p class="mt-3 text-sm text-ink-muted">{site.calendar}</p>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`,
          )}`}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1.5 font-bold text-sky-ink underline underline-offset-2"
        >
          <Icon name="map-pin" class="h-4 w-4" />
          Open in Google Maps
        </a>
      </div>
    </div>

    {/* Parking & entry — genuinely useful for first-time tour visitors. */}
    <div class="mx-auto mt-8 max-w-3xl" data-reveal>
      <Callout tone="warm">
        <strong class="font-bold text-navy">Parking &amp; entry:</strong> Enter through the rear west
        doors — look for <strong class="font-semibold text-navy">Door 5</strong>, a set of double
        white doors with white pillars on either side. Park near the concrete sidewalk by the rear
        doors.
      </Callout>
    </div>
  </Section>
</BaseLayout>
