---
/* ============================================================================
   Family Hub — Handbook & Documents (GATED)
   ============================================================================
   Document library, editable in Sanity (Family Hub → Documents & Forms).
   Links point to the school's shared Drive/Canva files (gated content, not
   public). Falls back to the built-in list from src/data/hub/documents.ts if
   Sanity is ever empty or unreachable.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubSegmented from '@/components/hub/HubSegmented.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { documentGroups as fallbackGroups, driveFolderUrl } from '@/data/hub/documents';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

const GROUP_META: Record<string, { label: string; action: string; intro?: string }> = {
  required: {
    label: 'Required Forms',
    action: 'Open form',
    intro:
      'Ohio state licensing requires these four on file before your child’s first day. New families, start here.',
  },
  handbook: { label: 'Handbooks & Policies', action: 'Open document' },
  orient: { label: 'Orientation Materials', action: 'View' },
  minutes: { label: 'Meeting Minutes', action: 'Open document' },
};
const GROUP_ORDER = ['required', 'handbook', 'orient', 'minutes'];

interface HubDocDoc {
  title: string;
  category: string;
  description?: string;
  icon?: string;
  href?: string;
  order: number;
}
// Independent of the document-list read — start now, await later (2026-07
// hub-speed pass).
const hubDocPromise = sanityFetch<HubPageDoc | null>(
  HUB_PAGE_QUERY,
  { key: 'documents' },
  { cache: BOARD_CONTENT_CACHE },
).catch(() => null);

// The built-in fallback now ships with empty hrefs (share links were redacted
// from src/data/hub/documents.ts — public repo). Drop any doc without a link so
// the fallback path never renders a dead <a href="">.
const usableFallback = fallbackGroups
  .map((g) => ({ ...g, docs: g.docs.filter((d) => d.href) }))
  .filter((g) => g.docs.length > 0);

let documentGroups = usableFallback;
try {
  // Both link-type docs and uploaded files (file.asset dereferenced to its URL).
  const docs = await sanityFetch<HubDocDoc[]>(
    `*[_type == "hubDocument" && (defined(link) || defined(file.asset))] | order(category asc, coalesce(orderRank, "~") asc, order asc){
      title, category, description, icon, order,
      "href": select(sourceType == "file" => file.asset->url, link)
    }`,
  );
  const usable = docs.filter((d) => d.href);
  if (usable.length > 0) {
    documentGroups = GROUP_ORDER.filter((k) => usable.some((d) => d.category === k)).map((k) => ({
      key: k,
      label: GROUP_META[k]?.label ?? k,
      action: GROUP_META[k]?.action ?? 'Open',
      intro: GROUP_META[k]?.intro,
      docs: usable
        .filter((d) => d.category === k)
        .map((d) => ({
          name: d.title,
          meta: d.description,
          icon: d.icon ?? 'file-text',
          href: d.href ?? '#',
        })),
    }));
  }
} catch {
  documentGroups = usableFallback;
}

// Segmented views (premium-screens plan, 2026-07-14): one section on screen
// at a time (?view=required|handbook|orient|minutes), a real link per segment
// so views are shareable and no-JS-safe. Unknown/absent param → the first
// group that has documents.
const requestedView = Astro.url.searchParams.get('view');
const activeGroup =
  documentGroups.find((g) => g.key === requestedView) ?? documentGroups[0] ?? null;
const segments = documentGroups.map((g) => ({
  label: g.label,
  href: `${Astro.url.pathname}?view=${g.key}`,
  current: g.key === activeGroup?.key,
  count: g.docs.length,
}));

// Editable heading/intro + closing section(s), from the hubPage doc (falls back
// to the built-in strings + Drive card if no doc exists yet).
const doc: HubPageDoc | null = await hubDocPromise;
// Drop the full-bleed closing `ctaSection` ("Need a file that isn't listed?"):
// the Board asked to remove it, and its full-bleed treatment is too heavy for
// this page. Filtered in code because Sanity writes are quota-blocked; remove
// this filter once the doc is patched in the Studio. (The built-in fallback
// prompt was removed too — its Drive link is a redacted placeholder, so it can't
// offer a working link anyway.)
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const docSections = ((doc?.sections ?? []) as any[]).filter((s) => s?._type !== 'ctaSection');
const hasSections = docSections.length > 0;
const title = doc?.heading || 'Handbook & Documents';
const intro =
  doc?.intro ||
  'Family Handbook, Bylaws, Standing Rules, and the state forms families need on file. Everything to read, sign, or refer back to.';
---

<HubShell title={title} bare pageTitle="Documents — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="folder-open">
        {
          driveFolderUrl !== '#' && (
            <Button
              slot="action"
              href={driveFolderUrl}
              target="_blank"
              rel="noopener"
              variant="outline"
              size="sm"
            >
              Open Google Drive
            </Button>
          )
        }
      </HubPageHeader>

      {
        documentGroups.length === 0 || !activeGroup ? (
          <HubEmptyState spot="documents" title="Documents will appear here" source="sanity" />
        ) : (
          <>
            {/* One section on screen at a time (premium-screens plan) — the
                segments are links, so every view is shareable and no-JS-safe. */}
            <HubSegmented label="Document sections" segments={segments} class="mb-6" />

            {/* New-families notice — belongs to the Required view only. */}
            {activeGroup.key === 'required' && (
              <HubCard class="flex items-start gap-4 p-4">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
                  aria-hidden="true"
                >
                  <Icon name="file-check" class="h-5 w-5" />
                </span>
                <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink">
                  <strong class="font-bold text-heading">New families:</strong> the four Required
                  Forms below must be on file before your child’s first day — Ohio state licensing
                  requires them.
                </p>
              </HubCard>
            )}

            <div class="mt-6" data-reveal>
              <h2 class="text-xl font-extrabold text-heading">{activeGroup.label}</h2>
              {activeGroup.intro && (
                <p class="mt-1 max-w-2xl text-ink-muted">{activeGroup.intro}</p>
              )}
              <ul class="mt-4 grid gap-3">
                {activeGroup.docs.map((doc) => (
                  <li>
                    <HubCard
                      as="a"
                      href={doc.href}
                      target="_blank"
                      rel="noopener"
                      class="flex items-center gap-4 p-4"
                    >
                      <span
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                        aria-hidden="true"
                      >
                        <Icon name={doc.icon} class="h-5 w-5" />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block font-bold text-heading">{doc.name}</span>
                        {doc.meta && <span class="block text-sm text-ink-muted">{doc.meta}</span>}
                      </span>
                      <span class="hidden shrink-0 items-center gap-1 text-sm font-semibold text-sky-ink sm:inline-flex">
                        {activeGroup.action}
                        <Icon name="external-link" class="h-4 w-4" />
                      </span>
                    </HubCard>
                  </li>
                ))}
              </ul>
            </div>
          </>
        )
      }
    </div>
  </Section>

  {
    /* Editable closing section(s) from the hubPage doc (Board-managed). The
      full-bleed ctaSection is filtered out above. */
  }
  {hasSections && <SectionRenderer sections={docSections} site={site} />}
</HubShell>
