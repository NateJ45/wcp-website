---
/* ============================================================================
   Family Hub — Threes Classroom (GATED, page-builder)
   ============================================================================
   Fixed widget: class facts + pay button + class-notes (class notes are their
   own editable docs), via <ClassHubBody>. Editable heading/intro + any extra
   sections come from the class's hubPage doc (hubKey "threes"); falls back to
   the built-in strings if no doc exists yet.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import ClassHubBody from '@/components/hub/ClassHubBody.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  handbookUrl?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
let doc: HubPageDoc | null = null;
try {
  doc = await sanityFetch<HubPageDoc | null>(
    HUB_PAGE_QUERY,
    { key: 'threes' },
    { cache: BOARD_CONTENT_CACHE },
  );
} catch {
  doc = null;
}
const title = doc?.heading || 'Threes Classroom';
const intro = doc?.intro || 'A joyful first real school experience.';
---

<HubShell
  title={title}
  bare
  current="/family-hub/threes"
  pageTitle="Threes Classroom — WCP Family Hub"
>
  <ClassHubBody
    slug="threes"
    title={title}
    intro={intro}
    sections={doc?.sections}
    handbookUrl={doc?.handbookUrl}
  />
</HubShell>
