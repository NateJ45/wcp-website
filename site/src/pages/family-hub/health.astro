---
/* ============================================================================
   Family Hub — Health & Safety (GATED, page-builder)
   ============================================================================
   The per-child info is a FIXED widget (PII, from Sanity behind the gate). The
   rest of the page (illness policy, closures) is a hubPage the Board edits in
   the Studio — heading, intro, and a stack of sections. Falls back to the
   built-in content if no hubPage doc exists yet, so it can never go blank.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { sanityFetch } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
let doc: HubPageDoc | null = null;
try {
  doc = await sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'health' });
} catch {
  doc = null;
}
const hasSections = Array.isArray(doc?.sections) && doc!.sections.length > 0;
const title = doc?.heading || 'Health & Safety';
const intro =
  doc?.intro ||
  'Emergency contacts, illness policies, immunization requirements, and what to do when your child isn’t feeling well.';

// Fallback content (shown until a hubPage "health" doc exists in the Studio).
const keepHome = [
  {
    icon: 'heart-pulse',
    title: 'Fever',
    body: 'Stay home until fever-free for 48 hours (per the Family Handbook).',
  },
  {
    icon: 'info',
    title: 'Vomiting or diarrhea',
    body: 'Stay home until symptom-free for 48 hours.',
  },
  {
    icon: 'eye',
    title: 'Pink eye',
    body: 'Stay home for 48 hours from diagnosis and until symptom-free for 48 hours.',
  },
  {
    icon: 'shield-check',
    title: 'Antibiotics',
    body: 'Children must be on antibiotics for at least 48 hours before returning to school.',
  },
  {
    icon: 'bell',
    title: 'Contagious illness',
    body: 'Notify your teacher right away so other families can be alerted. Names are never shared.',
  },
];
---

<HubShell title={title} bare pageTitle="Health & Safety — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="heart-pulse" />

      {
        !hasSections && (
          <Fragment>
            {/* When to keep your child home — orange chips (health caution is meaningful) */}
            <div aria-labelledby="keep-home">
              <h2 id="keep-home" class="text-xl font-extrabold text-heading">
                When to keep your child home
              </h2>
              <p class="mt-1 max-w-2xl text-ink-muted">
                When in doubt, keep them home. These guidelines protect every family at WCP.
              </p>
              <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {keepHome.map((k) => (
                  <HubCard icon={k.icon} title={k.title} iconChip="bg-orange/15 text-orange-ink">
                    <p class="text-sm leading-relaxed text-ink-muted">{k.body}</p>
                  </HubCard>
                ))}
              </div>
              {/* Allergy awareness — amber emphasis note (was a warm Callout) */}
              <HubCard class="mt-6 flex items-start gap-4 p-4">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
                  aria-hidden="true"
                >
                  <Icon name="file-check" class="h-5 w-5" />
                </span>
                <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink">
                  <strong class="font-bold text-heading">Allergy awareness:</strong> if your child
                  has a food allergy or any condition classroom helpers should know about, make sure
                  it’s on file with your teacher and on your Emergency Contact Form. Questions?
                  Contact your teacher directly.
                </p>
              </HubCard>
            </div>

            {/* Closures & the full policy — the single navy emphasis moment */}
            <HubCard class="mt-12 bg-navy text-white">
              <span
                class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-amber"
                aria-hidden="true"
              >
                <Icon name="snowflake" class="h-7 w-7" />
              </span>
              <h2 class="text-lg font-bold text-white">Closures & the full policy</h2>
              <p class="mt-2 max-w-xl leading-relaxed text-white/85">
                WCP follows <span class="font-semibold">Lakota Local Schools</span> for weather
                closures — if Lakota closes, WCP closes. The complete health policy lives in the
                Family Handbook, and Ohio licensing requirements always apply.
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <Button href="/family-hub/documents" variant="outline-white" size="md">
                  Open the Handbook
                </Button>
              </div>
            </HubCard>
          </Fragment>
        )
      }
    </div>
  </Section>

  {hasSections && <SectionRenderer sections={doc!.sections} site={site} />}
</HubShell>
