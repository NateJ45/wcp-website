---
/* ============================================================================
   Family Hub — Fundraising (GATED, page-builder)
   ============================================================================
   FIXED widgets: (1) featured Sanity `campaign` docs with donate links, when
   the Board publishes any, and (2) the year-at-a-glance — every fundraiser in
   the treasurer's Fundraising sheet tab with live totals and status chips
   (the treasurer edits the sheet; this page updates on the next visit).
   The rest (ways we raise, where it goes) is a hubPage the Board edits in the
   Studio; falls back to the built-in content if no hubPage doc exists yet.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import HubRing from '@/components/hub/HubRing.astro';
import HubStat from '@/components/hub/HubStat.astro';
import HubPill from '@/components/hub/HubPill.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import Button from '@/components/ui/Button.astro';
import HubSectionedBody from '@/components/hub/HubSectionedBody.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { getFundraisers, type Fundraiser, type FundraiserStatus } from '@/lib/gsheets';
import { budgetSheetIdFallback, pastFundraisingTotalsFallback } from '@/data/hub/live-links';

interface Campaign {
  title?: string;
  summary?: string;
  goalAmount?: number;
  raisedAmount?: number;
  deadline?: string;
  linkLabel?: string;
  linkUrl?: string;
}
interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// The three Sanity reads are independent — run them concurrently (they were
// sequential once, ~0.2s each; part of the 2026-07 hub-speed pass). Each keeps
// its original fallback on failure via allSettled.
const [campaignsResult, docResult, settingsResult] = await Promise.allSettled([
  sanityFetch<Campaign[]>(
    `*[_type == "campaign" && active == true] | order(_createdAt desc){ title, summary, goalAmount, raisedAmount, deadline, linkLabel, linkUrl }`,
  ),
  sanityFetch<HubPageDoc | null>(
    HUB_PAGE_QUERY,
    { key: 'fundraising' },
    { cache: BOARD_CONTENT_CACHE },
  ),
  sanityFetch<{
    budgetSheetId?: string | null;
    pastFundraisingTotals?: { yearLabel?: string; amount?: number }[] | null;
  } | null>(
    `*[_type == "siteSettings"][0]{ budgetSheetId, pastFundraisingTotals }`,
    {},
    { cache: BOARD_CONTENT_CACHE },
  ),
]);
const campaigns = campaignsResult.status === 'fulfilled' ? campaignsResult.value : [];
const doc = docResult.status === 'fulfilled' ? docResult.value : null;

// Year at a glance — live from the treasurer's Fundraising sheet tab — plus
// the "raised together" record of past-year grand totals (Board-editable on
// Site Settings; falls back to the old site's numbers until set).
const settings = settingsResult.status === 'fulfilled' ? settingsResult.value : null;
const sheetId = settings?.budgetSheetId || budgetSheetIdFallback;
const cmsTotals = (settings?.pastFundraisingTotals ?? []).filter(
  (t): t is { yearLabel: string; amount: number } =>
    Boolean(t.yearLabel) && typeof t.amount === 'number',
);
const pastTotals = cmsTotals.length > 0 ? cmsTotals : pastFundraisingTotalsFallback;
const fundraisers: Fundraiser[] = await getFundraisers(sheetId);
const totalGoal = fundraisers.reduce((s, f) => s + f.goal, 0);
const totalRaised = fundraisers.reduce((s, f) => s + f.raised, 0);
const totalPct = totalGoal > 0 ? Math.round((totalRaised / totalGoal) * 100) : 0;

// Status pills from the hub's shared vocabulary (HubPill) — same mapping the
// home Fundraising widget uses: live → open, coming → waitlist, finished →
// past. One color language across the whole hub.
const STATUS_META: Record<FundraiserStatus, { label: string; kind: 'open' | 'waitlist' | 'past' }> =
  {
    active: { label: 'Active', kind: 'open' },
    upcoming: { label: 'Soon', kind: 'waitlist' },
    complete: { label: 'Done', kind: 'past' },
  };
const hasSections = Array.isArray(doc?.sections) && doc!.sections.length > 0;
const title = doc?.heading || 'Fundraising';
const intro =
  doc?.intro ||
  'What we’re raising money for this year, what’s active right now, and how you can help. Every dollar goes back into the classrooms.';

const money = (n?: number) => `$${Math.round(n ?? 0).toLocaleString('en-US')}`;
const pctOf = (r?: number, g?: number) =>
  g && g > 0 ? Math.min(100, Math.round(((r ?? 0) / g) * 100)) : 0;
const fmtDeadline = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
---

<HubShell title={title} bare pageTitle="Fundraising — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="party-popper" />

      {/* FIXED: featured campaigns (Sanity docs with donate links), when any. */}
      {
        campaigns.length > 0 && (
          <div aria-labelledby="active-now">
            <h2 id="active-now" class="text-xl font-extrabold text-heading">
              Featured right now
            </h2>
            <p class="mt-1 max-w-2xl text-ink-muted">
              What’s live right now, and how close each one is to its goal.
            </p>
            <ul class="mt-6 space-y-4">
              {campaigns.map((c) => (
                <HubCard as="li">
                  <p class="font-display text-xl text-heading">{c.title}</p>
                  {c.summary && <p class="mt-1 text-ink-muted">{c.summary}</p>}
                  {c.goalAmount && c.goalAmount > 0 && (
                    <div class="mt-4">
                      <div class="flex items-end justify-between gap-4">
                        <p class="font-display text-2xl text-heading">
                          {money(c.raisedAmount)}
                          <span class="text-sm font-normal text-ink-muted"> raised</span>
                        </p>
                        <p class="text-sm font-semibold text-ink-muted">
                          {money(c.goalAmount)} goal
                        </p>
                      </div>
                      <HubProgress
                        value={c.raisedAmount ?? 0}
                        max={c.goalAmount}
                        label={`${c.title ?? 'Campaign'} progress`}
                        fill="bg-amber"
                        height="h-4"
                        valueText={`${money(c.raisedAmount)} of ${money(c.goalAmount)} raised`}
                        class="mt-2"
                      />
                      <p class="mt-1 text-sm text-ink-muted">
                        {pctOf(c.raisedAmount, c.goalAmount)}% of goal
                        {c.deadline ? ` · by ${fmtDeadline(c.deadline)}` : ''}
                      </p>
                    </div>
                  )}
                  {c.linkUrl && (
                    <Button href={c.linkUrl} variant="primary" size="sm" class="mt-4">
                      {c.linkLabel ?? 'Donate'}
                    </Button>
                  )}
                </HubCard>
              ))}
            </ul>
          </div>
        )
      }

      {/* FIXED: the year at a glance — live from the treasurer's sheet. */}
      <div class={campaigns.length > 0 ? 'mt-12' : ''} aria-labelledby="year-glance">
        <h2 id="year-glance" class="text-xl font-extrabold text-heading">This year so far</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Every fundraiser on this year’s calendar, with live totals from the treasurer’s tracking
          sheet.
        </p>
        {
          fundraisers.length === 0 ? (
            campaigns.length === 0 && (
              <HubEmptyState
                icon="party-popper"
                title="Current campaigns & totals will show here"
                source="google-sheets"
                class="mt-6"
              />
            )
          ) : (
            <>
              {/* Year total: ring + stat (the 2026-07-14 kit) — the same pairing
                  as the home widget and the command strip, at page scale. */}
              <HubCard class="mt-6">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
                  <HubRing
                    value={totalRaised}
                    max={totalGoal}
                    color="text-orange-ink dark:text-amber"
                    label="Fundraising progress this year"
                    valueText={`${money(totalRaised)} of ${money(totalGoal)} raised`}
                  />
                  <HubStat
                    size="lg"
                    value={money(totalRaised)}
                    label="raised this year"
                    footnote={`${money(totalGoal)} annual goal · ${totalPct}%`}
                  />
                </div>
                <HubProgress
                  class="mt-4"
                  height="h-4"
                  value={totalRaised}
                  max={totalGoal}
                  fill="bg-amber"
                  label="Fundraising progress this year"
                  valueText={`${money(totalRaised)} of ${money(totalGoal)} raised`}
                />
                <p class="mt-2 text-sm text-ink-muted">Every dollar goes back to our classrooms.</p>
              </HubCard>

              {/* grid-cols-1 at base: see the bento note on the hub home. */}
              <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {fundraisers.map((f) => (
                  <HubCard as="li" class="p-4">
                    <div class="flex items-center justify-between gap-3">
                      <p class="min-w-0 truncate font-bold text-heading" title={f.name}>
                        {f.name}
                      </p>
                      <HubPill kind={STATUS_META[f.status].kind} class="shrink-0">
                        {STATUS_META[f.status].label}
                      </HubPill>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-sm">
                      <span class="font-semibold text-heading">
                        {money(f.raised)}
                        {f.goal > 0 && (
                          <span class="font-normal text-ink-muted"> / {money(f.goal)}</span>
                        )}
                      </span>
                      {f.timeframe && <span class="text-ink-muted">{f.timeframe}</span>}
                    </div>
                    {f.goal > 0 && (
                      <HubProgress
                        class="mt-2"
                        height="h-1.5"
                        value={f.raised}
                        max={f.goal}
                        fill="bg-amber"
                        label={`${f.name} progress`}
                        valueText={`${money(f.raised)} of ${money(f.goal)} raised`}
                      />
                    )}
                  </HubCard>
                ))}
              </ul>
            </>
          )
        }
      </div>

      {
        /* FIXED: the running record — the old site's "What We Have Raised
          Together" band. Past-year grand totals, Board-editable on Site
          Settings → School year. This is the page's ONE navy emphasis moment
          (it absorbed the old "Where your money goes" card), and like the
          home hero it's a theme-stable island: navy + amber + white/…, all
          identical in light and dark. */
      }
      {
        pastTotals.length > 0 && (
          <HubCard class="mt-12 bg-navy text-center text-white">
            <h2 id="raised-together" class="font-display text-2xl text-white">
              What we’ve raised together
            </h2>
            <p class="mx-auto mt-2 max-w-xl leading-relaxed text-white/85">
              Every dollar goes straight back into our school — supplies, enrichment, playground
              upkeep, and the special days that make WCP feel like home.
            </p>
            <ul class="mt-6 flex flex-wrap justify-center gap-4">
              {pastTotals.map((t) => (
                <li class="min-w-40 rounded-xl bg-white/10 px-6 py-5">
                  <p class="font-display text-3xl text-amber">{money(t.amount)}</p>
                  <p class="mt-1 text-sm font-semibold text-white/85">{t.yearLabel} total</p>
                </li>
              ))}
            </ul>
          </HubCard>
        )
      }
      {
        /* Board-editable handbook sections (The Budget, and anything the Board
         adds) as an aligned card doc column with an "On this page" TOC. */
      }
      {
        hasSections && (
          <HubSectionedBody sections={doc!.sections} label="Fundraising sections" class="mt-12" />
        )
      }
    </div>
  </Section>
</HubShell>
