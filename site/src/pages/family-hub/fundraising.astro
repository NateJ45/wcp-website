---
/* ============================================================================
   Family Hub — Fundraising (GATED, page-builder)
   ============================================================================
   FIXED widget: the active campaigns + progress bars (Sanity `campaign` docs).
   The rest (ways we raise, where it goes) is a hubPage the Board edits in the
   Studio; falls back to the built-in content if no hubPage doc exists yet.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { sanityFetch } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { site } from '@/data/site';

interface Campaign {
  title?: string;
  summary?: string;
  goalAmount?: number;
  raisedAmount?: number;
  deadline?: string;
  linkLabel?: string;
  linkUrl?: string;
}
interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

let campaigns: Campaign[] = [];
let doc: HubPageDoc | null = null;
try {
  campaigns = await sanityFetch<Campaign[]>(
    `*[_type == "campaign" && active == true] | order(_createdAt desc){ title, summary, goalAmount, raisedAmount, deadline, linkLabel, linkUrl }`,
  );
} catch {
  campaigns = [];
}
try {
  doc = await sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'fundraising' });
} catch {
  doc = null;
}
const hasSections = Array.isArray(doc?.sections) && doc!.sections.length > 0;
const title = doc?.heading || 'Fundraising';
const intro =
  doc?.intro ||
  'What we’re raising money for this year, what’s active right now, and how you can help. Every dollar goes back into the classrooms.';

const money = (n?: number) => `$${Math.round(n ?? 0).toLocaleString('en-US')}`;
const pctOf = (r?: number, g?: number) =>
  g && g > 0 ? Math.min(100, Math.round(((r ?? 0) / g) * 100)) : 0;
const fmtDeadline = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });

// Fallback for the editable body (shown until a hubPage "fundraising" doc exists).
const waysToRaise = [
  {
    icon: 'hand-heart',
    title: 'Dine to Donate',
    body: 'Local restaurants give back a share of sales on WCP nights. Show up hungry — a portion of your bill comes back to the school.',
  },
  {
    icon: 'party-popper',
    title: 'Spring Raffle',
    body: 'Our biggest event of the year: themed baskets, donated prizes, and tickets sold across the community.',
  },
  {
    icon: 'shopping-bag',
    title: 'Seasonal Sales',
    body: 'Smaller fundraisers through the year — spirit wear, holiday items, and one-off sales run by the Fundraising Committee.',
  },
  {
    icon: 'gift',
    title: 'Direct Giving',
    body: 'Prefer to give directly? Donations are welcome any time and go straight into the classrooms.',
  },
];
---

<HubShell title={title} bare pageTitle="Fundraising — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="party-popper" />

      {/* FIXED: active campaigns + progress bars (Sanity campaign docs) */}
      <div aria-labelledby="active-now">
        <h2 id="active-now" class="text-xl font-extrabold text-heading">Active fundraisers</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          What’s live right now, and how close each one is to its goal.
        </p>
        {
          campaigns.length === 0 ? (
            <HubEmptyState
              icon="party-popper"
              title="Current campaigns & totals will show here"
              source="google-sheets"
              class="mt-6"
            />
          ) : (
            <ul class="mt-6 space-y-4">
              {campaigns.map((c) => (
                <HubCard as="li">
                  <p class="font-display text-xl text-heading">{c.title}</p>
                  {c.summary && <p class="mt-1 text-ink-muted">{c.summary}</p>}
                  {c.goalAmount && c.goalAmount > 0 && (
                    <div class="mt-4">
                      <div class="flex items-end justify-between gap-4">
                        <p class="font-display text-2xl text-heading">
                          {money(c.raisedAmount)}
                          <span class="text-sm font-normal text-ink-muted"> raised</span>
                        </p>
                        <p class="text-sm font-semibold text-ink-muted">
                          {money(c.goalAmount)} goal
                        </p>
                      </div>
                      <HubProgress
                        value={c.raisedAmount ?? 0}
                        max={c.goalAmount}
                        label={`${c.title ?? 'Campaign'} progress`}
                        fill="bg-amber"
                        height="h-4"
                        valueText={`${money(c.raisedAmount)} of ${money(c.goalAmount)} raised`}
                        class="mt-2"
                      />
                      <p class="mt-1 text-sm text-ink-muted">
                        {pctOf(c.raisedAmount, c.goalAmount)}% of goal
                        {c.deadline ? ` · by ${fmtDeadline(c.deadline)}` : ''}
                      </p>
                    </div>
                  )}
                  {c.linkUrl && (
                    <Button href={c.linkUrl} variant="primary" size="sm" class="mt-4">
                      {c.linkLabel ?? 'Donate'}
                    </Button>
                  )}
                </HubCard>
              ))}
            </ul>
          )
        }
      </div>

      {
        !hasSections && (
          <>
            {/* Editable body fallback — the ways WCP raises money. */}
            <div class="mt-12" aria-labelledby="ways">
              <h2 id="ways" class="text-xl font-extrabold text-heading">
                The ways WCP fundraises
              </h2>
              <p class="mt-1 max-w-2xl text-ink-muted">
                A handful of friendly, low-pressure efforts across the year — join what fits your
                family.
              </p>
              <ul class="mt-6 grid gap-4 sm:grid-cols-2">
                {waysToRaise.map((w) => (
                  <HubCard as="li" class="flex gap-4">
                    <span
                      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
                      aria-hidden="true"
                    >
                      <Icon name={w.icon} class="h-5 w-5" />
                    </span>
                    <div>
                      <p class="font-bold text-heading">{w.title}</p>
                      <p class="mt-1 text-sm leading-relaxed text-ink">{w.body}</p>
                    </div>
                  </HubCard>
                ))}
              </ul>
            </div>

            {/* The single navy emphasis moment — where the money goes. */}
            <HubCard class="mt-8 bg-navy text-white">
              <span
                class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-amber"
                aria-hidden="true"
              >
                <Icon name="graduation-cap" class="h-7 w-7" />
              </span>
              <p class="text-lg font-bold text-white">Where your money goes</p>
              <p class="mt-2 max-w-xl leading-relaxed text-white/85">
                Every dollar raised goes straight back into the classrooms — supplies, enrichment,
                playground upkeep, and the special days that make WCP feel like home. No overhead,
                no salaries skimmed off the top.
              </p>
            </HubCard>
          </>
        )
      }
    </div>
  </Section>

  {/* Editable extra section(s) the Board can add to the fundraising page. */}
  {hasSections && <SectionRenderer sections={doc!.sections} site={site} />}
</HubShell>
