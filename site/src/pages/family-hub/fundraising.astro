---
/* ============================================================================
   Family Hub — Fundraising (GATED)
   ============================================================================
   Active campaigns (goal + raised + progress) come from Sanity `campaign` docs,
   read server-side inside the gate — the Treasurer updates the raised amount in
   the Studio. The "ways we raise" and "where it goes" context is static. No
   hardcoded dollar figures.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Icon from '@/components/Icon.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import { sanityFetch } from '@/lib/sanity';

interface Campaign {
  title?: string;
  summary?: string;
  goalAmount?: number;
  raisedAmount?: number;
  deadline?: string;
  linkLabel?: string;
  linkUrl?: string;
}
let campaigns: Campaign[] = [];
try {
  campaigns = await sanityFetch<Campaign[]>(
    `*[_type == "campaign" && active == true] | order(_createdAt desc){ title, summary, goalAmount, raisedAmount, deadline, linkLabel, linkUrl }`,
  );
} catch {
  campaigns = [];
}
const money = (n?: number) => `$${Math.round(n ?? 0).toLocaleString('en-US')}`;
const pctOf = (r?: number, g?: number) =>
  g && g > 0 ? Math.min(100, Math.round(((r ?? 0) / g) * 100)) : 0;
const fmtDeadline = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });

const waysToRaise = [
  {
    icon: 'hand-heart',
    title: 'Dine to Donate',
    body: 'Local restaurants give back a share of sales on WCP nights. Show up hungry — a portion of your bill comes back to the school.',
  },
  {
    icon: 'party-popper',
    title: 'Spring Raffle',
    body: 'Our biggest event of the year: themed baskets, donated prizes, and tickets sold across the community.',
  },
  {
    icon: 'shopping-bag',
    title: 'Seasonal Sales',
    body: 'Smaller fundraisers through the year — spirit wear, holiday items, and one-off sales run by the Fundraising Committee.',
  },
  {
    icon: 'gift',
    title: 'Direct Giving',
    body: 'Prefer to give directly? Donations are welcome any time and go straight into the classrooms.',
  },
];
---

<HubShell
  title="Fundraising"
  intro="What we’re raising money for this year, what’s active right now, and how you can help. Every dollar goes back into the classrooms."
  current="/family-hub/fundraising"
  pageTitle="Fundraising — WCP Family Hub"
>
  <Section bg="white" labelledby="active-now">
    <div class="mx-auto max-w-3xl">
      <SectionHeader
        eyebrow="Happening Now"
        title="Active fundraisers"
        titleId="active-now"
        align="left"
      />
      {
        campaigns.length === 0 ? (
          <HubEmptyState
            icon="party-popper"
            title="Current campaigns & totals will show here"
            source="google-sheets"
            class="mt-8"
          />
        ) : (
          <ul class="mt-8 space-y-6">
            {campaigns.map((c) => (
              <li class="rounded-[var(--radius)] border border-border bg-white p-6 shadow-sm dark:bg-surface">
                <p class="font-display text-xl text-heading">{c.title}</p>
                {c.summary && <p class="mt-1 text-ink-muted">{c.summary}</p>}
                {c.goalAmount && c.goalAmount > 0 && (
                  <div class="mt-4">
                    <div class="flex items-end justify-between gap-4">
                      <p class="font-display text-2xl text-heading">
                        {money(c.raisedAmount)}
                        <span class="text-sm font-normal text-ink-muted"> raised</span>
                      </p>
                      <p class="text-sm font-semibold text-ink-muted">{money(c.goalAmount)} goal</p>
                    </div>
                    <div
                      class="mt-2 h-4 overflow-hidden rounded-full bg-navy/10 dark:bg-white/15"
                      role="progressbar"
                      aria-label={`${c.title ?? 'Campaign'} progress`}
                      aria-valuenow={pctOf(c.raisedAmount, c.goalAmount)}
                      aria-valuemin={0}
                      aria-valuemax={100}
                      aria-valuetext={`${money(c.raisedAmount)} of ${money(c.goalAmount)} raised`}
                    >
                      <div
                        class="h-full rounded-full bg-amber"
                        style={`width: ${pctOf(c.raisedAmount, c.goalAmount)}%`}
                      />
                    </div>
                    <p class="mt-1 text-sm text-ink-muted">
                      {pctOf(c.raisedAmount, c.goalAmount)}% of goal
                      {c.deadline ? ` · by ${fmtDeadline(c.deadline)}` : ''}
                    </p>
                  </div>
                )}
                {c.linkUrl && (
                  <a
                    href={c.linkUrl}
                    class="mt-4 inline-flex items-center gap-1 rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy/90"
                  >
                    {c.linkLabel ?? 'Donate'}
                  </a>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Section>

  <Section bg="grey" labelledby="ways">
    <SectionHeader
      eyebrow="How We Raise"
      title="The ways WCP fundraises"
      titleId="ways"
      lead="A handful of friendly, low-pressure efforts across the year — join what fits your family."
    />
    <ul class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        waysToRaise.map((w) => (
          <li
            class="flex gap-4 rounded-[var(--radius)] bg-white p-6 shadow-sm dark:bg-surface"
            data-reveal
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
              aria-hidden="true"
            >
              <Icon name={w.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="font-bold text-heading">{w.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink">{w.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section bg="navy" seam labelledby="where-it-goes">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-amber"
        aria-hidden="true"
      >
        <Icon name="graduation-cap" class="h-7 w-7" />
      </span>
      <h2 id="where-it-goes" class="text-white">Where your money goes</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/85">
        Every dollar raised goes straight back into the classrooms — supplies, enrichment,
        playground upkeep, and the special days that make WCP feel like home. No overhead, no
        salaries skimmed off the top.
      </p>
    </div>
  </Section>
</HubShell>
