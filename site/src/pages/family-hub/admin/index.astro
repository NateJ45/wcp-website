---
/* ============================================================================
   Family Hub — admin (GATED, board only)
   ============================================================================
   The board's replacement for editing people in the Studio. The families' data
   left Sanity on 2026-09-06 because that dataset is PUBLIC on the free plan —
   37 families, children's names and home addresses were readable by anyone with
   the project id. It lives in the DIRECTORY KV namespace now, which has no
   public read surface at all.

   ONE PAGE on purpose: families, teachers' numbers and role contacts together,
   because a board member should never have to work out which sub-page an edit
   lives on. The only separate screen is editing a single family, where a small
   blast radius is worth the click.

   The line to hold: ANYTHING ABOUT A PERSON is edited here; anything published
   on the public site is edited in the Studio.

   Chrome matches the rest of the hub — `bare` shell, grey Section, the same
   HubPageHeader every other hub page uses — so this does not read as a
   different application bolted on the side.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import { readDirectoryDoc, readRepLinks } from '@/lib/hub-directory';
import { getTeacherPhones } from '@/lib/hub-teacher-phones';
import { getHubClassrooms } from '@/lib/hub-classes';
import { sanityFetch } from '@/lib/sanity';
import { ROLE_HOLDERS_QUERY } from '@/lib/queries';
import type { RoleHolderRow } from '@/lib/hub-org';

const [doc, links, phones] = await Promise.all([
  readDirectoryDoc(),
  readRepLinks(),
  getTeacherPhones(),
]);

const families = [...doc.entries].sort((a, b) =>
  (a.familyName || '').localeCompare(b.familyName || ''),
);
const optedIn = families.filter((f) => f.optedIn === true).length;

let holders: RoleHolderRow[] = [];
try {
  holders = (await sanityFetch<RoleHolderRow[]>(ROLE_HOLDERS_QUERY)) ?? [];
} catch {
  holders = [];
}
holders = holders.filter((h) => h?._id).sort((a, b) => (a.role ?? '').localeCompare(b.role ?? ''));

// ONE ROW PER CLASSROOM, not per class. Twos and Threes share a page and a
// teacher, so listing classes produced two boxes for one person - and they held
// the same number, which is the tell. `teacherPhoneFor` already tries the
// classroom key before the class slugs, so keying on the room is what the
// lookup wanted all along.
let rooms: { key: string; label: string }[] = [];
try {
  rooms = (await getHubClassrooms()).map((r) => ({ key: r.key, label: r.label }));
} catch {
  rooms = [];
}
// Anything stored under a key no room matches still shows, so a number can
// never be stranded somewhere the board cannot see or clear it.
for (const k of Object.keys(phones)) {
  if (!rooms.some((r) => r.key === k))
    rooms.push({ key: k, label: `${k} (no longer a class page)` });
}

const saved = Astro.url.searchParams.get('saved') === '1';
const conflict = Astro.url.searchParams.get('conflict') === '1';
const removed = Number(Astro.url.searchParams.get('removed') ?? '0');
const refusedEmpty = Astro.url.searchParams.get('refused-empty') === '1';
const input = 'w-full rounded-md border border-border bg-white px-3 py-2 dark:bg-surface';
const btn =
  'rounded-full bg-navy px-4 py-2 text-sm font-medium text-white hover:opacity-90 dark:bg-white dark:text-navy';
const btnGhost =
  'rounded-full border border-border px-4 py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10';
---

<HubShell title="Board admin" bare pageTitle="Board admin — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader
        title="Board admin"
        subtitle="Families, teachers' numbers and role contacts. Only the board can open this."
        icon="lock"
      />

      {
        saved && (
          <p class="mb-4 rounded-[var(--radius)] border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-900">
            Saved.
          </p>
        )
      }
      {
        conflict && (
          <p class="mb-4 rounded-[var(--radius)] border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Someone else changed the directory since this page was opened, so nothing was saved.
            Reload and make the change again — this is deliberate, so an old open tab cannot quietly
            undo someone else's edit.
          </p>
        )
      }

      {
        removed > 0 && (
          <p class="mb-4 rounded-[var(--radius)] border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-900">
            Removed {removed} {removed === 1 ? 'family' : 'families'}. The previous version was
            backed up first, so this can be undone if it was a mistake.
          </p>
        )
      }
      {
        refusedEmpty && (
          <p class="mb-4 rounded-[var(--radius)] border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            That would have removed every family, so nothing was changed. If you really do mean to
            clear the whole directory, remove them in smaller batches.
          </p>
        )
      }

      <h2 class="mt-2 mb-3 text-xl font-semibold">Families</h2>
      <HubCard>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-muted-foreground">
            {families.length} on file, {optedIn} showing in the directory. “Showing” means the family
            ticked include us — unticking hides them without deleting anything.
          </p>
          <div class="flex shrink-0 items-center gap-2">
            <button type="button" id="bulk-toggle" class={btnGhost}>Select several…</button>
            <a href="/family-hub/admin/family/new" class={btn}>Add a family</a>
          </div>
        </div>

        <form method="POST" action="/api/hub-admin/families-bulk" id="bulk-form">
          <input type="hidden" name="version" value={doc.version} />
          <div
            id="bulk-bar"
            hidden
            class="mb-3 flex flex-wrap items-center gap-3 rounded-[var(--radius)] border border-border bg-white/60 px-4 py-3 dark:bg-white/5"
          >
            <label class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="bulk-all" class="h-4 w-4" />
              Select all
            </label>
            <span id="bulk-count" class="text-sm text-muted-foreground">0 selected</span>
            <button
              type="submit"
              id="bulk-remove"
              disabled
              class="ml-auto inline-flex items-center rounded-full border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:opacity-40"
            >
              Remove selected
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-border text-muted-foreground">
                  <th class="bulk-cell py-2 pr-3 font-medium" hidden
                    ><span class="sr-only">Select</span></th
                  >
                  <th class="py-2 pr-3 font-medium">Family</th>
                  <th class="py-2 pr-3 font-medium">Grown-ups</th>
                  <th class="py-2 pr-3 font-medium">Children</th>
                  <th class="py-2 pr-3 font-medium">In directory</th>
                  <th class="py-2"></th>
                </tr>
              </thead>
              <tbody>
                {
                  families.map((f) => (
                    <tr class="border-b border-border/60">
                      <td class="bulk-cell py-2 pr-3" hidden>
                        <input
                          type="checkbox"
                          class="bulk-check h-4 w-4"
                          name="remove"
                          value={f._id}
                          aria-label={`Select ${f.familyName}`}
                        />
                      </td>
                      <td class="py-2 pr-3 font-medium">{f.familyName || '(no name)'}</td>
                      <td class="py-2 pr-3">
                        {(f.parents ?? [])
                          .map((p) => p.name)
                          .filter(Boolean)
                          .join(', ') || '—'}
                      </td>
                      <td class="py-2 pr-3">
                        {(f.children ?? [])
                          .map((c) => c.name)
                          .filter(Boolean)
                          .join(', ') || '—'}
                      </td>
                      <td class="py-2 pr-3">{f.optedIn === true ? 'Yes' : 'No'}</td>
                      <td class="py-2 text-right">
                        <a
                          class="font-medium underline"
                          href={`/family-hub/admin/family/${encodeURIComponent(f._id)}`}
                        >
                          Edit
                        </a>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </form>

        {
          families.length === 0 && (
            <p class="py-6 text-sm text-muted-foreground">
              No families on file. That is not normal — if it is unexpected, do not retype them: a
              backup of the previous version is written before every save, so restoring one is
              quicker and safer.
            </p>
          )
        }
      </HubCard>

      <h2 class="mt-8 mb-3 text-xl font-semibold">Teachers' phone numbers</h2>
      <HubCard>
        <p class="mb-4 text-sm text-muted-foreground">
          The “Call or text” number on each class's teacher card, private to signed-in families.
          Teachers' names, photos, notes and school email addresses are still edited in the Studio —
          those appear on the public website. Emptying a box removes the number and its link.
        </p>
        <form method="POST" action="/api/hub-admin/teachers" class="flex flex-col gap-3">
          {
            rooms.map((r) => (
              <div class="grid gap-2 sm:grid-cols-[14rem_1fr] sm:items-center">
                <label class="text-sm font-medium" for={`phone-${r.key}`}>
                  {r.label}
                </label>
                <input
                  id={`phone-${r.key}`}
                  name={`phone-${r.key}`}
                  value={phones[r.key] ?? ''}
                  class={input}
                />
              </div>
            ))
          }
          <button type="submit" class={`mt-2 self-start ${btn}`}>Save numbers</button>
        </form>
      </HubCard>

      <h2 class="mt-8 mb-3 text-xl font-semibold">Role contacts</h2>
      <HubCard>
        <p class="mb-4 text-sm text-muted-foreground">
          Which family each role is reached through. Their email and phone come from the directory
          above, so updating them in one place updates the card too. A role mailbox typed on the
          Sanity document (like president@…) still wins — an address that outlives whoever holds the
          role is the better one to publish.
        </p>
        {
          holders.length === 0 ? (
            <p class="text-sm text-muted-foreground">
              No role holders found. They are created in the Studio under Family Hub → Who's who.
            </p>
          ) : (
            <form method="POST" action="/api/hub-admin/reps" class="flex flex-col gap-3">
              {holders.map((h) => (
                <div class="grid gap-2 sm:grid-cols-[16rem_1fr] sm:items-center">
                  <label class="text-sm font-medium" for={`rep-${h._id}`}>
                    {h.role || h._id}
                    {h.person ? (
                      <span class="font-normal text-muted-foreground"> — {h.person}</span>
                    ) : null}
                  </label>
                  <select id={`rep-${h._id}`} name={`rep-${h._id}`} class={input}>
                    <option value="">No contact</option>
                    {families.map((f) => (
                      <option
                        value={f._id}
                        selected={(links[h._id as string] || h.contactFamilyId) === f._id}
                      >
                        {f.familyName}
                      </option>
                    ))}
                  </select>
                </div>
              ))}
              <button type="submit" class={`mt-2 self-start ${btn}`}>
                Save role contacts
              </button>
            </form>
          )
        }
      </HubCard>
    </div>
  </Section>
</HubShell>

<script>
  // Bulk removal for the end-of-year clear-out. Hidden until asked for, so the
  // everyday view stays a plain list and nobody deletes a family while meaning
  // to edit one.
  //
  // Progressive enhancement: with JS off the checkboxes and the bar stay hidden
  // and every family is still editable one at a time, which is what the board
  // did before this existed.
  const toggle = document.getElementById('bulk-toggle');
  const bar = document.getElementById('bulk-bar');
  const all = document.getElementById('bulk-all') as HTMLInputElement | null;
  const count = document.getElementById('bulk-count');
  const remove = document.getElementById('bulk-remove') as HTMLButtonElement | null;
  const form = document.getElementById('bulk-form') as HTMLFormElement | null;
  const boxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.bulk-check'));
  const cells = () => Array.from(document.querySelectorAll<HTMLElement>('.bulk-cell'));

  let on = false;
  const refresh = () => {
    const n = boxes().filter((b) => b.checked).length;
    if (count) count.textContent = `${n} selected`;
    if (remove) {
      remove.disabled = n === 0;
      remove.textContent = n ? `Remove ${n} ${n === 1 ? 'family' : 'families'}` : 'Remove selected';
    }
  };

  toggle?.addEventListener('click', () => {
    on = !on;
    cells().forEach((c) => (c.hidden = !on));
    if (bar) bar.hidden = !on;
    toggle.textContent = on ? 'Done selecting' : 'Select several…';
    if (!on) {
      boxes().forEach((b) => (b.checked = false));
      if (all) all.checked = false;
    }
    refresh();
  });

  all?.addEventListener('change', () => {
    boxes().forEach((b) => (b.checked = all.checked));
    refresh();
  });
  document.addEventListener('change', (e) => {
    if ((e.target as HTMLElement)?.classList?.contains('bulk-check')) refresh();
  });

  // Name the families in the confirmation. "Remove 12 families?" is a number
  // nobody checks; the names are what makes a wrong selection obvious.
  form?.addEventListener('submit', (e) => {
    const chosen = boxes().filter((b) => b.checked);
    if (!chosen.length) {
      e.preventDefault();
      return;
    }
    const names = chosen
      .map((b) => b.closest('tr')?.querySelector('td:nth-child(2)')?.textContent?.trim())
      .filter(Boolean);
    const shown =
      names.slice(0, 12).join(', ') + (names.length > 12 ? `, and ${names.length - 12} more` : '');
    if (
      !confirm(`Remove these ${chosen.length} families from the directory?

${shown}`)
    ) {
      e.preventDefault();
    }
  });
</script>
