---
/* ============================================================================
   Family Hub — sign-in (public: the one un-gated /family-hub page)
   ============================================================================
   Enrolled families enter the single shared password. The form POSTs to
   /api/hub-login, which verifies it against the FAMILY_HUB_PASSWORD secret and
   sets the session flag the middleware checks. prerender=false so the session
   check runs at request time.
   ============================================================================ */
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { HUB_SESSION_KEY, isFamilyAuthed } from '@/lib/hub-auth';

// Already signed in? Skip the form.
//
// This MUST use the same fingerprint check as the middleware, not a plain
// truthiness test on the session value. After the board rotates the password a
// stale fingerprint is still a non-empty string: "truthy" would send the family
// to /family-hub, the middleware would bounce them straight back here, and they
// would be stuck in a redirect loop instead of being asked for the new password.
const to = Astro.url.searchParams.get('to');
const safeTo = to && to.startsWith('/family-hub') ? to : '/family-hub';
const stored = await Astro.session?.get(HUB_SESSION_KEY);
if (await isFamilyAuthed(stored, env.FAMILY_HUB_PASSWORD)) {
  return Astro.redirect(safeTo);
}
const hasError = Astro.url.searchParams.get('error') === '1';
---

<BaseLayout
  title="Family Sign-In — West Chester Preschool"
  description="Sign in to the West Chester Preschool Family Hub."
>
  <Hero
    eyebrow="Enrolled Families"
    title="Family sign-in"
    lead="Enter the shared family password to reach your hub. New each school year, so check your welcome email or ask the board."
    height="medium"
  />

  <Section bg="grey" label="Sign in">
    <form
      method="POST"
      action="/api/hub-login"
      class="mx-auto flex max-w-sm flex-col gap-4 rounded-[var(--radius)] bg-white p-8 shadow-sm dark:bg-surface"
      data-reveal
    >
      <input type="hidden" name="to" value={safeTo} />
      <label class="block text-left">
        <span class="mb-1 block text-sm font-bold text-heading">Family password</span>
        <input
          type="password"
          name="password"
          required
          autocomplete="current-password"
          autofocus
          class="w-full rounded-lg border-2 border-border bg-white px-4 py-3 text-heading focus-visible:border-sky-ink dark:bg-surface"
        />
      </label>
      {
        hasError && (
          <p role="alert" class="text-sm font-semibold text-orange-ink">
            That password didn’t match. Please try again.
          </p>
        )
      }
      <Button type="submit" variant="primary" size="lg" class="w-full">Sign in</Button>
    </form>
    <p class="mx-auto mt-6 max-w-sm text-center text-sm text-ink-muted">
      Don’t have this year’s password? Email
      <a href={`mailto:${site.email.general}`} class="font-semibold text-sky-ink underline">
        {site.email.general}
      </a>.
    </p>
  </Section>
</BaseLayout>
