---
/* ============================================================================
   Family Hub — a single School Update / meeting post (GATED)
   ============================================================================
   Full post view for the meeting blog. Reads one `update` by slug server-side
   behind the gate and renders its Portable Text body in full. Falls back to the
   Updates index if the slug isn't found.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import Prose from '@/components/Prose.astro';
import SanityImage from '@/components/SanityImage.astro';
import { sanityFetch } from '@/lib/sanity';
import { classLabel } from '@/lib/class-colors';
import { renderPortableText } from '@/lib/portable-text';
import type { PortableTextBlock } from '@portabletext/types';
import type { SanityImageValue } from '@/lib/image';

interface UpdatePost {
  _id: string;
  title: string;
  publishedAt: string;
  audience?: string;
  image?: SanityImageValue | null;
  body?: PortableTextBlock[];
}

const { slug } = Astro.params;
let post: UpdatePost | null = null;
try {
  post = await sanityFetch<UpdatePost | null>(
    `*[_type == "update" && slug.current == $slug][0]{ _id, title, publishedAt, audience, image, body }`,
    { slug },
  );
} catch {
  post = null;
}
if (!post) return Astro.redirect('/family-hub/updates');

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
// The body is the whole article, rendered directly under the page <h1>, so
// normalize its heading levels (blockContent's "Heading" is h3) up to h2 — else
// h1 -> h3 trips WCAG heading-order. See src/lib/portable-text.ts.
const bodyHtml = renderPortableText(post.body, '', { normalizeHeadings: true });
---

<HubShell
  title={post.title}
  bare
  pageTitle={`${post.title} — WCP Family Hub`}
  description="A School Update from the WCP Board."
>
  <Section bg="grey" labelledby="hub-page-title">
    <article class="mx-auto max-w-3xl">
      <HubPageHeader
        title={post.title}
        icon="newspaper"
        backHref="/family-hub/updates"
        backLabel="All updates"
      />

      {/* Post meta — neutral text + a neutral-on-tint chip (both AA in dark mode). */}
      <div class="-mt-4 flex flex-wrap items-center gap-2">
        <span class="text-sm text-ink-muted">{fmtDate(post.publishedAt)}</span>
        {
          post.audience && post.audience !== 'all' && (
            <span class="rounded-full bg-sky/15 px-2.5 py-0.5 text-xs font-semibold text-heading">
              {classLabel(post.audience)}
            </span>
          )
        }
      </div>

      {
        post.image?.asset && (
          <HubCard class="mt-6 overflow-hidden p-0">
            <SanityImage
              source={post.image as never}
              alt={(post.image.alt as string) ?? post.title}
              class="w-full object-cover"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 768px"
            />
          </HubCard>
        )
      }
      {
        bodyHtml && (
          <Prose class="mt-8">
            <Fragment set:html={bodyHtml} />
          </Prose>
        )
      }
    </article>
  </Section>
</HubShell>
