---
/* ============================================================================
   Family Hub — landing (GATED)
   ============================================================================
   prerender=false so the middleware runs the sign-in check at request time.
   Only signed-in families reach this. Content is deliberately non-sensitive
   (welcome + quick links); the real family data lives in the section pages,
   sourced from Sanity behind this same gate.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { hubNav } from '@/data/hub-nav';
import { sanityFetch } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
let doc: HubPageDoc | null = null;
try {
  doc = await sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'home' });
} catch {
  doc = null;
}
const title = doc?.heading || 'Welcome back, WCP family.';
const intro =
  doc?.intro ||
  'Everything you need for the school year, all in one place. Pick a section above, or jump in below.';

// Quick-link cards for the two most-used groups (Information + Community).
const quickLinks = hubNav
  .filter((g) => g.label === 'Information' || g.label === 'Community')
  .flatMap((g) => g.links)
  .filter((l) => !l.external);
// The class rooms, so a family can jump straight to their child's page.
const classLinks = (hubNav.find((g) => g.label === 'Classes')?.links ?? []).filter(
  (l) => !l.external,
);
---

<HubShell
  title={title}
  intro={intro}
  current="/family-hub"
  pageTitle="Family Hub — West Chester Preschool"
>
  <Section bg="white" labelledby="hub-quicklinks">
    <SectionHeader
      eyebrow="Your Shortcuts"
      title="Jump right in"
      titleId="hub-quicklinks"
      lead="The things families reach for most, one tap away."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        quickLinks.map((link) => (
          <li>
            <a href={link.href} class="block h-full no-underline">
              <FeatureCard icon={link.icon} chip="sky" title={link.label}>
                Open {link.label.toLowerCase()}.
              </FeatureCard>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    classLinks.length > 0 && (
      <Section bg="grey" seam labelledby="hub-classes">
        <SectionHeader
          eyebrow="Your Classroom"
          title="Jump to your class"
          titleId="hub-classes"
          lead="Class notes, the daily schedule, and tuition for each room."
        />
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {classLinks.map((link) => (
            <li>
              <a href={link.href} class="block h-full no-underline">
                <FeatureCard icon={link.icon} chip="amber" title={link.label}>
                  Open the {link.label} room.
                </FeatureCard>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {/* Editable welcome section(s) the Board can add to the hub landing. */}
  <SectionRenderer sections={doc?.sections} site={site} />
</HubShell>
