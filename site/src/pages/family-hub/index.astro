---
/* ============================================================================
   Family Hub — landing / dashboard (GATED)
   ============================================================================
   prerender=false so the middleware runs the sign-in check at request time.
   The at-a-glance dashboard: greeting + community chips + school-year
   progress bar (HubGreeting), the four class cards (ClassHelperRow), and six
   compact content widgets. Board-editable content from the "home" hubPage
   doc still renders below via SectionRenderer, unchanged from every other
   hub page.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import HubGreeting from '@/components/hub/HubGreeting.astro';
import ClassHelperRow from '@/components/hub/ClassHelperRow.astro';
import PresidentNoteModal from '@/components/hub/PresidentNoteModal.astro';
import UpcomingEventsWidget from '@/components/hub/UpcomingEventsWidget.astro';
import AnnouncementsWidget from '@/components/hub/AnnouncementsWidget.astro';
import ClassPhotosWidget from '@/components/hub/ClassPhotosWidget.astro';
import MeetingMinutesWidget from '@/components/hub/MeetingMinutesWidget.astro';
import BudgetSnapshotWidget from '@/components/hub/BudgetSnapshotWidget.astro';
import FundraisingWidget from '@/components/hub/FundraisingWidget.astro';
import HubWidgetSkeleton from '@/components/hub/HubWidgetSkeleton.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY, SITE_SETTINGS_QUERY, DIRECTORY_FAMILY_COUNT_QUERY } from '@/lib/queries';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
interface SettingsDoc {
  tagline?: string;
  yearStart?: string;
  yearEnd?: string;
  firstDay?: string;
  familyCount?: number;
}

// The three page-level fetches are fully independent — run them concurrently
// (this is the highest-traffic gated page, so three sequential round-trips
// on top of each widget's own fetch is worth avoiding). Promise.allSettled
// preserves each fetch's existing fallback (null / null / 0) even if one
// (or more) of the three fails, matching the previous try/catch behavior.
const [docResult, settingsResult, familyCountResult] = await Promise.allSettled([
  sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'home' }, { cache: BOARD_CONTENT_CACHE }),
  sanityFetch<SettingsDoc | null>(SITE_SETTINGS_QUERY, {}, { cache: BOARD_CONTENT_CACHE }),
  // The count is a scalar over directory docs (no PII in the result), so it
  // rides the same cache — a new opt-in showing a few minutes late is fine.
  sanityFetch<number>(DIRECTORY_FAMILY_COUNT_QUERY, {}, { cache: BOARD_CONTENT_CACHE }),
]);
const doc = docResult.status === 'fulfilled' ? docResult.value : null;
const settings = settingsResult.status === 'fulfilled' ? settingsResult.value : null;
const liveFamilyCount = familyCountResult.status === 'fulfilled' ? familyCountResult.value : 0;

const title = doc?.heading || 'Family Hub';
const familyCount = settings?.familyCount ?? liveFamilyCount;
---

<HubShell title={title} bare pageTitle="Family Hub — West Chester Preschool">
  <Section bg="grey" labelledby="hub-page-title">
    {
      /* Bento dashboard: a 12-column grid where tile SIZE encodes importance
        (hero greeting largest → events/announcements features → smaller
        accent tiles), so the layout itself carries the hierarchy. Wrapper
        divs hold the grid spans + a staggered `--reveal-delay` (inherited by
        each card's data-reveal transition) so the dashboard cascades in on
        load — one orchestrated entrance, reduced-motion-safe (reveal.ts shows
        everything instantly under prefers-reduced-motion). */
    }
    {
      /* grid-cols-1 at base is load-bearing: an implicit auto column has a
        min-content floor, so a wide unbreakable widget row would stretch the
        whole column past 320px. minmax(0,1fr) clamps it. */
    }
    {
      /* overflow-x-clip: the decorative glow extends past the grid on purpose;
        clip (not hidden — no scroll container) keeps it off the page's
        horizontal scroll width at 320px. */
    }
    <div class="relative grid grid-cols-1 gap-4 overflow-x-clip lg:grid-cols-12">
      {/* Warm wash behind the greeting — tints the paper canvas, never text. */}
      <div class="wcp-glow wcp-glow-cream -top-24 -left-24 h-96 w-[36rem]" aria-hidden="true"></div>
      {/* HubGreeting owns the page h1 (id="hub-page-title") — Home is `bare`. */}
      <div class="relative lg:col-span-8">
        <HubGreeting
          tagline={settings?.tagline || site.tagline}
          yearStart={settings?.yearStart}
          yearEnd={settings?.yearEnd}
          firstDay={settings?.firstDay}
          familyCount={familyCount}
        />
      </div>

      {
        /* sr-only h2 bridges the h1 greeting → the h3 widget cards (no skip).
          Positioned absolutely (sr-only), so it doesn't occupy a grid cell. */
      }
      <h2 id="hub-dashboard-heading" class="sr-only">Your dashboard</h2>

      {
        /* The three Google-backed widgets (calendar feed, treasurer's sheet)
          are SERVER ISLANDS (server:defer): the dashboard shell paints
          immediately and they stream in behind a matching skeleton. This is
          what keeps even a cold-cache visit (fresh deploy, quiet morning)
          from blanking the whole page while Google answers — worst case is
          now "page instantly, numbers a beat later". The Sanity-backed
          widgets stay inline: the authenticated CDN answers in ~100ms, below
          the cost of an extra island round-trip. */
      }
      <div class="lg:col-span-4 lg:row-span-2" style="--reveal-delay: 60ms">
        <UpcomingEventsWidget server:defer>
          <HubWidgetSkeleton slot="fallback" title="Upcoming events" lines={6} />
        </UpcomingEventsWidget>
      </div>

      <div class="lg:col-span-8" style="--reveal-delay: 120ms">
        {
          /* My-classes picker (JS-only nicety; hidden without JS). Stored on
            the device — no accounts. MULTI-select: plenty of families have
            kids in more than one class, so the chips toggle (aria-pressed)
            and Done closes. src/scripts/my-class.ts shows exactly one of
            these two strips and personalizes tiles/albums/rail from the set. */
        }
        <div
          data-my-class-picker
          hidden
          class="mb-3 flex flex-wrap items-center gap-2 rounded-[var(--radius)] border border-border bg-white/80 px-4 py-2.5 text-sm dark:bg-surface/80"
        >
          <span class="font-semibold text-heading">Which classes are yours?</span>
          {
            [
              { slug: 'twos', label: 'Twos' },
              { slug: 'threes', label: 'Threes' },
              { slug: 'pre-k-am', label: 'Pre-K AM' },
              { slug: 'pre-k-pm', label: 'Pre-K PM' },
            ].map((c) => (
              <button
                type="button"
                data-my-class-pick={c.slug}
                aria-pressed="false"
                class="rounded-full border border-border bg-white px-3 py-1 font-semibold text-ink transition-colors hover:border-navy hover:text-heading aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white dark:bg-surface"
              >
                {c.label}
              </button>
            ))
          }
          <button
            type="button"
            data-my-class-done
            hidden
            class="ml-auto font-bold text-sky-ink hover:underline"
          >
            Done
          </button>
        </div>
        <div
          data-my-class-current
          hidden
          class="mb-3 flex flex-wrap items-center gap-2 rounded-[var(--radius)] border border-border bg-white/80 px-4 py-2.5 text-sm dark:bg-surface/80"
        >
          <span class="text-ink">Your class<span data-my-class-plural>es</span>:</span>
          {/* Separate flex item so the strip's gap-2 spaces it from the label. */}
          <strong class="text-heading" data-my-class-label></strong>
          <button type="button" data-my-class-change class="font-bold text-sky-ink hover:underline">
            Change
          </button>
        </div>
        <ClassHelperRow />
      </div>

      <div class="lg:col-span-8" style="--reveal-delay: 180ms">
        <AnnouncementsWidget />
      </div>
      <div class="lg:col-span-4" style="--reveal-delay: 240ms">
        <FundraisingWidget server:defer>
          <HubWidgetSkeleton slot="fallback" title="Fundraising" lines={3} />
        </FundraisingWidget>
      </div>

      <div class="lg:col-span-4" style="--reveal-delay: 300ms">
        <MeetingMinutesWidget />
      </div>
      <div class="lg:col-span-4" style="--reveal-delay: 360ms">
        <ClassPhotosWidget />
      </div>
      <div class="lg:col-span-4" style="--reveal-delay: 420ms">
        <BudgetSnapshotWidget server:defer>
          <HubWidgetSkeleton slot="fallback" title="Budget snapshot" lines={3} />
        </BudgetSnapshotWidget>
      </div>
    </div>
  </Section>

  {/* Editable welcome section(s) the Board can add to the hub landing. */}
  <SectionRenderer sections={doc?.sections} site={site} />

  {/* The President's welcome letter — pops once per version stamp. */}
  <PresidentNoteModal />
</HubShell>
