---
/* ============================================================================
   Family Hub — Family Directory (GATED, PII)
   ============================================================================
   Real family names/photos/contact info are PII: they load from Sanity behind
   this gate, only for families who opt in, and never touch git or the public
   site. This page is layout + privacy framing + an empty-state only.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Icon from '@/components/Icon.astro';
import Callout from '@/components/Callout.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import SanityImage from '@/components/SanityImage.astro';
import DirectoryMap from '@/components/hub/DirectoryMap.astro';
import { sanityFetch } from '@/lib/sanity';

// The preschool, geocoded once (9463 Cincinnati Columbus Rd, West Chester OH).
const PRESCHOOL = { lat: 39.3143544, lng: -84.3750201, label: 'West Chester Preschool' };

const classLabel: Record<string, string> = {
  twos: 'Twos',
  threes: 'Threes',
  'pre-k-am': 'Pre-K AM',
  'pre-k-pm': 'Pre-K PM',
};

interface DirChild {
  name?: string;
  class?: string;
}
interface DirEntry {
  _id: string;
  familyName: string;
  parents?: string[];
  children?: DirChild[];
  email?: string;
  phone?: string;
  photo?: { asset?: unknown; alt?: string } | null;
  location?: { lat?: number; lng?: number } | null;
  notes?: string;
}
let entries: DirEntry[] = [];
try {
  entries = await sanityFetch<DirEntry[]>(
    `*[_type == "directoryEntry" && optedIn == true] | order(familyName asc){ _id, familyName, parents, children, email, phone, photo, location, notes }`,
  );
} catch {
  entries = [];
}

// Families with a geocoded pin, for the map.
const mapFamilies = entries
  .filter(
    (f) => f.location && typeof f.location.lat === 'number' && typeof f.location.lng === 'number',
  )
  .map((f) => ({
    name: `The ${f.familyName} Family`,
    lat: f.location!.lat as number,
    lng: f.location!.lng as number,
    kids:
      (f.children ?? [])
        .map((c) => c.name)
        .filter(Boolean)
        .join(', ') || undefined,
  }));

const points = [
  {
    icon: 'lock',
    title: 'Families only',
    body: 'The directory is visible only to signed-in WCP families — never on the public site or in search results.',
  },
  {
    icon: 'hand',
    title: 'Opt-in',
    body: 'Your family appears only if you choose to share. You decide exactly what to list.',
  },
  {
    icon: 'heart-handshake',
    title: 'For connecting',
    body: 'Built to help families set up playdates, carpools, and friendships outside the classroom.',
  },
];
---

<HubShell
  title="Family Directory"
  intro="Names, photos, and contact info for every WCP family this year. Built for connecting outside the classroom."
  current="/family-hub/directory"
  pageTitle="Family Directory — WCP Family Hub"
>
  <Section bg="white" labelledby="directory">
    <div class="mx-auto max-w-3xl">
      <SectionHeader
        eyebrow="This Year’s Families"
        title="The WCP family directory"
        titleId="directory"
        align="left"
      />

      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          points.map((p) => (
            <li
              class="rounded-[var(--radius)] border border-border bg-white p-5 text-center dark:bg-surface"
              data-reveal
            >
              <span
                class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                aria-hidden="true"
              >
                <Icon name={p.icon} class="h-5 w-5" />
              </span>
              <p class="font-bold text-heading">{p.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink">{p.body}</p>
            </li>
          ))
        }
      </ul>

      {
        entries.length === 0 ? (
          <HubEmptyState
            icon="contact"
            title="Family cards will appear here"
            source="directory"
            class="mt-10"
          />
        ) : (
          <div class="mt-10">
            <div
              class="mb-6 inline-flex rounded-full border border-border p-1"
              role="tablist"
              aria-label="Directory view"
            >
              <button
                id="dir-tab-list"
                type="button"
                class="rounded-full px-5 py-1.5 text-sm font-semibold text-ink-muted aria-selected:bg-navy aria-selected:text-white"
                aria-selected="true"
              >
                List
              </button>
              <button
                id="dir-tab-map"
                type="button"
                class="rounded-full px-5 py-1.5 text-sm font-semibold text-ink-muted aria-selected:bg-navy aria-selected:text-white"
                aria-selected="false"
              >
                Map
              </button>
            </div>
            <ul id="dir-list" class="grid gap-5 sm:grid-cols-2">
              {entries.map((f) => (
                <li class="flex gap-4 rounded-[var(--radius)] border border-border bg-white p-5 shadow-sm dark:bg-surface">
                  {f.photo?.asset ? (
                    <SanityImage
                      source={f.photo as never}
                      alt={f.photo.alt ?? f.familyName}
                      widths={[96, 192]}
                      sizes="64px"
                      class="h-16 w-16 shrink-0 rounded-full object-cover"
                    />
                  ) : (
                    <span
                      class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-sky/15 font-display text-2xl text-sky-ink"
                      aria-hidden="true"
                    >
                      {f.familyName.charAt(0)}
                    </span>
                  )}
                  <div class="min-w-0">
                    <p class="font-bold text-heading">The {f.familyName} Family</p>
                    {f.parents && f.parents.length > 0 && (
                      <p class="text-sm text-ink-muted">{f.parents.join(' & ')}</p>
                    )}
                    {f.children && f.children.length > 0 && (
                      <p class="mt-1 flex flex-wrap gap-1">
                        {f.children.map((ch) => (
                          <span class="rounded-full bg-grey px-2 py-0.5 text-xs font-semibold text-ink-muted">
                            {ch.name}
                            {ch.class ? ` · ${classLabel[ch.class] ?? ch.class}` : ''}
                          </span>
                        ))}
                      </p>
                    )}
                    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                      {f.email && (
                        <a
                          href={`mailto:${f.email}`}
                          class="font-semibold text-navy underline underline-offset-2 dark:text-sky"
                        >
                          Email
                        </a>
                      )}
                      {f.phone && (
                        <a
                          href={`tel:${f.phone}`}
                          class="font-semibold text-navy underline underline-offset-2 dark:text-sky"
                        >
                          {f.phone}
                        </a>
                      )}
                    </p>
                    {f.notes && <p class="mt-2 text-sm text-ink">{f.notes}</p>}
                  </div>
                </li>
              ))}
            </ul>
            <div id="dir-map-view" hidden>
              <DirectoryMap families={mapFamilies} preschool={PRESCHOOL} />
              <p class="mt-3 text-sm text-ink-muted">
                The star marks the preschool; each pin is a family who added a home address.
              </p>
            </div>
          </div>
        )
      }

      <Callout tone="sky" class="mt-10">
        <strong class="font-bold text-heading">Your privacy:</strong> WCP never publishes family information.
        Directory details stay behind this family sign-in, are shared only with your permission, and are
        kept out of the public website entirely.
      </Callout>
    </div>
  </Section>

  <script>
    const listTab = document.getElementById('dir-tab-list');
    const mapTab = document.getElementById('dir-tab-map');
    const listView = document.getElementById('dir-list');
    const mapView = document.getElementById('dir-map-view');
    function show(isMap: boolean) {
      if (listView) listView.hidden = isMap;
      if (mapView) mapView.hidden = !isMap;
      listTab?.setAttribute('aria-selected', String(!isMap));
      mapTab?.setAttribute('aria-selected', String(isMap));
      if (isMap) document.dispatchEvent(new CustomEvent('wcp:showmap'));
    }
    listTab?.addEventListener('click', () => show(false));
    mapTab?.addEventListener('click', () => show(true));
  </script>
</HubShell>
