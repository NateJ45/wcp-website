---
/* ============================================================================
   Family Hub — Family Directory (GATED, PII)
   ============================================================================
   Real family names/photos/contact info are PII: they load from Sanity behind
   this gate, only for families who opt in, and never touch git or the public
   site. This page is layout + privacy framing + an empty-state only.
   ============================================================================ */
export const prerender = false;

import HubHint from '@/components/hub/HubHint.astro';
import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubFilterChip from '@/components/hub/HubFilterChip.astro';
import HubDisclosure from '@/components/hub/HubDisclosure.astro';
import Icon from '@/components/Icon.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import SanityImage from '@/components/SanityImage.astro';
import DirectoryMap from '@/components/hub/DirectoryMap.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { colorStyles } from '@/lib/class-colors';
import { getHubClassrooms } from '@/lib/hub-classes';
import { classLookup } from '@/lib/hub-classrooms';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { getDirectoryEntries, type DirEntry } from '@/lib/hub-directory';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { hubDraftMode, readHubPageDoc, publishedId } from '@/lib/hub-preview';
import { site } from '@/data/site';

interface HubPageDoc {
  _id?: string;
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// Studio Presentation loads this REAL page as its preview (2026-08-30): the
// verified preview cookie makes the hubPage read draft-aware (stega on) and
// mounts the click-to-edit overlay via previewDocId. Families: unchanged.
const draftMode = await hubDraftMode(Astro.cookies);

// The preschool. Coordinates come from site.geo (the one place they live) so
// the map pin, the JSON-LD, and the hub's weather lookups can never disagree.
const PRESCHOOL = { lat: site.geo.lat, lng: site.geo.lng, label: site.name };

// Independent of the entries read — start now, await later (2026-07 hub-speed
// pass).
const hubDocPromise = readHubPageDoc<HubPageDoc>(draftMode, HUB_PAGE_QUERY, {
  key: 'directory',
}).catch(() => null);

// Families come from KV, NOT Sanity. The Sanity dataset is public on the free
// plan, so `directoryEntry` documents were readable by anyone with the project
// id — 37 families, 40 children, 33 home addresses — straight past this page's
// gate (2026-09-06). Do not "restore" a Sanity fallback here: it would quietly
// republish the lot. See src/lib/hub-directory.ts.
const entries: DirEntry[] = await getDirectoryEntries();

// Map tab is a Board on/off switch (Hub settings → Google connections). Off by
// default: no Map tab, and the Leaflet map never loads.
let showMap = false;
try {
  const s = await sanityFetch<{ showDirectoryMap?: boolean } | null>(
    `*[_type == "hubSettings"][0]{ showDirectoryMap }`,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
  showMap = s?.showDirectoryMap === true;
} catch {
  showMap = false;
}

// Class filter (?class=twos): find families by the class their kids are in.
// SSR link-chips, not JS state — the filter is shareable, works with no JS,
// and the persistent-shell view transitions keep the reload feeling app-like.
// Chips only render for classes that actually have opted-in families, and an
// unknown/absent param falls back to everyone.
// The order, the names and the colours all come from the `class` documents, so
// a class the Board adds filters, labels and tints itself (2026-08-29 — this
// used to be a hardcoded list of the four 2026-27 slugs). A slug no class
// matches still shows, titleized, rather than vanishing from the filter.
const cls = classLookup(await getHubClassrooms());
const classesPresent = [
  ...new Set(entries.flatMap((f) => (f.children ?? []).map((c) => c.class).filter(Boolean))),
].sort(
  (a, b) => (cls.slugs.indexOf(a as string) + 1 || 99) - (cls.slugs.indexOf(b as string) + 1 || 99),
) as string[];
const requestedClass = Astro.url.searchParams.get('class');
const classFilter =
  requestedClass && classesPresent.includes(requestedClass) ? requestedClass : null;
const shown = classFilter
  ? entries.filter((f) => (f.children ?? []).some((c) => c.class === classFilter))
  : entries;

// Alpha jump rail (2026-07-14 app-elevation): the letters that actually have
// families IN THE CURRENT FILTER, each linking to that letter's first card.
// Pure anchors — works with no JS. `firstOfLetter` marks which card carries
// each letter's id.
const lettersPresent = [...new Set(shown.map((f) => f.familyName.charAt(0).toUpperCase()))];
const firstOfLetter = new Map<string, string>(); // letter -> entry _id
for (const f of shown) {
  const l = f.familyName.charAt(0).toUpperCase();
  if (!firstOfLetter.has(l)) firstOfLetter.set(l, f._id);
}
const letterFor = (f: DirEntry) => {
  const l = f.familyName.charAt(0).toUpperCase();
  return firstOfLetter.get(l) === f._id ? l : null;
};

// Contact-chip label: the first REAL name word. Teachers are listed with an
// honorific ("Mrs. Lisa Cortez"), and a bare split(' ')[0] rendered that chip
// as "MRS." (2026-07-17 audit). Skip leading honorifics; a name that is ONLY
// an honorific falls back to its first word.
const firstName = (name?: string): string => {
  const parts = (name ?? '').trim().split(/\s+/);
  return parts.find((w) => !/^(?:mr|mrs|ms|miss|mx|dr)\.?$/i.test(w)) ?? parts[0] ?? '';
};

// Families with a geocoded pin, for the map (filter applies here too).
const mapFamilies = shown
  .filter(
    (f) => f.location && typeof f.location.lat === 'number' && typeof f.location.lng === 'number',
  )
  .map((f) => ({
    name: `The ${f.familyName} Family`,
    lat: f.location!.lat as number,
    lng: f.location!.lng as number,
    kids:
      (f.children ?? [])
        .map((c) => c.name)
        .filter(Boolean)
        .join(', ') || undefined,
  }));

const points = [
  {
    icon: 'lock',
    title: 'Families only',
    body: 'The directory is visible only to signed-in WCP families — never on the public site or in search results.',
  },
  {
    icon: 'hand',
    title: 'Opt-in',
    body: 'Your family appears only if you choose to share. You decide exactly what to list.',
  },
  {
    icon: 'heart-handshake',
    title: 'For connecting',
    body: 'Built to help families set up playdates, carpools, and friendships outside the classroom.',
  },
];

const doc: HubPageDoc | null = await hubDocPromise;
const title = doc?.heading || 'Family Directory';
const intro =
  doc?.intro ||
  'Names, photos, and contact info for every WCP family this year. Built for connecting outside the classroom.';
---

<HubShell
  title={title}
  bare
  pageTitle="Family Directory — WCP Family Hub"
  previewDocId={draftMode ? publishedId(doc?._id) : undefined}
>
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="contact" />

      {
        /* Privacy framing, compacted (premium-screens phase 2): answer-first
           means families open the page on the DIRECTORY, not on three cards
           of policy. The same three assurances live one line tall in a
           disclosure a family can open when they want the detail. */
      }
      <HubDisclosure
        card
        icon="lock"
        title="How the directory protects your family"
        hint="Families only · opt-in · built for connecting"
        class="mt-8"
      >
        <ul class="grid gap-3 sm:grid-cols-3">
          {
            points.map((p) => (
              <li>
                <p class="font-bold text-heading">{p.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink">{p.body}</p>
              </li>
            ))
          }
        </ul>
      </HubDisclosure>

      {
        entries.length === 0 ? (
          <HubEmptyState
            spot="families"
            title="Family cards will appear here"
            source="directory"
            class="mt-10"
          />
        ) : (
          <div class="mt-10">
            {/* List/Map view toggle — only when the Board turns the map on. */}
            {showMap && (
              <div
                class="mb-6 inline-flex rounded-full border border-border p-1"
                role="tablist"
                aria-label="Directory view"
              >
                <button
                  id="dir-tab-list"
                  type="button"
                  role="tab"
                  aria-controls="dir-list"
                  class="rounded-full px-5 py-1.5 text-sm font-semibold text-ink-muted aria-selected:bg-navy aria-selected:text-white"
                  aria-selected="true"
                >
                  List
                </button>
                <button
                  id="dir-tab-map"
                  type="button"
                  role="tab"
                  aria-controls="dir-map-view"
                  class="rounded-full px-5 py-1.5 text-sm font-semibold text-ink-muted aria-selected:bg-navy aria-selected:text-white"
                  aria-selected="false"
                >
                  Map
                </button>
              </div>
            )}
            {/* Class filter chips: find the families in your child's class.
                Real links (?class=…), so the filter is shareable and JS-free;
                chips carry the class dot, active chip goes solid navy. */}
            {classesPresent.length > 1 && (
              <nav aria-label="Filter families by class" class="mb-4 flex flex-wrap gap-2">
                <HubFilterChip href={Astro.url.pathname} active={!classFilter}>
                  All families
                </HubFilterChip>
                {classesPresent.map((slug) => (
                  <HubFilterChip
                    href={`${Astro.url.pathname}?class=${slug}`}
                    active={classFilter === slug}
                  >
                    <span
                      class={`h-2 w-2 rounded-full ${colorStyles(cls.color(slug)).dot}`}
                      aria-hidden="true"
                    />
                    {cls.label(slug)}
                  </HubFilterChip>
                ))}
              </nav>
            )}
            {/* Alpha jump rail: plain anchors to each letter's first card
                (scroll-mt clears the sticky desktop topbar). Only letters
                with families render, so it never dead-ends. */}
            {lettersPresent.length > 2 && (
              <nav aria-label="Jump to families by letter" class="mb-5">
                <ul class="flex flex-wrap gap-1">
                  {lettersPresent.map((l) => (
                    <li>
                      <a
                        href={`#dir-${l}`}
                        class="flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-heading no-underline hover:bg-navy/10 dark:hover:bg-white/10"
                      >
                        {l}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            <ul id="dir-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {shown.map((f) => {
                const kidClasses = [
                  ...new Set((f.children ?? []).map((c) => c.class).filter(Boolean)),
                ] as string[];
                const contacts = (f.parents ?? []).filter((p) => p.email || p.phone);
                const letter = letterFor(f);
                return (
                  <li
                    id={letter ? `dir-${letter}` : undefined}
                    class="wcp-lift group flex scroll-mt-20 flex-col overflow-hidden rounded-[var(--radius)] border border-border bg-white shadow-sm hover:shadow-md dark:bg-surface"
                  >
                    {/* Large portrait family photo with class overlay */}
                    <div class="relative aspect-[3/4] w-full overflow-hidden bg-navy/5 dark:bg-white/5">
                      {f.photo?.asset ? (
                        <SanityImage
                          source={f.photo as never}
                          alt={f.photo.alt ?? `The ${f.familyName} family`}
                          widths={[400, 800]}
                          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 100vw"
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        />
                      ) : (
                        /* No-photo fallback (2026-07-14 app-elevation): a
                           class-color RINGED initial avatar on the soft tint —
                           the panel keeps the photo slot's 3:4 rhythm, but the
                           avatar reads as a deliberate profile mark instead of
                           an empty tile. Ring = class colour border (AA-safe
                           theme-stable class shade). */
                        <div
                          class={`flex h-full w-full items-center justify-center ${colorStyles(cls.color(kidClasses[0])).softBg}`}
                          aria-hidden="true"
                        >
                          <span
                            class={`flex h-24 w-24 items-center justify-center rounded-full border-4 bg-white shadow-sm dark:bg-surface ${colorStyles(cls.color(kidClasses[0])).border}`}
                          >
                            <span
                              class={`font-display text-4xl ${colorStyles(cls.color(kidClasses[0])).text}`}
                            >
                              {f.familyName.charAt(0)}
                            </span>
                          </span>
                        </div>
                      )}
                      {kidClasses.length > 0 && (
                        <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
                          {kidClasses.map((kidClass) => (
                            <span
                              class={`rounded-full px-3 py-1 text-xs font-bold shadow-sm ${colorStyles(cls.color(kidClass)).badge}`}
                            >
                              {cls.label(kidClass)}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    {/* Family info */}
                    <div class="flex flex-1 flex-col p-5">
                      <p class="font-display text-xl text-heading">The {f.familyName} Family</p>

                      {(f.neighborhood || f.carpoolInterest || f.playdateInterest) && (
                        <div class="mt-2 flex flex-wrap items-center gap-1.5">
                          {f.neighborhood && (
                            <span class="inline-flex items-center gap-1 rounded-full bg-grey px-2.5 py-0.5 text-xs font-semibold text-ink-muted dark:bg-white/10">
                              <Icon name="map-pin" class="h-3 w-3" />
                              {f.neighborhood}
                            </span>
                          )}
                          {f.carpoolInterest && (
                            <span class="inline-flex items-center gap-1 rounded-full bg-sky/15 px-2.5 py-0.5 text-xs font-semibold text-heading">
                              <Icon name="users" class="h-3 w-3 text-sky-ink" />
                              Open to carpool
                            </span>
                          )}
                          {f.playdateInterest && (
                            <span class="inline-flex items-center gap-1 rounded-full bg-green/15 px-2.5 py-0.5 text-xs font-semibold text-heading">
                              <Icon name="hand-heart" class="h-3 w-3 text-green-ink" />
                              Playdates welcome
                            </span>
                          )}
                        </div>
                      )}

                      {((f.parents?.length ?? 0) > 0 || (f.children?.length ?? 0) > 0) && (
                        <ul class="mt-2 space-y-0.5 text-sm">
                          {(f.parents ?? []).map((p) => (
                            <li>
                              <span class="font-semibold text-heading">{p.name}</span>
                              <span class="text-ink-muted"> · {p.role || 'Parent'}</span>
                            </li>
                          ))}
                          {(f.children ?? []).map((ch) => (
                            <li>
                              <span class="font-semibold text-heading">{ch.name}</span>
                              {ch.class && (
                                <span
                                  class={`font-semibold ${colorStyles(cls.color(ch.class)).text}`}
                                >
                                  {' · '}
                                  {cls.label(ch.class)}
                                </span>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}

                      {f.notes && (
                        <p class="mt-3 rounded-[var(--radius)] bg-grey/70 p-3 text-sm text-ink-muted italic dark:bg-white/5">
                          {f.notes}
                        </p>
                      )}

                      {contacts.length > 0 && (
                        <div class="mt-4 space-y-2">
                          {contacts.map((p) => (
                            <div class="flex flex-wrap items-center gap-2">
                              {/* min-w (not w): a fixed 56px box wrapped long names
                                  mid-word ("PARAMIT / A" — 2026-07 responsive audit).
                                  Short names keep the aligned column; long ones take
                                  the room they need and the buttons wrap below. */}
                              <span class="min-w-14 text-xs font-semibold tracking-wide whitespace-nowrap text-ink-muted uppercase">
                                {firstName(p.name)}
                              </span>
                              {p.email && (
                                <a
                                  href={`mailto:${p.email}`}
                                  data-copy={p.email}
                                  data-copy-label={`${firstName(p.name)}’s email`}
                                  aria-label={`Email ${p.name} (${p.email}) — also copies the address`}
                                  class="inline-flex items-center gap-1.5 rounded-full bg-amber px-3 py-1.5 text-sm font-bold text-black transition hover:brightness-95"
                                >
                                  <Icon name="mail" class="h-4 w-4" /> Email
                                </a>
                              )}
                              {p.phone && (
                                <a
                                  href={`tel:${p.phone}`}
                                  data-copy={p.phone}
                                  data-copy-label={`${firstName(p.name)}’s number`}
                                  aria-label={`Call ${p.name} (${p.phone}) — also copies the number`}
                                  class="inline-flex items-center gap-1.5 rounded-full bg-navy px-3 py-1.5 text-sm font-bold text-white transition hover:bg-navy/90"
                                >
                                  <Icon name="phone" class="h-4 w-4" /> Call
                                </a>
                              )}
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
            {showMap && (
              <div id="dir-map-view" hidden>
                <DirectoryMap families={mapFamilies} preschool={PRESCHOOL} />
                <p class="mt-3 text-sm text-ink-muted">
                  The star marks the preschool; each pin is a family who added a home address.
                </p>
              </div>
            )}
          </div>
        )
      }

      <HubCard class="mt-10 flex items-start gap-4 p-4">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
          aria-hidden="true"
        >
          <Icon name="shield-check" class="h-5 w-5" />
        </span>
        <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink">
          <strong class="font-bold text-heading">Your privacy:</strong> WCP never publishes family information.
          Directory details stay behind this family sign-in, are shared only with your permission, and
          are kept out of the public website entirely.
        </p>
      </HubCard>
    </div>
  </Section>

  {/* Editable extra section(s) the Board can add to the directory page. */}
  <SectionRenderer sections={doc?.sections} site={site} hub />

  {/* Toast shown when a contact button copies an email/number to the clipboard. */}
  <div
    id="wcp-toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed inset-x-0 bottom-6 z-50 mx-auto flex w-max max-w-[90vw] translate-y-2 items-center gap-2 rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white opacity-0 shadow-lg transition-[opacity,transform] duration-300"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4 shrink-0 text-green"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    <span id="wcp-toast-msg"></span>
  </div>

  <script>
    import '@/scripts/copy-contact';
    import { onPageLoad } from '@/scripts/_page-load';
    onPageLoad(() => {
      const listTab = document.getElementById('dir-tab-list');
      const mapTab = document.getElementById('dir-tab-map');
      const listView = document.getElementById('dir-list');
      const mapView = document.getElementById('dir-map-view');
      function show(isMap: boolean) {
        if (listView) listView.hidden = isMap;
        if (mapView) mapView.hidden = !isMap;
        listTab?.setAttribute('aria-selected', String(!isMap));
        mapTab?.setAttribute('aria-selected', String(isMap));
        if (isMap) document.dispatchEvent(new CustomEvent('wcp:showmap'));
      }
      listTab?.addEventListener('click', () => show(false));
      mapTab?.addEventListener('click', () => show(true));
    });
  </script>
  <HubHint
    id="directory-map"
    target='nav[aria-label="Filter families by class"], #wcp-dirmap'
    text="These chips show just one class's families. Only families who opted in appear here."
  />
</HubShell>
