---
/* ============================================================================
   Family Hub — School Calendar (GATED)
   ============================================================================
   Live sources, all read server-side inside the gate:
     1. The school Google Calendar via its Apps Script JSON feed (Sanity
        `event` docs as fallback — see src/lib/hub-calendar.ts), rendered as
        the upcoming agenda list with type chips.
     2. The same feed, rendered as our own on-brand month grid (HubCalendarGrid,
        desktop only) — replaces the un-styleable cross-origin Google iframe.
   Plus subscribe buttons (Add to Google / Apple & Outlook / Open in browser)
   built from the calendar id, so families can put the school calendar on their
   phones or open Google's own full UI.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubFilterChip from '@/components/hub/HubFilterChip.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import HubCalendarGrid from '@/components/hub/HubCalendarGrid.astro';
import HubCalendarSchedule from '@/components/hub/HubCalendarSchedule.astro';
import HubEventDialog from '@/components/hub/HubEventDialog.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import {
  getUpcomingEvents,
  getCalendarEvents,
  eventDate,
  fmtEventMonth,
  fmtEventDay,
  fmtEventWeekday,
  fmtEventTime,
  eventType,
  eventId,
  EVENT_TYPE_META,
  type HubEvent,
} from '@/lib/hub-calendar';
import { calendarFeedUrlFallback, googleCalendarIdFallback } from '@/data/hub/live-links';
import { deEmDash } from '@/lib/portable-text';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// Independent of the settings→feed chain below — start it now, await later
// (2026-07 hub-speed pass).
const hubDocPromise = sanityFetch<HubPageDoc | null>(
  HUB_PAGE_QUERY,
  { key: 'calendar' },
  { cache: BOARD_CONTENT_CACHE },
).catch(() => null);

let calId = googleCalendarIdFallback;
let feedUrl = calendarFeedUrlFallback;
try {
  const s = await sanityFetch<{ googleCalendarId?: string; calendarFeedUrl?: string } | null>(
    `*[_type == "siteSettings"][0]{ googleCalendarId, calendarFeedUrl }`,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
  calId = s?.googleCalendarId || googleCalendarIdFallback;
  feedUrl = s?.calendarFeedUrl || calendarFeedUrlFallback;
} catch {
  calId = googleCalendarIdFallback;
}

// The upcoming list — the live Google Calendar feed (Sanity events fallback).
const allEvents: HubEvent[] = (await getUpcomingEvents(feedUrl)).slice(0, 12);
// The full-window event set for the branded month grid (shares the same cache
// entry as the upcoming list above, so this is a cache hit, not a second fetch).
const calendarEvents: HubEvent[] = await getCalendarEvents(feedUrl);

// Event-type filter (?type=meeting|volunteer|milestone|event): page-global
// link-chips, same SSR mechanics as the Directory's class filter. Chips only
// render for types that exist in the current window; unknown param → all.
const typesPresent = [...new Set(allEvents.map((e) => eventType(e.title)))];
const requestedType = Astro.url.searchParams.get('type');
const typeFilter =
  requestedType && (typesPresent as string[]).includes(requestedType)
    ? (requestedType as (typeof typesPresent)[number])
    : null;
const events = typeFilter ? allEvents.filter((e) => eventType(e.title) === typeFilter) : allEvents;

const doc: HubPageDoc | null = await hubDocPromise;
const title = doc?.heading || 'School Calendar';
const intro =
  doc?.intro ||
  'Class days, closures, board meetings, fundraisers, and family events. All the dates that matter this school year, in one place.';
const calEmbedUrl = calId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calId)}&ctz=America/New_York&mode=MONTH&showTitle=0&showPrint=0&showTabs=1&showCalendars=0&showTz=0`
  : '';
// Subscribe links, built from the same calendar id as the embed.
const addToGoogleUrl = calId
  ? `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(calId)}`
  : '';
const icalUrl = calId
  ? `https://calendar.google.com/calendar/ical/${encodeURIComponent(calId)}/public/basic.ics`
  : '';
---

<HubShell title={title} bare pageTitle="Calendar — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="calendar-days" />

      {/* Subscribe — put the school calendar on your phone. */}
      {
        calId && (
          <HubCard class="flex flex-wrap items-center justify-between gap-4 p-4">
            <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink" style="min-width: 14rem">
              <strong class="font-bold text-heading">Never miss a date.</strong> Add the WCP
              calendar to your phone and updates land automatically.
            </p>
            <span class="flex flex-wrap gap-2">
              <Button
                href={addToGoogleUrl}
                target="_blank"
                rel="noopener"
                variant="primary"
                size="sm"
              >
                Add to Google
              </Button>
              <Button href={icalUrl} variant="outline" size="sm">
                Apple / Outlook
              </Button>
              <Button href={calEmbedUrl} target="_blank" rel="noopener" variant="outline" size="sm">
                Open in browser
              </Button>
            </span>
          </HubCard>
        )
      }

      {/* What's coming up — live from the school Google Calendar feed. */}
      <div class="mt-10" aria-labelledby="upcoming">
        <h2 id="upcoming" class="text-xl font-extrabold text-heading">What’s coming up</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Straight from the school calendar. Updates made there show up here automatically.
        </p>

        {/* Type filter chips — real links, page-global (premium-screens plan). */}
        {
          typesPresent.length > 1 && (
            <nav aria-label="Filter events by type" class="mt-4 flex flex-wrap gap-2">
              <HubFilterChip href={Astro.url.pathname} active={!typeFilter}>
                Everything
              </HubFilterChip>
              {typesPresent.map((t) => (
                <HubFilterChip href={`${Astro.url.pathname}?type=${t}`} active={typeFilter === t}>
                  <Icon
                    name={EVENT_TYPE_META[t].icon}
                    class={`h-3.5 w-3.5 ${EVENT_TYPE_META[t].iconColor}`}
                  />
                  {EVENT_TYPE_META[t].labelPlural}
                </HubFilterChip>
              ))}
            </nav>
          )
        }

        {
          events.length > 0 ? (
            <ul class="mt-6 grid gap-3">
              {events.map((e, i) => {
                const meta = EVENT_TYPE_META[eventType(e.title)];
                // Month separator (2026-07-14 app-elevation): a quiet label +
                // rule whenever the agenda crosses into a new month, so a long
                // list scans by month instead of reading as one undated run.
                const monthOf = (ev: HubEvent) =>
                  eventDate(ev.start).toLocaleDateString('en-US', {
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'America/New_York',
                  });
                const newMonth = i === 0 || monthOf(events[i - 1]) !== monthOf(e);
                return (
                  <>
                    {newMonth && (
                      <li class="mt-3 flex items-center gap-3 px-1 first:mt-0">
                        <span class="text-xs font-bold tracking-wide text-ink-muted uppercase">
                          {monthOf(e).replace(` ${new Date().getFullYear()}`, '')}
                        </span>
                        <span class="h-px flex-1 bg-border" aria-hidden="true" />
                      </li>
                    )}
                    <HubCard
                      as="li"
                      class="relative flex cursor-pointer items-center gap-4 p-4 transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                      style={`--note-accent: ${meta.accent}`}
                    >
                      {/* Overlay trigger — click the card to open the event in
                          the detail dialog (hub-event-dialog.ts). */}
                      <button
                        type="button"
                        class="wcp-card-trigger absolute inset-0 z-[1] rounded-[inherit]"
                        data-event-id={eventId(e)}
                        aria-label={`View details: ${deEmDash(e.title)}`}
                      />
                      <span
                        class={`flex w-12 shrink-0 flex-col items-center rounded-lg py-1.5 ${meta.chipBg}`}
                      >
                        <span class={`text-xs font-bold uppercase ${meta.chipText}`}>
                          {fmtEventMonth(e)}
                        </span>
                        <span class="text-xl leading-tight font-extrabold text-heading">
                          {fmtEventDay(e)}
                        </span>
                      </span>
                      <div class="min-w-0 flex-1">
                        <p class="font-bold text-heading">{deEmDash(e.title)}</p>
                        <p class="text-sm text-ink-muted">
                          {fmtEventWeekday(e)} · {fmtEventTime(e)}
                          {e.location ? ` · ${e.location}` : ''}
                        </p>
                      </div>
                      <span
                        class={`hidden shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold sm:inline-flex ${meta.chipBg} ${meta.chipText}`}
                      >
                        <Icon name={meta.icon} class={`h-3.5 w-3.5 ${meta.iconColor}`} />
                        {meta.label}
                      </span>
                    </HubCard>
                  </>
                );
              })}
            </ul>
          ) : (
            <HubEmptyState
              spot="calendar"
              title="Upcoming events will list here"
              source="google-calendar"
              class="mt-6"
            />
          )
        }
      </div>

      {
        /* The full school calendar — the same feed as the agenda, shown as our
          on-brand month grid on desktop and a compact collapsible-month schedule
          on phones (where a 7-col grid is unusable). Both cover the full ~12
          month window. "Open in browser" in the subscribe card still reaches
          Google's own UI. */
      }
      <div class="mt-12" aria-labelledby="full-calendar">
        <h2 id="full-calendar" class="text-xl font-extrabold text-heading">
          The full school calendar
        </h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Every dated item, straight from the school calendar. Updates made there show up here
          automatically. Tap any day or event for details.
        </p>
        {/* Desktop: month grid. */}
        <HubCard class="mt-6 hidden p-4 sm:p-5 md:block">
          <HubCalendarGrid events={calendarEvents} />
        </HubCard>
        {/* Phones: compact full-year schedule (browse all 12 months). */}
        <div class="mt-6 md:hidden">
          <HubCalendarSchedule events={calendarEvents} />
        </div>
      </div>

      {/* Weather closures — neutral info note (was a Callout side-stripe) */}
      <HubCard class="mt-12 flex items-start gap-4 p-4">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
          aria-hidden="true"
        >
          <Icon name="snowflake" class="h-5 w-5" />
        </span>
        <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink">
          <strong class="font-bold text-heading">Weather closures:</strong> WCP follows
          <span class="font-semibold"> Lakota Local Schools</span>. If Lakota closes, WCP closes.
          Watch your email and our Facebook page for school-specific updates.
        </p>
      </HubCard>

      {
        /* Shared event/day details modal — opened by the agenda cards and grid
          day cells above. Built from the full event window (same data). */
      }
      <HubEventDialog events={calendarEvents} />
    </div>
  </Section>

  {/* Editable extra section(s) the Board can add below the calendar. */}
  <SectionRenderer sections={doc?.sections} site={site} />

  <script>
    import '@/scripts/hub-calendar-grid';
    import '@/scripts/hub-event-dialog';
  </script>
</HubShell>
