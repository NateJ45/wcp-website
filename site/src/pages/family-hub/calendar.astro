---
/* ============================================================================
   Family Hub — School Calendar (GATED)
   ============================================================================
   Live sources, all read server-side inside the gate:
     1. The school Google Calendar via its Apps Script JSON feed (Sanity
        `event` docs as fallback — see src/lib/hub-calendar.ts), rendered as
        the upcoming list with type chips.
     2. The full Google Calendar embed, click-to-load (privacy: nothing loads
        from Google until the family clicks).
   Plus subscribe buttons (Add to Google / Apple & Outlook) built from the
   calendar id, so families can put the school calendar on their phones.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { sanityFetch } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import {
  getUpcomingEvents,
  fmtEventMonth,
  fmtEventDay,
  fmtEventWeekday,
  fmtEventTime,
  eventType,
  EVENT_TYPE_META,
  type HubEvent,
} from '@/lib/hub-calendar';
import { calendarFeedUrlFallback, googleCalendarIdFallback } from '@/data/hub/live-links';
import { site } from '@/data/site';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// Independent of the settings→feed chain below — start it now, await later
// (2026-07 hub-speed pass).
const hubDocPromise = sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'calendar' }).catch(
  () => null,
);

let calId = googleCalendarIdFallback;
let feedUrl = calendarFeedUrlFallback;
try {
  const s = await sanityFetch<{ googleCalendarId?: string; calendarFeedUrl?: string } | null>(
    `*[_type == "siteSettings"][0]{ googleCalendarId, calendarFeedUrl }`,
  );
  calId = s?.googleCalendarId || googleCalendarIdFallback;
  feedUrl = s?.calendarFeedUrl || calendarFeedUrlFallback;
} catch {
  calId = googleCalendarIdFallback;
}

// The upcoming list — the live Google Calendar feed (Sanity events fallback).
const events: HubEvent[] = (await getUpcomingEvents(feedUrl)).slice(0, 12);

const doc: HubPageDoc | null = await hubDocPromise;
const title = doc?.heading || 'School Calendar';
const intro =
  doc?.intro ||
  'Class days, closures, board meetings, fundraisers, and family events. All the dates that matter this school year, in one place.';
const calEmbedUrl = calId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calId)}&ctz=America/New_York&mode=MONTH&showTitle=0&showPrint=0&showTabs=1&showCalendars=0&showTz=0`
  : '';
// Subscribe links, built from the same calendar id as the embed.
const addToGoogleUrl = calId
  ? `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(calId)}`
  : '';
const icalUrl = calId
  ? `https://calendar.google.com/calendar/ical/${encodeURIComponent(calId)}/public/basic.ics`
  : '';
---

<HubShell title={title} bare pageTitle="Calendar — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="calendar-days" />

      {/* Subscribe — put the school calendar on your phone. */}
      {
        calId && (
          <HubCard class="flex flex-wrap items-center justify-between gap-4 p-4">
            <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink" style="min-width: 14rem">
              <strong class="font-bold text-heading">Never miss a date.</strong> Add the WCP
              calendar to your phone and updates land automatically.
            </p>
            <span class="flex flex-wrap gap-2">
              <Button
                href={addToGoogleUrl}
                target="_blank"
                rel="noopener"
                variant="primary"
                size="sm"
              >
                Add to Google
              </Button>
              <Button href={icalUrl} variant="outline" size="sm">
                Apple / Outlook
              </Button>
              <Button href={calEmbedUrl} target="_blank" rel="noopener" variant="outline" size="sm">
                Open in browser
              </Button>
            </span>
          </HubCard>
        )
      }

      {/* What's coming up — live from the school Google Calendar feed. */}
      <div class="mt-10" aria-labelledby="upcoming">
        <h2 id="upcoming" class="text-xl font-extrabold text-heading">What’s coming up</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Straight from the school calendar. Updates made there show up here automatically.
        </p>

        {
          events.length > 0 ? (
            <ul class="mt-6 grid gap-3">
              {events.map((e) => {
                const meta = EVENT_TYPE_META[eventType(e.title)];
                return (
                  <HubCard as="li" class="flex items-center gap-4 p-4">
                    <span class="flex w-12 shrink-0 flex-col items-center rounded-lg bg-grey py-1.5">
                      <span class="text-xs font-bold text-sky-ink uppercase">
                        {fmtEventMonth(e)}
                      </span>
                      <span class="text-xl leading-tight font-extrabold text-heading">
                        {fmtEventDay(e)}
                      </span>
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="font-bold text-heading">{e.title}</p>
                      <p class="text-sm text-ink-muted">
                        {fmtEventWeekday(e)} · {fmtEventTime(e)}
                        {e.location ? ` · ${e.location}` : ''}
                      </p>
                    </div>
                    <span class="hidden shrink-0 items-center gap-1.5 rounded-full bg-grey px-2.5 py-1 text-xs font-semibold text-heading sm:inline-flex">
                      <Icon name={meta.icon} class={`h-3.5 w-3.5 ${meta.iconColor}`} />
                      {meta.label}
                    </span>
                  </HubCard>
                );
              })}
            </ul>
          ) : (
            <HubEmptyState
              icon="calendar-days"
              title="Upcoming events will list here"
              source="google-calendar"
              class="mt-6"
            />
          )
        }
      </div>

      {/* The full school calendar — privacy-preserving click-to-load embed */}
      {
        calEmbedUrl && (
          <div class="mt-12" aria-labelledby="full-calendar">
            <h2 id="full-calendar" class="text-xl font-extrabold text-heading">
              The full school calendar
            </h2>
            <p class="mt-1 max-w-2xl text-ink-muted">
              Month view of every dated item. It opens from Google Calendar only when you click, so
              nothing loads from Google until you ask.
            </p>
            <HubCard class="mt-6 overflow-hidden p-0">
              <div
                class="relative h-[620px] bg-grey"
                data-embed-calendar={calEmbedUrl}
                data-embed-title="West Chester Preschool calendar"
              >
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
                  <span
                    class="flex h-14 w-14 items-center justify-center rounded-full bg-navy text-white"
                    aria-hidden="true"
                  >
                    <Icon name="calendar-days" class="h-7 w-7" />
                  </span>
                  <div>
                    <p class="font-bold text-heading">The WCP school calendar</p>
                    <p class="mt-1 text-sm text-ink-muted">
                      Opens from Google Calendar when you click, so nothing loads from Google until
                      you ask.
                    </p>
                  </div>
                  <button
                    type="button"
                    class="wcp-embed-open rounded-full bg-navy px-6 py-2.5 font-semibold text-white transition hover:bg-navy/90"
                  >
                    Show the calendar
                  </button>
                </div>
              </div>
            </HubCard>
          </div>
        )
      }

      {/* Weather closures — neutral info note (was a Callout side-stripe) */}
      <HubCard class="mt-12 flex items-start gap-4 p-4">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
          aria-hidden="true"
        >
          <Icon name="snowflake" class="h-5 w-5" />
        </span>
        <p class="min-w-0 flex-1 text-sm leading-relaxed text-ink">
          <strong class="font-bold text-heading">Weather closures:</strong> WCP follows
          <span class="font-semibold"> Lakota Local Schools</span>. If Lakota closes, WCP closes —
          watch your email and our Facebook page for school-specific updates.
        </p>
      </HubCard>
    </div>
  </Section>

  {/* Editable extra section(s) the Board can add below the calendar. */}
  <SectionRenderer sections={doc?.sections} site={site} />

  <script>
    import '@/scripts/embeds';
  </script>
</HubShell>
