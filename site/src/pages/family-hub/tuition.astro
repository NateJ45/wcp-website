---
/* ============================================================================
   Family Hub — Tuition & Payments (GATED)
   ============================================================================
   Class facts, fee amounts, PayPal button ids, and the payment FAQ all read
   from Sanity (the `class` docs + the `feeSchedule` singleton), so the Board
   edits them in the Studio. src/data/classes.ts + the *Fallback arrays below
   are only used, per field, when Sanity is missing a value or the read fails.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { payUrl } from '@/data/classes';
import { getHubClasses } from '@/lib/hub-classes';
import { safeIcon } from '@/lib/icons';
import { site } from '@/data/site';
import { sanityFetch } from '@/lib/sanity';
import { HUB_PAGE_QUERY, FEE_SCHEDULE_HUB_QUERY } from '@/lib/queries';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

interface FeeSchedule {
  registrationFee?: string;
  registrationNote?: string;
  registrationPayId?: string;
  participationFee?: string;
  participationNote?: string;
  participationPayId?: string;
  studentFeeBands?: { label?: string; amount?: string; payId?: string }[];
  paymentTerms?: { icon?: string; question?: string; answer?: string }[];
}

// Fallbacks — used per field when Sanity is missing a value or the read fails.
const studentFeesFallback = [
  { label: 'Twos & Threes', amount: '$45', payId: 'GQZ67ZRZ4W9UN' },
  { label: 'Pre-K AM & PM', amount: '$50', payId: 'A797LM4LL5PGJ' },
];
const enrollmentFeesFallback = [
  {
    icon: 'file-check',
    title: 'Registration Fee',
    amount: '$100',
    when: 'due at enrollment',
    body: 'Secures your child’s spot. Non-refundable once enrollment is confirmed.',
    payId: 'CUDQHL444WZLC',
    action: 'Pay Registration Fee',
  },
  {
    icon: 'shield-check',
    title: 'Participation Fee',
    amount: '$100',
    when: 'due at May Gathering',
    body: 'Returned at year-end when all co-op commitments have been fulfilled.',
    payId: 'LB4PP7LPYD5R2',
    action: 'Pay Deposit',
  },
];
const faqsFallback = [
  {
    icon: 'calendar-days',
    q: 'When tuition is due',
    a: 'The 1st of each month. You have through the 7th to pay before a late fee applies.',
  },
  {
    icon: 'clock',
    q: 'Late fee',
    a: '10% of the month’s tuition is added if your payment arrives after the 7th.',
  },
  {
    icon: 'circle-dollar-sign',
    q: 'How to pay',
    a: 'Use the PayPal buttons on this page (small processing fee), pay by check, or pay in cash. All three work the same to the school.',
  },
  {
    icon: 'mail',
    q: 'Paying by check',
    a: 'Make checks payable to WCP and write your child’s name in the memo line. Drop it in the Treasurer’s mailbox at school or hand it to her in person. If you use bank bill-pay, set the send date so the check arrives by the 1st.',
  },
  {
    icon: 'coins',
    q: 'Paying for the full year',
    a: 'There’s no annual discount, but you can skip monthly billing entirely — email the Treasurer to arrange a single yearly payment.',
  },
];

// Class facts + tuition button ids, from Sanity (data-file fallback per field).
const classRows = await getHubClasses();

// Fee amounts, notes, PayPal button ids, and the payment FAQ, from the
// feeSchedule singleton (falls back to the arrays above, per field).
let fee: FeeSchedule | null = null;
try {
  fee = await sanityFetch<FeeSchedule | null>(FEE_SCHEDULE_HUB_QUERY);
} catch {
  fee = null;
}
const studentBands =
  fee?.studentFeeBands && fee.studentFeeBands.length > 0
    ? fee.studentFeeBands
    : studentFeesFallback;
// Normalize so label/amount/payId are always strings (fall back by index).
const studentFees = studentBands.map((b, i) => ({
  label: b.label ?? studentFeesFallback[i]?.label ?? '',
  amount: b.amount ?? studentFeesFallback[i]?.amount ?? '',
  payId: b.payId ?? studentFeesFallback[i]?.payId ?? '',
}));
const enrollmentFees = [
  {
    ...enrollmentFeesFallback[0],
    amount: fee?.registrationFee ?? enrollmentFeesFallback[0].amount,
    body: fee?.registrationNote ?? enrollmentFeesFallback[0].body,
    payId: fee?.registrationPayId ?? enrollmentFeesFallback[0].payId,
  },
  {
    ...enrollmentFeesFallback[1],
    amount: fee?.participationFee ?? enrollmentFeesFallback[1].amount,
    body: fee?.participationNote ?? enrollmentFeesFallback[1].body,
    payId: fee?.participationPayId ?? enrollmentFeesFallback[1].payId,
  },
];
const faqs =
  fee?.paymentTerms && fee.paymentTerms.length > 0
    ? fee.paymentTerms.map((t) => ({
        icon: safeIcon(t.icon, 'circle-dollar-sign'),
        q: t.question,
        a: t.answer,
      }))
    : faqsFallback;

let doc: HubPageDoc | null = null;
try {
  doc = await sanityFetch<HubPageDoc | null>(HUB_PAGE_QUERY, { key: 'tuition' });
} catch {
  doc = null;
}
const title = doc?.heading || 'Tuition & Payments';
const intro =
  doc?.intro ||
  'Monthly amounts by class, due dates, late fees, and the buttons to pay your tuition. Questions about your account go to the Treasurer.';
---

<HubShell
  title={title}
  intro={intro}
  current="/family-hub/tuition"
  pageTitle="Tuition & Payments — WCP Family Hub"
>
  {/* Class tuition — a pay card per class */}
  <Section bg="white" labelledby="class-tuition">
    <SectionHeader
      eyebrow="2026-27 Class Tuition"
      title="Pay your monthly tuition"
      titleId="class-tuition"
      lead="Tuition is billed monthly. Pick your class and pay by card through PayPal, or use check or cash (see below)."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        classRows.map((c) => (
          <li
            class="wcp-lift flex flex-col rounded-[var(--radius)] border border-border bg-white p-6 shadow-sm hover:shadow-md dark:bg-surface"
            data-reveal
          >
            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full bg-navy text-white"
                aria-hidden="true"
              >
                <Icon name={c.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="text-lg font-extrabold text-heading">{c.name}</p>
                <p class="text-sm text-ink-muted">{c.days}</p>
              </div>
              <p class="ml-auto text-right">
                <span class="block text-2xl font-extrabold text-green-ink">{c.monthly}</span>
                <span class="block text-xs text-ink-muted">/ month</span>
              </p>
            </div>
            <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
              <dt class="text-ink-muted">Time</dt>
              <dd class="text-right font-semibold text-heading">{c.time}</dd>
              <dt class="text-ink-muted">Age</dt>
              <dd class="text-right font-semibold text-heading">{c.age}</dd>
              <dt class="text-ink-muted">Annual</dt>
              <dd class="text-right font-semibold text-heading">{c.annual}</dd>
            </dl>
            <Button
              href={payUrl(c.payId)}
              target="_blank"
              rel="noopener"
              variant="primary"
              size="md"
              class="mt-5 w-full"
            >
              Pay {c.name} Tuition
            </Button>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Student + enrollment fees */}
  <Section bg="grey" labelledby="other-fees">
    <SectionHeader
      eyebrow="Fees"
      title="Student & enrollment fees"
      titleId="other-fees"
      lead="Paid once a year. Student fees cover supplies and enrichment; enrollment fees secure your spot and back your co-op commitment."
    />

    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        studentFees.map((f) => (
          <div
            class="flex items-center gap-4 rounded-[var(--radius)] bg-white p-5 shadow-sm dark:bg-surface"
            data-reveal
          >
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
              aria-hidden="true"
            >
              <Icon name="palette" class="h-5 w-5" />
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-heading">Student Fee · {f.label}</p>
              <p class="text-sm text-ink-muted">{f.amount} per year — supplies & enrichment</p>
            </div>
            <Button
              href={payUrl(f.payId)}
              target="_blank"
              rel="noopener"
              variant="outline"
              size="sm"
            >
              Pay {f.amount}
            </Button>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-6 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        enrollmentFees.map((f) => (
          <div
            class="flex flex-col rounded-[var(--radius)] bg-white p-6 shadow-sm dark:bg-surface"
            data-reveal
          >
            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                aria-hidden="true"
              >
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-bold text-heading">{f.title}</p>
                <p class="text-sm text-ink-muted">
                  {f.amount} · {f.when}
                </p>
              </div>
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-ink">{f.body}</p>
            <Button
              href={payUrl(f.payId)}
              target="_blank"
              rel="noopener"
              variant="primary"
              size="sm"
              class="mt-5 w-full"
            >
              {f.action}
            </Button>
          </div>
        ))
      }
    </div>
  </Section>

  {/* How payments work */}
  <Section bg="navy" seam labelledby="how-pay">
    <SectionHeader
      eyebrow="How Payments Work"
      eyebrowTone="amber"
      title="Quick answers to the common questions"
      titleId="how-pay"
      lead="For anything not covered here, the Treasurer is one email away."
    />
    <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        faqs.map((f) => (
          <li class="flex gap-4 rounded-[var(--radius)] bg-white/10 p-5" data-reveal>
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15 text-amber"
              aria-hidden="true"
            >
              <Icon name={f.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="font-bold text-white">{f.q}</p>
              <p class="mt-1 text-sm leading-relaxed text-white/85">{f.a}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-center text-white/85">
      Questions about your account?{' '}
      <a
        href={`mailto:${site.email.general}`}
        class="font-semibold text-amber underline underline-offset-2"
      >
        Email the Treasurer
      </a>
    </p>
  </Section>

  {/* Editable extra section(s) the Board can add to the tuition page. */}
  <SectionRenderer sections={doc?.sections} site={site} />
</HubShell>
