---
/* ============================================================================
   Family Hub — Tuition & Payments (GATED)
   ============================================================================
   Class facts, fee amounts, PayPal button ids, and the payment FAQ all read
   from Sanity (the `class` docs + the `feeSchedule` singleton), so the Board
   edits them in the Studio. src/data/classes.ts + the *Fallback arrays below
   are only used, per field, when Sanity is missing a value or the read fails.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubDisclosure from '@/components/hub/HubDisclosure.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import HubSectionedBody from '@/components/hub/HubSectionedBody.astro';
import { payUrl } from '@/data/classes';
import { getHubClasses } from '@/lib/hub-classes';
import { classStyles } from '@/lib/class-colors';
import { safeIcon } from '@/lib/icons';
import { cn } from '@/lib/utils';
import { site } from '@/data/site';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY, FEE_SCHEDULE_HUB_QUERY } from '@/lib/queries';

interface HubPageDoc {
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

interface FeeSchedule {
  registrationFee?: string;
  registrationNote?: string;
  registrationPayId?: string;
  participationFee?: string;
  participationNote?: string;
  participationPayId?: string;
  studentFeeBands?: { label?: string; amount?: string; payId?: string }[];
  paymentTerms?: { icon?: string; question?: string; answer?: string }[];
}

// Fallbacks — used per field when Sanity is missing a value or the read fails.
const studentFeesFallback = [
  { label: 'Twos & Threes', amount: '$45', payId: 'GQZ67ZRZ4W9UN' },
  { label: 'Pre-K AM & PM', amount: '$50', payId: 'A797LM4LL5PGJ' },
];
const enrollmentFeesFallback = [
  {
    icon: 'file-check',
    title: 'Registration Fee',
    amount: '$100',
    when: 'due at enrollment',
    body: 'Secures your child’s spot. Non-refundable once enrollment is confirmed.',
    payId: 'CUDQHL444WZLC',
    action: 'Pay Registration Fee',
  },
  {
    icon: 'shield-check',
    title: 'Participation Fee',
    amount: '$100',
    when: 'due at May Gathering',
    body: 'Returned at year-end when all co-op commitments have been fulfilled.',
    payId: 'LB4PP7LPYD5R2',
    action: 'Pay Deposit',
  },
];
const faqsFallback = [
  {
    icon: 'calendar-days',
    q: 'When tuition is due',
    a: 'The 1st of each month. You have through the 7th to pay before a late fee applies.',
  },
  {
    icon: 'clock',
    q: 'Late fee',
    a: '10% of the month’s tuition is added if your payment arrives after the 7th.',
  },
  {
    icon: 'circle-dollar-sign',
    q: 'How to pay',
    a: 'Use the PayPal buttons on this page (small processing fee), pay by check, or pay in cash. All three work the same to the school.',
  },
  {
    icon: 'mail',
    q: 'Paying by check',
    a: 'Make checks payable to WCP and write your child’s name in the memo line. Drop it in the Treasurer’s mailbox at school or hand it to her in person. If you use bank bill-pay, set the send date so the check arrives by the 1st.',
  },
  {
    icon: 'coins',
    q: 'Paying for the full year',
    a: 'There’s no annual discount, but you can skip monthly billing entirely — email the Treasurer to arrange a single yearly payment.',
  },
];

// The three Sanity reads are independent — start them together, await in
// order (2026-07 hub-speed pass; each keeps its original failure fallback).
const feePromise = sanityFetch<FeeSchedule | null>(
  FEE_SCHEDULE_HUB_QUERY,
  {},
  {
    cache: BOARD_CONTENT_CACHE,
  },
).catch(() => null);
const hubDocPromise = sanityFetch<HubPageDoc | null>(
  HUB_PAGE_QUERY,
  { key: 'tuition' },
  { cache: BOARD_CONTENT_CACHE },
).catch(() => null);

// Class facts + tuition button ids, from Sanity (data-file fallback per field).
const classRows = await getHubClasses();

// Fee amounts, notes, PayPal button ids, and the payment FAQ, from the
// feeSchedule singleton (falls back to the arrays above, per field).
const fee: FeeSchedule | null = await feePromise;
const studentBands =
  fee?.studentFeeBands && fee.studentFeeBands.length > 0
    ? fee.studentFeeBands
    : studentFeesFallback;
// Normalize so label/amount/payId are always strings (fall back by index).
const studentFees = studentBands.map((b, i) => ({
  label: b.label ?? studentFeesFallback[i]?.label ?? '',
  amount: b.amount ?? studentFeesFallback[i]?.amount ?? '',
  payId: b.payId ?? studentFeesFallback[i]?.payId ?? '',
}));
const enrollmentFees = [
  {
    ...enrollmentFeesFallback[0],
    amount: fee?.registrationFee ?? enrollmentFeesFallback[0].amount,
    body: fee?.registrationNote ?? enrollmentFeesFallback[0].body,
    payId: fee?.registrationPayId ?? enrollmentFeesFallback[0].payId,
  },
  {
    ...enrollmentFeesFallback[1],
    amount: fee?.participationFee ?? enrollmentFeesFallback[1].amount,
    body: fee?.participationNote ?? enrollmentFeesFallback[1].body,
    payId: fee?.participationPayId ?? enrollmentFeesFallback[1].payId,
  },
];
const faqs =
  fee?.paymentTerms && fee.paymentTerms.length > 0
    ? fee.paymentTerms.map((t) => ({
        icon: safeIcon(t.icon, 'circle-dollar-sign'),
        q: t.question,
        a: t.answer,
      }))
    : faqsFallback;

const doc: HubPageDoc | null = await hubDocPromise;
const title = doc?.heading || 'Tuition & Payments';
const intro =
  doc?.intro ||
  'Monthly amounts by class, due dates, late fees, and the buttons to pay your tuition. Questions about your account go to the Treasurer.';
---

<HubShell
  title={title}
  bare
  current="/family-hub/tuition"
  pageTitle="Tuition & Payments — WCP Family Hub"
>
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="circle-dollar-sign">
        <Button slot="action" href={`mailto:${site.email.general}`} variant="outline" size="sm">
          Email the Treasurer
        </Button>
      </HubPageHeader>

      {/* Monthly tuition — a pay card per class */}
      <div aria-labelledby="class-tuition">
        <h2 id="class-tuition" class="text-xl font-extrabold text-heading">
          Monthly tuition by class
        </h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Billed monthly. Pay by card through PayPal, or by check or cash (see “How payments work”
          below).
        </p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            classRows.map((c) => (
              /* Class color everywhere it's safe: solid name pill (white on the
                 class ink — theme-stable, AA), tinted icon chip, colored price,
                 and a class-colored Pay button, so the four cards read apart at
                 a glance (the old site's strongest cue). */
              <HubCard as="li" class="flex flex-col">
                <div class="flex-1">
                  <div class="flex items-center gap-3">
                    <span
                      class={cn(
                        'flex h-11 w-11 shrink-0 items-center justify-center rounded-full',
                        classStyles(c.slug).iconChip,
                      )}
                      aria-hidden="true"
                    >
                      <Icon name={c.icon} class="h-5 w-5" />
                    </span>
                    <div class="min-w-0">
                      <span
                        class={cn(
                          'inline-flex rounded-full px-2.5 py-0.5 text-xs font-extrabold tracking-wide uppercase',
                          classStyles(c.slug).badge,
                        )}
                      >
                        {c.name}
                      </span>
                      <p class="mt-1 text-sm text-ink-muted">{c.days}</p>
                    </div>
                    <p class="ml-auto text-right">
                      <span class={cn('block text-2xl font-extrabold', classStyles(c.slug).text)}>
                        {c.monthly}
                      </span>
                      <span class="block text-xs text-ink-muted">/ month</span>
                    </p>
                  </div>
                  <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
                    <dt class="text-ink-muted">Time</dt>
                    <dd class="text-right font-semibold text-heading">{c.time}</dd>
                    <dt class="text-ink-muted">Age</dt>
                    <dd class="text-right font-semibold text-heading">{c.age}</dd>
                    <dt class="text-ink-muted">Annual</dt>
                    <dd class="text-right font-semibold text-heading">{c.annual}</dd>
                  </dl>
                </div>
                <Button
                  href={payUrl(c.payId)}
                  target="_blank"
                  rel="noopener"
                  variant="primary"
                  size="md"
                  class={cn('mt-5 w-full', classStyles(c.slug).button)}
                >
                  Pay {c.name} Tuition
                </Button>
              </HubCard>
            ))
          }
        </ul>
      </div>

      {/* Student + enrollment fees */}
      <div class="mt-12" aria-labelledby="other-fees">
        <h2 id="other-fees" class="text-xl font-extrabold text-heading">
          Student & enrollment fees
        </h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Paid once a year. Student fees cover supplies and enrichment; enrollment fees secure your
          spot and back your co-op commitment.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            studentFees.map((f) => (
              <HubCard class="flex items-center gap-4">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
                  aria-hidden="true"
                >
                  <Icon name="palette" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-bold text-heading">Student Fee · {f.label}</p>
                  <p class="text-sm text-ink-muted">{f.amount} per year for supplies & enrichment</p>
                </div>
                <Button
                  href={payUrl(f.payId)}
                  target="_blank"
                  rel="noopener"
                  variant="outline"
                  size="sm"
                >
                  Pay {f.amount}
                </Button>
              </HubCard>
            ))
          }
          {
            enrollmentFees.map((f) => (
              <HubCard class="flex flex-col">
                <div class="flex-1">
                  <div class="flex items-center gap-3">
                    <span
                      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                      aria-hidden="true"
                    >
                      <Icon name={f.icon} class="h-5 w-5" />
                    </span>
                    <div>
                      <p class="font-bold text-heading">{f.title}</p>
                      <p class="text-sm text-ink-muted">
                        {f.amount} · {f.when}
                      </p>
                    </div>
                  </div>
                  <p class="mt-4 text-sm leading-relaxed text-ink">{f.body}</p>
                </div>
                <Button
                  href={payUrl(f.payId)}
                  target="_blank"
                  rel="noopener"
                  variant="primary"
                  size="sm"
                  class="mt-5 w-full"
                >
                  {f.action}
                </Button>
              </HubCard>
            ))
          }
        </div>
      </div>

      {/* How payments work */}
      <div class="mt-12" aria-labelledby="how-pay">
        <h2 id="how-pay" class="text-xl font-extrabold text-heading">How payments work</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          The common questions, answered. For anything else, the Treasurer is one email away.
        </p>
        {
          /* Progressive disclosure (premium-screens phase 2): each answer opens
             on demand instead of stacking two columns of prose — questions
             scan in one glance, find-in-page still auto-expands matches. */
        }
        <ul class="mt-6 grid gap-3">
          {
            faqs.map((f) => (
              <li>
                <HubDisclosure card icon={f.icon} title={f.q ?? 'Question'}>
                  <p class="text-sm leading-relaxed text-ink">{f.a}</p>
                </HubDisclosure>
              </li>
            ))
          }
        </ul>
      </div>

      {
        /* Board-editable handbook sections (The Payment Year, The Fine Print) as
          an aligned card doc column with an "On this page" TOC. */
      }
      <HubSectionedBody sections={doc?.sections} label="Tuition handbook sections" class="mt-12" />
    </div>
  </Section>
</HubShell>
