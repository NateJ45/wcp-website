---
/* ============================================================================
   Family Hub — Tuition & Payments (GATED)
   ============================================================================
   Real 2026-27 rates, fees, PayPal buttons, and payment FAQ from the current
   live hub. Class facts + pay-button ids come from src/data/classes.ts.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { classes, payUrl } from '@/data/classes';
import { site } from '@/data/site';

const studentFees = [
  { label: 'Twos & Threes', amount: '$45', payId: 'GQZ67ZRZ4W9UN' },
  { label: 'Pre-K AM & PM', amount: '$50', payId: 'A797LM4LL5PGJ' },
];

const enrollmentFees = [
  {
    icon: 'file-check',
    title: 'Registration Fee',
    amount: '$100',
    when: 'due at enrollment',
    body: 'Secures your child’s spot. Non-refundable once enrollment is confirmed.',
    payId: 'CUDQHL444WZLC',
    action: 'Pay Registration Fee',
  },
  {
    icon: 'shield-check',
    title: 'Participation Fee',
    amount: '$100',
    when: 'due at May Gathering',
    body: 'Returned at year-end when all co-op commitments have been fulfilled.',
    payId: 'LB4PP7LPYD5R2',
    action: 'Pay Deposit',
  },
];

const faqs = [
  {
    icon: 'calendar-days',
    q: 'When tuition is due',
    a: 'The 1st of each month. You have through the 7th to pay before a late fee applies.',
  },
  {
    icon: 'clock',
    q: 'Late fee',
    a: '10% of the month’s tuition is added if your payment arrives after the 7th.',
  },
  {
    icon: 'circle-dollar-sign',
    q: 'How to pay',
    a: 'Use the PayPal buttons on this page (small processing fee), pay by check, or pay in cash. All three work the same to the school.',
  },
  {
    icon: 'mail',
    q: 'Paying by check',
    a: 'Make checks payable to WCP and write your child’s name in the memo line. Drop it in the Treasurer’s mailbox at school or hand it to her in person. If you use bank bill-pay, set the send date so the check arrives by the 1st.',
  },
  {
    icon: 'coins',
    q: 'Paying for the full year',
    a: 'There’s no annual discount, but you can skip monthly billing entirely — email the Treasurer to arrange a single yearly payment.',
  },
];
---

<HubShell
  title="Tuition & Payments"
  intro="Monthly amounts by class, due dates, late fees, and the buttons to pay your tuition. Questions about your account go to the Treasurer."
  current="/family-hub/tuition"
  pageTitle="Tuition & Payments — WCP Family Hub"
>
  {/* Class tuition — a pay card per class */}
  <Section bg="white" labelledby="class-tuition">
    <SectionHeader
      eyebrow="2026-27 Class Tuition"
      title="Pay your monthly tuition"
      titleId="class-tuition"
      lead="Tuition is billed monthly. Pick your class and pay by card through PayPal, or use check or cash (see below)."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        classes.map((c) => (
          <li
            class="flex flex-col rounded-[var(--radius)] border border-border bg-white p-6 shadow-sm"
            data-reveal
          >
            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full bg-navy text-white"
                aria-hidden="true"
              >
                <Icon name={c.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="text-lg font-extrabold text-navy">{c.name}</p>
                <p class="text-sm text-ink-muted">{c.days}</p>
              </div>
              <p class="ml-auto text-right">
                <span class="block text-2xl font-extrabold text-green-ink">{c.monthly}</span>
                <span class="block text-xs text-ink-muted">/ month</span>
              </p>
            </div>
            <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
              <dt class="text-ink-muted">Time</dt>
              <dd class="text-right font-semibold text-navy">{c.time}</dd>
              <dt class="text-ink-muted">Age</dt>
              <dd class="text-right font-semibold text-navy">{c.age}</dd>
              <dt class="text-ink-muted">Annual</dt>
              <dd class="text-right font-semibold text-navy">{c.annual}</dd>
            </dl>
            <Button
              href={payUrl(c.payId)}
              target="_blank"
              rel="noopener"
              variant="primary"
              size="md"
              class="mt-5 w-full"
            >
              Pay {c.name} Tuition
            </Button>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Student + enrollment fees */}
  <Section bg="grey" labelledby="other-fees">
    <SectionHeader
      eyebrow="Fees"
      title="Student & enrollment fees"
      titleId="other-fees"
      lead="Paid once a year. Student fees cover supplies and enrichment; enrollment fees secure your spot and back your co-op commitment."
    />

    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        studentFees.map((f) => (
          <div
            class="flex items-center gap-4 rounded-[var(--radius)] bg-white p-5 shadow-sm"
            data-reveal
          >
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
              aria-hidden="true"
            >
              <Icon name="palette" class="h-5 w-5" />
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-navy">Student Fee · {f.label}</p>
              <p class="text-sm text-ink-muted">{f.amount} per year — supplies & enrichment</p>
            </div>
            <Button
              href={payUrl(f.payId)}
              target="_blank"
              rel="noopener"
              variant="outline"
              size="sm"
            >
              Pay {f.amount}
            </Button>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-6 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        enrollmentFees.map((f) => (
          <div class="flex flex-col rounded-[var(--radius)] bg-white p-6 shadow-sm" data-reveal>
            <div class="flex items-center gap-3">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                aria-hidden="true"
              >
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-bold text-navy">{f.title}</p>
                <p class="text-sm text-ink-muted">
                  {f.amount} · {f.when}
                </p>
              </div>
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-ink">{f.body}</p>
            <Button
              href={payUrl(f.payId)}
              target="_blank"
              rel="noopener"
              variant="primary"
              size="sm"
              class="mt-5 w-full"
            >
              {f.action}
            </Button>
          </div>
        ))
      }
    </div>
  </Section>

  {/* How payments work */}
  <Section bg="navy" seam labelledby="how-pay">
    <SectionHeader
      eyebrow="How Payments Work"
      eyebrowTone="amber"
      title="Quick answers to the common questions"
      titleId="how-pay"
      lead="For anything not covered here, the Treasurer is one email away."
    />
    <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        faqs.map((f) => (
          <li class="flex gap-4 rounded-[var(--radius)] bg-white/10 p-5" data-reveal>
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15 text-amber"
              aria-hidden="true"
            >
              <Icon name={f.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="font-bold text-white">{f.q}</p>
              <p class="mt-1 text-sm leading-relaxed text-white/85">{f.a}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-center text-white/85">
      Questions about your account?{' '}
      <a
        href={`mailto:${site.email.general}`}
        class="font-semibold text-amber underline underline-offset-2"
      >
        Email the Treasurer
      </a>
    </p>
  </Section>
</HubShell>
