---
/* ============================================================================
   Family Hub — School Updates (GATED, reads from Sanity)
   ============================================================================
   Announcements come from Sanity (`update` docs), read server-side with the
   token behind the gate — no CORS needed for this path. Falls back to the
   empty-state when there's nothing to show (or Sanity is unreachable).
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import Icon from '@/components/Icon.astro';
import SanityImage from '@/components/SanityImage.astro';
import HubPill from '@/components/hub/HubPill.astro';
import HubFilterChip from '@/components/hub/HubFilterChip.astro';
import { sanityFetch } from '@/lib/sanity';
import { classLabel } from '@/lib/class-colors';
import { deEmDash } from '@/lib/portable-text';

interface Update {
  _id: string;
  title: string;
  slug?: string;
  publishedAt: string;
  pinned?: boolean;
  audience?: string;
  category?: string;
  excerpt?: string;
  image?: { asset?: unknown; alt?: string } | null;
}

let updates: Update[] = [];
try {
  const raw = await sanityFetch<(Update & { showUntil?: string })[]>(
    `*[_type == "update"] | order(publishedAt desc){ _id, title, "slug": slug.current, publishedAt, pinned, showUntil, audience, category, excerpt, image }`,
  );
  // A pin past its `showUntil` no longer counts as pinned (it stays in the list,
  // just un-pinned), so an expired snow-day notice sinks into date order.
  const nowMs = Date.now();
  updates = raw
    .map((u) => ({
      ...u,
      pinned: u.pinned && (!u.showUntil || new Date(u.showUntil).getTime() >= nowMs),
    }))
    .sort((a, b) => {
      if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
      return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
    });
} catch {
  updates = [];
}

// ---- Filter (category) + sort (date direction) + pagination, all URL-param
// driven so every view is a shareable, no-JS link (same premium-screens pattern
// as the Calendar type filter). Pinned posts always lead, whatever the sort.
const PAGE_SIZE = 8;
const params = new URL(Astro.request.url).searchParams;
const catOf = (u: Update) => (u.category === 'minutes' ? 'minutes' : 'announcement');
const CAT_LABEL: Record<string, string> = {
  announcement: 'Announcements',
  minutes: 'Meeting minutes',
};
const catsPresent = ['announcement', 'minutes'].filter((c) => updates.some((u) => catOf(u) === c));
const catParam = params.get('category');
const activeCat = catParam && catsPresent.includes(catParam) ? catParam : null;
const sort = params.get('sort') === 'oldest' ? 'oldest' : 'newest';

const filtered = (activeCat ? updates.filter((u) => catOf(u) === activeCat) : updates)
  .slice()
  .sort((a, b) => {
    if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
    const d = new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
    return sort === 'oldest' ? -d : d;
  });

const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(Math.max(1, Number(params.get('page')) || 1), totalPages);
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

// Build a hub-relative URL, carrying the current category/sort unless overridden
// (pass a key as null to clear it). Filter/sort links reset to page 1.
const linkTo = (over: { category?: string | null; sort?: string | null; page?: number }) => {
  const p = new URLSearchParams();
  const cat = over.category !== undefined ? over.category : activeCat;
  const srt = over.sort !== undefined ? over.sort : sort === 'oldest' ? 'oldest' : null;
  const pg = over.page ?? 1;
  if (cat) p.set('category', cat);
  if (srt) p.set('sort', srt);
  if (pg > 1) p.set('page', String(pg));
  const qs = p.toString();
  return qs ? `${Astro.url.pathname}?${qs}` : Astro.url.pathname;
};

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const title = 'School Updates';
const intro =
  'Announcements from the Board and Administrator throughout the year. New posts surface on the hub home; older ones live here.';
---

<HubShell title={title} bare pageTitle="Updates — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="newspaper" />

      {
        updates.length === 0 ? (
          <HubEmptyState spot="sun" title="No announcements posted yet" source="sanity" />
        ) : (
          <>
            {/* Controls: category filter (left) + newest/oldest sort (right). */}
            <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
              {catsPresent.length > 1 ? (
                <nav aria-label="Filter updates by type" class="flex flex-wrap gap-2">
                  <HubFilterChip href={linkTo({ category: null })} active={!activeCat}>
                    All
                  </HubFilterChip>
                  {catsPresent.map((c) => (
                    <HubFilterChip href={linkTo({ category: c })} active={activeCat === c}>
                      {CAT_LABEL[c]}
                    </HubFilterChip>
                  ))}
                </nav>
              ) : (
                <span />
              )}
              <a
                href={linkTo({ sort: sort === 'oldest' ? null : 'oldest' })}
                class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border bg-white px-3.5 py-1.5 text-sm font-semibold text-heading transition-colors hover:border-navy/40 dark:bg-surface"
                aria-label={`Sorted ${sort === 'oldest' ? 'oldest' : 'newest'} first; switch order`}
              >
                {sort === 'oldest' ? 'Oldest first' : 'Newest first'}
              </a>
            </div>

            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {pageItems.map((u) => (
                <li>
                  <HubCard
                    as={u.slug ? 'a' : 'div'}
                    href={u.slug ? `/family-hub/updates/${u.slug}` : undefined}
                    class="flex h-full flex-col overflow-hidden p-0"
                  >
                    {u.image?.asset && (
                      <SanityImage
                        source={u.image as never}
                        alt={(u.image.alt as string) ?? u.title}
                        widths={[400, 800]}
                        sizes="(max-width: 640px) 100vw, 560px"
                        class="max-h-56 w-full object-cover"
                      />
                    )}
                    <div class="flex flex-1 flex-col p-6">
                      <div class="flex flex-wrap items-center gap-2">
                        {u.pinned && <HubPill kind="important">Pinned</HubPill>}
                        <span class="text-sm text-ink-muted">{fmtDate(u.publishedAt)}</span>
                        {/* Category pill (shared vocabulary): minutes are the
                          exception worth marking; announcements are the
                          default and stay unpilled. */}
                        {u.category === 'minutes' && <HubPill kind="past">Meeting minutes</HubPill>}
                        {u.audience && u.audience !== 'all' && (
                          <span class="rounded-full bg-sky/15 px-2.5 py-0.5 text-xs font-semibold text-heading">
                            {classLabel(u.audience)}
                          </span>
                        )}
                      </div>
                      <p class="mt-2 text-lg font-extrabold text-heading">{deEmDash(u.title)}</p>
                      {u.excerpt && <p class="mt-2 leading-relaxed text-ink-muted">{u.excerpt}</p>}
                      {u.slug && (
                        <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-sky-ink">
                          Read the full update
                          <Icon name="arrow-right" class="h-4 w-4" />
                        </span>
                      )}
                    </div>
                  </HubCard>
                </li>
              ))}
            </ul>

            {totalPages > 1 && (
              <nav aria-label="Pagination" class="mt-8 flex items-center justify-between gap-2">
                {page > 1 ? (
                  <a
                    href={linkTo({ page: page - 1 })}
                    rel="prev"
                    class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-2 text-sm font-semibold text-heading transition-colors hover:border-navy/40 dark:bg-surface"
                  >
                    <Icon name="arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
                    Previous
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-2 text-sm font-semibold text-ink-muted opacity-50">
                    <Icon name="arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
                    Previous
                  </span>
                )}
                <span class="text-sm font-semibold text-ink-muted">
                  Page {page} of {totalPages}
                </span>
                {page < totalPages ? (
                  <a
                    href={linkTo({ page: page + 1 })}
                    rel="next"
                    class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-2 text-sm font-semibold text-heading transition-colors hover:border-navy/40 dark:bg-surface"
                  >
                    Next
                    <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-2 text-sm font-semibold text-ink-muted opacity-50">
                    Next
                    <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
                  </span>
                )}
              </nav>
            )}
          </>
        )
      }
    </div>
  </Section>
</HubShell>
