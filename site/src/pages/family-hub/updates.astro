---
/* ============================================================================
   Family Hub — School Updates (GATED, reads from Sanity)
   ============================================================================
   Announcements come from Sanity (`update` docs), read server-side with the
   token behind the gate — no CORS needed for this path. Falls back to the
   empty-state when there's nothing to show (or Sanity is unreachable).
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import Icon from '@/components/Icon.astro';
import SanityImage from '@/components/SanityImage.astro';
import HubPill from '@/components/hub/HubPill.astro';
import { sanityFetch } from '@/lib/sanity';
import { classLabel } from '@/lib/class-colors';

interface Update {
  _id: string;
  title: string;
  slug?: string;
  publishedAt: string;
  pinned?: boolean;
  audience?: string;
  category?: string;
  excerpt?: string;
  image?: { asset?: unknown; alt?: string } | null;
}

let updates: Update[] = [];
try {
  const raw = await sanityFetch<(Update & { showUntil?: string })[]>(
    `*[_type == "update"] | order(publishedAt desc){ _id, title, "slug": slug.current, publishedAt, pinned, showUntil, audience, category, excerpt, image }`,
  );
  // A pin past its `showUntil` no longer counts as pinned (it stays in the list,
  // just un-pinned), so an expired snow-day notice sinks into date order.
  const nowMs = Date.now();
  updates = raw
    .map((u) => ({
      ...u,
      pinned: u.pinned && (!u.showUntil || new Date(u.showUntil).getTime() >= nowMs),
    }))
    .sort((a, b) => {
      if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
      return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
    });
} catch {
  updates = [];
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const title = 'School Updates';
const intro =
  'Announcements from the Board and Administrator throughout the year. New posts surface on the hub home; older ones live here.';
---

<HubShell title={title} bare pageTitle="Updates — WCP Family Hub">
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="newspaper" />

      {
        updates.length === 0 ? (
          <HubEmptyState spot="sun" title="No announcements posted yet" source="sanity" />
        ) : (
          <ul class="grid gap-4 sm:grid-cols-2">
            {updates.map((u) => (
              <li>
                <HubCard
                  as={u.slug ? 'a' : 'div'}
                  href={u.slug ? `/family-hub/updates/${u.slug}` : undefined}
                  class="flex h-full flex-col overflow-hidden p-0"
                >
                  {u.image?.asset && (
                    <SanityImage
                      source={u.image as never}
                      alt={(u.image.alt as string) ?? u.title}
                      widths={[400, 800]}
                      sizes="(max-width: 640px) 100vw, 560px"
                      class="max-h-56 w-full object-cover"
                    />
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <div class="flex flex-wrap items-center gap-2">
                      {u.pinned && <HubPill kind="important">Pinned</HubPill>}
                      <span class="text-sm text-ink-muted">{fmtDate(u.publishedAt)}</span>
                      {/* Category pill (shared vocabulary): minutes are the
                          exception worth marking; announcements are the
                          default and stay unpilled. */}
                      {u.category === 'minutes' && <HubPill kind="past">Meeting minutes</HubPill>}
                      {u.audience && u.audience !== 'all' && (
                        <span class="rounded-full bg-sky/15 px-2.5 py-0.5 text-xs font-semibold text-heading">
                          {classLabel(u.audience)}
                        </span>
                      )}
                    </div>
                    <p class="mt-2 text-lg font-extrabold text-heading">{u.title}</p>
                    {u.excerpt && <p class="mt-2 leading-relaxed text-ink-muted">{u.excerpt}</p>}
                    {u.slug && (
                      <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-sky-ink">
                        Read the full update
                        <Icon name="arrow-right" class="h-4 w-4" />
                      </span>
                    )}
                  </div>
                </HubCard>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Section>
</HubShell>
