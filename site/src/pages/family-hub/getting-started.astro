---
/* ============================================================================
   Family Hub — Getting Started (GATED, page-builder)
   ============================================================================
   The new-family runway: enrollment checklist, the co-op commitment at a
   glance, finding the building, communication channels, and first-year FAQs —
   transcribed from the May Gathering orientation deck + the Family Handbook's
   Admissions & Enrollment chapter. ENTIRELY Board-editable: everything is
   `hubPage-getting-started` sections (seeded by scripts/seed-hub-knowledge.mjs,
   edited in the Studio thereafter).
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubSectionedBody from '@/components/hub/HubSectionedBody.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY } from '@/lib/queries';
import { hubDraftMode, readHubPageDoc, publishedId } from '@/lib/hub-preview';
import { estimateReadMinutes } from '@/lib/hub-reading-time';
import { formatMonthYear } from '@/lib/hub-dashboard-dates';

interface HubPageDoc {
  _id?: string;
  heading?: string;
  intro?: string;
  _updatedAt?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// Studio Presentation loads this REAL page as its preview (2026-08-30): the
// verified preview cookie makes the hubPage read draft-aware (stega on) and
// mounts the click-to-edit overlay via previewDocId. Families: unchanged.
const draftMode = await hubDraftMode(Astro.cookies);
let doc: HubPageDoc | null = null;
try {
  doc = await readHubPageDoc<HubPageDoc>(draftMode, HUB_PAGE_QUERY, { key: 'getting-started' });
} catch {
  doc = null;
}
const title = doc?.heading || 'Getting Started at WCP';
const intro =
  doc?.intro ||
  'New to the co-op, or need a refresher? Everything between “we’re in!” and the first day of school lives here.';
const sections = doc?.sections ?? [];

const readMinutes = estimateReadMinutes(sections);
const updated = formatMonthYear(doc?._updatedAt);
---

<HubShell
  title={title}
  bare
  current="/family-hub/getting-started"
  pageTitle="Getting Started — WCP Family Hub"
  previewDocId={draftMode ? publishedId(doc?._id) : undefined}
>
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader
        title={title}
        subtitle={intro}
        icon="rocket"
        readMinutes={readMinutes}
        updated={updated}
      />

      {
        /* Board-editable page-builder content, in the SAME container as the
          header so the header, cards, and TOC all share one width. */
      }
      <HubSectionedBody sections={sections} label="Getting Started sections" class="mt-8" />
    </div>
  </Section>
</HubShell>
