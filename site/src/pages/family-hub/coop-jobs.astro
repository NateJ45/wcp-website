---
/* ============================================================================
   Family Hub — Co-op Jobs (GATED)
   ============================================================================
   How WCP is organized + the role descriptions. Both the JOBS and the org
   chart's shape come from the `coopRole` documents now (Studio → Family Hub →
   Co-op roles), so a school that renames a role, adds one, or retires one does
   it itself. Who HOLDS each job is live assignment data that loads from Sanity
   behind the gate, never hardcoded here. src/data/hub/coop-roles.ts and
   src/data/hub/org-holders.ts are the fallbacks for an unreachable Sanity.
   ============================================================================ */
export const prerender = false;

import HubShell from '@/layouts/HubShell.astro';
import Section from '@/components/Section.astro';
import HubPageHeader from '@/components/hub/HubPageHeader.astro';
import HubCard from '@/components/hub/HubCard.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import OrgChart from '@/components/hub/OrgChart.astro';
import HubSectionedBody from '@/components/hub/HubSectionedBody.astro';
import { site } from '@/data/site';
import {
  coopPrinciples as coopPrinciplesFallback,
  coopTiers as coopTiersFallback,
} from '@/data/hub/coop-roles';
import { orgSeats as seatsFallback } from '@/data/hub/org-holders';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_PAGE_QUERY, COOP_GUIDANCE_QUERY, ORG_SEATS_QUERY } from '@/lib/queries';
import { hubDraftMode, readHubPageDoc, publishedId } from '@/lib/hub-preview';
import { toSeats, ORG_TIERS, type OrgSeatRow, type OrgTier } from '@/lib/hub-org';

interface HubPageDoc {
  _id?: string;
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}

// Studio Presentation loads this REAL page as its preview (2026-08-30): the
// verified preview cookie makes the hubPage read draft-aware (stega on) and
// mounts the click-to-edit overlay via previewDocId. Families: unchanged.
const draftMode = await hubDraftMode(Astro.cookies);

// The standard headings for the five groups. A school renames any of them in
// the Studio (How the co-op works → Job-list headings); these are what shows
// until it does.
const TIER_META: Record<OrgTier, { label: string; blurb: string }> = {
  board: {
    label: 'Executive Board',
    blurb:
      'Elected each spring, serving one-year terms. Meets monthly to set policy, manage finances, and oversee school operations.',
  },
  staff: { label: 'Paid Staff', blurb: 'The school’s only paid employees.' },
  chairs: {
    label: 'Cabinet Chairs',
    blurb: 'Each chair leads a small team of co-op members and reports to a Board officer.',
  },
  reps: {
    label: 'Class Representatives',
    blurb: 'One per class — the link between families, the teacher, and the Board.',
  },
  committee: {
    label: 'Committee Members',
    blurb:
      'The hands-on roles that keep everything running — most are light, predictable commitments.',
  },
};
// Paid staff appear on the ORG CHART but not in this list: the page's whole
// claim is that every other role is filled by a parent volunteer, so a teacher
// does not belong among the jobs a family signs up for.
const LISTED_TIERS = ORG_TIERS.filter((t) => t !== 'staff');
// Independent of the roles read — start now, await later (2026-07 hub-speed
// pass).
const hubDocPromise = readHubPageDoc<HubPageDoc>(draftMode, HUB_PAGE_QUERY, {
  key: 'coop-jobs',
}).catch(() => null);

// Independent of the roles read — start it alongside, await after.
interface OrgSectionHeading {
  key?: string;
  label?: string;
  blurb?: string;
}
const guidancePromise = sanityFetch<{
  principles?: typeof coopPrinciplesFallback;
  sections?: OrgSectionHeading[];
} | null>(COOP_GUIDANCE_QUERY, {}, { cache: BOARD_CONTENT_CACHE }).catch(() => null);

// ONE read for both the job list and the chart: the same seats drive both, so
// they can never disagree about what the co-op's roles are.
const seatRows = await sanityFetch<OrgSeatRow[]>(ORG_SEATS_QUERY).catch(() => null);
const seats = seatRows?.length ? toSeats(seatRows) : seatsFallback;
// The seat a role reports to, by name — the "Reports to VP" tag. Derived from
// the reporting line rather than typed, so it can never name a deleted role.
const seatNames = new Map(seats.map((s) => [s.id, s.name]));

const guidance = await guidancePromise;
// A cleared list falls back rather than dropping the row entirely — the four
// rules are the co-op commitment, not decoration.
const coopPrinciples = guidance?.principles?.length ? guidance.principles : coopPrinciplesFallback;

// The Board's own headings for the five groups, where it set any.
const headings = new Map<string, { label: string; blurb: string }>(
  (guidance?.sections ?? [])
    .filter((s) => s?.key && s?.label)
    .map((s) => [s.key as string, { label: s.label as string, blurb: s.blurb ?? '' }]),
);
const heading = (key: OrgTier) => headings.get(key) ?? TIER_META[key];
const chartLabels = Object.fromEntries(
  ORG_TIERS.map((t) => [t, headings.get(t)?.label ?? TIER_META[t].label]),
);

// With Sanity unreachable the committed DESCRIPTIONS are richer than the
// committed seats (which carry the chart's shape, not the job write-ups), so
// the offline page keeps the full job list rather than a list of bare titles.
const derivedTiers = LISTED_TIERS.filter((t) => seats.some((s) => s.tier === t)).map((t) => ({
  key: t,
  label: heading(t).label,
  blurb: heading(t).blurb,
  roles: seats
    .filter((s) => s.tier === t)
    .map((s) => ({
      name: s.name,
      icon: s.icon,
      team: s.team,
      reportsTo: s.reportsTo ? `Reports to ${seatNames.get(s.reportsTo)}` : undefined,
      stipend: s.stipend,
      body: s.body ?? '',
    })),
}));
const coopTiers = seatRows?.length ? derivedTiers : coopTiersFallback;

const doc: HubPageDoc | null = await hubDocPromise;
const title = doc?.heading || 'Co-op Jobs';
const intro =
  doc?.intro ||
  'How WCP is run, the roles families fill each year, and the org chart that ties it together.';
---

<HubShell
  title={title}
  bare
  pageTitle="Co-op Jobs — WCP Family Hub"
  previewDocId={draftMode ? publishedId(doc?._id) : undefined}
>
  <Section bg="grey" labelledby="hub-page-title">
    <div class="mx-auto max-w-6xl">
      <HubPageHeader title={title} subtitle={intro} icon="heart-handshake" />

      {/* How WCP is organized — the guiding principles */}
      <div aria-labelledby="principles">
        <h2 id="principles" class="text-xl font-extrabold text-heading">Run by its families</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          Our teachers and administrator are the only paid staff. Every other role is filled by a
          parent volunteer — the Executive Board sets direction, Cabinet Chairs lead the programs,
          and committee members do the hands-on work.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            coopPrinciples.map((p) => (
              <HubCard icon={p.icon} title={p.title}>
                <p class="text-sm leading-relaxed text-ink-muted">{p.body}</p>
              </HubCard>
            ))
          }
        </div>
      </div>

      {/* Role descriptions, grouped by tier */}
      {
        coopTiers.map((tier) => (
          <div class="mt-12" aria-labelledby={`tier-${tier.key}`}>
            <h2 id={`tier-${tier.key}`} class="text-xl font-extrabold text-heading">
              {tier.label}
            </h2>
            {tier.blurb && <p class="mt-1 max-w-2xl text-ink-muted">{tier.blurb}</p>}
            <ul class="mt-6 grid gap-4 sm:grid-cols-2">
              {tier.roles.map((role) => (
                <HubCard as="li" class="flex gap-4">
                  <span
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                    aria-hidden="true"
                  >
                    <Icon name={role.icon} class="h-5 w-5" />
                  </span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      <span class="font-bold text-heading">{role.name}</span>
                      {role.team && <span class="text-xs text-ink-muted">· {role.team}</span>}
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-ink-muted">{role.body}</p>
                    {(role.stipend || role.reportsTo) && (
                      <p class="mt-2 flex flex-wrap gap-2">
                        {role.stipend && (
                          <span class="inline-flex items-center rounded-full bg-green/15 px-2.5 py-0.5 text-xs font-semibold text-green-ink">
                            {role.stipend}
                          </span>
                        )}
                        {role.reportsTo && (
                          <span class="inline-flex items-center rounded-full bg-grey px-2.5 py-0.5 text-xs font-semibold text-ink-muted">
                            {role.reportsTo}
                          </span>
                        )}
                      </p>
                    )}
                  </div>
                </HubCard>
              ))}
            </ul>
          </div>
        ))
      }

      {/* Org chart — who reports to whom, on a panel */}
      <div class="mt-12" aria-labelledby="org-chart">
        <h2 id="org-chart" class="text-xl font-extrabold text-heading">Who reports to whom</h2>
        <p class="mt-1 max-w-2xl text-ink-muted">
          The Board sits at the top; chairs lead the programs and their committees. Every box except
          the teachers and administrator is a parent volunteer.
        </p>
        <HubCard class="mt-6">
          <OrgChart labels={chartLabels} />
        </HubCard>
      </div>

      {/* Questions — the single navy emphasis moment */}
      <HubCard class="mt-12 bg-navy text-white">
        <span
          class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-amber"
          aria-hidden="true"
        >
          <Icon name="message-circle" class="h-7 w-7" />
        </span>
        <p class="text-lg font-bold text-white">Questions about co-op jobs?</p>
        <p class="mt-2 max-w-xl leading-relaxed text-white/85">
          The Secretary is the first stop for job questions, swaps, and clarifications — she’ll
          route it to the right chair or raise it to the Board.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={`mailto:${site.email.contact}`} variant="outline-white" size="md">
            Email the Secretary
          </Button>
          <Button href="/family-hub/documents" variant="outline-white" size="md">
            School documents
          </Button>
        </div>
      </HubCard>

      {
        /* Board-editable handbook sections (Scheduling, Super Helpers, Everything
          Else, Governance) as an aligned card doc column with an "On this page"
          TOC — the same treatment as the class handbooks. */
      }
      <HubSectionedBody sections={doc?.sections} label="Co-op handbook sections" class="mt-12" />
    </div>
  </Section>
</HubShell>
