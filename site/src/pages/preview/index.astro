---
/* ============================================================================
   Home — Studio-only PREVIEW (draft-aware mirror of /)
   ============================================================================
   See src/pages/preview/tuition.astro for the pattern this follows. Drops the
   hardcoded testimonialsFallback array — an empty featured-testimonials result
   renders as an empty section, not silently-substituted built-in quotes.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import StatBlock from '@/components/StatBlock.astro';
import Testimonial from '@/components/Testimonial.astro';
import Underline from '@/components/Underline.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { previewFetch } from '@/lib/cms-preview';
import { PAGE_HERO_QUERY, testimonialsQuery } from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);

const hero = await previewFetch<{ eyebrow?: string; heroTitle?: string; lead?: string } | null>(
  draftMode,
  PAGE_HERO_QUERY,
  { slug: 'home' },
);

const reasons = [
  {
    icon: 'users',
    chip: 'sky' as const,
    title: 'A real co-op',
    body: "Families run the school alongside the teachers. You're in the classroom two or three times a month, not waiting at the door.",
  },
  {
    icon: 'palette',
    chip: 'orange' as const,
    title: 'Play-based, standards-based',
    body: "Every class is built on Ohio's Early Learning Content Standards and delivered through play, art, music, and outdoor time.",
  },
  {
    icon: 'piggy-bank',
    chip: 'green' as const,
    title: 'Tuition that makes sense',
    body: 'Starting at $70 a month, the co-op model keeps WCP one of the most affordable preschools in West Chester.',
  },
];

const accentCycle = ['orange', 'sky', 'green'] as const;
interface TestimonialDoc {
  quote: string;
  author?: string;
  role?: string;
}
const featuredDocs = await previewFetch<TestimonialDoc[]>(
  draftMode,
  testimonialsQuery({ featuredOnly: true, limit: 3 }),
  {},
);
const testimonials = featuredDocs.map((t, i) => ({
  quote: t.quote,
  author: t.author ?? '',
  context: t.role ?? '',
  accent: accentCycle[i % accentCycle.length],
}));
---

<PreviewLayout title="Home — Preview" draftMode={draftMode}>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Now Enrolling 2026-27'}
    title={hero?.heroTitle ?? 'Where little ones learn, grow, and belong.'}
    lead={hero?.lead ?? ''}
    image="/hero/wcp-hero-poster.webp"
    imageAlt="Children playing together at West Chester Preschool"
    video="/hero/wcp-hero.mp4"
    videoWebm="/hero/wcp-hero.webm"
  >
    <Fragment slot="title">
      Where little ones learn, grow, and <Underline color="amber">belong</Underline>.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Your Child</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
  </Hero>

  <div class="bg-cream">
    <div
      class="wcp-container flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-3 text-center text-sm"
    >
      <span class="font-semibold text-heading">Summer Playdates are open to all families.</span>
      <a href="/contact" class="font-bold text-orange-ink underline underline-offset-2"
        >Ask us for dates</a
      >
    </div>
  </div>

  <Section bg="grey" labelledby="why-title">
    <SectionHeader
      eyebrow="Why families choose WCP"
      title="Small classes. Real community."
      titleId="why-title"
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        reasons.map((r) => (
          <FeatureCard as="li" icon={r.icon} chip={r.chip} title={r.title}>
            {r.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  <Section bg="navy" seam label="West Chester Preschool by the numbers">
    <ul class="grid grid-cols-2 gap-5 lg:grid-cols-4">
      <li>
        <StatBlock value={55} suffix="+" label="Years in West Chester">
          Founded in 1969 and still going strong.
        </StatBlock>
      </li>
      <li>
        <StatBlock value={70} prefix="$" label="Tuition from, per month">
          The co-op model keeps costs low without cutting corners.
        </StatBlock>
      </li>
      <li>
        <StatBlock value={12} label="Children per class, max">
          Small enough that every child is known by name.
        </StatBlock>
      </li>
      <li>
        <StatBlock value={4} label="Class options">
          Twos, Threes, and Pre-K morning or afternoon.
        </StatBlock>
      </li>
    </ul>
  </Section>

  <Section bg="white" seam labelledby="stories-title">
    <SectionHeader
      eyebrow="From our families"
      title="Heard directly from our community"
      titleId="stories-title"
    />
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <li class="h-full">
            <Testimonial
              quote={t.quote}
              author={t.author}
              context={t.context}
              accent={t.accent}
              confetti
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBanner
    title="Come see it for yourself."
    lead="The best way to know if WCP is right for your family is to walk through the door. Reach out and we'll be in touch within a day or two."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
    <Fragment slot="note">
      Call {site.phone} or email {site.email.general}
    </Fragment>
  </CtaBanner>
</PreviewLayout>
