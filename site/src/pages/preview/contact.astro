---
/* ============================================================================
   Contact — Studio-only PREVIEW (draft-aware mirror of /contact)
   ============================================================================
   See src/pages/preview/tuition.astro for the pattern this follows.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { site as siteFallback } from '@/data/site';
import { previewFetch, getPreviewSiteSettings } from '@/lib/cms-preview';
import { PAGE_HERO_QUERY, SITE_SETTINGS_PARKING_NOTE_QUERY } from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);

const site = await getPreviewSiteSettings(draftMode, siteFallback);
const parkingNote = await previewFetch<string | null>(
  draftMode,
  SITE_SETTINGS_PARKING_NOTE_QUERY,
  {},
);
const hero = await previewFetch<{ eyebrow?: string; heroTitle?: string; lead?: string } | null>(
  draftMode,
  PAGE_HERO_QUERY,
  { slug: 'contact' },
);
const phoneDigits = site.phone.replace(/[^\d]/g, '');
---

<PreviewLayout title="Contact — Preview" draftMode={draftMode}>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Get In Touch'}
    title={hero?.heroTitle ?? 'We would love to hear from you.'}
    lead={hero?.lead ?? ''}
  >
    <Fragment slot="actions">
      <Button href={`tel:${phoneDigits}`} variant="accent" size="lg">Call {site.phone}</Button>
      <Button href={`mailto:${site.email.general}`} variant="outline-white" size="lg"
        >Email Us</Button
      >
    </Fragment>
  </Hero>

  <Section bg="grey" label="Contact details">
    <div class="mx-auto grid max-w-3xl gap-8 sm:grid-cols-2">
      <div data-reveal>
        <h2 class="text-heading">Reach us</h2>
        <dl class="mt-4 space-y-3 text-ink">
          <div>
            <dt class="text-sm font-bold tracking-wide text-sky-ink uppercase">Phone</dt>
            <dd><a href={`tel:${phoneDigits}`} class="text-heading underline">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="text-sm font-bold tracking-wide text-sky-ink uppercase">Email</dt>
            <dd>
              <a href={`mailto:${site.email.general}`} class="text-heading underline"
                >{site.email.general}</a
              >
            </dd>
          </div>
        </dl>
      </div>
      <div data-reveal>
        <h2 class="text-heading">Visit</h2>
        <address class="mt-4 leading-relaxed text-ink not-italic">
          {site.address.street}<br />
          {site.address.city}, {site.address.state}
          {site.address.zip}<br />
          <span class="text-ink-muted">Inside Crestview Presbyterian Church</span>
        </address>
        <p class="mt-3 text-sm text-ink-muted">{site.calendar}</p>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`,
          )}`}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1.5 font-bold text-sky-ink underline underline-offset-2"
        >
          <Icon name="map-pin" class="h-4 w-4" />
          Open in Google Maps
        </a>
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-3xl" data-reveal>
      <Callout tone="warm">
        <strong class="font-bold text-heading">Parking &amp; entry:</strong>{' '}
        {parkingNote ?? ''}
      </Callout>
    </div>
  </Section>
</PreviewLayout>
