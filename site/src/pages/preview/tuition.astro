---
/* ============================================================================
   Tuition & Fees — Studio-only PREVIEW (draft-aware mirror of /tuition)
   ============================================================================
   Same shared UI components and derived-data logic as src/pages/tuition.astro,
   but request-time + draft-aware: reads via previewFetch (perspective flips to
   'drafts' + stega turns on when the Presentation Tool's cookie is present),
   wrapped in PreviewLayout instead of BaseLayout, and skips cmsFetch's
   fallback-to-hardcoded-copy behavior on purpose — an editor should see real
   (possibly empty) Sanity state here, not silently-substituted built-in copy.
   Never linked to from any production page; excluded from tests/routes.ts by
   the same prerender=false mechanism that already excludes /family-hub.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import TuitionTable from '@/components/TuitionTable.astro';
import Callout from '@/components/Callout.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { previewFetch } from '@/lib/cms-preview';
import { PAGE_HERO_QUERY, CLASS_ROWS_QUERY, FEE_SCHEDULE_QUERY } from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);

const hero = await previewFetch<{
  eyebrow?: string;
  heroTitle?: string;
  lead?: string;
} | null>(draftMode, PAGE_HERO_QUERY, { slug: 'tuition' });

const why = [
  {
    icon: 'award',
    chip: 'sky' as const,
    title: 'Expert teachers',
    body: 'Our only paid staff. Certified, experienced, and genuinely invested in every child.',
  },
  {
    icon: 'users',
    chip: 'orange' as const,
    title: 'Parent-powered',
    body: 'Everything else is run by the families enrolled, which is also what makes WCP special.',
  },
  {
    icon: 'trending-down',
    chip: 'green' as const,
    title: 'Lower overhead',
    body: 'No admin salaries, no outside contractors, no unnecessary costs passed on to you.',
  },
  {
    icon: 'star',
    chip: 'amber' as const,
    title: 'High standards',
    body: 'Affordable does not mean lower quality. WCP families consistently say it exceeded expectations.',
  },
];

const tuitionColumns = [
  'Class',
  'Days',
  'Time',
  'Age by Sept 30',
  'Monthly',
  'Annual',
  'Reg. fee',
  'Deposit',
  'Student fees',
];
interface ClassRow {
  name: string;
  days: string;
  time: string;
  age: string;
  monthly: string;
  annual: string;
  studentFee: string;
}
const classDocs = await previewFetch<ClassRow[]>(draftMode, CLASS_ROWS_QUERY, {});
const feeDoc = await previewFetch<{ registrationFee?: string; participationFee?: string }>(
  draftMode,
  FEE_SCHEDULE_QUERY,
  {},
);
const shortAge = (a?: string) => a?.match(/Age\s*\d+/i)?.[0] ?? a ?? '';
const tuitionRows = classDocs.map((c) => [
  c.name,
  c.days,
  c.time,
  shortAge(c.age),
  c.monthly,
  c.annual,
  feeDoc.registrationFee ?? '',
  feeDoc.participationFee ?? '',
  c.studentFee,
]);

const fees = [
  {
    icon: 'file-check',
    chip: 'orange' as const,
    title: 'Registration fee · $100',
    body: 'A one-time fee due at enrollment that secures your child’s place. Non-refundable once enrollment is confirmed.',
  },
  {
    icon: 'shield-check',
    chip: 'sky' as const,
    title: 'Participation deposit · $100',
    body: 'Due at the May Gathering (or at registration if you enroll mid-year). Held to ensure the co-op commitment is met, and returned at the end of the year when all obligations have been fulfilled.',
  },
  {
    icon: 'palette',
    chip: 'green' as const,
    title: 'Student fees · $45–$50',
    body: 'Covers classroom supplies, art materials, snack contributions, and other resources used directly by children.',
  },
];

const timeline = [
  {
    icon: 'users',
    chip: 'sky' as const,
    title: 'Current families',
    body: 'Families already enrolled get first pick. Registration forms are distributed in December.',
  },
  {
    icon: 'heart',
    chip: 'orange' as const,
    title: 'Alumni and Crestview members',
    body: 'Families who have previously enrolled at WCP, and Crestview Church members, register next in order received.',
  },
  {
    icon: 'door-open',
    chip: 'green' as const,
    title: 'Open House — public',
    body: 'Open registration begins at Open House in January. New families register on a first-come, first-served basis.',
  },
  {
    icon: 'list',
    chip: 'amber' as const,
    title: 'Waiting list',
    body: 'Once a class is full, a free waiting list is created. Families are contacted in order as spots open up.',
  },
];
---

<PreviewLayout title="Tuition & Fees — Preview" draftMode={draftMode}>
  <Hero
    eyebrow={hero?.eyebrow ?? '2026-27 Tuition Rates'}
    title={hero?.heroTitle ?? 'Quality early education. At a price that works.'}
    lead={hero?.lead ?? ''}
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="#tuition-table" variant="outline-white" size="lg">See Full Breakdown</Button>
    </Fragment>
  </Hero>

  <Section bg="white" labelledby="why-affordable">
    <SectionHeader
      eyebrow="Why WCP Costs Less"
      title="The co-op model makes it possible."
      titleId="why-affordable"
      lead="At most preschools every role is a paid position, and those salaries get passed on to families. At WCP, our teachers are the only paid staff. You are the reason the school can afford to be this good."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        why.map((w) => (
          <FeatureCard as="li" icon={w.icon} chip={w.chip} title={w.title}>
            {w.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  <Section bg="grey" labelledby="tuition-table">
    <SectionHeader
      eyebrow="2026-27 Tuition"
      title="Full breakdown — no surprises"
      titleId="tuition-table"
      lead="All fees listed below. The registration fee is due at sign-up to hold your child’s spot; the participation deposit is due at the May Gathering, and student fees at the start of the school year."
    />
    <div class="mt-10" data-reveal>
      <TuitionTable
        caption="West Chester Preschool 2026-27 tuition and fees by class"
        columns={tuitionColumns}
        rows={tuitionRows}
      />
    </div>
    <Callout tone="warm" class="mx-auto mt-8 max-w-3xl">
      <strong class="font-bold text-heading">Annual payment:</strong> families who pay the full year’s
      tuition and fees can skip the monthly billing cycle. Tuition is subject to a 5–15% annual adjustment,
      and rates for each school year are confirmed before enrollment opens. First month’s tuition and
      fees are due in May.
    </Callout>
  </Section>

  <Section bg="white" labelledby="fee-explainer">
    <SectionHeader
      eyebrow="What Each Fee Covers"
      title="Where your money goes"
      titleId="fee-explainer"
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        fees.map((f) => (
          <FeatureCard as="li" icon={f.icon} chip={f.chip} title={f.title}>
            {f.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  <Section bg="navy" seam labelledby="reg-timeline">
    <SectionHeader
      eyebrow="Registration Timeline"
      eyebrowTone="amber"
      title="Spots go fast. Here is how it works."
      titleId="reg-timeline"
      lead="Registration opens each January and follows a priority order. Families who move quickly are almost always placed in their first-choice class."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        timeline.map((t) => (
          <FeatureCard as="li" icon={t.icon} chip={t.chip} title={t.title}>
            {t.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="warm" class="mx-auto mt-8 max-w-3xl">
      <strong class="font-bold text-heading">Good to know:</strong> WCP also accepts open enrollment mid-year
      if space is available and the teacher and board approve. So even if you missed the start of the
      school year, it is worth reaching out.
    </Callout>
  </Section>

  <CtaBanner
    seam={false}
    title="Ready to get started?"
    lead="Enrollment for 2026-27 is open. Reach out and we will walk you through the paperwork and schedule a tour."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/contact" variant="outline-white" size="lg">Ask a Question</Button>
    </Fragment>
    <Fragment slot="note">Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</PreviewLayout>
