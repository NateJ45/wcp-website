---
/* ============================================================================
   Hub preview route — draft-aware Family Hub pages (Studio Presentation only)
   ============================================================================
   Lets the Board click-to-edit hub pages the same way as public pages. Renders
   the EDITABLE surface of a hubPage (heading, intro, sections through the same
   HubSectionedBody treatment the live hub uses) — not the code-owned chrome
   (rail, topbar, per-page widgets), which is not editable anyway.

   GATED, unlike the public preview route: hub content is families-only, so
   this page renders NOTHING without the Studio-issued preview cookie (set by
   /api/draft-mode/enable after validating Sanity's one-time secret — only the
   Presentation iframe can obtain it). A visitor who finds this URL gets 401.
   tests/hub-gate.spec.ts pins that behavior.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Section from '@/components/Section.astro';
import HubSectionedBody from '@/components/hub/HubSectionedBody.astro';
import { previewFetch } from '@/lib/cms-preview';
import { isStudioPreview } from '@/lib/preview-auth';
import { HUB_PAGE_PREVIEW_QUERY } from '@/lib/queries';

// The preview cookie is the gate: no cookie, no hub content — not even the
// published version (the public preview's "published to anyone" behavior is
// fine for public pages, and exactly wrong here). The cookie's VALUE is
// verified against the server-side fingerprint — a cookie merely NAMED right
// is a forgery and gets the same 401 (see src/lib/preview-auth.ts).
const draftMode = await isStudioPreview(Astro.cookies.get(perspectiveCookieName)?.value);
if (!draftMode) {
  return new Response('Hub previews are only available inside the Studio.', { status: 401 });
}

const key = (Astro.params.key as string | undefined) || 'home';

interface HubPageDoc {
  _id: string;
  title?: string;
  heading?: string;
  intro?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
// draftMode is always true past the gate above, so the fetch is draft-aware
// with stega on (click-to-edit).
const page = await previewFetch<HubPageDoc | null>(true, HUB_PAGE_PREVIEW_QUERY, { key });

if (!page) {
  return new Response(`No hub page found for "${key}"`, { status: 404 });
}
const title = page.heading || page.title || key;
---

<PreviewLayout title={`${title} — Hub preview`} draftMode={draftMode} pageId={page._id}>
  <Section bg="grey" labelledby="hub-preview-title">
    {/* Set expectations: this is the editable surface, not the full hub UI. */}
    <p
      class="mb-6 rounded-[var(--radius)] border border-sky/40 bg-sky/10 px-4 py-3 text-sm text-ink"
    >
      <strong>Family Hub page preview.</strong> This shows the parts you can edit — the heading, intro,
      and sections. The hub's menu, top bar, and built-in widgets are not shown here (they are not editable).
    </p>
    <h1 id="hub-preview-title" class="font-display text-4xl text-heading">{title}</h1>
    {page.intro && <p class="mt-3 max-w-2xl text-lg text-ink-muted">{page.intro}</p>}
    <HubSectionedBody sections={page.sections} label="Page sections" class="mt-8" />
  </Section>
</PreviewLayout>
