---
/* ============================================================================
   Hub preview route — now a redirect to the REAL hub page (2026-08-30)
   ============================================================================
   The hub preview used to render a stub here: heading, intro and sections on a
   bare canvas, with locked-area placeholders where the widgets live. Editors
   read that as "the preview shows text that doesn't exist on the actual hub".
   Since 2026-08-30 the real /family-hub/* routes ARE the preview — they accept
   the same Studio-issued cookie (src/middleware.ts), read their hubPage draft-
   aware, and mount the click-to-edit overlay — so this route only forwards old
   bookmarks and the navigator's history there.

   STILL GATED exactly as before: without the fingerprint-verified preview
   cookie this returns 401, never a redirect into the hub (the login bounce
   there would leak that the address exists — and hub-gate.spec.ts pins the
   401). The cookie's VALUE is verified against the server-side fingerprint — a
   cookie merely NAMED right is a forgery (see src/lib/preview-auth.ts).
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import { isStudioPreview } from '@/lib/preview-auth';

const draftMode = await isStudioPreview(Astro.cookies.get(perspectiveCookieName)?.value);
if (!draftMode) {
  return new Response('Hub previews are only available inside the Studio.', { status: 401 });
}

const key = (Astro.params.key as string | undefined) || 'home';
// 302, not 301: the mapping is ours to change and a cached permanent redirect
// in the Studio's browser would outlive it.
return Astro.redirect(key === 'home' ? '/family-hub' : `/family-hub/${key}`, 302);
---
