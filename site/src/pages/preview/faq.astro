---
/* ============================================================================
   FAQ — Studio-only PREVIEW (draft-aware mirror of /faq)
   ============================================================================
   See src/pages/preview/tuition.astro for the pattern this follows. No
   hardcoded fallback categories here (unlike /faq) — an empty Sanity result
   should render as an empty page, not silently substitute built-in copy.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Faq from '@/components/faq/Faq.astro';
import FaqItem from '@/components/faq/FaqItem.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { previewFetch } from '@/lib/cms-preview';
import { PAGE_HERO_QUERY, FAQ_ITEMS_QUERY } from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);

const hero = await previewFetch<{ eyebrow?: string; heroTitle?: string; lead?: string } | null>(
  draftMode,
  PAGE_HERO_QUERY,
  { slug: 'faq' },
);

const catConfig = [
  { id: 'coop', eyebrow: 'About the Co-op', title: 'How the cooperative model works' },
  { id: 'classes', eyebrow: 'Classes and Schedules', title: 'What classes are available and when' },
  { id: 'enrollment', eyebrow: 'Enrollment and Fees', title: 'How to join and what it costs' },
  { id: 'about', eyebrow: 'About WCP', title: 'The school itself' },
];

interface FaqDoc {
  question: string;
  answer?: { _type: string; children?: { text?: string }[] }[];
  category: string;
  order: number;
}
const faqDocs = await previewFetch<FaqDoc[]>(draftMode, FAQ_ITEMS_QUERY, {});
const toParas = (pt?: FaqDoc['answer']) =>
  (pt ?? [])
    .filter((b) => b._type === 'block')
    .map((b) => (b.children ?? []).map((c) => c.text ?? '').join(''))
    .filter(Boolean);

const categories = catConfig
  .map((cat) => ({
    ...cat,
    items: faqDocs
      .filter((f) => f.category === cat.id)
      .map((f) => ({ q: f.question, a: toParas(f.answer) })),
  }))
  .filter((cat) => cat.items.length > 0);
---

<PreviewLayout title="FAQ — Preview" draftMode={draftMode}>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Common Questions Answered'}
    title={hero?.heroTitle ?? 'Got questions? We have answers.'}
    lead={hero?.lead ?? ''}
  >
    <Fragment slot="actions">
      <Button href="/contact" variant="accent" size="lg">Ask Us Directly</Button>
    </Fragment>
  </Hero>

  {
    categories.map((cat, i) => (
      <Section bg={i % 2 === 0 ? 'grey' : 'white'} labelledby={`faq-${cat.id}`}>
        <SectionHeader eyebrow={cat.eyebrow} title={cat.title} titleId={`faq-${cat.id}`} />
        <Faq class="mt-10">
          {cat.items.map((item) => (
            <FaqItem question={item.q}>
              {item.a.map((p) => (
                <p class="mt-3 first:mt-0">{p}</p>
              ))}
            </FaqItem>
          ))}
        </Faq>
      </Section>
    ))
  }

  <CtaBanner
    title="Still have questions?"
    lead="We are a parent-run school and we actually reply. Call, email, or send us a message."
    tone="navy"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/contact" variant="outline-white" size="lg">Get in Touch</Button>
    </Fragment>
    <Fragment slot="note">Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</PreviewLayout>
