---
/* ============================================================================
   Preview route — draft-aware page builder (Studio Presentation only)
   ============================================================================
   One SSR route renders ANY builder page in draft mode for the Presentation
   Tool: reads the perspective cookie, fetches the page + sections draft-aware
   (stega on), and renders them through PageHero + SectionRenderer. `/preview`
   resolves the home page. noindex via PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { previewFetch, getPreviewSiteSettings } from '@/lib/cms-preview';
import { PAGE_BY_SLUG_QUERY } from '@/lib/queries';
import { site as siteFallback } from '@/data/site';

const draftMode = Astro.cookies.has(perspectiveCookieName);

// Never let a browser cache a preview page (2026-08-28). These SSR responses
// carried NO Cache-Control, so browsers applied heuristic caching — and the
// Presentation iframe kept serving the PREVIOUS deploy's page (stale island
// hashes, invisible new editor features) until the cache aged out. Draft
// content is per-cookie anyway; caching it was never right.
Astro.response.headers.set('Cache-Control', 'no-store');

const slug = (Astro.params.slug as string | undefined) || 'home';

interface PageDoc {
  _id: string;
  title?: string;
  seoTitle?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  hero?: any;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
const page = await previewFetch<PageDoc | null>(draftMode, PAGE_BY_SLUG_QUERY, { slug });
const site = await getPreviewSiteSettings(draftMode, siteFallback);

if (!page) {
  return new Response(`No page found for "${slug}"`, { status: 404 });
}

// The doc id the overlay + /preview/live listen on, read from the QUERY — a
// derived `page-<slug>` id only holds for script-seeded pages, and a Studio-
// created page (random id) got no live refresh at all (found by the Babies
// test page, 2026-08-24). Draft perspective can return the drafts. twin's id;
// strip it so the listen filter matches both twins.
const pageId = page._id.replace(/^drafts\./, '');
---

<PreviewLayout title={`${page.title ?? slug} — Preview`} draftMode={draftMode} pageId={pageId}>
  {page.hero && <PageHero hero={page.hero} linkBase="/preview" pageSlug={slug} />}
  {
    /* editDoc puts a `data-sanity` target on every section wrapper, so the
      overlay shows section-level controls (move / duplicate / delete /
      insert), not just text click-to-edit. Draft mode only — outside it the
      overlay is not rendered and the attribute would be dead weight. */
  }
  <SectionRenderer
    sections={page.sections}
    linkBase="/preview"
    site={site}
    editDoc={draftMode ? { id: pageId, type: 'page' } : undefined}
  />
</PreviewLayout>
