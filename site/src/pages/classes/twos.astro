---
/* ============================================================================
   Twos Class page
   ============================================================================
   Real approved copy (extraction Part 4). This is the TEMPLATE the other class
   pages (Threes, Pre-K) follow. Copy becomes editable Sanity `classPage` fields
   later; this file is the locked layout.
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import ScheduleTimeline from '@/components/ScheduleTimeline.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Testimonial from '@/components/Testimonial.astro';
import Callout from '@/components/Callout.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import erinSchmerr from '@/assets/staff/erin-schmerr.jpg';
import twosHero from '@/assets/photos/twos-hero.jpg';
import { getStaff, getClassFacts, toParagraphs, getTestimonials, getPageHero } from '@/lib/cms';

// Class schedule/tuition facts and the teacher's bio are edited in Sanity
// (Classes / Staff) and read here at build time, so the numbers below always
// match Tuition, the Family Hub, and every other page that shows them.
const hero = await getPageHero('classes/twos');
const classFacts = await getClassFacts('class-twos');
const erin = await getStaff('staff-erin');
const erinBio = toParagraphs(erin?.bio);
const [twosQuote] = await getTestimonials({ tag: 'twos', limit: 1 }, [
  {
    quote:
      'I was worried about my pandemic baby’s socialization after so much time at home. WCP has done a fantastic job helping him become independent, social, and confident. We are already signed up for the Threes program.',
    author: 'Taylor Dore',
    role: 'Twos Parent',
  },
]);

const glance = [
  {
    icon: 'calendar-days',
    chip: 'sky' as const,
    title: classFacts?.days ?? 'Thursdays only',
    body: 'One morning a week, perfect for little ones just starting out.',
  },
  {
    icon: 'clock',
    chip: 'orange' as const,
    title: classFacts?.time ?? '9:30 am – 12:00 pm',
    body: 'Drop off, enjoy your morning, and pick up at noon.',
  },
  {
    icon: 'cake',
    chip: 'amber' as const,
    title: classFacts?.age ?? 'Age 2 by Sept 30',
    body: 'Your child must turn 2 by September 30 of the enrollment year.',
  },
  {
    icon: 'piggy-bank',
    chip: 'green' as const,
    title: classFacts?.monthly ? `${classFacts.monthly} per month` : '$70 per month',
    body: '$100 registration fee holds your spot at sign-up. $100 deposit due at the May Gathering.',
  },
];

const classSize = [
  {
    icon: 'users',
    chip: 'amber' as const,
    title: classFacts?.classSizeCap
      ? `${classFacts.classSizeCap} children, max`
      : '7 children, max',
    body: 'The Twos class is capped at 7 children so every child gets real individual attention from the teacher.',
  },
  {
    icon: 'graduation-cap',
    chip: 'sky' as const,
    title: 'Certified teacher',
    body: 'Mrs. Erin leads every Twos session. She knows every child by name before the second week.',
  },
  {
    icon: 'heart-handshake',
    chip: 'orange' as const,
    title: 'Two parent helpers',
    body: 'Two co-op parents help in the classroom every session. One of them could be you.',
  },
];

const schedule = [
  {
    time: '9:30 am',
    title: 'Greeting and Free Play',
    desc: 'Kids arrive and settle in at their own pace. Free exploration of toys and materials.',
  },
  {
    time: '9:45 am',
    title: 'First Circle Time',
    desc: 'Songs, simple activities, and group time on the rug together.',
  },
  {
    time: '10:00 am',
    title: 'Sensory Bins and Free Play',
    desc: 'Hands-on sensory exploration and open play with parent helpers at every table.',
  },
  {
    time: '10:50 am',
    title: 'Snack Time',
    desc: 'Parent helpers bring snack. Kids eat together and start winding down.',
  },
  {
    time: '11:15 am',
    title: 'Storytime',
    desc: 'A quiet wind-down with books and songs before heading outside.',
  },
  {
    time: '11:40 am',
    title: 'Outdoor Play and Dismissal',
    desc: 'Playground time. Families pick up at 12:00 pm.',
  },
];

const learn = [
  {
    title: 'Reading and language',
    body: 'Children are introduced to letters, printed names, and how books work. They enjoy stories and rhymes and begin recognising print vs pictures.',
  },
  {
    title: 'Communication',
    body: 'Toddlers begin to speak more clearly to express ideas, feelings, and needs, follow simple directions, and grow their vocabulary through conversation.',
  },
  {
    title: 'Early math',
    body: 'An introduction to colours, numbers, and basic shapes through play, hands-on materials, and daily activities.',
  },
  {
    title: 'Social and emotional',
    body: 'Learning to separate from parents, take turns, share, and ask for things in appropriate ways, building confidence with teachers and peers.',
  },
  {
    title: 'Music and art',
    body: 'Group singing, art projects, and creative exploration with tools like scissors, paintbrushes, and cookie cutters.',
  },
  {
    title: 'Science and social studies',
    body: 'Exploring weather and seasons, animals, plants, and life cycles, plus family history, cultural traditions, and seasonal holidays.',
  },
];
---

<BaseLayout
  title="Twos Class — West Chester Preschool"
  description="The Twos class at West Chester Preschool meets Thursday mornings — a calm, play-based introduction to school for children who are just starting out."
>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Now Enrolling 2026-27 · Ages 2+'}
    title={hero?.heroTitle ?? 'A gentle first step into school life.'}
    lead={hero?.lead ??
      'The Twos class meets every Thursday morning. It is a calm, play-based introduction to being at school, made for children who are just starting out.'}
    image={twosHero}
    imageAlt="Two Twos-class children exploring a sensory bin filled with beans and toy animals together"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll in the Twos Class</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
  </Hero>

  {/* At a glance */}
  <Section bg="grey" labelledby="twos-glance">
    <SectionHeader eyebrow="Twos Class" title="Everything you need to know" titleId="twos-glance" />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        glance.map((g) => (
          <FeatureCard as="li" icon={g.icon} chip={g.chip} title={g.title}>
            {g.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  {/* Class size */}
  <Section bg="white" labelledby="twos-size">
    <SectionHeader
      eyebrow="Class Size"
      title="Small classes. Real attention."
      titleId="twos-size"
      lead="The Twos class is intentionally tiny. Seven children, one teacher, and two parent helpers every single session. Your child will never be a face in a crowd."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        classSize.map((c) => (
          <FeatureCard as="li" icon={c.icon} chip={c.chip} title={c.title}>
            {c.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="sky" class="mx-auto mt-8 max-w-3xl">
      <strong class="font-bold text-heading">Caregiver and Me option:</strong> if your child is not yet
      fully potty trained, a parent or guardian is welcome to stay in the building for the entire session.
      No child is ever turned away.
    </Callout>
  </Section>

  {/* Daily schedule */}
  <Section bg="grey" labelledby="twos-day">
    <SectionHeader
      eyebrow="A Typical Thursday"
      title="What your child’s morning looks like"
      titleId="twos-day"
      lead="Each session is paced for two-year-olds: short bursts of activity, plenty of free time, and a snack and outdoor play to finish the morning."
    />
    <ScheduleTimeline entries={schedule} class="mt-12" />
    <p class="mt-10 text-center" data-reveal>
      <a href="/a-day-at-wcp" class="font-bold text-sky-ink underline underline-offset-2">
        Compare schedules across every WCP class
      </a>
    </p>
  </Section>

  {/* What they learn */}
  <Section bg="white" labelledby="twos-learn">
    <SectionHeader
      eyebrow="Ohio Early Learning Standards"
      title="What your two-year-old learns at WCP"
      titleId="twos-learn"
      lead="Our curriculum is built on Ohio’s Early Learning Content Standards. For two-year-olds, every goal is delivered through play."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        learn.map((l) => (
          <FeatureCard as="li" title={l.title}>
            {l.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="warm" class="mx-auto mt-8 max-w-3xl">
      Every goal above is drawn directly from Ohio’s Early Learning Content Standards and delivered
      through play, every single session.
    </Callout>
  </Section>

  {/* Meet Mrs. Erin + a Twos family's story */}
  <Section bg="grey" labelledby="twos-teacher">
    <SectionHeader eyebrow="Your Child’s Teacher" title="Meet Mrs. Erin" titleId="twos-teacher" />
    <div class="mx-auto mt-12 grid max-w-4xl items-start gap-8 md:grid-cols-2">
      <TeacherCard
        photo={erinSchmerr}
        name={erin ? [erin.honorific, erin.name].filter(Boolean).join(' ') : 'Mrs. Erin Schmerr'}
        role={erin?.role ?? 'Twos & Threes · 3 years at WCP'}
        email={erin?.email ?? site.teachers.erin}
      >
        {
          erinBio.length > 0 ? (
            erinBio.map((p) => <p class="mt-2 first:mt-0">{p}</p>)
          ) : (
            <p>
              Erin is a Cincinnati native with nearly 20 years of experience in education, social
              work, and childcare. She holds a degree in Social Work from Xavier University and also
              serves as WCP’s school administrator. She came to WCP as a parent, fell in love with
              the school, and never left. In her spare time she runs a photography business and
              loves to travel.
            </p>
          )
        }
      </TeacherCard>
      <div class="md:pt-4">
        <Testimonial
          quote={twosQuote.quote}
          author={twosQuote.author ?? ''}
          context={twosQuote.role ?? 'Twos Parent'}
          accent="sky"
        />
        <p class="mt-6 text-center md:text-left" data-reveal>
          <a href="/why-wcp#stories" class="font-bold text-sky-ink underline underline-offset-2">
            Read more family stories
          </a>
        </p>
      </div>
    </div>
  </Section>

  <CtaBanner
    title="Ready to get your two-year-old started?"
    lead="Enrollment for 2026-27 is open now. Send us a message and we will be in touch within a day or two."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
    <Fragment slot="note">Questions? Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</BaseLayout>
