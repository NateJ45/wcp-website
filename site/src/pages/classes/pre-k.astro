---
/* ============================================================================
   Pre-K Class page  (real copy, extraction Part 4). Uses ClassCard for AM/PM.
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import ClassCard from '@/components/ClassCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Testimonial from '@/components/Testimonial.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import prekHero from '@/assets/photos/prek-hero.jpg';
import lisaCortez from '@/assets/staff/lisa-cortez.jpg';

const classSize = [
  { icon: 'users', chip: 'orange' as const, title: '12 children per session', body: 'Both AM and PM sessions are capped at 12 children, well below the averages at larger preschools.' },
  { icon: 'graduation-cap', chip: 'sky' as const, title: 'Mrs. Lisa, lead teacher', body: '10 years at WCP. Her own children are alumni. She brings deep expertise and genuine care to every session.' },
  { icon: 'calendar-days', chip: 'green' as const, title: 'Annual conferences', body: 'Pre-K families receive parent-teacher conferences early in the year to help with kindergarten placement.' },
];

// The full "what your Pre-K child learns" curriculum, drawn directly from
// Ohio's Early Learning Content Standards.
const curriculum = [
  { icon: 'book-open', chip: 'orange' as const, title: 'Reading and phonics', body: 'Children recognize upper and lower case letters, identify rhymes, isolate syllables through clapping and movement, and begin reading their own first and last name. They predict story events, answer comprehension questions, and retell stories after read-alouds.' },
  { icon: 'pencil', chip: 'sky' as const, title: 'Writing', body: 'Using the Handwriting Without Tears approach, children practice printing letters of their name and other meaningful words. They learn proper letter formation, write from top to bottom in horizontal rows, and develop a mature pencil grip through daily fine motor exercises.' },
  { icon: 'message-circle', chip: 'green' as const, title: 'Communication', body: 'Children speak clearly to express ideas and needs, sustain back-and-forth conversations, recite their home address and phone number, and participate in poems, chants, and nursery rhymes. They also state their parents’ names and follow multi-step oral directions.' },
  { icon: 'calculator', chip: 'amber' as const, title: 'Math', body: 'Counting to 20, identifying numerals 0–20, recognizing coins and their values, identifying 2D and 3D shapes, creating and extending patterns, differentiating left from right, and using the language of time — day, night, yesterday, today, and tomorrow.' },
  { icon: 'hand', chip: 'sky' as const, title: 'Fine and gross motor', body: 'Tracing lines, cutting straight and curved lines, drawing from memory, working puzzles with ten or more pieces, and drawing a person with full body detail. Gross motor includes hopping, skipping, balancing, catching a ball, and climbing with alternating feet.' },
  { icon: 'microscope', chip: 'orange' as const, title: 'Science and social studies', body: 'Weather, seasons, planets, life cycles, dinosaurs, forces and motion, dental health, and our bodies. Social studies covers U.S. symbols, the Pledge of Allegiance, authority figures, community helpers, maps, and different environments.' },
];

const readiness = [
  { icon: 'book-open', chip: 'orange' as const, title: 'Literacy', body: 'Alphabet recognition, phonics basics, and comprehension through daily storytime and reading centers.' },
  { icon: 'calculator', chip: 'sky' as const, title: 'Math', body: 'Counting, patterning, shapes, classifying, and number recognition through hands-on activities every session.' },
  { icon: 'file-check', chip: 'green' as const, title: 'Fine motor', body: 'Handwriting Without Tears builds the pencil control kids need for writing in kindergarten.' },
  { icon: 'heart-handshake', chip: 'amber' as const, title: 'Social skills', body: 'Cooperating, listening, following routines, and managing emotions — the skills teachers say matter most.' },
  { icon: 'microscope', chip: 'sky' as const, title: 'Science', body: 'Curiosity-driven exploration through experiments, sensory bins, and outdoor observation.' },
  { icon: 'sparkles', chip: 'orange' as const, title: 'Independence', body: 'Managing belongings, following directions, and navigating routines without constant adult support.' },
];
---

<BaseLayout
  title="Pre-K Class — West Chester Preschool"
  description="Pre-K at West Chester Preschool gives four-year-olds the skills and confidence for kindergarten, with morning and afternoon session options."
>
  <Hero
    eyebrow="Now Enrolling 2026-27 · Ages 4+ · AM and PM"
    title="Ready for kindergarten. Ready for anything."
    lead="Pre-K at WCP gives four-year-olds the skills, confidence, and love of learning they need to walk into kindergarten ready. Two session options to fit your family."
    image={prekHero}
    imageAlt="A Pre-K teacher reads to the class during circle time, with a second teacher assisting"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll in Pre-K</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
  </Hero>

  <Section bg="white" labelledby="prek-size">
    <SectionHeader
      eyebrow="Class Size"
      title="Small classes. Real attention."
      titleId="prek-size"
      lead="Both Pre-K sessions are capped at 12 children with one lead teacher: small enough that Mrs. Lisa knows every child deeply, large enough for the social experience of a real classroom."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {classSize.map((c) => (<FeatureCard as="li" icon={c.icon} chip={c.chip} title={c.title}>{c.body}</FeatureCard>))}
    </ul>
  </Section>

  <Section bg="grey" labelledby="prek-options">
    <SectionHeader
      eyebrow="Pre-K Class"
      title="Two options to fit your schedule"
      titleId="prek-options"
      lead="Both sessions cover the same curriculum. Pick the time that works best for your family."
    />
    <ul class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
      <ClassCard
        as="li"
        name="Pre-K AM"
        color="orange"
        price="$200"
        cadence="/ mo"
        schedule="Mon – Thurs · 9:15 am – 12:00 pm"
        age="4 days a week"
        features={[
          'Must be 4 by September 30',
          '4-day schedule for maximum readiness',
          'Kindergarten curriculum focus',
          '$100 reg · $100 deposit · $50 student fees',
        ]}
        href="/enroll"
        ctaLabel="Enroll in AM"
      />
      <ClassCard
        as="li"
        name="Pre-K PM"
        color="sky"
        price="$175"
        cadence="/ mo"
        schedule="Mon – Wed · 12:30 pm – 3:15 pm"
        age="3 days a week"
        features={[
          'Must be 4 by September 30',
          '3-day afternoon option',
          'Same curriculum as the AM session',
          '$100 reg · $100 deposit · $50 student fees',
        ]}
        href="/enroll"
        ctaLabel="Enroll in PM"
      />
    </ul>
    <p class="mt-10 text-center" data-reveal>
      <a href="/a-day-at-wcp" class="font-bold text-sky-ink underline underline-offset-2">
        See the full AM and PM daily schedules
      </a>
    </p>
  </Section>

  {/* Full curriculum — Ohio Early Learning Standards */}
  <Section bg="white" labelledby="prek-curriculum">
    <SectionHeader
      eyebrow="Ohio Early Learning Standards"
      title="What your Pre-K child learns at WCP"
      titleId="prek-curriculum"
      lead="Kindergarten readiness is the heart of our Pre-K program. Every goal below is drawn directly from Ohio’s Early Learning Content Standards and delivered through a structured but playful daily routine."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {curriculum.map((c) => (<FeatureCard as="li" icon={c.icon} chip={c.chip} title={c.title}>{c.body}</FeatureCard>))}
    </ul>
  </Section>

  {/* Meet Mrs. Lisa */}
  <Section bg="grey" labelledby="prek-teacher">
    <SectionHeader eyebrow="Your Child’s Teacher" title="Meet Mrs. Lisa" titleId="prek-teacher" />
    <div class="mx-auto mt-12 grid max-w-4xl items-start gap-8 md:grid-cols-2">
      <TeacherCard photo={lisaCortez} name="Mrs. Lisa Cortez" role="Pre-K · 10 years at WCP" email={site.teachers.lisa}>
        Lisa has a passion for early education and a classroom built around hands-on activities that
        develop social skills, early literacy, math, science, and the arts. She and her family have
        called Ohio home since 2014 and her youngest, Oliver, is a proud WCP alumnus. She describes
        the co-op model as one of the most rewarding parts of the job — getting to build real
        relationships with every family in the class.
      </TeacherCard>
      <div class="md:pt-4">
        <Testimonial
          quote="We have had the best Pre-K experience at WCP. This school cares immensely about its students. My son loves going to school because he has a great time learning through play. The teachers go above and beyond — we could not recommend WCP more."
          author="Meagan Gegner"
          context="Pre-K Alumni Parent"
          accent="orange"
        />
        <p class="mt-6 text-center md:text-left" data-reveal>
          <a href="/why-wcp#stories" class="font-bold text-sky-ink underline underline-offset-2">
            Read more family stories
          </a>
        </p>
      </div>
    </div>
  </Section>

  {/* Navy readiness band — top seam clouds up into the teacher section above.
      It flows straight into the navy CTA below, so the CTA's own seam is off. */}
  <Section bg="navy" seam labelledby="prek-readiness">
    <SectionHeader
      eyebrow="Kindergarten Readiness"
      title="What WCP Pre-K graduates walk in with"
      titleId="prek-readiness"
      lead="Our curriculum is built around Ohio’s Early Learning Content Standards, aligned with what kindergarten teachers expect on day one."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {readiness.map((r) => (<FeatureCard as="li" icon={r.icon} chip={r.chip} title={r.title}>{r.body}</FeatureCard>))}
    </ul>
  </Section>

  <CtaBanner
    seam={false}
    title="Give your four-year-old the best start."
    lead="Enrollment for 2026-27 Pre-K is open now. AM and PM spots fill up, so reach out soon."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
    <Fragment slot="note">Questions? Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</BaseLayout>
