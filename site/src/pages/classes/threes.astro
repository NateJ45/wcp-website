---
/* ============================================================================
   Threes Class page  (real copy, extraction Part 4). Same template as Twos.
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import ScheduleTimeline from '@/components/ScheduleTimeline.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Testimonial from '@/components/Testimonial.astro';
import Callout from '@/components/Callout.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import erinSchmerr from '@/assets/staff/erin-schmerr.jpg';
import threesHero from '@/assets/photos/threes-hero.jpg';
import { getStaff, getClassFacts, toParagraphs, getTestimonials, getPageHero } from '@/lib/cms';

// Class schedule/tuition facts and the teacher's bio are edited in Sanity
// (Classes / Staff) and read here at build time, so the numbers below always
// match Tuition, the Family Hub, and every other page that shows them.
const hero = await getPageHero('classes/threes');
const classFacts = await getClassFacts('class-threes');
const erin = await getStaff('staff-erin');
const erinBio = toParagraphs(erin?.bio);
const [threesQuote] = await getTestimonials({ tag: 'threes', limit: 1 }, [
  {
    quote:
      'Our first year at WCP has been amazing. My son loves his teacher and his friends. The teachers and parents here are a blessing, I could not recommend this school more.',
    author: 'Amber Cron',
    role: 'Threes Parent',
  },
]);

const glance = [
  {
    icon: 'calendar-days',
    chip: 'green' as const,
    title: classFacts?.days ?? 'Mon, Tue, Wed',
    body: 'Three mornings a week gives kids real routine and rhythm.',
  },
  {
    icon: 'clock',
    chip: 'sky' as const,
    title: classFacts?.time ?? '9:30 am – 12:00 pm',
    body: 'Drop off, enjoy your morning, and pick up at noon.',
  },
  {
    icon: 'cake',
    chip: 'amber' as const,
    title: classFacts?.age ?? 'Age 3 by Sept 30',
    body: 'Your child must turn 3 by September 30 of the enrollment year.',
  },
  {
    icon: 'piggy-bank',
    chip: 'orange' as const,
    title: classFacts?.monthly ? `${classFacts.monthly} per month` : '$150 per month',
    body: '$100 registration fee holds your spot at sign-up. $100 deposit due at the May Gathering.',
  },
];
const classSize = [
  {
    icon: 'users',
    chip: 'green' as const,
    title: classFacts?.classSizeCap
      ? `${classFacts.classSizeCap} children, max`
      : '12 children, max',
    body: 'Small enough for individual attention, large enough for real friendships.',
  },
  {
    icon: 'graduation-cap',
    chip: 'sky' as const,
    title: 'Certified teacher',
    body: 'Mrs. Erin leads every Threes session with years of experience in early childhood education.',
  },
  {
    icon: 'heart-handshake',
    chip: 'orange' as const,
    title: 'Two parent helpers',
    body: 'Two co-op parents help in the classroom every session. You will be one of them 2 to 3 times a month.',
  },
];
const schedule = [
  {
    time: '9:30 am',
    title: 'Greeting and Free Play',
    desc: 'Kids arrive and start playing with friends right away.',
  },
  {
    time: '9:45 am',
    title: 'First Circle Time',
    desc: 'Songs, calendar, and group conversation to start the morning.',
  },
  {
    time: '10:00 am',
    title: 'Group Activity',
    desc: 'A teacher-led activity: crafts, science, cooking, or a themed project.',
  },
  {
    time: '10:10 am',
    title: 'Centers and Free Play',
    desc: 'Open play across activity stations with parent helpers.',
  },
  {
    time: '10:50 am',
    title: 'Snack Time',
    desc: 'Parent helpers bring snack. Kids eat and talk together.',
  },
  {
    time: '11:15 am',
    title: 'Second Circle Time',
    desc: 'Stories, literacy activities, and a group wind-down before outdoor play.',
  },
  {
    time: '11:40 am',
    title: 'Outdoor Play and Dismissal',
    desc: 'Playground time. Families pick up at 12:00 pm.',
  },
];
const learn = [
  {
    title: 'Reading and phonics',
    body: 'Recognising and naming letters, identifying rhymes, spotting their own name in print, and responding to read-alouds.',
  },
  {
    title: 'Writing',
    body: 'Practising writing from top to bottom and printing letters from their own name with assistance.',
  },
  {
    title: 'Math',
    body: 'Counting to 10, identifying numerals 0-5, naming shapes, and sorting by size, colour, and shape.',
  },
  {
    title: 'Social and emotional',
    body: 'Following classroom routines, self-confidence, sharing and turn-taking, and respecting authority.',
  },
  {
    title: 'Fine and gross motor',
    body: 'Crayons, scissors, and clay build small-muscle control; climbing and balancing build coordination for kindergarten.',
  },
  {
    title: 'Science and social studies',
    body: 'Weather, seasons, animals, plants, and life cycles, plus family heritage, community helpers, and holidays.',
  },
];
---

<BaseLayout
  title="Threes Class — West Chester Preschool"
  description="The Threes class at West Chester Preschool meets Monday through Wednesday. More structure, more creativity, and more time with friends."
>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Now Enrolling 2026-27 · Ages 3+'}
    title={hero?.heroTitle ?? 'Building independence, one morning at a time.'}
    lead={hero?.lead ??
      'The Threes class meets Monday through Wednesday. Kids this age are ready for more structure, more creativity, and more time with friends.'}
    image={threesHero}
    imageAlt="A Threes-class group exploring a creek with a parent volunteer during an outdoor nature walk"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll in the Threes Class</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
  </Hero>

  <Section bg="grey" labelledby="threes-glance">
    <SectionHeader
      eyebrow="Threes Class"
      title="Everything you need to know"
      titleId="threes-glance"
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        glance.map((g) => (
          <FeatureCard as="li" icon={g.icon} chip={g.chip} title={g.title}>
            {g.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  <Section bg="white" labelledby="threes-size">
    <SectionHeader
      eyebrow="Class Size"
      title="Small classes. Real attention."
      titleId="threes-size"
      lead="Twelve children, one teacher, and two parent helpers every session. Small enough that every child is known. Large enough that friendships form fast."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        classSize.map((c) => (
          <FeatureCard as="li" icon={c.icon} chip={c.chip} title={c.title}>
            {c.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="sky" class="mx-auto mt-8 max-w-3xl">
      <strong class="font-bold text-navy">Caregiver and Me option:</strong> if your child is not yet fully
      potty trained, a parent or guardian is welcome to stay in the building for the entire session. No
      child is ever turned away.
    </Callout>
  </Section>

  <Section bg="grey" labelledby="threes-day">
    <SectionHeader
      eyebrow="A Typical Morning"
      title="What your child’s day looks like"
      titleId="threes-day"
      lead="The Threes day has more structure: two circle times, group activities, and centers, while still leaving room for free play and outdoor time every session."
    />
    <ScheduleTimeline entries={schedule} class="mt-12" />
    <p class="mt-10 text-center" data-reveal>
      <a href="/a-day-at-wcp" class="font-bold text-sky-ink underline underline-offset-2">
        Compare schedules across every WCP class
      </a>
    </p>
  </Section>

  <Section bg="white" labelledby="threes-learn">
    <SectionHeader
      eyebrow="Ohio Early Learning Standards"
      title="What your three-year-old learns at WCP"
      titleId="threes-learn"
      lead="The Threes curriculum introduces real literacy and number skills alongside science, social studies, and creative expression, all grounded in Ohio’s Early Learning Standards."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        learn.map((l) => (
          <FeatureCard as="li" title={l.title}>
            {l.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="warm" class="mx-auto mt-8 max-w-3xl">
      Every goal above is drawn directly from Ohio’s Early Learning Content Standards and delivered
      through play, every single session.
    </Callout>
  </Section>

  {/* Meet Mrs. Erin + a Threes family's story */}
  <Section bg="grey" labelledby="threes-teacher">
    <SectionHeader eyebrow="Your Child’s Teacher" title="Meet Mrs. Erin" titleId="threes-teacher" />
    <div class="mx-auto mt-12 grid max-w-4xl items-start gap-8 md:grid-cols-2">
      <TeacherCard
        photo={erinSchmerr}
        name={erin ? [erin.honorific, erin.name].filter(Boolean).join(' ') : 'Mrs. Erin Schmerr'}
        role={erin?.role ?? 'Twos & Threes · 3 years at WCP'}
        email={erin?.email ?? site.teachers.erin}
      >
        {
          erinBio.length > 0 ? (
            erinBio.map((p) => <p class="mt-2 first:mt-0">{p}</p>)
          ) : (
            <p>
              Erin is a Cincinnati native with nearly 20 years of experience in education, social
              work, and childcare. She holds a degree in Social Work from Xavier University and also
              serves as WCP’s school administrator. She came to WCP as a parent, fell in love with
              the school, and never left. In her spare time she runs a photography business and
              loves to travel.
            </p>
          )
        }
      </TeacherCard>
      <div class="md:pt-4">
        <Testimonial
          quote={threesQuote.quote}
          author={threesQuote.author ?? ''}
          context={threesQuote.role ?? 'Threes Parent'}
          accent="green"
        />
        <p class="mt-6 text-center md:text-left" data-reveal>
          <a href="/why-wcp#stories" class="font-bold text-sky-ink underline underline-offset-2">
            Read more family stories
          </a>
        </p>
      </div>
    </div>
  </Section>

  <CtaBanner
    title="Ready to enroll your three-year-old?"
    lead="Enrollment for 2026-27 is open now. Reach out and we will get back to you within a day or two."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Now</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
    <Fragment slot="note">Questions? Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</BaseLayout>
