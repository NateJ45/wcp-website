---
/* ============================================================================
   [...slug] — every builder page, statically prerendered
   ============================================================================
   getStaticPaths reads every `page` document from Sanity at build time and
   emits one static route each ("home" → /, slashes stay: classes/twos →
   /classes/twos). New pages published in the Studio go live on the next
   rebuild (the Sanity webhook triggers it). Non-builder routes (family-hub,
   404, api, studio, preview) are their own files and are never page docs, so
   they don't collide.
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { cmsFetch, getSiteSettings } from '@/lib/cms';
import { site as siteFallback } from '@/data/site';
import { PAGE_BY_SLUG_QUERY, ALL_PAGE_SLUGS_QUERY } from '@/lib/queries';
import { imageUrl, type SanityImageSource, type SanityImageValue } from '@/lib/image';
import { portableTextToPlain, deEmDash } from '@/lib/portable-text';

export async function getStaticPaths() {
  const slugs = await cmsFetch<string[]>(ALL_PAGE_SLUGS_QUERY, {}, []);
  return slugs.map((slug) => ({
    params: { slug: slug === 'home' ? undefined : slug },
    props: { slug },
  }));
}

interface PageDoc {
  title?: string;
  seoTitle?: string;
  seoDescription?: string;
  ogImage?: SanityImageValue | null;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  hero?: any;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
const { slug } = Astro.props as { slug: string };
const page = await cmsFetch<PageDoc | null>(PAGE_BY_SLUG_QUERY, { slug }, null);
const siteData = await getSiteSettings(siteFallback);

const title =
  page?.seoTitle ?? (page?.title ? `${page.title} — ${siteFallback.name}` : siteFallback.name);
// Page's own share image when set; otherwise the branded card generated for
// this page at build time (see /og/[...slug].png.ts).
const ogImage = page?.ogImage?.asset
  ? imageUrl(page.ogImage as SanityImageSource, 1200)
  : `/og/${slug}.jpg`;

// ---------------------------------------------------------------------------
// One FAQPage per page (Google's rich-result rule)
// ---------------------------------------------------------------------------
// FaqSection.astro renders the visible accordions but deliberately emits no
// JSON-LD of its own — a page with several faqSections (/faq has four) would
// otherwise ship several competing FAQPage entities, which disqualifies the
// rich result. Aggregate every faqSection's Q&As here into one script tag
// instead. The GROQ projection has already resolved BOTH sources (inline
// items and referenced faqItem docs) into a flat `items` array of
// { question, answer }, so this only has to collect. Static path (cms.ts, no
// stega), so plain string handling is safe; deEmDash + portableTextToPlain
// mirror exactly what FaqSection renders visibly (house style, plain text).
interface FaqQA {
  question?: string;
  answer?: unknown;
}
const faqPairs = (page?.sections ?? [])
  .filter((s) => s?._type === 'faqSection')
  .flatMap((s) => (s.items as FaqQA[] | undefined) ?? [])
  .map((qa) => ({
    question: qa.question ? deEmDash(qa.question) : '',
    answer: portableTextToPlain(qa.answer as never),
  }))
  .filter((qa) => qa.question && qa.answer);
const faqJsonLd =
  faqPairs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqPairs.map((qa) => ({
          '@type': 'Question',
          name: qa.question,
          acceptedAnswer: { '@type': 'Answer', text: qa.answer },
        })),
      }
    : null;
---

<BaseLayout title={title} description={page?.seoDescription} ogImage={ogImage}>
  {page?.hero && <PageHero hero={page.hero} />}
  <SectionRenderer sections={page?.sections} site={siteData} />
  {
    faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
    )
  }
</BaseLayout>
