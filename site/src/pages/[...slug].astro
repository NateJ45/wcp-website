---
/* ============================================================================
   [...slug] — every builder page, statically prerendered
   ============================================================================
   getStaticPaths reads every `page` document from Sanity at build time and
   emits one static route each ("home" → /, slashes stay: classes/twos →
   /classes/twos). New pages published in the Studio go live on the next
   rebuild (the Sanity webhook triggers it). Non-builder routes (family-hub,
   404, api, studio, preview) are their own files and are never page docs, so
   they don't collide.
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { HERO_OVERRIDES, finalBandBg } from '@/lib/page-doctrine';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { cmsFetch, getSiteSettings } from '@/lib/cms';
import { site as siteFallback } from '@/data/site';
import { PAGE_BY_SLUG_QUERY, ALL_PAGE_SLUGS_QUERY } from '@/lib/queries';
import { imageUrl, type SanityImageSource, type SanityImageValue } from '@/lib/image';
import { portableTextToPlain, deEmDash } from '@/lib/portable-text';

export async function getStaticPaths() {
  const slugs = await cmsFetch<string[]>(ALL_PAGE_SLUGS_QUERY, {}, []);
  return slugs.map((slug) => ({
    params: { slug: slug === 'home' ? undefined : slug },
    props: { slug },
  }));
}

interface PageDoc {
  title?: string;
  seoTitle?: string;
  seoDescription?: string;
  ogImage?: SanityImageValue | null;
  /** "Keep this page out of Google" in the Studio's Search & sharing group. */
  hideFromSearch?: boolean;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  hero?: any;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
const { slug } = Astro.props as { slug: string };
const page = await cmsFetch<PageDoc | null>(PAGE_BY_SLUG_QUERY, { slug }, null);
const siteData = await getSiteSettings(siteFallback);

const title =
  page?.seoTitle ?? (page?.title ? `${page.title} — ${siteFallback.name}` : siteFallback.name);
// Page's own share image when set; otherwise the branded card generated for
// this page at build time (see /og/[...slug].png.ts).
// hideFromSearch: the Board can keep one page out of Google (a page that is
// only for people who have the link). It adds the robots tag below, and
// astro.config.mjs keeps the same page out of the sitemap.
const ogImage = page?.ogImage?.asset
  ? imageUrl(page.ogImage as SanityImageSource, 1200)
  : `/og/${slug}.jpg`;

// ---------------------------------------------------------------------------
// One FAQPage per page (Google's rich-result rule)
// ---------------------------------------------------------------------------
// FaqSection.astro renders the visible accordions but deliberately emits no
// JSON-LD of its own — a page with several faqSections (/faq has four) would
// otherwise ship several competing FAQPage entities, which disqualifies the
// rich result. Aggregate every faqSection's Q&As here into one script tag
// instead. The GROQ projection has already resolved BOTH sources (inline
// items and referenced faqItem docs) into a flat `items` array of
// { question, answer }, so this only has to collect. Static path (cms.ts, no
// stega), so plain string handling is safe; deEmDash + portableTextToPlain
// mirror exactly what FaqSection renders visibly (house style, plain text).
interface FaqQA {
  question?: string;
  answer?: unknown;
}
const faqPairs = (page?.sections ?? [])
  .filter((s) => s?._type === 'faqSection')
  .flatMap((s) => (s.items as FaqQA[] | undefined) ?? [])
  .map((qa) => ({
    question: qa.question ? deEmDash(qa.question) : '',
    answer: portableTextToPlain(qa.answer as never),
  }))
  .filter((qa) => qa.question && qa.answer);
const faqJsonLd =
  faqPairs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqPairs.map((qa) => ({
          '@type': 'Question',
          name: qa.question,
          acceptedAnswer: { '@type': 'Answer', text: qa.answer },
        })),
      }
    : null;

// Class pages own their brand color — DERIVED from the class documents
// (their own `color` field), matched by the same longest-prefix rule the hub
// uses, so a class the Board adds gets its accent with no code edit. Falls
// back to the shipped map for the four originals when the read fails.
const footerSeam = finalBandBg((page?.sections ?? []) as never, slug) as never;
let classAccent: string =
  slug === 'classes/twos' ? 'amber' : slug === 'classes/threes' ? 'green' : 'orange';
if (slug.startsWith('classes/')) {
  try {
    const rows = await cmsFetch<{ slug?: string; color?: string }[]>(
      `*[_type == "class" && defined(slug.current)]{ "slug": slug.current, color }`,
      {},
      [],
    );
    const pageLeaf = slug.slice('classes/'.length);
    // Longest class slug that this page's leaf is a prefix of (pre-k covers
    // pre-k-am/pm; exact match wins for twos/threes).
    const match = (rows ?? [])
      .filter((r) => r.slug && (r.slug === pageLeaf || r.slug.startsWith(`${pageLeaf}-`)))
      .sort((a, b) => (a.slug === pageLeaf ? -1 : 1) - (b.slug === pageLeaf ? -1 : 1))[0];
    if (match?.color) classAccent = match.color;
  } catch {
    /* fallback map stands */
  }
}

// Notice → hero (2026-07-19). The `noticeBarSection` used to render as a thin
// cream strip under the hero, where it read as system chrome. It now rides
// INSIDE the hero as a taped note. Content is untouched Sanity data, so the
// Board still edits the notice in the Studio; we only move where it draws.
// Only with a hero to put it in, and only the FIRST one — a page with two
// notice bars keeps the rest in the normal flow rather than silently dropping
// them. `heroSections` is what the renderer gets, so it can never draw twice.
const heroNotice = page?.hero
  ? (page?.sections ?? []).find((s: { _type?: string }) => s._type === 'noticeBarSection')
  : undefined;
const heroSections = heroNotice
  ? (page?.sections ?? []).filter((s: { _key?: string }) => s._key !== heroNotice._key)
  : page?.sections;
---

<BaseLayout
  title={title}
  description={page?.seoDescription}
  ogImage={ogImage}
  footerSeam={footerSeam}
  noindex={page?.hideFromSearch === true}
  nofollow={page?.hideFromSearch === true}
>
  {
    /* HERO_OVERRIDES: the code-owned page doctrine (src/lib/page-doctrine.ts)
      can retitle a hero while the matching Sanity patch waits on the quota —
      the Visit page leads with the visit ask instead of "take a look around".
      Stopgap; close-out registered in docs/PENDING.md. */
    page?.hero && (
      <PageHero
        hero={{ ...page.hero, ...(HERO_OVERRIDES[slug] ?? {}) }}
        notice={heroNotice}
        pageSlug={slug}
      />
    )
  }
  {
    /* Class pages own their brand color (Act II: Phase 0 found Twos-amber and
       Threes-green appeared nowhere ownable on their own pages). The wrapper
       sets --page-accent for the grammar CSS (display: contents = zero box). */
  }
  {
    slug.startsWith('classes/') ? (
      <div
        class="wcp-class-accent contents"
        style={`--page-accent: var(--color-${classAccent}); --page-accent-ink: var(--color-${classAccent}-ink)`}
      >
        <SectionRenderer
          sections={heroSections}
          site={siteData}
          pageSlug={slug}
          afterHero={Boolean(page?.hero)}
        />
      </div>
    ) : (
      <SectionRenderer
        sections={heroSections}
        site={siteData}
        pageSlug={slug}
        afterHero={Boolean(page?.hero)}
      />
    )
  }
  {
    faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
    )
  }
</BaseLayout>
