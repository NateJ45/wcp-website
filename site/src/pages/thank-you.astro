---
/* ============================================================================
   /thank-you — where the contact form lands after a no-JS submit
   ============================================================================
   (With JS the form shows an inline thank-you and never navigates here.)
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
---

<BaseLayout title={`Thank you — ${site.name}`} description="Thanks for reaching out.">
  <Hero
    title="Thank you"
    eyebrow="Message received"
    lead="Thanks for reaching out. We will be in touch soon."
    height="medium"
  />
  <Section bg="white">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-lg text-ink-muted">
        A member of our volunteer board will get back to you as soon as we can. In the meantime,
        feel free to look around.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <Button href="/" variant="accent">Back home</Button>
        <Button href="/news" variant="outline">Read our news</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
