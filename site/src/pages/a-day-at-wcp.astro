// Hero copy + each class's age/tuition line are edited in Sanity (Pages, and
// Classes for the numbers), so this page can never drift from the class pages
// or the tuition table.
const hero = await getPageHero('a-day-at-wcp');
const [twosFacts, threesFacts, amFacts, pmFacts] = await Promise.all([
  getClassFacts('class-twos'),
  getClassFacts('class-threes'),
  getClassFacts('class-pre-k-am'),
  getClassFacts('class-pre-k-pm'),
]);

