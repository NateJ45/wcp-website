---
/* ============================================================================
   /search — site search, powered by Pagefind
   ============================================================================
   Pagefind builds a static search index over dist/client after the site is
   built (see the "postbuild" npm script), then this page loads its prebuilt UI
   from /pagefind/. No server, no external service. The index only exists in a
   real build, so search doesn't work under `astro dev` — use a build to test.
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import { site } from '@/data/site';
---

{
  /* noindex: a search shell has no content of its own to rank, and Google
    treats indexable internal search pages as a spam signal. */
}
<BaseLayout
  title={`Search — ${site.name}`}
  description="Search the West Chester Preschool website."
  noindex
>
  <Hero
    title="Search"
    eyebrow="Find it fast"
    lead="Search classes, tuition, news, and everything else on the site."
    height="medium"
  />
  <Section bg="white">
    {/* data-pagefind-ignore: keep the search page itself out of the results. */}
    <div class="mx-auto max-w-2xl" data-pagefind-ignore>
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
      <div id="search" class="wcp-search"></div>
      <noscript>
        <p class="text-center text-ink-muted">Search needs JavaScript turned on.</p>
      </noscript>
    </div>
  </Section>
</BaseLayout>

<!-- data-astro-rerun: re-run on every View Transition navigation so the search
     UI mounts when arriving at /search via client-side nav, not only a full
     load. Guards below prevent loading pagefind-ui.js twice or mounting twice. -->
<script is:inline data-astro-rerun>
  (function () {
    var el = document.getElementById('search');
    if (!el) return;
    function build() {
      if (el.querySelector('.pagefind-ui__form')) return; // already mounted
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
      });
      // Pagefind's input is labelled only via `title`, which fails the WCAG
      // "visible label" check — give it a proper accessible name.
      var input = document.querySelector('#search .pagefind-ui__search-input');
      if (input) input.setAttribute('aria-label', 'Search the site');
    }
    if (window.PagefindUI) return build();
    var existing = document.querySelector('script[data-pagefind-ui]');
    if (existing) return existing.addEventListener('load', build);
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.setAttribute('data-pagefind-ui', '');
    s.onload = build;
    document.head.appendChild(s);
  })();
</script>

<style is:global>
  /* Nudge Pagefind's default UI toward the brand (navy focus ring, rounded). */
  .wcp-search .pagefind-ui__search-input {
    border-radius: 0.75rem;
  }
  .wcp-search .pagefind-ui__result-link {
    color: var(--color-navy);
  }
</style>
