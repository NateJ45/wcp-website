---
/* 404 — friendly not-found page. PLACEHOLDER copy, safe to refine. */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — West Chester Preschool" description="That page could not be found.">
  <section class="bg-grey" aria-labelledby="nf-title">
    <div class="wcp-container py-[var(--wcp-space-2xl)] text-center">
      <p class="mb-2 font-semibold uppercase tracking-widest text-sky-ink">Page not found</p>
      <h1 id="nf-title">We couldn&rsquo;t find that page.</h1>
      <p class="mx-auto mt-4 max-w-md text-ink">
        The link may be old or mistyped. Let&rsquo;s get you back on track.
      </p>
      <p class="mt-8">
        <a
          href="/"
          class="rounded-pill bg-accent px-8 py-3.5 font-bold text-accent-foreground no-underline"
        >
          Back to home
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
