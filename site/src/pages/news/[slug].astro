---
/* ============================================================================
   /news/[slug] — a single News post, statically prerendered.
   ============================================================================
   getStaticPaths reads every post slug from Sanity at build time. New posts
   go live on the next rebuild (the Sanity publish webhook triggers it), or at
   their scheduled time.
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PostArticle, { type PostDoc } from '@/components/PostArticle.astro';
import { cmsFetch } from '@/lib/cms';
import { ALL_POST_SLUGS_QUERY, POST_BY_SLUG_QUERY } from '@/lib/queries';
import { imageUrl, type SanityImageSource } from '@/lib/image';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const slugs = await cmsFetch<string[]>(ALL_POST_SLUGS_QUERY, {}, []);
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: string };
const post = await cmsFetch<PostDoc | null>(POST_BY_SLUG_QUERY, { slug }, null);

if (!post) {
  return new Response(`No post found for "${slug}"`, { status: 404 });
}

// The post's own photo when it has one, else its branded headline card.
const shareImg = post.ogImage ?? post.coverImage;
const ogImage = shareImg?.asset
  ? imageUrl(shareImg as SanityImageSource, 1200)
  : `/og/news/${slug}.jpg`;
const title = post.seoTitle ?? `${post.title} — ${site.name}`;
const description = post.seoDescription ?? post.excerpt;

// BlogPosting JSON-LD so posts are eligible for article rich results.
// `ogImage` is either an absolute Sanity CDN URL or the root-relative branded
// card — new URL() absolutizes the latter and passes the former through. The
// school Organization stands as author + publisher (posts are the school's
// voice; the byline person still shows in the visible article). dateModified
// rides Sanity's _updatedAt (any edit republish bumps it).
const canonical = new URL(`/news/${slug}`, site.url).toString();
const orgRef = { '@type': 'Organization', name: site.name, url: site.url };
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  ...(description ? { description } : {}),
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  ...(post._updatedAt ? { dateModified: post._updatedAt } : {}),
  image: new URL(ogImage, site.url).toString(),
  mainEntityOfPage: canonical,
  url: canonical,
  author: orgRef,
  publisher: {
    ...orgRef,
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site.url).toString() },
  },
};
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article">
  <PostArticle post={post} />
  <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} is:inline />
</BaseLayout>
