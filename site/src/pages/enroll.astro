---
/* ============================================================================
   Enroll page
   ============================================================================
   The primary CTA target across the site. The online enrollment FORM comes in
   a later phase (needs a form handler + spam protection); for now this is a
   real, useful page: how enrollment works, and how to reach us directly.
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import Icon from '@/components/Icon.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { getPageHero } from '@/lib/cms';

// Hero eyebrow/title/lead are edited in Sanity (Pages → Page copy → "enroll").
const hero = await getPageHero('enroll');

const steps = [
  {
    icon: 'phone',
    chip: 'sky' as const,
    title: '1. Reach out',
    body: 'Call, email, or send us a message. Tell us your child’s age and which class you are considering.',
  },
  {
    icon: 'map-pin',
    chip: 'orange' as const,
    title: '2. Schedule a tour',
    body: 'Come see the classrooms, meet the teachers, and let your child spend some time in the space.',
  },
  {
    icon: 'file-pen',
    chip: 'green' as const,
    title: '3. Complete paperwork',
    body: 'We walk you through the enrollment forms. The $100 registration fee is due now to secure your spot; the participation deposit follows at the May Gathering.',
  },
];

// What enrolling actually signs a family up for — the co-op ask, at a glance.
// Full detail lives on /co-op-life; this is the "good to know before you commit".
const goodToKnow = [
  {
    icon: 'heart-handshake',
    title: 'Help in the classroom',
    body: '1–3 times per month, alongside the teacher.',
  },
  {
    icon: 'users',
    title: 'Hold a co-op job',
    body: 'One role for the year, matched to your skills.',
  },
  {
    icon: 'shield-check',
    title: 'Complete a background check',
    body: 'Required by Ohio before your first shift.',
  },
  {
    icon: 'megaphone',
    title: 'Join in fundraising',
    body: 'At least one fundraiser a year — your pick.',
  },
  {
    icon: 'calendar-days',
    title: 'Attend four meetings',
    body: 'May Parent Conference, two info meetings, and September Orientation.',
  },
  {
    icon: 'piggy-bank',
    title: 'Pay tuition on time',
    body: 'Monthly, with an annual-payment option.',
  },
];
const phoneDigits = site.phone.replace(/[^\d]/g, '');
---

<BaseLayout
  title="Enroll — West Chester Preschool"
  description="Enroll your child at West Chester Preschool for 2026-27. Reach out to schedule a tour and we will walk you through the paperwork."
>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Now Enrolling 2026-27'}
    title={hero?.heroTitle ?? 'Let’s get your child started.'}
    lead={hero?.lead ??
      'Enrollment for 2026-27 is open. Reach out and we will schedule a tour, answer your questions, and walk you through everything.'}
  >
    <Fragment slot="actions">
      <Button href={`tel:${phoneDigits}`} variant="accent" size="lg">Call {site.phone}</Button>
      <Button href={`mailto:${site.email.general}`} variant="outline-white" size="lg"
        >Email Us</Button
      >
    </Fragment>
  </Hero>

  <Section bg="grey" labelledby="how-enroll">
    <SectionHeader
      eyebrow="How It Works"
      title="Enrolling takes three steps"
      titleId="how-enroll"
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s) => (
          <FeatureCard as="li" icon={s.icon} chip={s.chip} title={s.title}>
            {s.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  {/* Good to know — the co-op commitment, before you sign up */}
  <Section bg="white" labelledby="good-to-know">
    <SectionHeader
      eyebrow="Good to Know"
      title="What being a co-op family involves"
      titleId="good-to-know"
      lead="Enrolling at WCP means joining the co-op. Here is the commitment at a glance — it gives back far more than it asks."
    />
    <ul class="mt-12 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        goodToKnow.map((g) => (
          <li class="flex gap-4" data-reveal>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky-soft text-sky-ink">
              <Icon name={g.icon} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-base text-navy">{g.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink">{g.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-center" data-reveal>
      <a href="/co-op-life" class="font-bold text-sky-ink underline underline-offset-2">
        See everything the co-op involves
      </a>
    </p>
  </Section>

  <Section bg="grey" labelledby="reach-us">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <SectionHeader
        eyebrow="Get In Touch"
        title="Talk to a real parent volunteer"
        titleId="reach-us"
      />
      <p class="mt-4 text-lg leading-relaxed text-ink">
        We are a parent-run school and we actually reply, usually within a day or two. An online
        enrollment form is on the way. In the meantime, the fastest way to start is to call or
        email.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href={`tel:${phoneDigits}`} variant="primary" size="lg">Call {site.phone}</Button>
        <Button href={`mailto:${site.email.general}`} variant="outline" size="lg">Email Us</Button>
      </div>
      {
        /* The full address is shown as a wrapping text link rather than crammed
          into a pill button (a long, space-free email can't wrap inside a
          whitespace-nowrap pill and overflows at 320px). */
      }
      <p class="mt-4 text-ink">
        or email{' '}
        <a
          href={`mailto:${site.email.general}`}
          class="font-bold text-sky-ink underline underline-offset-2"
        >
          {site.email.general}
        </a>
      </p>
      <p class="mt-6 text-sm text-ink-muted">
        {site.address.street}, {site.address.city}, {site.address.state}
        {site.address.zip} · inside Crestview Presbyterian Church
      </p>
    </div>
  </Section>

  <CtaBanner
    title="Not sure which class fits?"
    lead="Tell us your child’s age and we will help you find the right fit, from Twos through Pre-K."
    tone="navy"
  >
    <Fragment slot="actions">
      <Button href="/classes/twos" variant="accent" size="lg">See the Classes</Button>
      <Button href="/tuition" variant="outline-white" size="lg">View Tuition</Button>
    </Fragment>
  </CtaBanner>
</BaseLayout>
