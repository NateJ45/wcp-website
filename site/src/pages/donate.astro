---
/* ============================================================================
   Donate page  — real copy from the live site
   ============================================================================
   The live site used Squarespace's donation block for checkout. That processor
   does not exist on Cloudflare/Astro yet, so online checkout is a later phase.
   Until then this page presents the impact, the transparency, and a clear
   "contact us to give today" path (treasurer email) — honest, not a dead form.
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import Faq from '@/components/faq/Faq.astro';
import FaqItem from '@/components/faq/FaqItem.astro';
import Callout from '@/components/Callout.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { getPageHero } from '@/lib/cms';

// Hero eyebrow/title/lead are edited in Sanity (Pages → Page copy → "donate").
const hero = await getPageHero('donate');

const tiers = [
  {
    icon: 'palette',
    amount: '$25',
    title: 'Classroom Supplies',
    body: 'Covers a full month of art supplies for one class — paint, paper, glue, and craft materials kids love.',
    accent: 'orange' as const,
  },
  {
    icon: 'book-open',
    amount: '$50',
    title: 'New Books',
    body: 'Adds a collection of new books to a classroom library that children read every single day.',
    accent: 'sky' as const,
  },
  {
    icon: 'puzzle',
    amount: '$100',
    title: 'Learning Materials',
    body: 'Funds sensory bins, puzzles, or manipulatives — the hands-on tools that make play-based learning work.',
    accent: 'green' as const,
  },
  {
    icon: 'star',
    amount: '$250+',
    title: 'Enrichment Programs',
    body: 'Sponsors a special event or enrichment session for all WCP children — field trips, guests, and seasonal celebrations.',
    accent: 'amber' as const,
  },
];

const moneyGoes = [
  {
    icon: 'blocks',
    chip: 'orange' as const,
    title: 'Classroom resources and supplies',
    body: 'Art materials, sensory tools, games, books, and the hands-on supplies that fill our classrooms with things for children to explore and create with.',
  },
  {
    icon: 'trees',
    chip: 'green' as const,
    title: 'Playground and facility upgrades',
    body: 'Donations help maintain and improve our outdoor play space, gym equipment, and classroom furnishings — keeping the school a safe, joyful place to learn.',
  },
  {
    icon: 'party-popper',
    chip: 'sky' as const,
    title: 'Enrichment and special events',
    body: 'Field trips, enrichment programs, seasonal celebrations, and the extra experiences that make a school year memorable for children and families alike.',
  },
  {
    icon: 'graduation-cap',
    chip: 'amber' as const,
    title: 'Teacher appreciation and development',
    body: 'Extra fundraising goes toward teacher bonuses, raises, and professional development. Our teachers are the heart of WCP and we work to show it.',
  },
  {
    icon: 'piggy-bank',
    chip: 'green' as const,
    title: 'Keeping tuition affordable',
    body: 'Donations help close the gap between tuition revenue and operating costs. The less we need to raise tuition, the more accessible WCP stays for every family.',
  },
  {
    icon: 'hand-heart',
    chip: 'orange' as const,
    title: 'Community programs',
    body: 'Support for open house events, new family orientations, and outreach that helps families discover WCP and feel at home when they arrive.',
  },
];

const moreWays = [
  {
    icon: 'building-2',
    chip: 'sky' as const,
    title: 'Business and corporate giving',
    body: 'Local businesses can sponsor classroom supplies, enrichment events, or annual fundraisers. Your business name is acknowledged in school communications. Email us to discuss partnership options.',
  },
  {
    icon: 'shopping-bag',
    chip: 'green' as const,
    title: 'In-kind donations',
    body: 'New or gently-used classroom materials, art supplies, books, games, and sensory items are always welcome. Reach out before donating so we can confirm what is most needed.',
  },
  {
    icon: 'megaphone',
    chip: 'orange' as const,
    title: 'Spread the word',
    body: 'Leave a Google or Facebook review. Share WCP posts on social media. Tell a friend who is looking for a preschool. Word-of-mouth is the most powerful support a small school can get.',
  },
];
---

<BaseLayout
  title="Donate — West Chester Preschool"
  description="Support West Chester Preschool. Every dollar goes directly toward enriching classrooms, supporting teachers, and keeping our parent-run co-op strong since 1969."
>
  <Hero
    eyebrow={hero?.eyebrow ?? 'Support West Chester Preschool'}
    title={hero?.heroTitle ?? 'Help a child’s school year shine.'}
    lead={hero?.lead ??
      'WCP has been a cornerstone of the West Chester community since 1969. Every dollar donated goes directly toward enriching classrooms, supporting teachers, and keeping our co-op strong for the families who need us most.'}
  >
    <Fragment slot="actions">
      <Button href="#give" variant="accent" size="lg">Make a Donation</Button>
      <Button href="/about" variant="outline-white" size="lg">Learn About WCP</Button>
    </Fragment>
  </Hero>

  {/* Your Impact — the tiers, with oversized amounts */}
  <Section bg="white" labelledby="impact">
    <SectionHeader
      eyebrow="Your Impact"
      title="Every gift goes straight to the classroom"
      titleId="impact"
      lead="WCP is a parent-run cooperative. There is no large administrative overhead — donations fund things families and teachers can actually see and use."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        tiers.map((t) => (
          <li data-reveal>
            <article class="flex h-full flex-col rounded-[var(--radius)] bg-white p-6 text-center shadow-sm ring-1 ring-border transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0 dark:bg-surface">
              <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-cream text-orange-ink">
                <Icon name={t.icon} class="h-7 w-7" />
              </span>
              <span class="mt-4 font-display text-4xl text-heading">{t.amount}</span>
              <h3 class="mt-1 text-lg text-heading">{t.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink">{t.body}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Make your gift — honest "coming soon" + contact-to-give */}
  <Section bg="grey" labelledby="give">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <SectionHeader eyebrow="Make Your Gift" title="Ready to support WCP?" titleId="give" />
      <p class="mt-4 leading-relaxed text-ink">
        Your donation, whatever the size, makes a real difference for the children and families in
        our community. Secure online giving is coming soon — in the meantime, we would love to help
        you give today.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button
          href={`mailto:${site.email.treasurer}?subject=Donation%20to%20WCP`}
          variant="primary"
          size="lg">Email the Treasurer</Button
        >
        <Button href={`tel:${site.phone.replace(/[^\d]/g, '')}`} variant="outline" size="lg"
          >Call {site.phone}</Button
        >
      </div>
      <ul
        class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-muted"
      >
        <li class="inline-flex items-center gap-1.5">
          <Icon name="lock" class="h-4 w-4 text-green-ink" /> Secure giving
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="heart" class="h-4 w-4 text-orange-ink" /> 100% goes to WCP
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="file-text" class="h-4 w-4 text-sky-ink" /> Receipt on request
        </li>
      </ul>
    </div>
  </Section>

  {/* Where your money goes */}
  <Section bg="white" labelledby="money-goes">
    <SectionHeader
      eyebrow="Where Your Money Goes"
      title="Transparent. Local. All for the kids."
      titleId="money-goes"
      lead="Our fundraising is managed by the WCP Vice President in coordination with the Executive Board. All spending decisions are made at open monthly board meetings where any family can attend and participate."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        moneyGoes.map((m) => (
          <FeatureCard as="li" icon={m.icon} chip={m.chip} title={m.title}>
            {m.body}
          </FeatureCard>
        ))
      }
    </ul>
  </Section>

  {/* More ways to help */}
  <Section bg="grey" labelledby="more-ways">
    <SectionHeader
      eyebrow="More Ways to Help"
      title="Not just cash — every kind of support counts"
      titleId="more-ways"
      lead="Money is helpful. But WCP also thrives on in-kind support, business partnerships, and community word-of-mouth."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        moreWays.map((m) => (
          <FeatureCard as="li" icon={m.icon} chip={m.chip} title={m.title}>
            {m.body}
          </FeatureCard>
        ))
      }
    </ul>
    <Callout tone="warm" class="mx-auto mt-8 max-w-2xl text-center">
      To discuss a business sponsorship or in-kind gift, email
      <a
        href={`mailto:${site.email.general}`}
        class="font-bold break-words text-orange-ink underline underline-offset-2"
        >{site.email.general}</a
      >.
    </Callout>
  </Section>

  {/* Donation FAQ */}
  <Section bg="white" labelledby="donate-faq">
    <SectionHeader eyebrow="Questions About Giving" title="Donation FAQ" titleId="donate-faq" />
    <Faq class="mt-10">
      <FaqItem question="Is my donation tax-deductible?">
        WCP is a nonprofit parent cooperative. We recommend speaking with your tax advisor regarding
        deductibility. For questions about our tax status or to request documentation, email {
          site.email.treasurer
        }.
      </FaqItem>
      <FaqItem question="How is my donation used?">
        All donations support WCP’s operating budget and enrichment programs. This includes
        classroom supplies, playground upkeep, teacher support, special events, and keeping tuition
        affordable for enrolled families. Spending decisions are made by the volunteer parent board
        at open monthly meetings.
      </FaqItem>
      <FaqItem question="Can I set up a recurring monthly gift?">
        Yes. Once online giving is live, our donation form will support both one-time and recurring
        monthly gifts. Monthly giving helps us plan ahead and is especially valuable for a small
        school like WCP. In the meantime, contact the treasurer to arrange recurring support.
      </FaqItem>
      <FaqItem question="Can my business make a donation or sponsorship?">
        Absolutely. We welcome business sponsorships of classroom materials, enrichment events, and
        annual fundraisers. Your support is acknowledged in school communications. Email {
          site.email.general
        } to start a conversation.
      </FaqItem>
      <FaqItem question="Will I receive a receipt for my donation?">
        Yes. A receipt is provided for every gift — keep it for your records. Email the treasurer if
        you need documentation for a specific donation.
      </FaqItem>
      <FaqItem question="I don't have children at WCP — can I still donate?">
        Of course. WCP has been part of the West Chester community since 1969. We welcome support
        from alumni families, neighbors, local businesses, and anyone who values quality early
        childhood education in our area.
      </FaqItem>
    </Faq>
  </Section>

  <CtaBanner
    title="Every gift makes a difference."
    lead="Your donation, whatever the size, makes a real difference for the children and families in our community."
    tone="navy"
  >
    <Fragment slot="actions">
      <Button
        href={`mailto:${site.email.treasurer}?subject=Donation%20to%20WCP`}
        variant="accent"
        size="lg">Make a Donation</Button
      >
      <Button href="/contact" variant="outline-white" size="lg">Contact Us</Button>
    </Fragment>
    <Fragment slot="note">Call {site.phone} · {site.email.treasurer}</Fragment>
  </CtaBanner>
</BaseLayout>
