---
/* ============================================================================
   /newsletter/archive — the public list of past newsletter issues.
   ============================================================================
   Every published newsletterIssue as a card, newest first. Statically
   prerendered; new issues appear on the next rebuild. The /newsletter page
   itself stays the sign-up landing (a page-builder page); this is the back
   catalogue linked from each issue and from the email teaser.
   ============================================================================ */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import { cmsFetch } from '@/lib/cms';
import { NEWSLETTER_LIST_QUERY } from '@/lib/queries';
import { imageUrl, type SanityImageSource, type SanityImageValue } from '@/lib/image';
import { formatDate } from '@/lib/utils';
import { site } from '@/data/site';

interface IssueCard {
  title?: string;
  slug?: string;
  publishedAt?: string;
  preheader?: string;
  coverImage?: SanityImageValue | null;
}

const issues = await cmsFetch<IssueCard[]>(NEWSLETTER_LIST_QUERY, {}, []);
---

<BaseLayout
  title={`Newsletter archive — ${site.name}`}
  description="Past issues of the West Chester Preschool family newsletter."
>
  <Section bg="white">
    <div class="mx-auto max-w-4xl">
      <SectionHeader
        as="h1"
        eyebrow="Newsletter"
        title="Past issues"
        lead="Catch up on our family newsletter, or subscribe to get the next one."
      />

      <div class="mt-6">
        <Button href="/newsletter" variant="primary" size="md">Subscribe</Button>
      </div>

      {
        issues.length === 0 ? (
          <p class="mt-10 text-ink-muted">The first issue will appear here soon.</p>
        ) : (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {issues.map((issue) => {
              const cover = issue.coverImage?.asset
                ? imageUrl(issue.coverImage as SanityImageSource, 640)
                : null;
              return (
                <li>
                  <a
                    href={`/newsletter/${issue.slug}`}
                    class="group block h-full overflow-hidden rounded-2xl border border-border bg-white shadow-sm transition-shadow hover:shadow-md dark:bg-surface"
                  >
                    {cover && (
                      <img
                        src={cover}
                        alt={issue.coverImage?.alt ?? ''}
                        loading="lazy"
                        class="aspect-[16/9] w-full object-cover"
                      />
                    )}
                    <div class="p-5">
                      <p class="text-xs font-semibold text-ink-muted">
                        {formatDate(issue.publishedAt)}
                      </p>
                      <h2 class="mt-1 font-display text-xl text-heading group-hover:text-navy dark:group-hover:text-sky">
                        {issue.title}
                      </h2>
                      {issue.preheader && (
                        <p class="mt-2 line-clamp-3 text-sm text-ink-muted">{issue.preheader}</p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </Section>
</BaseLayout>
