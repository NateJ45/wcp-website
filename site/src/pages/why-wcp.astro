---
/* ============================================================================
   Why WCP? page  (real copy, extraction Part 4)
   ============================================================================ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import StatBlock from '@/components/StatBlock.astro';
import CompareTable from '@/components/CompareTable.astro';
import SchoolYear from '@/components/SchoolYear.astro';
import TestimonialWall from '@/components/TestimonialWall.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { testimonials } from '@/data/testimonials';
import { schoolYear } from '@/data/school-year';
import outdoorExploration from '@/assets/photos/outdoor-exploration.jpg';

const reasons = [
  { icon: 'door-open', chip: 'sky' as const, title: 'You get a front-row seat', body: 'Most preschools keep parents at the door. At WCP you are in the classroom, watching your child make friends, solve problems, and grow in real time.' },
  { icon: 'piggy-bank', chip: 'green' as const, title: 'Tuition that makes sense', body: 'Starting at $70 a month, WCP is one of the most affordable preschools in West Chester. The co-op model keeps costs low without cutting corners.' },
  { icon: 'graduation-cap', chip: 'orange' as const, title: 'Teachers who know your child', body: 'Small classes and the same teachers every day. Our staff know every child by name, every quirk, every strength.' },
  { icon: 'users', chip: 'amber' as const, title: 'A community that sticks around', body: 'WCP families become actual friends who stay in touch long after their kids move on.' },
  { icon: 'award', chip: 'sky' as const, title: 'Kids leave ready for kindergarten', body: 'Our curriculum follows Ohio’s Early Learning Content Standards. By Pre-K graduation, their kindergarten teachers notice the difference.' },
  { icon: 'heart', chip: 'orange' as const, title: '55 years of doing this well', body: 'WCP has been here since 1969. Families keep coming back, often enrolling a second or third child before the first has finished.' },
];

// "Your Child's Progress" — how families always know how their child is doing.
const progress = [
  { icon: 'file-check', chip: 'sky' as const, title: 'Annual parent-teacher conferences', body: 'Threes and Pre-K families receive a formal conference each year where the teacher reviews your child’s development in detail. You can also request a conference at any time — no waiting for a scheduled slot.' },
  { icon: 'graduation-cap', chip: 'orange' as const, title: 'Early Pre-K conferences', body: 'Pre-K conferences are scheduled early in the year specifically to help families make informed decisions about kindergarten readiness or whether an additional Pre-K year would benefit their child.' },
  { icon: 'eye', chip: 'green' as const, title: 'You see it yourself', body: 'Because you help in the classroom 1–3 times a month, you do not have to wait for a conference to know how your child is doing. You watch them learn, grow, and make friends in real time.' },
];

// "How We Compare" — an honest side-by-side with a typical preschool.
const compareRows = [
  { feature: 'Parent involvement in classroom', wcp: 'Yes — 1–3× per month', typical: 'Rarely or never' },
  { feature: 'Monthly tuition (4-year-old)', wcp: 'From $175–$200', typical: 'Often $500–$1,500+' },
  { feature: 'Class size', wcp: 'Small, intentional', typical: 'Varies, often larger' },
  { feature: 'Know every classmate’s family', wcp: 'Yes', typical: 'Unlikely' },
  { feature: 'Curriculum basis', wcp: 'Ohio Early Learning Standards', typical: 'Varies by school' },
  { feature: 'Parent community', wcp: 'Built in by design', typical: 'Up to you to find' },
  { feature: 'State licensed', wcp: 'Yes, by ODJFS', typical: 'Varies' },
  { feature: 'Non-discriminatory', wcp: 'Yes, always', typical: 'Varies' },
];
---

<BaseLayout
  title="Why WCP? — West Chester Preschool"
  description="Six reasons families choose West Chester Preschool: a front-row seat in the classroom, affordable tuition, teachers who know your child, and 55 years of community."
>
  <Hero
    eyebrow="Still Comparing Schools?"
    title="Here is why families choose WCP."
    lead="We are not the biggest preschool in West Chester. We are the one families talk about for years after their kids graduate. Here is what makes the difference."
    image={outdoorExploration}
    imageAlt="A WCP teacher and a small group of children examining something together outdoors during a nature exploration activity"
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Enroll Your Child</Button>
      <Button href="/enroll" variant="outline-white" size="lg">Schedule a Tour</Button>
    </Fragment>
  </Hero>

  <Section bg="grey" labelledby="reasons">
    <SectionHeader
      eyebrow="What Sets Us Apart"
      title="Six reasons families pick WCP"
      titleId="reasons"
      lead="These are the things families tell us they wish they had known before they started looking."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((r) => (<FeatureCard as="li" icon={r.icon} chip={r.chip} title={r.title}>{r.body}</FeatureCard>))}
    </ul>
  </Section>

  {/* Stats — a "special" navy band framed by cloud seams (top here; the seam
      on the compare section below marks the exit). */}
  <Section bg="navy" seam label="West Chester Preschool by the numbers">
    <ul class="grid grid-cols-2 gap-5 lg:grid-cols-4">
      <li><StatBlock value={55} suffix="+" label="Years in West Chester">Founded in 1969 and still going strong.</StatBlock></li>
      <li><StatBlock value={4} label="Classes for ages 2-5">Twos, Threes, and Pre-K AM and PM.</StatBlock></li>
      <li><StatBlock value={70} prefix="$" label="Tuition from, per month">The co-op model keeps our tuition low.</StatBlock></li>
      <li><StatBlock value={100} suffix="%" label="Ohio licensed">Fully licensed and non-discriminatory. Every family is welcome.</StatBlock></li>
    </ul>
  </Section>

  {/* How We Compare — its top seam is the navy band's "exit" cloud. */}
  <Section bg="white" seam labelledby="compare">
    <SectionHeader
      eyebrow="How We Compare"
      title="WCP vs a typical preschool"
      titleId="compare"
      lead="An honest look at what makes the co-op model different."
    />
    <CompareTable rows={compareRows} class="mt-12" />
  </Section>

  {/* Your Child's Progress */}
  <Section bg="grey" labelledby="progress">
    <SectionHeader
      eyebrow="Your Child’s Progress"
      title="You will always know how your child is doing."
      titleId="progress"
      lead="Between ClassDojo updates, your own classroom helper days, and formal conferences, you will never feel out of the loop."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {progress.map((p) => (<FeatureCard as="li" icon={p.icon} chip={p.chip} title={p.title}>{p.body}</FeatureCard>))}
    </ul>
  </Section>

  {/* The School Year */}
  <Section bg="white" labelledby="school-year">
    <SectionHeader
      eyebrow="The School Year"
      title="A year full of things to look forward to"
      titleId="school-year"
      lead="WCP is not just classes. The school year is packed with events, celebrations, and community moments that families talk about long after their kids graduate."
    />
    <SchoolYear events={schoolYear} class="mt-12" />
  </Section>

  {/* Family Stories — the full testimonial wall */}
  <Section bg="grey" labelledby="stories">
    <SectionHeader
      eyebrow="Family Stories"
      title="Heard directly from our community"
      titleId="stories"
      lead="Real families. Real words. Not ours."
    />
    <TestimonialWall items={testimonials} class="mt-12" />
  </Section>

  <CtaBanner
    title="Come see it for yourself."
    lead="The best way to know if WCP is right for your family is to walk through the door. Meet the teachers, see the classrooms, and let your child spend time in the space."
  >
    <Fragment slot="actions">
      <Button href="/enroll" variant="accent" size="lg">Schedule a Tour</Button>
      <Button href="/tuition" variant="outline-white" size="lg">View Tuition</Button>
    </Fragment>
    <Fragment slot="note">Call {site.phone} or email {site.email.general}</Fragment>
  </CtaBanner>
</BaseLayout>
