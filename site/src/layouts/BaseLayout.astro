---
/* ============================================================================
   Base Layout — the shell every public page renders inside
   ============================================================================
   FOUNDATION, edit with care. Owns the <head> (SEO, Open Graph, fonts,
   analytics), the page landmarks (header / main / footer), and the sitewide
   scripts. Page content goes in the <slot /> inside <main>.
   ============================================================================ */
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@/components/Analytics.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HubRail from '@/components/hub/HubRail.astro';
import HubTopBar from '@/components/hub/HubTopBar.astro';
import HubFooter from '@/components/hub/HubFooter.astro';
import ClosureBanner from '@/components/ClosureBanner.astro';
import { site } from '@/data/site';
import { getClosureAlert } from '@/lib/cms';

interface Props {
  /** Browser tab + Open Graph title. Required so no page ships untitled. */
  title: string;
  /** Meta description + OG description. Falls back to the site tagline. */
  description?: string;
  /** Absolute or root-relative OG image. Defaults to the sitewide card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /**
   * Which chrome to render. 'site' = the public marketing header/footer
   * (default). 'hub' = the dedicated Family Hub header/footer (its own nav,
   * one link back to the public site). Used by HubShell for gated pages.
   */
  chrome?: 'site' | 'hub';
  /** Current page title, shown in the mobile HubTopBar when chrome='hub'. */
  hubTitle?: string;
}

const {
  title,
  description = site.tagline,
  ogImage,
  ogType = 'website',
  chrome = 'site',
  hubTitle = 'Family Hub',
} = Astro.props;

// Absolute canonical + OG URLs (Astro.url resolves per-page at build time).
// Every page gets a share card: the page's own og image (a post's cover, a
// page's SEO image) when set, otherwise the branded hero poster as a sitewide
// default — so a link to any page shows a real image on social/chat, never a
// blank card.
const DEFAULT_OG_IMAGE = '/hero/wcp-hero-poster.webp';
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG_IMAGE, site.url).toString();

// Site-wide alert (snow days / urgent notices). null unless the Alert singleton
// is active with a message — baked in at build, so it appears/clears on the
// next rebuild after Publish.
const closureAlert = await getClosureAlert();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets full-bleed sections run into a phone's notch;
         .wcp-container adds safe-area padding so content never hides under it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#01457E" />

    <!-- View Transitions: smooth cross-page navigation (a soft cross-fade by
         default). Scripts re-init on `astro:page-load` (see src/scripts/*). The
         built-in fallback animates even in browsers without native VT support,
         and a visitor with prefers-reduced-motion gets an instant swap, no
         animation — so the a11y contract is preserved. -->
    <ClientRouter />
    <meta name="view-transition" content="same-origin" />

    <!-- View-transition load tracker. Runs before the deferred module scripts,
         so it reliably records the router's page-load lifecycle for the CURRENT
         view: `.loaded` is true once astro:page-load has fired and is cleared at
         the start of each navigation. src/scripts/_page-load.ts reads it so a
         late-registering script still initializes on first paint without
         double-running during a navigation. -->
    <script is:inline>
      window.__wcpVT = { loaded: false };
      document.addEventListener('astro:before-swap', function () {
        window.__wcpVT.loaded = false;
      });
      document.addEventListener('astro:page-load', function () {
        window.__wcpVT.loaded = true;
      });
    </script>

    <!-- Open Graph + Twitter card for rich link previews. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Google Ads tag + search-console verification (env-driven, see component). -->
    <Analytics />

    <!-- Preload the display font used by the LCP heading. crossorigin is
         required on font preloads or the browser fetches the file twice. Only
         the regular weight is preloaded; bold/italic load on demand. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/captain-comic-regular.woff2"
      crossorigin
    />

    <!-- Mark that JS is running BEFORE first paint, so the scroll-reveal
         hidden-state (scoped to .js in globals.css) only applies when JS can
         un-hide it. Without JS the class is absent and all content stays
         visible. is:inline keeps it out of the bundle so it runs first.

         Same script also applies a saved dark-mode choice before paint, so
         there's no flash of the wrong theme. Light is the default: a visitor
         who has never toggled has nothing in localStorage and stays light,
         on every visit, forever — only an explicit click (src/scripts/theme.ts)
         ever writes a preference. Deliberately does NOT check
         prefers-color-scheme; "light by default" was an explicit choice, not
         an oversight. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('wcp-theme') === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = 'dark';
      }
    </script>
  </head>

  <body class="relative">
    <!-- Skip link: first focusable element, hidden until focused, then jumps
         keyboard/screen-reader users straight to the page content. Sits above
         the overlay header (z-50) so it's never hidden behind it. -->
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-navy focus-visible:px-4 focus-visible:py-2 focus-visible:font-semibold focus-visible:text-white"
    >
      Skip to main content
    </a>

    {closureAlert && <ClosureBanner alert={closureAlert} />}

    <!-- body is `relative` so the big header's absolute overlay (Header.astro,
         `data-big-header`) positions against the full document, not just the
         viewport — it scrolls away naturally with the page instead of
         behaving like `fixed`. The hub renders its own chrome: a sticky left
         rail on desktop, a top bar + off-canvas drawer on mobile. -->
    {
      chrome === 'hub' ? (
        <div class="flex min-h-screen">
          <aside class="sticky top-0 hidden h-screen w-56 shrink-0 overflow-y-auto lg:block">
            <HubRail />
          </aside>

          {/* Mobile off-canvas drawer + backdrop (hidden ≥ lg). */}
          <div id="hub-drawer-backdrop" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" />
          <aside
            id="hub-drawer"
            aria-hidden="true"
            class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto shadow-xl transition-transform duration-200 motion-reduce:transition-none lg:hidden"
          >
            <HubRail />
          </aside>

          <div class="flex min-w-0 flex-1 flex-col">
            <HubTopBar title={hubTitle} />
            {
              /* data-pagefind-body: site search (Pagefind) indexes only the main
                content of real pages, not the header/footer chrome — and because
                the marker exists, pages without it (the Studio SPA shell) are
                skipped entirely. */
            }
            <main id="main" tabindex="-1" data-pagefind-body class="flex-1">
              <slot />
            </main>
            <HubFooter />
          </div>
        </div>
      ) : (
        <>
          <Header />
          <main id="main" tabindex="-1" data-pagefind-body>
            <slot />
          </main>
          <Footer />
        </>
      )
    }

    <!-- Scroll-reveal observer (own module — Astro dev doesn't reliably
         re-execute an inline layout <script>, so this is imported like the
         other client scripts). Re-runs on every ClientRouter navigation. -->
    <script>
      import '@/scripts/reveal';
      import '@/scripts/hub-drawer';
      import '@/scripts/theme';
    </script>
  </body>
</html>
