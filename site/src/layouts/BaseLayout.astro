---
/* ============================================================================
   Base Layout — the shell every public page renders inside
   ============================================================================
   FOUNDATION, edit with care. Owns the <head> (SEO, Open Graph, fonts,
   analytics), the page landmarks (header / main / footer), and the sitewide
   scripts. Page content goes in the <slot /> inside <main>.
   ============================================================================ */
import '../styles/globals.css';
import Analytics from '@/components/Analytics.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TourPill from '@/components/TourPill.astro';
import HubRail from '@/components/hub/HubRail.astro';
import HubTopBar from '@/components/hub/HubTopBar.astro';
import HubTabBar from '@/components/hub/HubTabBar.astro';
import HubSearch from '@/components/hub/HubSearch.astro';
import ClosureBanner from '@/components/ClosureBanner.astro';
import AnnouncementBars from '@/components/AnnouncementBars.astro';
import AnnouncementModal from '@/components/AnnouncementModal.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import StructuredData from '@/components/StructuredData.astro';
import { site } from '@/data/site';
import { getClosureAlert, getAnnouncements } from '@/lib/cms';
// Fixed emblem watermark behind the hub canvas (plain <img> src via a pre-sized
// webp; a bg-image data-URI would bloat the CSS).
import wcpEmblem from '@/assets/brand/wcp-emblem-sm.webp';

interface Props {
  /** Browser tab + Open Graph title. Required so no page ships untitled. */
  title: string;
  /** Meta description + OG description. Falls back to the site tagline. */
  description?: string;
  /** Absolute or root-relative OG image. Defaults to the sitewide card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /**
   * Which chrome to render. 'site' = the public marketing header/footer
   * (default). 'hub' = the dedicated Family Hub header/footer (its own nav,
   * one link back to the public site). Used by HubShell for gated pages.
   */
  chrome?: 'site' | 'hub';
  /** Current page title, shown in the mobile HubTopBar when chrome='hub'. */
  hubTitle?: string;
  /**
   * Emit <meta name="robots" content="noindex"> — for public utility pages
   * (/search) that crawlers can reach but should never rank. The preview
   * surfaces carry their own tag (PreviewLayout) and the gated hub is covered
   * by robots.txt; this prop is for pages that render inside THIS layout.
   */
  noindex?: boolean;
  /**
   * RSS autodiscovery link for feed-bearing pages (the News index pages point
   * readers at /news/rss.xml). A PROP instead of a named head slot on purpose:
   * a <slot> inside <head> breaks the Astro prettier plugin's parse of the
   * whole file (hit 2026-07-17), and head extras stay auditable in one place.
   */
  rssFeed?: { href: string; title: string };
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  chrome = 'site',
  hubTitle = 'Family Hub',
  noindex = false,
  rssFeed,
} = Astro.props;

// Absolute canonical + OG URLs (Astro.url resolves per-page at build time).
// Every page gets a share card: the page's own og image (a post's cover, a
// page's SEO image) when set, otherwise a branded card generated at build
// time (/og/*.png, see src/pages/og/[...slug].png.ts) — so a link to any
// page shows a real branded image on social/chat, never a blank card.
const DEFAULT_OG_IMAGE = '/og/default.jpg';
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG_IMAGE, site.url).toString();

// `||` (not a destructuring default): Sanity returns NULL for an unset
// seoDescription, and null bypasses a `= default` — which shipped every
// page-builder page with an empty meta description until the 2026-07 audit.
const metaDescription = description || site.tagline;

// Site-wide alert (snow days / urgent notices). null unless the Alert singleton
// is active with a message — baked in at build, so it appears/clears on the
// next rebuild after Publish.
const closureAlert = await getClosureAlert();

// Board-managed announcement bars + popups (public site only). Placement and
// time-window are resolved in the components/scripts; the fetch never throws.
const announcements = chrome === 'site' ? await getAnnouncements() : [];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets full-bleed sections run into a phone's notch;
         .wcp-container adds safe-area padding so content never hides under it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      rssFeed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          href={rssFeed.href}
          title={rssFeed.title}
        />
      )
    }

    <!-- Every photo on the site serves from Sanity's CDN; warming the
         connection here saves DNS+TLS setup (~100-300ms on mobile) before the
         first image request. Plain preconnect on purpose: <img> fetches are
         no-cors, so a crossorigin preconnect would open the WRONG connection
         pool and be wasted. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#01457E" />

    <!-- Navigation architecture (2026-07 performance pass): NATIVE
         cross-document View Transitions + Speculation Rules prerendering,
         replacing Astro's <ClientRouter />. Every navigation is a real
         document load again, which is exactly what lets Chrome/Edge fully
         PRERENDER the next public page on hover — a click then activates an
         already-rendered page (0ms perceived). Safari/Firefox ignore the
         rules and ride Astro's prefetch instead; Chrome+Safari both get the
         soft cross-fade from the `@view-transition` rule in globals.css
         (reduced-motion users get an instant swap — see that block).
         Per-page scripts run per document now; src/scripts/_page-load.ts
         keeps the onPageLoad/onBeforeSwap API every script already uses. -->
    {
      chrome === 'site' && (
        <script
          type="speculationrules"
          is:inline
          set:html={JSON.stringify({
            // Public marketing pages only: they're static files, so a
            // prerender costs one cached asset fetch. SSR surfaces (hub,
            // api, preview, studio) are excluded — prerendering those would
            // burn Worker time (and, for the hub, hit gated routes).
            prerender: [
              {
                where: {
                  and: [
                    { href_matches: '/*' },
                    { not: { href_matches: '/family-hub/*' } },
                    { not: { href_matches: '/api/*' } },
                    { not: { href_matches: '/studio/*' } },
                    { not: { href_matches: '/preview/*' } },
                    { not: { href_matches: '*.pdf' } },
                    { not: { selector_matches: '[download]' } },
                  ],
                },
                eagerness: 'moderate',
              },
            ],
          })}
        />
      )
    }

    <!-- Open Graph + Twitter card for rich link previews. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content={site.name} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Preschool (LocalBusiness) JSON-LD — public pages only; the gated hub
         is noindex territory and needs no search-engine hints. -->
    {chrome === 'site' && <StructuredData />}

    <!-- Google Ads tag + search-console verification (env-driven, see component). -->
    <Analytics />

    <!-- Preload the display font used by the LCP heading. crossorigin is
         required on font preloads or the browser fetches the file twice. Only
         the regular weight is preloaded; bold/italic load on demand. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/captain-comic-regular.woff2"
      crossorigin
    />

    <!-- Mark that JS is running BEFORE first paint, so the scroll-reveal
         hidden-state (scoped to .js in globals.css) only applies when JS can
         un-hide it. Without JS the class is absent and all content stays
         visible. is:inline keeps it out of the bundle so it runs first.

         Same script also applies a saved dark-mode choice before paint, so
         there's no flash of the wrong theme. Light is the default: a visitor
         who has never toggled has nothing in localStorage and stays light,
         on every visit, forever — only an explicit click (src/scripts/theme.ts)
         ever writes a preference. Deliberately does NOT check
         prefers-color-scheme; "light by default" was an explicit choice, not
         an oversight. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('wcp-theme') === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = 'dark';
      }
      // Apply the saved hub-rail collapsed state before paint (no flash of the
      // wide rail). Only the desktop rail (.hub-rail-aside) reads this.
      if (localStorage.getItem('wcp-rail') === 'collapsed') {
        document.documentElement.setAttribute('data-rail-collapsed', '');
      }
    </script>
  </head>

  {
    /* wcp-site-paper (public only): scopes the construction-paper texture layer
      to the marketing site's warm bands (globals.css "Public paper texture"),
      keeping the hub's own .wcp-hub-canvas the single texture owner there. */
  }
  <body class:list={['relative', chrome === 'site' && 'wcp-site-paper']}>
    <!-- Skip link: first focusable element, hidden until focused, then jumps
         keyboard/screen-reader users straight to the page content. Sits above
         the overlay header (z-50) so it's never hidden behind it. -->
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-navy focus-visible:px-4 focus-visible:py-2 focus-visible:font-semibold focus-visible:text-white"
    >
      Skip to main content
    </a>

    {closureAlert && <ClosureBanner alert={closureAlert} />}
    {
      chrome === 'site' && announcements.length > 0 && (
        <AnnouncementBars announcements={announcements} currentPath={currentPath} />
      )
    }

    <!-- body is `relative` so the big header's absolute overlay (Header.astro,
         `data-big-header`) positions against the full document, not just the
         viewport — it scrolls away naturally with the page instead of
         behaving like `fixed`. The hub renders its own chrome: a sticky left
         rail on desktop, a top bar + off-canvas drawer on mobile. -->
    {
      chrome === 'hub' ? (
        <div class="flex min-h-screen bg-grey">
          {/* Disable cross-document view transitions on the HUB only. A VT
              freezes the outgoing page as a non-interactive snapshot for the
              whole SSR load (~1s), so clicks don't register until the next page
              arrives. Plain navigation keeps the current page live + clickable
              during the load, so families can click through as fast as they
              like. This inline rule is later in the cascade than globals.css's
              `@view-transition { navigation: auto }`, so `none` wins here;
              public pages (no override) keep their cross-fade. */}
          <style is:inline set:html="@view-transition { navigation: none; }" />
          {/* The rail floats as a lifted panel: the aside carries a small
              gutter (p-2) on the grey canvas, and the inner wrapper rounds +
              shadows the navy so it reads as separated from the content (and no
              navy bleeds below it on tall pages — the container is bg-grey).
              overflow-hidden on the wrapper (not auto): HubRail's nav owns the
              scrolling (its min-h-0 middle), so the logo and Sign out stay
              pinned. The collapse widths in globals.css include this gutter. */}
          {/* shadow-xl lifts the navy off the light canvas; in dark mode the
              shadow reads as a hard black halo around the panel (there's nothing
              lighter for it to lift OFF of), so drop it there — the navy sits
              flush and blends with the dark dashboard bg. */}
          <aside class="hub-rail-aside sticky top-0 hidden h-screen shrink-0 p-2 lg:block">
            <div class="h-full overflow-hidden rounded-2xl shadow-xl dark:shadow-none">
              <HubRail collapsible />
            </div>
          </aside>

          {/* Mobile off-canvas drawer + backdrop (hidden ≥ lg). */}
          <div id="hub-drawer-backdrop" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" />
          {/* `inert` + aria-hidden while closed: the off-canvas drawer is
              rendered (translated offscreen) at mobile widths, and an
              aria-hidden container with focusable links fails axe
              (aria-hidden-focus) — inert removes them from the focus order.
              hub-drawer.ts toggles both attributes together. */}
          <aside
            id="hub-drawer"
            aria-hidden="true"
            inert
            class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto shadow-xl transition-transform duration-200 motion-reduce:transition-none lg:hidden"
          >
            <HubRail />
          </aside>

          {/* Content column IS the app canvas: bg-grey plus the construction-
              paper texture (grain + hand-drawn doodles — see globals.css
              "Hub canvas texture"), so short pages don't show a mismatched
              empty band under the content. No footer — the hub is an app
              surface, not a marketing page. */}
          <div class="wcp-hub-canvas flex min-w-0 flex-1 flex-col bg-grey">
            {/* Ambient brand-wash: three soft glows drifting slowly under every
                card so the hub surface breathes instead of sitting flat once
                loaded. Fixed + transform-only + aria-hidden; reduced-motion
                users get it perfectly still (see .wcp-hub-wash in globals.css). */}
            <div class="wcp-hub-wash" aria-hidden="true">
              <span class="wash-a" />
              <span class="wash-b" />
              <span class="wash-c" />
            </div>
            {/* Fixed emblem watermark: stays put as the page scrolls, sits above
                the paper texture but below every card (z-index handled in
                globals.css). Purely decorative. The plate is a page-grey disc
                one layer beneath the emblem that fills the mark's own
                transparent gaps with the canvas colour, so the hand-drawn
                doodles don't read THROUGH the emblem. Separate element on
                purpose: the emblem is at 5% opacity, so a child/pseudo would
                inherit that and couldn't occlude anything. */}
            <div class="wcp-hub-emblem-plate" aria-hidden="true" />
            <div
              class="wcp-hub-emblem"
              style={`background-image: url('${wcpEmblem.src}')`}
              aria-hidden="true"
            />
            <HubTopBar title={hubTitle} />
            {/* data-pagefind-body: site search (Pagefind) indexes only the main
                content of real pages, not the header/footer chrome — and because
                the marker exists, pages without it (the Studio SPA shell) are
                skipped entirely. */}
            {/* pb clears the fixed bottom tab bar on phones (+ safe area). */}
            <main
              id="main"
              tabindex="-1"
              data-pagefind-body
              class="flex-1 pb-[calc(3.5rem+env(safe-area-inset-bottom))] md:pb-0"
            >
              <slot />
            </main>
            <HubTabBar />
            <HubSearch />
          </div>
        </div>
      ) : (
        <>
          <Header />
          <main id="main" tabindex="-1" data-pagefind-body>
            <slot />
          </main>
          <Footer />
          {/* The pinned tour invitation: mobile floating CTA between hero and
              footer (Act II conversion doctrine). Public marketing chrome only. */}
          <TourPill />
          {announcements.length > 0 && (
            <AnnouncementModal announcements={announcements} currentPath={currentPath} />
          )}
          <CookieConsent />
        </>
      )
    }

    <!-- Scroll-reveal observer (own module — Astro dev doesn't reliably
         re-execute an inline layout <script>, so this is imported like the
         other client scripts). Re-runs on every ClientRouter navigation. -->
    <script>
      import '@/scripts/reveal';
      import '@/scripts/consent';
      import '@/scripts/hub-drawer';
      import '@/scripts/hub-rail';
      import '@/scripts/theme';
      import '@/scripts/my-class';
      import '@/scripts/hub-fresh';
      import '@/scripts/hub-menus';
      import '@/scripts/hub-store';
      import '@/scripts/wcp-email-copy';
      import '@/scripts/hub-page-links';
    </script>
  </body>
</html>
