---
/* ============================================================================
   PreviewLayout — Studio-only shell for /preview/* pages
   ============================================================================
   Deliberately NOT BaseLayout: skips Analytics, canonical/OG tags, and hub-
   chrome branching, none of which belong on a draft-content page only the
   Presentation Tool's iframe ever loads. `noindex, nofollow` is non-negotiable
   here — these pages must never appear in search results.

   Reuses the same Header/Footer components the public site uses so preview
   pages visually match production. `linkBase="/preview"` is threaded into the
   chrome so nav/logo/CTA links stay inside the preview (clicking "About" goes
   to /preview/about, keeping the editor in Presentation, not bouncing to the
   published page). Header/Footer read published site settings/menus via the
   build-time client — the page CONTENT in the slot is what's draft-aware.
   ============================================================================ */
import '../styles/globals.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import VisualEditingOverlay from '@/components/preview/VisualEditingOverlay.tsx';
import { docEditAttr } from '@/lib/preview-edit-attr';

interface Props {
  title: string;
  draftMode: boolean;
  /** Doc id this preview renders (e.g. "page-classes-twos"), for auto-refresh. */
  pageId: string;
  /** 'bare' skips the public Header/Footer — the hub preview uses it, since
      wrapping gated hub content in the marketing chrome reads as the wrong
      site (and the transparent header expects a hero underneath it). */
  chrome?: 'public' | 'bare';
}
const { title, draftMode, pageId, chrome = 'public' } = Astro.props;

// The WordPress-template-part gesture (2026-08-28): the chrome is an editable
// surface. In Edit mode the overlay outlines header and footer; a click opens
// the owning document in the edit panel — header → the Menus doc at mainNav,
// footer → Site settings (its contact/identity content).
const headerAttr = docEditAttr('navigation', 'navigation', 'mainNav');
const footerAttr = docEditAttr('siteSettings', 'siteSettings', 'name');
---

<!doctype html>
<html lang="en" data-draft={draftMode ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline>
      // Before paint: mark whether this preview page is EMBEDDED in the Studio's
      // Presentation iframe (2026-08-27, same fix as presacademy). The "Exit
      // preview" button hides when embedded: inside Presentation it clears the
      // draft cookie and strands the iframe on the live site with no Studio
      // connection. The way out of Presentation is Presentation's own chrome.
      // A page rendering embedded WITHOUT draft mode shows a reconnect hint.
      if (window.self !== window.top) {
        document.documentElement.classList.add('in-studio-frame');
        if (document.documentElement.dataset.draft !== '1') {
          document.documentElement.classList.add('preview-disconnected');
        }
      }
    </script>
    <style>
      .in-studio-frame [data-exit-preview] {
        display: none;
      }
      [data-reconnect-hint] {
        display: none;
      }
      .in-studio-frame.preview-disconnected [data-reconnect-hint] {
        display: block;
      }
    </style>
  </head>
  <body class="relative">
    {
      chrome === 'public' && (
        <div data-sanity={headerAttr}>
          <Header linkBase="/preview" />
        </div>
      )
    }
    <p
      data-reconnect-hint
      class="border-b border-black/10 bg-cream px-4 py-2 text-center text-sm font-semibold text-ink"
    >
      Draft session ended — reload the Studio browser tab to reconnect the preview.
    </p>
    <main id="main"><slot /></main>
    {
      chrome === 'public' && (
        <div data-sanity={footerAttr}>
          <Footer linkBase="/preview" />
        </div>
      )
    }

    {
      draftMode && (
        <>
          <VisualEditingOverlay client:only="react" pageId={pageId} />
          <a
            href="/api/draft-mode/disable"
            data-exit-preview
            class="fixed right-4 bottom-4 z-50 rounded-full bg-navy px-4 py-2 text-sm font-bold text-white shadow-lg hover:bg-heading"
          >
            Exit preview
          </a>
        </>
      )
    }

    <script>
      // =======================================================================
      // Keep clicks INSIDE the preview surface (2026-08-26)
      // =======================================================================
      // linkBase covers the Header/Footer, but SECTION BODIES are full of real
      // links (action buttons, CTA bands, card links). Left alone, clicking one
      // navigates the Presentation iframe to the LIVE page, which has no Studio
      // connection: the URL bar, the page navigator, and the edit panel all
      // silently freeze on the previous page while the iframe shows production.
      // (Found on the presacademy site by an editor; the same hole existed
      // here.)
      //
      // Same-origin links with a preview equivalent are remapped into
      // /preview/* (the visual-editing history adapter then reports the new
      // location, so the navigator and the edit panel follow the click). Links
      // with no preview route (files, /api, /studio, external origins) open in
      // a NEW TAB so the preview surface is never hijacked. Route map:
      //   /               -> /preview
      //   /news/<slug>    -> /preview/news/<slug>       (post preview route)
      //   /family-hub/... -> /preview/family-hub/...    (hub preview route)
      //   /<page slug>    -> /preview/<page slug>       (multi-segment slugs ok)
      document.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const anchor = (event.target as Element | null)?.closest?.('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) return;
          if (anchor.target === '_blank' || anchor.hasAttribute('download')) return;

          const embedded = document.documentElement.classList.contains('in-studio-frame');
          // EDIT MODE (2026-08-28, editor feedback on presacademy): while
          // Presentation's Edit toggle is ON, the visual-editing overlay keeps
          // its outline boxes ([data-sanity-overlay-element]) in the DOM. In
          // that mode EVERY click is a selection gesture - buttons with
          // preview equivalents included - so suppress ALL navigation and let
          // the overlay's selection be the whole result. With Edit toggled
          // OFF the boxes are gone and clicks browse normally (remap below).
          if (embedded && document.querySelector('[data-sanity-overlay-element]')) {
            event.preventDefault();
            return;
          }
          const url = new URL(anchor.href, window.location.href);
          if (url.origin !== window.location.origin) {
            event.preventDefault();
            // Embedded in the Studio, a click is an EDIT gesture (2026-08-28,
            // editor feedback on presacademy): suppress, never pop a tab.
            if (!embedded) window.open(url.href, '_blank', 'noopener');
            return;
          }
          const path = url.pathname.replace(/\/+$/, '') || '/';
          const first = path === '/' ? '' : path.split('/')[1];
          // Already in preview, an API/Studio path, or a same-page hash: default.
          if (path.startsWith('/preview') || first === 'api' || first === 'studio') return;
          if (path === window.location.pathname && url.hash) return;
          // A real file (pdf, image, ics...) has no preview: new tab when
          // standalone, suppressed when embedded (edit gesture).
          if (/\.[a-z0-9]+$/i.test(path.split('/').pop() ?? '')) {
            event.preventDefault();
            if (!embedded) window.open(url.href, '_blank', 'noopener');
            return;
          }

          // Everything else on this site is a previewable document: the page
          // builder's catch-all covers page slugs (slashes preserved), and
          // news/family-hub have dedicated preview routes at the same subpath.
          event.preventDefault();
          window.location.assign(path === '/' ? '/preview' : `/preview${path}`);
        },
        true,
      );
    </script>
  </body>
</html>
