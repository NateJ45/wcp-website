---
/* ============================================================================
   PreviewLayout — Studio-only shell for /preview/* pages
   ============================================================================
   Deliberately NOT BaseLayout: skips Analytics, canonical/OG tags, and hub-
   chrome branching, none of which belong on a draft-content page only the
   Presentation Tool's iframe ever loads. `noindex, nofollow` is non-negotiable
   here — these pages must never appear in search results.

   Reuses the same Header/Footer components the public site uses so preview
   pages visually match production. `linkBase="/preview"` is threaded into the
   chrome so nav/logo/CTA links stay inside the preview (clicking "About" goes
   to /preview/about, keeping the editor in Presentation, not bouncing to the
   published page). Header/Footer read published site settings/menus via the
   build-time client — the page CONTENT in the slot is what's draft-aware.
   ============================================================================ */
import '../styles/globals.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import VisualEditingOverlay from '@/components/preview/VisualEditingOverlay.tsx';

interface Props {
  title: string;
  draftMode: boolean;
  /** Doc id this preview renders (e.g. "page-classes-twos"), for auto-refresh. */
  pageId: string;
}
const { title, draftMode, pageId } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="relative">
    <Header linkBase="/preview" />
    <main id="main"><slot /></main>
    <Footer linkBase="/preview" />

    {
      draftMode && (
        <>
          <VisualEditingOverlay client:only="react" pageId={pageId} />
          <a
            href="/api/draft-mode/disable"
            class="fixed right-4 bottom-4 z-50 rounded-full bg-navy px-4 py-2 text-sm font-bold text-white shadow-lg hover:bg-heading"
          >
            Exit preview
          </a>
        </>
      )
    }
  </body>
</html>
