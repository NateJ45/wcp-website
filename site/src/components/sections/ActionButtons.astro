---
/* Renders an actionButton[] array as Button components (hero + CTA rows). */
import Button from '@/components/ui/Button.astro';
import { linkHref, isExternal, type ActionData } from './section-helpers';

interface Props {
  actions?: ActionData[];
  linkBase?: string;
  size?: 'sm' | 'lg';
  /** Background the buttons sit on. On 'navy', the navy fills (accent/primary)
   *  and outlines are remapped to navy-visible variants so a button is never
   *  invisible-until-hover on a navy CTA band. 'amber' is the drench closer:
   *  navy-fill buttons carry, orange 'accent' would vanish on amber. */
  tone?: 'navy' | 'cream' | 'amber' | 'sky';
}
const { actions = [], linkBase = '', size = 'lg', tone } = Astro.props;

// On a navy band, swap the fills/outlines that vanish against navy.
const forNavy: Record<string, string> = {
  accent: 'on-navy',
  primary: 'on-navy',
  ghost: 'outline-white',
  outline: 'outline-white',
};
// On a light (cream) band, swap the white outlines/on-navy fills that were
// authored for the old dark full-bleed hero — a white outline is invisible on
// cream. Used by the framed living-photograph hero, whose actions were seeded
// for the dark layout.
const forCream: Record<string, string> = {
  'outline-white': 'outline',
  'on-navy': 'accent',
  ghost: 'outline',
};
// On the amber drench: orange 'accent' fills vanish into the amber, white
// outlines wash out — everything strong maps to the navy fill (9.75 on white
// label, and navy-on-amber edges read crisply), secondary styles to the
// white-bg navy outline.
// On the sky closer: navy-fill primaries (white label, 9.75:1) and navy
// outlines — amber/orange never carries text here (Nathan's call, 2026-07-19).
const forSky: Record<string, string> = {
  accent: 'primary',
  'on-navy': 'primary',
  'outline-white': 'outline',
  ghost: 'outline',
};
const forAmber: Record<string, string> = {
  accent: 'primary',
  'on-navy': 'primary',
  'outline-white': 'outline',
  ghost: 'outline',
};
const variantFor = (style?: string) => {
  const s = style ?? 'accent';
  if (tone === 'navy') return forNavy[s] ?? s;
  if (tone === 'cream') return forCream[s] ?? s;
  if (tone === 'amber') return forAmber[s] ?? s;
  if (tone === 'sky') return forSky[s] ?? s;
  return s;
};
---

{
  actions.map((a) => {
    const href = linkHref(a, linkBase);
    const ext = isExternal(href);
    return (
      <Button
        href={href}
        variant={variantFor(a.style) as never}
        size={size}
        class="whitespace-nowrap"
        {...(ext ? { target: '_blank', rel: 'noopener' } : {})}
      >
        {a.label}
      </Button>
    );
  })
}
