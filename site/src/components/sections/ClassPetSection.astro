---
/* ============================================================================
   ClassPetSection — the class-pet blurb + photo on a class handbook
   ============================================================================
   WHY THIS EXISTS INSTEAD OF `splitMediaSection` (the normal "image + text"
   section): that bridge renders its photo through <SanityImage>, which needs an
   asset UPLOADED to Sanity — and uploads are writes, which the plan quota has
   blocked since 2026-07-15 (docs/PENDING.md). So the photo ships as a committed
   pre-sized webp instead.

   The image is a plain <img> with explicit width/height on purpose: these class
   pages are `prerender = false`, and on SSR routes the Cloudflare adapter's
   image optimization is compile-time only, so `astro:assets <Image>` would pass
   the ORIGINAL file through at full size (the CLAUDE.md gotcha that once served
   a 4.1MB logo into a 38px slot). `kit-the-kat-sm.webp` is a 900x506 copy sized
   to what actually renders. The camera original is deliberately NOT in the repo
   (see .gitignore): this repo is public, the photo shows an identifiable child,
   and this page sits behind the family login. Regenerate from the original with
   sharp if it is ever needed at another size.

   >>> TEMPORARY. When the Sanity quota is back, run
       scripts/patch-twos-class-pet.mjs, upload the photo in the Studio, and
       delete this component + its HubSectionedBody case + the stopgap. <<<
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import kitPhoto from '@/assets/photos/kit-the-kat-sm.webp';

interface Props {
  section: {
    _key?: string;
    background?: 'white' | 'grey' | 'cream' | 'navy';
    header?: { title?: string };
    body?: string;
    alt?: string;
  };
}
const { section } = Astro.props;
const titleId = section.header?.title ? `sec-${section._key}` : undefined;
---

<Section bg={section.background ?? 'white'} labelledby={titleId}>
  <div class="grid items-center gap-8 md:grid-cols-2" data-reveal>
    <div class="overflow-hidden rounded-[var(--radius)] shadow-sm">
      <img
        src={kitPhoto.src}
        width={kitPhoto.width}
        height={kitPhoto.height}
        alt={section.alt ?? ''}
        class="h-auto w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      {
        section.header?.title && (
          <SectionHeader title={section.header.title} titleId={titleId} align="left" class="mb-4" />
        )
      }
      {section.body && <p class="text-ink">{section.body}</p>}
    </div>
  </div>
</Section>
