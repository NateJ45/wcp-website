---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScheduleTimeline from '@/components/ScheduleTimeline.astro';
import { emphasisHtml } from '@/lib/emphasis';
import {
  titleIdFor,
  eyebrowTone,
  bandSize,
  type SectionData,
  headerLeadHtml,
} from './section-helpers';

interface Entry {
  time?: string;
  timePm?: string;
  title: string;
  description?: string;
}
interface Props {
  section: SectionData;
}
const { section } = Astro.props;
const titleId = titleIdFor(section);
// '' unless the editor filled the intro's rich twin, in which case it replaces
// the plain intro line.
const introHtml = emphasisHtml(section.introRich);
const entries = ((section.entries as Entry[] | undefined) ?? []).map((e) => ({
  time: e.time,
  timePm: e.timePm,
  title: e.title,
  desc: e.description,
}));
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        leadHtml={headerLeadHtml(section.header)}
        accent={section.header.headingAccent}
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  {
    introHtml && (
      <p class="mx-auto mt-4 max-w-2xl text-center leading-relaxed text-ink" set:html={introHtml} />
    )
  }
  {
    !introHtml && section.intro && (
      <p class="mx-auto mt-4 max-w-2xl text-center leading-relaxed text-ink">{section.intro}</p>
    )
  }
  <div class="mt-10">
    <ScheduleTimeline entries={entries as never} />
  </div>
</Section>
