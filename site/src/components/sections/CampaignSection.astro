---
/* ============================================================================
   CampaignSection — the current fundraising campaign with a progress bar
   ============================================================================
   Config-only in Sanity; pulls the single active Campaign at build time and
   hides when none is running. The bar is a real ARIA progressbar with a text
   equivalent, so it reads correctly with no color-only meaning.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { cmsFetch } from '@/lib/cms';
import { ACTIVE_CAMPAIGN_QUERY } from '@/lib/queries';
import { titleIdFor, eyebrowTone, bandSize, isExternal, type SectionData } from './section-helpers';
import { withBase } from '@/lib/utils';

interface Campaign {
  title?: string;
  summary?: string;
  goalAmount?: number;
  raisedAmount?: number;
  deadline?: string;
  linkLabel?: string;
  linkUrl?: string;
}
const { section, linkBase = '' } = Astro.props as { section: SectionData; linkBase?: string };
const header = section.header as { eyebrow?: string; title?: string; lead?: string } | undefined;
const titleId = titleIdFor(section);

const campaign = await cmsFetch<Campaign | null>(ACTIVE_CAMPAIGN_QUERY, {}, null);
const goal = campaign?.goalAmount ?? 0;
const raised = campaign?.raisedAmount ?? 0;
const pct = goal > 0 ? Math.min(100, Math.round((raised / goal) * 100)) : 0;
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const deadlineText = campaign?.deadline
  ? new Date(`${campaign.deadline}T00:00:00`).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;
const href = campaign?.linkUrl ? withBase(campaign.linkUrl, linkBase) : null;
const external = href ? isExternal(campaign?.linkUrl ?? '') : false;
---

{
  campaign && (
    <Section
      bg={(section.background as never) ?? 'cream'}
      seam={section.seam as boolean}
      size={bandSize(section)}
      labelledby={titleId}
    >
      <SectionHeader
        eyebrow={header?.eyebrow}
        title={header?.title ?? campaign.title ?? 'Our campaign'}
        lead={header?.lead ?? campaign.summary}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
        as="h2"
      />
      <div class="mx-auto mt-10 max-w-2xl">
        {goal > 0 && (
          <Fragment>
            <div class="flex items-end justify-between gap-4">
              <p class="font-display text-3xl text-heading">
                {money(raised)}
                <span class="text-base font-normal text-ink-muted"> raised</span>
              </p>
              <p class="text-sm font-semibold text-ink-muted">{money(goal)} goal</p>
            </div>
            <div
              class="mt-3 h-4 overflow-hidden rounded-full bg-navy/10 dark:bg-white/15"
              role="progressbar"
              aria-label="Fundraising progress"
              aria-valuenow={pct}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuetext={`${money(raised)} of ${money(goal)} raised (${pct}%)`}
            >
              <div class="h-full rounded-full bg-sky" style={`width: ${pct}%`} />
            </div>
            <p class="mt-2 text-sm text-ink-muted">
              {pct}% of our goal{deadlineText ? ` · by ${deadlineText}` : ''}
            </p>
          </Fragment>
        )}
        {href && (
          <div class="mt-8 text-center">
            <a
              href={href}
              class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-3 font-semibold text-white shadow-sm transition hover:bg-navy/90"
              {...(external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {campaign.linkLabel ?? 'Donate'}
            </a>
          </div>
        )}
      </div>
    </Section>
  )
}
