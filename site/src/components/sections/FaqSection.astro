---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Faq from '@/components/faq/Faq.astro';
import FaqItem from '@/components/faq/FaqItem.astro';
import { renderPortableText, deEmDash } from '@/lib/portable-text';
import {
  titleIdFor,
  eyebrowTone,
  bandSize,
  type SectionData,
  headerLeadHtml,
} from './section-helpers';

interface QA {
  question: string;
  answer?: unknown;
}
interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section, linkBase = '' } = Astro.props;
const titleId = titleIdFor(section);
const items = (section.items as QA[] | undefined) ?? [];

// NO JSON-LD here, on purpose. Google allows at most ONE FAQPage entity per
// page, and a page can hold several faqSections (/faq has four) — a per-
// section script tag emitted four competing FAQPage blocks, which disquali-
// fies the rich result. The public route ([...slug].astro) aggregates every
// faqSection's Q&As into a single page-level FAQPage instead; hub renders of
// this section are gated + noindex and need no markup at all.
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        leadHtml={headerLeadHtml(section.header)}
        accent={section.header.headingAccent}
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  <Faq class="mt-10">
    {
      items.map((qa) => (
        <FaqItem question={deEmDash(qa.question as string)}>
          <Fragment set:html={renderPortableText(qa.answer as never, linkBase)} />
        </FaqItem>
      ))
    }
  </Faq>
</Section>
