---
import CtaBanner from '@/components/CtaBanner.astro';
import ActionButtons from './ActionButtons.astro';
import TeacherSignoff from '@/components/hub/TeacherSignoff.astro';
import { renderPortableText } from '@/lib/portable-text';
import type { SectionData, ActionData } from './section-helpers';

interface Props {
  section: SectionData;
  linkBase?: string;
  /** When set (class hub pages), the closing CTA becomes a signed sign-off
      card: the teacher's headshot + Email / Call-or-text pills stand in for the
      plain-text note. Omitted everywhere else, so the CTA is unchanged. */
  teacherSlug?: string;
  /** Set by SectionRenderer when this CTA is the page's FINAL band. The
      closing-band doctrine (boldness pass 2026-07): a closing navy CTA renders
      as the AMBER DRENCH instead — the old site ended every page on its thick
      warm color band, and a third navy block is the quiet alternative nobody
      chose on purpose. Code-owned; stored tone is untouched, cream stays
      cream, mid-page navy CTAs stay navy. Hub pages never pass it. */
  isClosing?: boolean;
  /** Family Hub call sites set this — suppresses the Google-rating trust slip,
      which is a public-marketing signal that has no place behind the family
      login. */
  hideRating?: boolean;
}
const { section, linkBase = '', teacherSlug, isClosing = false, hideRating = false } = Astro.props;
const actions = (section.actions as ActionData[] | undefined) ?? [];
const noteHtml = teacherSlug ? '' : renderPortableText(section.note as never, linkBase);
const storedTone = (section.tone as 'navy' | 'cream') ?? 'navy';
// Closers stay NAVY: white text on navy (9.75:1) with ORANGE as accent only
// (crayon underline, seam trace, amber glow). Nathan ruled out dark text on
// warm fills entirely (amber 2026-07-19a, sky 2026-07-19b); white on navy is
// the AA-passing way to keep the color energy.
const tone = storedTone;
const accentClose = isClosing && storedTone === 'navy' && !teacherSlug;
---

<CtaBanner
  title={section.title as string}
  lead={section.lead as string | undefined}
  tone={tone}
  underlineAccent={accentClose}
  seam={section.seam as boolean}
  rating={!teacherSlug && !hideRating}
  titleId={`sec-${section._key}`}
>
  <Fragment slot="actions">
    <ActionButtons actions={actions} linkBase={linkBase} size="lg" tone={tone} />
  </Fragment>
  {
    teacherSlug && (
      <Fragment slot="signature">
        <TeacherSignoff slug={teacherSlug} />
      </Fragment>
    )
  }
  {
    noteHtml && (
      <Fragment slot="note">
        <Fragment set:html={noteHtml} />
      </Fragment>
    )
  }
</CtaBanner>
