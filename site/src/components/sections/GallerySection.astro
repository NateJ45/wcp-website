---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import { titleIdFor, eyebrowTone, bandSize, type SectionData } from './section-helpers';

interface Photo {
  image?: unknown;
  alt: string;
  caption?: string;
}
interface Props {
  section: SectionData;
}
const { section } = Astro.props;
const titleId = titleIdFor(section);
const photos = ((section.photos as Photo[] | undefined) ?? []).map((p) => ({
  sanityImage: p.image,
  alt: p.alt,
  caption: p.caption,
}));
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  <div class="mt-10">
    <PhotoGallery photos={photos as never} />
  </div>
</Section>
