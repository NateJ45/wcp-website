---
/* ============================================================================
   LogoStripSection — a row of partner/sponsor or accreditation logos
   ============================================================================
   Config picks the source (Partners vs Accreditations); the logos are pulled
   from that collection at build time and the band hides when empty. Logos sit
   on a neutral row, greyed until hover, and link out when a URL is set.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SanityImage from '@/components/SanityImage.astro';
import { cmsFetch } from '@/lib/cms';
import { PARTNERS_QUERY, CREDENTIALS_QUERY } from '@/lib/queries';
import type { SanityImageSource, SanityImageValue } from '@/lib/image';
import {
  titleIdFor,
  eyebrowTone,
  bandSize,
  type SectionData,
  headerLeadHtml,
} from './section-helpers';

interface Logo {
  name?: string;
  logo?: { image?: SanityImageValue; alt?: string } | null;
  url?: string;
}
const { section } = Astro.props as { section: SectionData };
const header = section.header;
const titleId = titleIdFor(section);
const isCredentials = (section.source as string) === 'credentials';
const logos = await cmsFetch<Logo[]>(isCredentials ? CREDENTIALS_QUERY : PARTNERS_QUERY, {}, []);
---

{
  logos.length > 0 && (
    <Section
      bg={(section.background as never) ?? 'grey'}
      seam={section.seam as boolean}
      size={bandSize(section)}
      labelledby={titleId}
    >
      {header?.title && (
        <SectionHeader
          leadHtml={headerLeadHtml(header)}
          accent={header?.headingAccent}
          eyebrow={header.eyebrow}
          title={header.title}
          lead={header.lead}
          titleId={titleId}
          eyebrowTone={eyebrowTone(section.background)}
          as="h2"
        />
      )}
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-8">
        {logos.map((l) => {
          const img = l.logo?.image?.asset ? (
            <SanityImage
              source={l.logo.image as SanityImageSource}
              alt={l.logo.alt ?? l.name ?? ''}
              widths={[160, 320]}
              sizes="160px"
              class="h-12 w-auto object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0 md:h-16 dark:opacity-100 dark:grayscale-0"
            />
          ) : (
            <span class="font-display text-lg text-ink-muted">{l.name}</span>
          );
          return (
            /* Dark mode gets a light PLATE behind each logo rather than any
               filter on the logo itself. These are Board-uploaded partner
               marks, typically dark ink on transparent, which simply vanish on
               the dark page — and `grayscale` was stripping the one thing that
               might have carried them. Inverting is worse (NN/g: it wrecks
               multi-colour marks and anything containing a photo), so the fix
               is to move the BACKGROUND lighter and leave the artwork alone.
               The site logo already does the equivalent via an asset swap in
               Header.astro; this is the CMS-supplied case, where we cannot ask
               for a second file. */
            <li class="dark:rounded-lg dark:bg-white/90 dark:px-3 dark:py-2">
              {l.url ? (
                <a href={l.url} target="_blank" rel="noopener" title={l.name}>
                  {img}
                </a>
              ) : (
                img
              )}
            </li>
          );
        })}
      </ul>
    </Section>
  )
}
