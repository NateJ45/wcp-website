---
/* ============================================================================
   MapSection — click-to-load Google Map + directions (page-builder bridge)
   ============================================================================
   The map iframe only loads after a click (src/scripts/embeds), so Google
   isn't contacted on a normal page view. The address and a "Get directions"
   link are always shown, so the section is fully useful even without loading
   the map at all.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { mapEmbedUrl, mapDirectionsUrl } from '@/lib/embeds';
import { titleIdFor, bandSize, type SectionData } from './section-helpers';

interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section } = Astro.props;
const header = section.header as { eyebrow?: string; title?: string; lead?: string } | undefined;
const titleId = titleIdFor(section);
const hasHeader = Boolean(header?.title);
const address = (section.address as string) ?? '';
const embed = mapEmbedUrl(address);
const directions = mapDirectionsUrl(address);
---

<Section
  bg={(section.background as never) ?? 'white'}
  seam={section.seam as boolean}
  size={bandSize(section)}
  labelledby={hasHeader ? titleId : undefined}
  label={hasHeader ? undefined : 'Map and directions'}
>
  {
    hasHeader && (
      <SectionHeader
        eyebrow={header?.eyebrow}
        title={header?.title ?? ''}
        lead={header?.lead}
        titleId={titleId}
        as="h2"
      />
    )
  }

  <div class="mx-auto mt-8 max-w-3xl">
    <div
      class="wcp-embed relative aspect-[16/9] overflow-hidden rounded-2xl bg-grey dark:bg-heading/20"
      data-embed-map={embed}
      data-embed-title="Map"
    >
      <button
        type="button"
        class="wcp-embed-open group flex h-full w-full flex-col items-center justify-center gap-3 text-navy dark:text-white"
        aria-label="Load the map"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-white shadow-md dark:bg-surface"
        >
          <svg
            class="h-7 w-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </span>
        <span class="font-semibold">Show map</span>
      </button>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <address class="text-sm text-ink-muted not-italic">{address}</address>
      <a
        href={directions}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white hover:bg-heading"
      >
        Get directions <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Section>
