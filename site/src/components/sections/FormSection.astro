---
/* ============================================================================
   FormSection — page-builder bridge for the contact form
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
import { normalizeCustomFields } from '@/lib/custom-form-fields';
import {
  titleIdFor,
  eyebrowTone,
  bandSize,
  type SectionData,
  headerLeadHtml,
} from './section-helpers';

interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section } = Astro.props;
const header = section.header;
const titleId = titleIdFor(section);
const formId = `form-${section._key}`;
// Board-written questions. Empty (the normal case) → the form keeps asking the
// questions of its variant, byte for byte as before.
const customFields = normalizeCustomFields(section.fields);
---

<Section
  bg={(section.background as never) ?? 'grey'}
  seam={section.seam as boolean}
  size={bandSize(section)}
  labelledby={titleId}
>
  <SectionHeader
    leadHtml={headerLeadHtml(header)}
    accent={header?.headingAccent}
    eyebrow={header?.eyebrow}
    title={header?.title ?? 'Get in touch'}
    lead={header?.lead}
    titleId={titleId}
    eyebrowTone={eyebrowTone(section.background ?? 'grey')}
    as="h2"
  />
  <div class="mt-8">
    <ContactForm
      topic={(section.topic as string) ?? 'Contact us'}
      variant={(section.variant as 'general' | 'enroll' | 'tour' | 'teach' | 'waitlist') ??
        'general'}
      showPhone={section.showPhone !== false}
      buttonLabel={(section.buttonLabel as string) ?? 'Send message'}
      successMessage={(section.successMessage as string) ?? undefined}
      formId={formId}
      customFields={customFields}
    />
  </div>
</Section>
