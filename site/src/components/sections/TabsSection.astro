---
/* ============================================================================
   TabsSection — accessible tabbed content (page-builder bridge)
   ============================================================================
   Renders the ARIA tabs pattern: a tablist of buttons + one tabpanel each.
   Keyboard: arrows/Home/End move between tabs (see src/scripts/tabs). If JS is
   off, a <noscript> style reveals every panel so no content is ever trapped
   behind a non-working tab. Brand-locked — styling is fixed here, not editable.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { renderPortableText } from '@/lib/portable-text';
import { titleIdFor, eyebrowTone, bandSize, type SectionData } from './section-helpers';

interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section, linkBase = '' } = Astro.props;

const header = section.header as { eyebrow?: string; title?: string; lead?: string } | undefined;
const tabs =
  (section.tabs as { _key?: string; label?: string; body?: unknown }[] | undefined) ?? [];
const titleId = titleIdFor(section);
const key = section._key ?? 'tabs';
const listLabel = header?.title ?? 'Tabbed information';
const hasHeader = Boolean(header?.title);
---

<Section
  bg={(section.background as never) ?? 'white'}
  seam={section.seam as boolean}
  size={bandSize(section)}
  labelledby={hasHeader ? titleId : undefined}
  label={hasHeader ? undefined : listLabel}
>
  {
    hasHeader && (
      <SectionHeader
        eyebrow={header?.eyebrow}
        title={header?.title ?? ''}
        lead={header?.lead}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background ?? 'white')}
        as="h2"
      />
    )
  }

  <div class="mx-auto mt-8 max-w-3xl" data-tabs>
    <div role="tablist" aria-label={listLabel} class="flex flex-wrap gap-1 border-b border-border">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${key}-${i}`}
            aria-controls={`panel-${key}-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="wcp-tab -mb-px rounded-t-lg border-b-2 border-transparent px-4 py-2.5 text-sm font-semibold text-ink-muted hover:text-navy aria-selected:border-navy aria-selected:text-navy dark:hover:text-sky dark:aria-selected:text-sky"
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    {
      tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`panel-${key}-${i}`}
          aria-labelledby={`tab-${key}-${i}`}
          tabindex="0"
          hidden={i !== 0}
          class="wcp-tabpanel pt-6 leading-relaxed text-ink [&_a]:font-semibold [&_a]:text-sky-ink [&_a]:underline [&_p]:mt-4 [&_p:first-child]:mt-0"
        >
          <Fragment set:html={renderPortableText(tab.body as never, linkBase)} />
        </div>
      ))
    }
  </div>
</Section>

<noscript>
  <style>
    /* No JS: reveal every panel so content is never trapped behind a tab. */
    [data-tabs] .wcp-tabpanel[hidden] {
      display: block;
    }
  </style>
</noscript>

<script>
  import '@/scripts/tabs';
</script>
