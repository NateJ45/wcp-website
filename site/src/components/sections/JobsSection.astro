---
/* ============================================================================
   JobsSection — open positions (teaching / board / other)
   ============================================================================
   Pulls open Job postings at build time. Unlike most pull sections this one
   stays visible when empty (a careers page should still say "nothing open"),
   showing the editor-set emptyMessage instead of a list.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { renderPortableText } from '@/lib/portable-text';
import { cmsFetch } from '@/lib/cms';
import { OPEN_JOBS_QUERY } from '@/lib/queries';
import { titleIdFor, eyebrowTone, bandSize, isExternal, type SectionData } from './section-helpers';
import { withBase } from '@/lib/utils';

interface Job {
  title?: string;
  type?: string;
  summary?: string;
  body?: unknown;
  applyUrl?: string;
}
const { section, linkBase = '' } = Astro.props as { section: SectionData; linkBase?: string };
const header = section.header as { eyebrow?: string; title?: string; lead?: string } | undefined;
const titleId = titleIdFor(section);
const emptyMessage =
  (section.emptyMessage as string) || 'No open positions right now — check back soon.';

const jobs = await cmsFetch<Job[]>(OPEN_JOBS_QUERY, {}, []);
const TYPE_LABEL: Record<string, string> = {
  teaching: 'Teaching',
  board: 'Board / volunteer',
  other: 'Opportunity',
};
---

<Section
  bg={(section.background as never) ?? 'white'}
  seam={section.seam as boolean}
  size={bandSize(section)}
  labelledby={titleId}
>
  <SectionHeader
    eyebrow={header?.eyebrow}
    title={header?.title ?? 'Join our team'}
    lead={header?.lead}
    titleId={titleId}
    eyebrowTone={eyebrowTone(section.background)}
    as="h2"
  />
  {
    jobs.length > 0 ? (
      <ul class="mx-auto mt-10 grid max-w-3xl gap-6">
        {jobs.map((job) => {
          const href = job.applyUrl ? withBase(job.applyUrl, linkBase) : null;
          const external = href ? isExternal(job.applyUrl ?? '') : false;
          const bodyHtml = job.body ? renderPortableText(job.body as never, linkBase) : '';
          return (
            <li class="rounded-2xl border border-border bg-white p-6 shadow-sm dark:bg-surface">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-display text-xl text-heading">{job.title}</h3>
                {job.type && (
                  <span class="rounded-full bg-sky/15 px-3 py-1 text-xs font-semibold text-sky-ink">
                    {TYPE_LABEL[job.type] ?? job.type}
                  </span>
                )}
              </div>
              {job.summary && <p class="mt-2 text-ink-muted">{job.summary}</p>}
              {bodyHtml && (
                <div class="prose-sm mt-3 max-w-none text-ink-muted [&_a]:text-navy [&_a]:underline dark:[&_a]:text-sky">
                  <Fragment set:html={bodyHtml} />
                </div>
              )}
              {href && (
                <a
                  href={href}
                  class="mt-4 inline-flex items-center gap-1 rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy/90"
                  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  Apply <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="mx-auto mt-8 max-w-xl text-center text-ink-muted">{emptyMessage}</p>
    )
  }
</Section>
