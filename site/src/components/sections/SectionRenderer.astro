---
/* ============================================================================
   SectionRenderer — turns a page's `sections` array into rendered components
   ============================================================================
   The bridge between Sanity's page-builder data and the site's existing
   components. Each section _type maps to a thin bridge component that unpacks
   the Sanity fields into the real component's props. `linkBase` (''/'/preview')
   keeps in-section links inside preview mode; `site` feeds the contact block.
   ============================================================================ */
import type { SectionData } from './section-helpers';
import { effectiveBg, wantsSeam } from './section-helpers';
import { deEmDashDeep } from '@/lib/portable-text';
import PhotoStrip from '@/components/PhotoStrip.astro';
import Interlude from '@/components/Interlude.astro';
import TuitionOpener from '@/components/TuitionOpener.astro';
import HeritageStrip from '@/components/HeritageStrip.astro';
import ChooserRows from '@/components/ChooserRows.astro';
import { PHOTO_MOMENTS, type PhotoMoment } from '@/lib/photo-moments';
import {
  SECTION_HOIST,
  SECTION_APPEND,
  SECTION_DROP,
  SECTION_INSERT_AFTER,
  SECTION_HEADER_OVERRIDES,
  CARDGRID_KEEP_CARDS,
} from '@/lib/page-doctrine';
import ProseSection from './ProseSection.astro';
import CardGridSection from './CardGridSection.astro';
import StatBandSection from './StatBandSection.astro';
import CtaSection from './CtaSection.astro';
import TestimonialSection from './TestimonialSection.astro';
import TeacherSection from './TeacherSection.astro';
import ClassCardsSection from './ClassCardsSection.astro';
import FaqSection from './FaqSection.astro';
import SchoolYearSection from './SchoolYearSection.astro';
import TuitionTableSection from './TuitionTableSection.astro';
import TuitionCalculatorSection from './TuitionCalculatorSection.astro';
import EnrollmentCtaSection from './EnrollmentCtaSection.astro';
import ReviewFormSection from './ReviewFormSection.astro';
import ScheduleSection from './ScheduleSection.astro';
import StepListSection from './StepListSection.astro';
import CompareSection from './CompareSection.astro';
import TabsSection from './TabsSection.astro';
import AccordionSection from './AccordionSection.astro';
import QuickFactsSection from './QuickFactsSection.astro';
import PullQuoteSection from './PullQuoteSection.astro';
import VideoSection from './VideoSection.astro';
import MapSection from './MapSection.astro';
import CountdownSection from './CountdownSection.astro';
import GallerySection from './GallerySection.astro';
import StoryTimelineSection from './StoryTimelineSection.astro';
import SplitMediaSection from './SplitMediaSection.astro';
import LatestPostsSection from './LatestPostsSection.astro';
import UpcomingEventsSection from './UpcomingEventsSection.astro';
import FormSection from './FormSection.astro';
import NewsletterSection from './NewsletterSection.astro';
import NoticeBarSection from './NoticeBarSection.astro';
import ContactDetailsSection from './ContactDetailsSection.astro';
import ProgramCardsSection from './ProgramCardsSection.astro';
import BoardMembersSection from './BoardMembersSection.astro';
import LogoStripSection from './LogoStripSection.astro';
import CampaignSection from './CampaignSection.astro';
import JobsSection from './JobsSection.astro';
import DownloadsSection from './DownloadsSection.astro';
import AlbumSection from './AlbumSection.astro';
import InstagramSection from './InstagramSection.astro';

interface Props {
  sections?: SectionData[];
  linkBase?: string;
  site?: unknown;
  /** Hub-only: render the faint corner watermark on card-grid cards. Public
      pages omit it, so marketing grids stay clean. Only CardGridSection reads it. */
  cardWatermark?: boolean;
  /** Page slug — enables the code-owned photo moments (PhotoStrip bands from
      the build-time registry, see src/lib/photo-moments.ts). Public [...slug]
      passes it; hub/preview surfaces omit it and get no injected strips. */
  pageSlug?: string;
  /** Family Hub surfaces set this so a Board-added ctaSection never carries the
      Google-rating trust slip — that's a public-marketing trust signal for
      prospective parents, not something an already-enrolled family needs. */
  hub?: boolean;
  /** True when a page hero renders directly above these sections: the first
      band then always carries the sweep seam (the old site's media→content
      divider, every page). Public page routes pass it; hub surfaces don't. */
  afterHero?: boolean;
}
const {
  sections: rawSections = [],
  linkBase = '',
  site,
  cardWatermark = false,
  pageSlug,
  hub = false,
  afterHero = false,
} = Astro.props;
// House style bans em-dashes. Strip them from ALL section string content here
// (headers, step descriptions, schedule text, prose, ...) so every section type
// is covered at once — the Board's Sanity copy can't be re-seeded while writes
// are quota-blocked. A no-op once the content itself is em-dash-free.
let sections = rawSections.map((s) => deEmDashDeep(s));

// Page doctrine (public pages only): hoist named sections to the front (the
// Visit page's tour form was 7th of 8) and append synthetic sections (the
// Visit page's contact details). Runs BEFORE the seam computation so edges
// follow the rendered order. Stopgaps registered in docs/PENDING.md.
if (pageSlug) {
  // Drops first (render-time stopgaps mirroring queued Sanity patches; keys or
  // 'type:<sectionType>' entries — see SECTION_DROP).
  const dropKeys = SECTION_DROP[pageSlug] ?? [];
  if (dropKeys.length > 0) {
    sections = sections.filter(
      (s) => !dropKeys.includes(s._key) && !dropKeys.includes(`type:${s._type}`),
    );
  }
  const hoistKeys = SECTION_HOIST[pageSlug] ?? [];
  if (hoistKeys.length > 0) {
    const hoisted = hoistKeys
      .map((k) => sections.find((s) => s._key === k))
      .filter((s): s is SectionData => Boolean(s));
    sections = [...hoisted, ...sections.filter((s) => !hoistKeys.includes(s._key))];
  }
  // Splice synthetic sections in after their anchor keys (final order).
  const inserts = SECTION_INSERT_AFTER[pageSlug];
  if (inserts) {
    for (const [afterKey, extra] of Object.entries(inserts)) {
      const at = sections.findIndex((s) => s._key === afterKey);
      if (at !== -1) sections = [...sections.slice(0, at + 1), ...extra, ...sections.slice(at + 1)];
    }
  }
  sections = [...sections, ...(SECTION_APPEND[pageSlug] ?? [])];
  // Header copy overrides (title/lead/eyebrow by _key).
  const headerOverrides = SECTION_HEADER_OVERRIDES[pageSlug];
  if (headerOverrides) {
    sections = sections.map((s) => {
      const o = headerOverrides[s._key];
      if (!o) return s;
      return { ...s, header: { ...(s.header ?? {}), ...o } } as SectionData;
    });
  }
}

// The code-owned photo moments for this page (empty for hub/preview surfaces
// and unlisted pages). Indexed by "render after section i" for the loop below;
// a string `after` anchors to a section _key in the FINAL order (survives the
// doctrine drops/hoists above; a missing key drops the moment rather than
// landing it somewhere random).
const moments: PhotoMoment[] = pageSlug ? (PHOTO_MOMENTS[pageSlug] ?? []) : [];
const momentsAfter = new Map<number, PhotoMoment[]>();
for (const m of moments) {
  let at: number;
  if (typeof m.after === 'string') {
    const idx = sections.findIndex((s) => s._key === m.after);
    if (idx === -1) continue;
    at = idx;
  } else {
    at = Math.max(-1, Math.min(m.after, sections.length - 1));
  }
  momentsAfter.set(at, [...(momentsAfter.get(at) ?? []), m]);
}

// Seams are computed here from adjacent band colours, NOT read from a volunteer
// toggle (that field was removed from the schema — a page-builder shouldn't ask
// a board member to hand-judge where a divider belongs). Walk the array once,
// tracking the previous band's effective background, and set each section's
// `seam` accordingly. The noticeBar is a thin strip, never a full band, so it
// neither carries a seam nor counts as the band above the next section. An
// injected PhotoStrip IS a band, so it joins the chain via its own bg.
// The page's FINAL real band (notice bars excluded) — drives the closing-band
// doctrine: a closing navy ctaSection renders as the amber drench (CtaSection
// reads the isClosing prop below).
let lastBandIndex = -1;
for (const [i, s] of sections.entries()) {
  if (s._type !== 'noticeBarSection') lastBandIndex = i;
}

// A moment's effective band colour for the seam chain: strips and the tuition
// opener are cream paper; a full-bleed interlude is a photograph (neutral, so
// the next strong band gets its seam).
const momentBg = (m: PhotoMoment): string =>
  m.kind === 'interlude' || m.kind === 'chooser' ? 'white' : (m.bg ?? 'cream');

// Seed with the hero boundary (the sweep divider lands under every hero, like
// the old site), then a leading moment's colour when one renders first.
let prevBg: string | null = afterHero ? 'hero' : null;
for (const m of momentsAfter.get(-1) ?? []) prevBg = momentBg(m);
// Flush detection (Nathan 2026-07-19): when two ADJACENT bands share a color
// (no moment between them), the doodle tile would visibly slice its icons at
// the invisible boundary — so every member of a same-color run drops its
// texture (data-flush → grammar CSS) and the run reads as ONE surface. The
// navy drench hero counts as navy for the band sitting flush under it.
const flushWith = (a: string | null, b: string | null) =>
  a !== null &&
  b !== null &&
  (a === b || (a === 'hero' && b === 'navy') || (b === 'hero' && a === 'navy'));
const bgs: (string | null)[] = sections.map((s) =>
  s._type === 'noticeBarSection' ? null : effectiveBg(s),
);
for (const [i, section] of sections.entries()) {
  if (section._type === 'noticeBarSection') {
    section.seam = false;
    continue;
  }
  const bg = effectiveBg(section);
  section.seam = wantsSeam(bg, prevBg);
  const prevFlush = flushWith(bg, prevBg);
  let nextFlush = false;
  if (!momentsAfter.has(i)) {
    for (let j = i + 1; j < bgs.length; j++) {
      if (bgs[j] === null) continue; // notice bars are thin strips, not bands
      nextFlush = flushWith(bg, bgs[j]);
      break;
    }
  }
  section.flush = prevFlush || nextFlush;
  prevBg = bg;
  // A moment after this section becomes the band the NEXT section sits under.
  for (const m of momentsAfter.get(i) ?? []) prevBg = momentBg(m);
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const MAP: Record<string, any> = {
  proseSection: ProseSection,
  cardGridSection: CardGridSection,
  statBandSection: StatBandSection,
  ctaSection: CtaSection,
  testimonialSection: TestimonialSection,
  teacherSection: TeacherSection,
  classCardsSection: ClassCardsSection,
  faqSection: FaqSection,
  schoolYearSection: SchoolYearSection,
  tuitionTableSection: TuitionTableSection,
  tuitionCalculatorSection: TuitionCalculatorSection,
  enrollmentCtaSection: EnrollmentCtaSection,
  scheduleSection: ScheduleSection,
  stepListSection: StepListSection,
  compareSection: CompareSection,
  tabsSection: TabsSection,
  accordionSection: AccordionSection,
  quickFactsSection: QuickFactsSection,
  pullQuoteSection: PullQuoteSection,
  videoSection: VideoSection,
  mapSection: MapSection,
  countdownSection: CountdownSection,
  gallerySection: GallerySection,
  storyTimelineSection: StoryTimelineSection,
  splitMediaSection: SplitMediaSection,
  latestPostsSection: LatestPostsSection,
  upcomingEventsSection: UpcomingEventsSection,
  formSection: FormSection,
  newsletterSignupSection: NewsletterSection,
  reviewFormSection: ReviewFormSection,
  noticeBarSection: NoticeBarSection,
  contactDetailsSection: ContactDetailsSection,
  programCardsSection: ProgramCardsSection,
  boardMembersSection: BoardMembersSection,
  logoStripSection: LogoStripSection,
  campaignSection: CampaignSection,
  jobsSection: JobsSection,
  downloadsSection: DownloadsSection,
  albumSection: AlbumSection,
  instagramSection: InstagramSection,
};
---

{
  (momentsAfter.get(-1) ?? []).map((m) =>
    m.kind === 'interlude' ? (
      <Interlude slot={m.slot} caption={m.caption ?? ''} />
    ) : m.kind === 'tuition-opener' ? (
      <TuitionOpener />
    ) : m.kind === 'heritage' ? (
      <HeritageStrip slot={m.slot} />
    ) : m.kind === 'chooser' ? (
      <ChooserRows />
    ) : (
      <PhotoStrip slot={m.slot} bg={m.bg} captions={m.captions} />
    ),
  )
}
{
  sections.map((section, i) => {
    const Comp = MAP[section._type];
    const strips = momentsAfter.get(i) ?? [];
    if (!Comp && strips.length === 0) return null;
    // cardWatermark reaches only CardGridSection (the sole reader); every other
    // bridge ignores the extra prop. Photo strips splice in AFTER their section.
    // Act II section grammar (public only): each section is wrapped in a
    // zero-box `display: contents` div carrying its _type, so the grammar
    // layer in globals.css can compose per section TYPE (header treatments,
    // the card-grid sheet re-expression, the stat strip) with no bridge
    // edits and no hub impact (hub surfaces don't pass pageSlug and lack the
    // .wcp-site-paper scope anyway). `data-cards` opts a specific grid back
    // into real cards where cards earn it (CARDGRID_KEEP_CARDS doctrine).
    const grammarAttrs = pageSlug
      ? {
          'data-stype': section._type,
          'data-flush': section.flush ? '' : undefined,
          'data-cards':
            section._type === 'cardGridSection' &&
            (CARDGRID_KEEP_CARDS[pageSlug] ?? []).includes(section._key)
              ? ''
              : undefined,
        }
      : null;
    const rendered = Comp && (
      <Comp
        section={section}
        linkBase={linkBase}
        site={site}
        cardWatermark={section._type === 'cardGridSection' ? cardWatermark : undefined}
        pageSlug={section._type === 'testimonialSection' ? pageSlug : undefined}
        hideRating={section._type === 'ctaSection' ? hub : undefined}
        isClosing={
          // Public pages only (they pass pageSlug): the hub keeps its navy
          // closers; the amber drench is public-marketing doctrine.
          section._type === 'ctaSection' ? Boolean(pageSlug) && i === lastBandIndex : undefined
        }
      />
    );
    return (
      <>
        {rendered && grammarAttrs && (
          <div class="contents" {...grammarAttrs}>
            {rendered}
          </div>
        )}
        {rendered && !grammarAttrs && rendered}
        {strips.map((m) =>
          m.kind === 'interlude' ? (
            <Interlude slot={m.slot} caption={m.caption ?? ''} />
          ) : m.kind === 'tuition-opener' ? (
            <TuitionOpener />
          ) : m.kind === 'heritage' ? (
            <HeritageStrip slot={m.slot} />
          ) : m.kind === 'chooser' ? (
            <ChooserRows />
          ) : (
            <PhotoStrip slot={m.slot} bg={m.bg} captions={m.captions} />
          ),
        )}
      </>
    );
  })
}
