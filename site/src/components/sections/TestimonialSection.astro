---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Testimonial from '@/components/Testimonial.astro';
import TestimonialWall from '@/components/TestimonialWall.astro';
import Button from '@/components/ui/Button.astro';
import { getTestimonials } from '@/lib/cms';
import { photoFor } from '@/lib/testimonial-photos';
import { titleIdFor, eyebrowTone, bandSize, type SectionData } from './section-helpers';
import { cn } from '@/lib/utils';

interface Quote {
  quote: string;
  author?: string;
  role?: string;
}
interface Props {
  section: SectionData;
  /** Page slug from SectionRenderer (public pages only). On /reviews the
      section is FORCED to the full masonry wall regardless of stored layout —
      the dedicated social-proof page showed 3 quotes while /why-wcp showed 24
      (the audit's "thinner than its teaser" P1); a code override fixes it with
      no Sanity write. */
  pageSlug?: string;
}
const { section, pageSlug } = Astro.props;
const titleId = titleIdFor(section);
// On /reviews the dedicated social-proof page must show EVERY voice, not the
// 3 its stored section selects — fetch the full set at build time (same
// authenticated CDN read every page uses; no Sanity write involved).
const allItems: Quote[] =
  pageSlug === 'reviews'
    ? ((await getTestimonials({}, [])) as Quote[])
    : ((section.items as Quote[] | undefined) ?? []);
// Apply the limit here (GROQ can't slice by a coalesced value). Manual picks
// and walls show everything; featured/tag grids cap at the section's limit.
const limit = typeof section.limit === 'number' ? section.limit : 3;
// Act II proof-ownership doctrine: /reviews owns the FULL deck; /why-wcp keeps
// a curated teaser (4 voices) and points at /reviews instead of duplicating
// all ~24 quotes (Phase 0: the wall ran 6 mobile viewports on why-wcp and the
// duplicate copies had even drifted apart in punctuation). STOPGAP mirroring
// the queued patch-testimonial-redistribution script (PENDING.md).
const isWall = (section.layout === 'wall' || pageSlug === 'reviews') && pageSlug !== 'why-wcp';
let items = isWall || section.source === 'manual' ? allItems : allItems.slice(0, limit);
if (pageSlug === 'why-wcp') items = items.slice(0, 4);
// Any page showing a TEASER of the quotes gets a way through to the full set.
// This was /why-wcp only, so the home page ended its testimonials with no exit
// at all — a visitor who just read three glowing quotes had nowhere to go
// (Nathan, 2026-07-19). /reviews is excluded because it already IS the full
// set, and walls are excluded for the same reason.
const readAllLink = Boolean(pageSlug) && pageSlug !== 'reviews' && !isWall;
const confetti = Boolean(section.confetti);
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  {
    isWall ? (
      <div class="mt-12">
        <TestimonialWall items={items.map((t) => ({ ...t, author: t.author ?? '' })) as never} />
      </div>
    ) : (
      <ul class={cn('mt-12 grid gap-6', items.length === 4 ? 'md:grid-cols-2' : 'md:grid-cols-3')}>
        {items.map((t) => (
          <li class="h-full">
            <Testimonial
              quote={t.quote}
              author={t.author ?? ''}
              context={t.role}
              photo={photoFor(t.author)}
              confetti={confetti}
            />
          </li>
        ))}
      </ul>
    )
  }
  {
    readAllLink && (
      <p class="mt-10 text-center">
        {/* A real button, not the bare underlined link this used to be: it sits
            at the end of a band of proof and is the only way onward from it,
            so it should look like an action. Outline rather than accent keeps
            the hero's "Schedule a Tour" as the page's one primary CTA. */}
        {/* Label kept SHORT on purpose: buttonVariants sets whitespace-nowrap,
            so a long label cannot wrap and simply overflows the viewport. "Read
            every family review" measured 314px against a 320px screen and broke
            reflow on 7 routes. */}
        <Button href="/reviews" variant="outline" size="lg" class="wcp-press">
          Read all reviews
          <span aria-hidden="true"> →</span>
        </Button>
      </p>
    )
  }
</Section>
