---
import Section from '@/components/Section.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import { bandSize, type SectionData } from './section-helpers';

interface SiteLike {
  phone: string;
  email: { general: string };
  address: { street: string; city: string; state: string; zip: string };
  calendar?: string;
  parkingNote?: string;
  venueNote?: string;
}
interface Props {
  section: SectionData;
  site: SiteLike;
}
const { section, site } = Astro.props;
const phoneDigits = site.phone.replace(/[^\d]/g, '');
const mapQuery = encodeURIComponent(
  `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`,
);
---

<Section
  bg={section.background}
  seam={section.seam as boolean}
  size={bandSize(section)}
  label="Contact details"
>
  <div class="mx-auto grid max-w-3xl gap-8 sm:grid-cols-2">
    <div data-reveal>
      <h2 class="text-heading">{section.reachHeading ?? 'Reach us'}</h2>
      <dl class="mt-4 space-y-3 text-ink">
        <div>
          <dt class="text-sm font-bold tracking-wide text-sky-ink uppercase">Phone</dt>
          <dd><a href={`tel:${phoneDigits}`} class="text-heading underline">{site.phone}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-bold tracking-wide text-sky-ink uppercase">Email</dt>
          <dd>
            <a href={`mailto:${site.email.general}`} class="text-heading underline"
              >{site.email.general}</a
            >
          </dd>
        </div>
      </dl>
    </div>
    <div data-reveal>
      <h2 class="text-heading">{section.visitHeading ?? 'Visit'}</h2>
      <address class="mt-4 leading-relaxed text-ink not-italic">
        {site.address.street}<br />
        {`${site.address.city}, ${site.address.state} ${site.address.zip}`}<br />
        {site.venueNote && <span class="text-ink-muted">{site.venueNote}</span>}
      </address>
      {site.calendar && <p class="mt-3 text-sm text-ink-muted">{site.calendar}</p>}
      <a
        href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center gap-1.5 font-bold text-sky-ink underline underline-offset-2"
      >
        <Icon name="map-pin" class="h-4 w-4" />
        Open in Google Maps
      </a>
    </div>
  </div>

  {
    section.showParking !== false && (
      <div class="mx-auto mt-8 max-w-3xl" data-reveal>
        <Callout tone="warm">
          <strong class="font-bold text-heading">Parking &amp; entry:</strong>{' '}
          {site.parkingNote ??
            'Enter through the rear west doors — look for Door 5, a set of double white doors with white pillars on either side. Park near the concrete sidewalk by the rear doors.'}
        </Callout>
      </div>
    )
  }
</Section>
