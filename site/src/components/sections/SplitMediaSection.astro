---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SanityImage from '@/components/SanityImage.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { emphasisHtml } from '@/lib/emphasis';
import {
  titleIdFor,
  eyebrowTone,
  bandSize,
  type SectionData,
  headerLeadHtml,
} from './section-helpers';
import { withBase } from '@/lib/utils';
import { cn } from '@/lib/utils';

interface Row {
  image?: unknown;
  alt: string;
  eyebrow?: string;
  title: string;
  body?: string;
  /** The body's rich twin (bold / italic). Empty on every stored row. */
  bodyRich?: unknown;
  linkLabel?: string;
  linkUrl?: string;
}
interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section, linkBase = '' } = Astro.props;
const titleId = titleIdFor(section);
// bodyHtml is '' unless the editor filled the row's rich twin, in which case
// it replaces the plain body line.
const rows = ((section.rows as Row[] | undefined) ?? []).map((r) => ({
  ...r,
  bodyHtml: emphasisHtml(r.bodyRich),
}));
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        leadHtml={headerLeadHtml(section.header)}
        accent={section.header.headingAccent}
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  <div class="mt-12 space-y-12">
    {
      rows.map((r, i) => (
        <div class="grid items-center gap-8 md:grid-cols-2" data-reveal>
          {/* The photo as a physical print (white frame + tilt), matching the
              hero's framed film. The tilt alternates per row via an inline
              custom property rather than nth-of-type, which would give every
              row the same angle here (this wrapper is the only div of its type
              in its row). The tilt sits on THIS element and data-reveal on the
              row above it, because reveal animates transform and would cancel a
              resting rotate() on the same node. */}
          <div
            class={cn('wcp-photo-print', i % 2 === 1 && 'md:order-2')}
            style={`--print-tilt: ${i % 2 === 0 ? '-1.2deg' : '1deg'}`}
          >
            <div class="aspect-[4/3] overflow-hidden">
              <SanityImage
                source={r.image as never}
                alt={r.alt}
                class="h-full w-full object-cover"
                sizes="(min-width: 768px) 50vw, 100vw"
              />
            </div>
          </div>
          <div class={cn(i % 2 === 1 && 'md:order-1')}>
            {r.eyebrow && <Eyebrow tone={eyebrowTone(section.background)}>{r.eyebrow}</Eyebrow>}
            <h3 class="font-display text-2xl text-heading">{r.title}</h3>
            {r.bodyHtml ? (
              <p class="mt-3 leading-relaxed text-ink" set:html={r.bodyHtml} />
            ) : (
              r.body && <p class="mt-3 leading-relaxed text-ink">{r.body}</p>
            )}
            {r.linkLabel && r.linkUrl && (
              <a
                href={withBase(r.linkUrl, linkBase)}
                class="mt-4 inline-flex font-bold text-sky-ink underline underline-offset-2"
              >
                {r.linkLabel}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
