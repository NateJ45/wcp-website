---
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SanityImage from '@/components/SanityImage.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { titleIdFor, eyebrowTone, bandSize, type SectionData } from './section-helpers';
import { withBase } from '@/lib/utils';
import { cn } from '@/lib/utils';

interface Row {
  image?: unknown;
  alt: string;
  eyebrow?: string;
  title: string;
  body?: string;
  linkLabel?: string;
  linkUrl?: string;
}
interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section, linkBase = '' } = Astro.props;
const titleId = titleIdFor(section);
const rows = (section.rows as Row[] | undefined) ?? [];
---

<Section bg={section.background} seam={section.seam} size={bandSize(section)} labelledby={titleId}>
  {
    section.header?.title && (
      <SectionHeader
        eyebrow={section.header.eyebrow}
        title={section.header.title}
        lead={section.header.lead}
        align={section.header.align}
        titleId={titleId}
        eyebrowTone={eyebrowTone(section.background)}
      />
    )
  }
  <div class="mt-12 space-y-12">
    {
      rows.map((r, i) => (
        <div class="grid items-center gap-8 md:grid-cols-2" data-reveal>
          <div
            class={cn(
              'overflow-hidden rounded-[var(--radius)] shadow-sm',
              i % 2 === 1 && 'md:order-2',
            )}
          >
            <div class="aspect-[4/3]">
              <SanityImage
                source={r.image as never}
                alt={r.alt}
                class="h-full w-full object-cover"
                sizes="(min-width: 768px) 50vw, 100vw"
              />
            </div>
          </div>
          <div class={cn(i % 2 === 1 && 'md:order-1')}>
            {r.eyebrow && <Eyebrow tone={eyebrowTone(section.background)}>{r.eyebrow}</Eyebrow>}
            <h3 class="font-display text-2xl text-heading">{r.title}</h3>
            {r.body && <p class="mt-3 leading-relaxed text-ink">{r.body}</p>}
            {r.linkLabel && r.linkUrl && (
              <a
                href={withBase(r.linkUrl, linkBase)}
                class="mt-4 inline-flex font-bold text-sky-ink underline underline-offset-2"
              >
                {r.linkLabel}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
