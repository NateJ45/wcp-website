---
/* ============================================================================
   QuickFactsSection — a row of key facts (page-builder bridge)
   ============================================================================
   Icon + value + label per fact. Good for hours, ages, ratios, class size.
   ============================================================================ */
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Icon from '@/components/Icon.astro';
import { titleIdFor, bandSize, type SectionData } from './section-helpers';

interface Props {
  section: SectionData;
  linkBase?: string;
}
const { section } = Astro.props;
const header = section.header as { eyebrow?: string; title?: string; lead?: string } | undefined;
const facts =
  (section.facts as
    { _key?: string; icon?: string; value?: string; label?: string }[] | undefined) ?? [];
const titleId = titleIdFor(section);
const hasHeader = Boolean(header?.title);
const cols =
  facts.length <= 2
    ? 'sm:grid-cols-2'
    : facts.length === 4
      ? 'sm:grid-cols-2 lg:grid-cols-4'
      : 'sm:grid-cols-3';
---

<Section
  bg={(section.background as never) ?? 'grey'}
  seam={section.seam as boolean}
  size={bandSize(section)}
  labelledby={hasHeader ? titleId : undefined}
  label={hasHeader ? undefined : 'Quick facts'}
>
  {
    hasHeader && (
      <SectionHeader
        eyebrow={header?.eyebrow}
        title={header?.title ?? ''}
        lead={header?.lead}
        titleId={titleId}
        as="h2"
      />
    )
  }

  <div class={`mt-8 grid gap-6 ${cols}`}>
    {
      facts.map((fact) => (
        <div class="flex flex-col items-center rounded-2xl border border-border bg-white p-6 text-center dark:bg-surface">
          {fact.icon && (
            <span class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-sky/15 text-sky-ink">
              <Icon name={fact.icon} class="h-6 w-6" />
            </span>
          )}
          <p class="font-display text-2xl text-heading">{fact.value}</p>
          <p class="mt-1 text-sm text-ink-muted">{fact.label}</p>
        </div>
      ))
    }
  </div>
</Section>
