---
/* ============================================================================
   ContactForm — accessible inquiry forms, posts to /api/contact
   ============================================================================
   Progressive enhancement: with no JS the native POST redirects to /thank-you;
   with JS it submits in the background and swaps in an inline thank-you. A
   hidden honeypot field ("company") catches basic bots.

   VARIANTS reproduce the live Squarespace forms field-for-field (captured
   from the rendered old site 2026-07 — they're JS-hydrated there, so view
   source lies):
     general → the old /contact form  (First, Last, Email, Subject, Message)
     enroll  → the old /enroll form   (parent + child details, class checkboxes)
     tour    → the old /tour form     (child info, preferred dates/times)
     teach   → the old /work-with-us  (experience, age groups, certification)
   Every field posts under a stable name; /api/contact folds the extras into
   the stored submission + email, so no schema change is needed per variant.
   (2026-07 friction pass: the enroll variant no longer REQUIRES phone or the
   child's birthdate — the fields stay, marked optional, because a hard gate
   on either was stalling parents who just want to start the conversation.)
   ============================================================================ */
interface Props {
  topic: string;
  variant?: 'general' | 'enroll' | 'tour' | 'teach' | 'waitlist';
  showPhone?: boolean;
  buttonLabel?: string;
  successMessage?: string;
  formId: string;
}
const {
  topic,
  variant = 'general',
  showPhone = true,
  buttonLabel = 'Send message',
  successMessage = 'Thank you! We have your message and will be in touch soon.',
  formId,
} = Astro.props;

// One flat field list per variant, rendered generically below. `name`s are
// what /api/contact receives; keep them stable.
type Field =
  | {
      kind: 'text' | 'email' | 'tel' | 'date';
      name: string;
      label: string;
      required?: boolean;
      autocomplete?: string;
      optionalNote?: boolean;
    }
  | { kind: 'textarea'; name: string; label: string; required?: boolean }
  | { kind: 'select'; name: string; label: string; required?: boolean; options: string[] }
  | { kind: 'checkboxes'; name: string; label: string; options: string[] };

const VARIANTS: Record<string, Field[]> = {
  general: [
    { kind: 'text', name: 'subject', label: 'Subject', required: true },
    { kind: 'textarea', name: 'message', label: 'Message', required: true },
  ],
  enroll: [
    { kind: 'text', name: 'childName', label: 'Child’s name', required: true },
    // Optional on purpose (2026-07 friction pass): the old form demanded a
    // birthdate up front, which stalls a parent who just wants to start the
    // conversation. The board can ask for it in the reply.
    { kind: 'date', name: 'childBirthdate', label: 'Child’s date of birth', optionalNote: true },
    {
      kind: 'checkboxes',
      name: 'classInterest',
      label: 'Class interested in',
      options: ['Twos', 'Threes', 'Pre-K AM', 'Pre-K PM'],
    },
    { kind: 'text', name: 'hearAbout', label: 'How did you hear about us?', optionalNote: true },
    { kind: 'textarea', name: 'message', label: 'Anything else you’d like us to know' },
  ],
  waitlist: [
    { kind: 'text', name: 'childName', label: 'Child’s name', required: true },
    { kind: 'date', name: 'childBirthdate', label: 'Child’s date of birth', required: true },
    {
      kind: 'checkboxes',
      name: 'classInterest',
      label: 'Class you’re hoping for',
      options: ['Twos', 'Threes', 'Pre-K AM', 'Pre-K PM'],
    },
    {
      kind: 'text',
      name: 'preferredStart',
      label: 'When would you like to start?',
      optionalNote: true,
    },
    { kind: 'textarea', name: 'message', label: 'Anything else we should know?' },
  ],
  tour: [
    { kind: 'text', name: 'childInfo', label: 'Child’s name and birthdate', required: true },
    {
      kind: 'checkboxes',
      name: 'classInterest',
      label: 'Class interested in',
      options: ['Twos', 'Threes', 'Pre-K'],
    },
    { kind: 'text', name: 'datesTimes', label: 'Dates/times that work for you', required: true },
    { kind: 'text', name: 'hearAbout', label: 'How did you hear about us?', optionalNote: true },
    { kind: 'textarea', name: 'message', label: 'Anything else you want us to know?' },
  ],
  teach: [
    {
      kind: 'select',
      name: 'experienceYears',
      label: 'Years of experience working with children',
      required: true,
      options: ['Less than 1 year', '1-2 years', '3-5 years', '5-10 years', '10+ years'],
    },
    {
      kind: 'checkboxes',
      name: 'ageGroups',
      label: 'Age groups you’re interested in teaching',
      options: ['Toddlers (2s)', 'Threes (3s)', 'Pre-K (4-5s)'],
    },
    {
      kind: 'select',
      name: 'certification',
      label: 'Do you hold an early childhood education certification or degree?',
      required: true,
      options: ['Yes', 'No', 'Currently pursuing'],
    },
    {
      kind: 'textarea',
      name: 'message',
      label: 'Briefly tell us about yourself and why you’re interested in teaching at WCP',
      required: true,
    },
    { kind: 'text', name: 'hearAbout', label: 'How did you hear about us?', optionalNote: true },
  ],
};
const extraFields = VARIANTS[variant] ?? VARIANTS.general;

const field =
  'mt-1 w-full rounded-lg border border-border bg-white px-3 py-2.5 text-ink shadow-sm focus:border-navy focus:ring-2 focus:ring-navy/30 focus:outline-none dark:bg-surface';
const label = 'block text-sm font-semibold text-heading';

// Turnstile is DORMANT until a site key is set (see docs/FORMS.md). When it
// is, the widget renders above the button and /api/contact verifies its token
// server-side (TURNSTILE_SECRET_KEY). Until then: honeypot only, no widget,
// no third-party script.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="mx-auto max-w-xl" data-contact-root>
  <form
    method="POST"
    action="/api/contact"
    class="grid gap-4"
    data-contact-form
    data-success={successMessage}
  >
    <input type="hidden" name="topic" value={topic} />
    {/* Honeypot: hidden from people, tempting to bots. Real users leave it blank. */}
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    {/* First + last name, like every form on the old site. */}
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={label} for={`${formId}-fname`}>First name</label>
        <input
          class={field}
          id={`${formId}-fname`}
          name="fname"
          type="text"
          required
          autocomplete="given-name"
        />
      </div>
      <div>
        <label class={label} for={`${formId}-lname`}>Last name</label>
        <input
          class={field}
          id={`${formId}-lname`}
          name="lname"
          type="text"
          required
          autocomplete="family-name"
        />
      </div>
    </div>
    <div>
      <label class={label} for={`${formId}-email`}>Email</label>
      <input
        class={field}
        id={`${formId}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
      />
    </div>
    {
      /* Phone is optional on EVERY variant (2026-07 friction pass). The old
         enroll form hard-required it, but a required phone stalls a parent who
         prefers email first — and /api/contact never required it server-side
         anyway. Email (required above) is the reply channel. */
      showPhone && (
        <div>
          <label class={label} for={`${formId}-phone`}>
            Phone <span class="font-normal text-ink-muted">(optional)</span>
          </label>
          <input class={field} id={`${formId}-phone`} name="phone" type="tel" autocomplete="tel" />
        </div>
      )
    }

    {
      extraFields.map((f) => {
        const id = `${formId}-${f.name}`;
        if (f.kind === 'checkboxes')
          return (
            <fieldset>
              <legend class={label}>{f.label}</legend>
              <div class="mt-1 flex flex-wrap gap-x-5 gap-y-2">
                {f.options.map((opt) => (
                  <label class="inline-flex items-center gap-2 text-ink">
                    <input
                      type="checkbox"
                      name={f.name}
                      value={opt}
                      class="h-4 w-4 rounded border-border text-navy focus:ring-2 focus:ring-navy/30"
                    />
                    {opt}
                  </label>
                ))}
              </div>
            </fieldset>
          );
        if (f.kind === 'select')
          return (
            <div>
              <label class={label} for={id}>
                {f.label}
              </label>
              <select class={field} id={id} name={f.name} required={f.required}>
                <option value="">Select an option…</option>
                {f.options.map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>
          );
        if (f.kind === 'textarea')
          return (
            <div>
              <label class={label} for={id}>
                {f.label}
                {!f.required && <span class="font-normal text-ink-muted"> (optional)</span>}
              </label>
              <textarea class={field} id={id} name={f.name} rows="5" required={f.required} />
            </div>
          );
        return (
          <div>
            <label class={label} for={id}>
              {f.label}
              {'optionalNote' in f && f.optionalNote && (
                <span class="font-normal text-ink-muted"> (optional)</span>
              )}
            </label>
            <input class={field} id={id} name={f.name} type={f.kind} required={f.required} />
          </div>
        );
      })
    }

    {
      turnstileKey && (
        <>
          <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto" />
          <script is:inline defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
        </>
      )
    }

    <p class="hidden text-sm text-destructive" data-form-error role="alert">
      Something went wrong. Please try again, or email us directly.
    </p>

    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-full bg-navy px-6 py-3 font-semibold text-white transition-colors hover:bg-heading disabled:opacity-60"
    >
      {buttonLabel}
    </button>
  </form>

  <div
    class="hidden rounded-2xl border border-border bg-white p-6 text-center dark:bg-surface"
    data-contact-success
    role="status"
  >
    <p class="font-display text-xl text-navy dark:text-sky">{successMessage}</p>
  </div>
</div>

<script>
  import '@/scripts/contact-form';
</script>
