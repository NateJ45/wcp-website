---
/* ============================================================================
   HubTabBar — phone-only bottom tab bar for the Family Hub (< md)
   ============================================================================
   THE app-navigation pattern on phones: Home (pinned), three Board-picked
   destinations (Family Hub menu → "Phone tab bar"; Calendar, Documents and
   Updates until the Board picks), and More (opens the existing off-canvas
   drawer for everything else via [data-hub-drawer-toggle]). Hidden ≥ md,
   where the top bar's menu (md–lg) or the rail (lg+) take over.

   THEME-STABLE NAVY ISLAND like the rail/top bar: identical in light and
   dark, so active/inactive tones are hardcoded (white active, white/65
   inactive — 7.5:1 on navy, AA for the 10px labels' bold weight). The bar
   respects the iPhone home-indicator inset via safe-area padding; BaseLayout
   pads the content column bottom so nothing hides underneath.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_NAV_MENU_QUERY } from '@/lib/queries';
import { resolveTabBar } from '@/lib/hub-nav-doc';

// The Board's picks for the middle slots (Family Hub menu → "Phone tab bar").
// Same cached query the rail pays for, so this read is free; any failure or an
// empty field keeps the shipped three.
let stored: unknown;
try {
  stored = (
    await sanityFetch<{ tabBar?: unknown } | null>(
      HUB_NAV_MENU_QUERY,
      {},
      { cache: BOARD_CONTENT_CACHE },
    )
  )?.tabBar;
} catch {
  stored = undefined;
}
const TABS = [{ label: 'Home', href: '/family-hub', icon: 'house' }, ...resolveTabBar(stored)];

// Active tab: exact match for Home, prefix match for the rest (so an update
// detail page keeps the Updates tab lit).
const path = new URL(Astro.request.url).pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/family-hub' ? path === '/family-hub' : path === href || path.startsWith(`${href}/`);
---

<nav
  aria-label="Hub quick navigation"
  data-hub-tabbar
  class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-navy pb-[env(safe-area-inset-bottom)] md:hidden"
>
  <ul class="grid" style={`grid-template-columns: repeat(${TABS.length + 1}, minmax(0, 1fr))`}>
    {
      TABS.map((tab) => (
        <li>
          <a
            href={tab.href}
            aria-current={isActive(tab.href) ? 'page' : undefined}
            data-tab-updates={tab.href === '/family-hub/updates' ? '' : undefined}
            class:list={[
              'relative flex flex-col items-center gap-0.5 px-1 pt-2 pb-1.5 text-[10px] font-bold tracking-wide uppercase',
              isActive(tab.href) ? 'text-white' : 'text-white/65',
            ]}
          >
            <Icon name={tab.icon} class="h-5 w-5" />
            {tab.label}
            {isActive(tab.href) && (
              <span class="absolute top-0 h-0.5 w-8 rounded-full bg-amber" aria-hidden="true" />
            )}
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        class="flex w-full flex-col items-center gap-0.5 px-1 pt-2 pb-1.5 text-[10px] font-bold tracking-wide text-white/65 uppercase"
        aria-label="More — open the full menu"
        aria-controls="hub-drawer"
        aria-expanded="false"
        data-hub-drawer-toggle
      >
        <Icon name="menu" class="h-5 w-5" />
        More
      </button>
    </li>
  </ul>
</nav>
