---
/* ============================================================================
   ClassHelperRow — the four class helper-schedule tiles on the Family Hub home
   ============================================================================
   One tile per class, tinted with the shared class-color helper (never a
   hardcoded color — see src/lib/class-colors.ts). Each links to that class's
   HELPER SCHEDULE Google Sheet — the single most-repeated parent task, so it
   gets the prime tiles (the class hub pages stay one click away in the rail).
   The sheet link is Board-editable on each `class` doc (`helperScheduleUrl`),
   with the current working sheets as fallbacks (live-links.ts); a class with
   no sheet link anywhere falls back to linking its class hub page.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { classStyles } from '@/lib/class-colors';
import { sanityFetch } from '@/lib/sanity';
import { helperScheduleFallback } from '@/data/hub/live-links';

const CLASSES = [
  { slug: 'twos', label: 'Twos', icon: 'blocks', pageHref: '/family-hub/twos' },
  { slug: 'threes', label: 'Threes', icon: 'crayon', pageHref: '/family-hub/threes' },
  { slug: 'pre-k-am', label: 'Pre-K AM', icon: 'sun', pageHref: '/family-hub/pre-k-am' },
  { slug: 'pre-k-pm', label: 'Pre-K PM', icon: 'moon', pageHref: '/family-hub/pre-k-pm' },
] as const;

interface HelperRow {
  slug?: string;
  helperScheduleUrl?: string;
}
let sanityLinks: Record<string, string> = {};
try {
  const rows = await sanityFetch<HelperRow[]>(
    `*[_type == "class"]{ "slug": slug.current, helperScheduleUrl }`,
  );
  for (const r of rows ?? [])
    if (r.slug && r.helperScheduleUrl) sanityLinks[r.slug] = r.helperScheduleUrl;
} catch {
  sanityLinks = {};
}

const tiles = CLASSES.map((c) => {
  const sheet = sanityLinks[c.slug] ?? helperScheduleFallback[c.slug];
  return { ...c, href: sheet ?? c.pageHref, external: Boolean(sheet) };
});
---

{
  /* 2x2 in the bento's 8-col cell (chunkier tiles than a thin 4-up strip);
    h-full so the block fills its grid row beside the tall events tile. */
}
<ul class="grid h-full gap-4 sm:grid-cols-2">
  {
    tiles.map((c) => {
      const styles = classStyles(c.slug);
      return (
        <li>
          <a
            href={c.href}
            {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
            class={`group flex h-full items-center gap-3 rounded-[var(--radius)] border-2 bg-white p-4 no-underline shadow-sm transition-[transform,box-shadow] hover:-translate-y-0.5 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0 dark:bg-surface ${styles.border}`}
            data-reveal
          >
            <span
              class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${styles.iconChip}`}
              aria-hidden="true"
            >
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-bold text-heading">{c.label}</span>
              <span class="block text-[0.68rem] font-semibold tracking-wide text-ink-muted uppercase">
                Helper schedule
              </span>
            </span>
            {c.external && (
              <Icon name="external-link" class="h-3.5 w-3.5 shrink-0 text-ink-muted" />
            )}
          </a>
        </li>
      );
    })
  }
</ul>
