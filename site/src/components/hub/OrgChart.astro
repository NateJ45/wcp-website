---
/* ============================================================================
   OrgChart — how WCP's co-op runs, as a real chart (the old site's flow)
   ============================================================================
   Rebuilt from the old Squarespace chart: tiered person cards instead of a
   file-tree. Executive Board (president over the three officers) → Paid
   Staff → the two cabinet branches ("Reports to Secretary" / "Reports to
   VP", each chair with the committees it leads) → every family, with a live
   Directory count. WHO holds each role is Board-editable in the Studio
   (Family Hub → "Who's who this year"), merged over the committed fallback in
   src/data/hub/org-holders.ts by src/lib/hub-org.ts — so the post-election
   update needs no deploy. This file and org-holders own only the chart's SHAPE.
   Role descriptions stay in the section above the chart.

   Tier colors follow the old chart's key — president orange, board navy,
   staff sky, chairs amber, class reps green — as avatar RINGS (decorative)
   plus `-ink` role text (AA on the card surface in both themes). Mobile:
   every row wraps and the columns stack; nothing scrolls sideways at 320px.
   ============================================================================ */
import OrgPersonCard from '@/components/hub/OrgPersonCard.astro';
// Plain <img> + pre-sized webp (not astro:assets): SSR hub pages can't resize
// at request time on the Cloudflare adapter (see HubRail's note).
import wcpEmblem from '@/assets/brand/wcp-emblem-sm.webp';
import { sanityFetch } from '@/lib/sanity';
import { DIRECTORY_FAMILY_COUNT_QUERY, ROLE_HOLDERS_QUERY } from '@/lib/queries';
import { toHolderMap, applyHolder, applyHolders, type RoleHolderRow } from '@/lib/hub-org';
import {
  president as presidentFallback,
  officers as officersFallback,
  paidStaff as paidStaffFallback,
  secretaryBranch as secretaryBranchFallback,
  vpBranch as vpBranchFallback,
  classReps as classRepsFallback,
} from '@/data/hub/org-holders';

const TIER = {
  president: { ring: 'border-[#ff8c00]', role: 'text-orange-ink' },
  board: { ring: 'border-navy dark:border-[#7dd3fc]', role: 'text-sky-ink' },
  staff: { ring: 'border-[#40aaed]', role: 'text-sky-ink' },
  chair: { ring: 'border-[#ffa334]', role: 'text-amber-ink' },
  rep: { ring: 'border-[#22c55e]', role: 'text-green-ink' },
} as const;

// The two reads are independent — start both, await after (2026-07 hub-speed
// pass). The holders read carries PII once a rep is linked to the Directory, so
// it passes NO cache; the count is a scalar and could, but there is nothing to
// gain caching one of a pair.
const countPromise = sanityFetch<number>(DIRECTORY_FAMILY_COUNT_QUERY).catch(() => null);
const holdersPromise = sanityFetch<RoleHolderRow[]>(ROLE_HOLDERS_QUERY).catch(() => null);

const familyCount = await countPromise;

// WHO holds each seat comes from the Studio ("Who's who this year"); the tiers,
// branches, icons and committee sizes below stay code-owned. An unreachable
// Sanity leaves `holders` empty, and every seat falls back to the committed
// names — the chart is never blank.
const holders = toHolderMap(await holdersPromise);
const president = applyHolder(presidentFallback, holders);
const officers = applyHolders(officersFallback, holders);
const paidStaff = applyHolders(paidStaffFallback, holders);
const classReps = applyHolders(classRepsFallback, holders);
const secretaryBranch = secretaryBranchFallback.map((s) => ({
  ...s,
  chair: applyHolder(s.chair, holders),
}));
const vpBranch = vpBranchFallback.map((s) => ({ ...s, chair: applyHolder(s.chair, holders) }));
---

<div class="org-chart text-center">
  {/* Color key — mirrors the old chart's legend (neutral labels, colored dots). */}
  <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs font-semibold text-ink-muted">
    <li class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff8c00]" aria-hidden="true"></span>President
    </li>
    <li class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-navy dark:bg-[#7dd3fc]" aria-hidden="true"
      ></span>Executive Board
    </li>
    <li class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#40aaed]" aria-hidden="true"></span>Paid Staff
    </li>
    <li class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ffa334]" aria-hidden="true"></span>Cabinet Chair
    </li>
    <li class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#22c55e]" aria-hidden="true"></span>Class Rep
    </li>
  </ul>

  {/* ── Executive Board ── */}
  <div class="mt-6 rounded-[var(--radius)] border border-navy/25 p-4 sm:p-6 dark:border-white/20">
    <p class="text-xs font-extrabold tracking-widest text-heading uppercase">Executive Board</p>
    <p class="mx-auto mt-1 max-w-md text-xs text-ink-muted">
      Elected each spring, serving one-year terms. Meets monthly to set policy, manage finances, and
      oversee school operations.
    </p>
    <div class="mt-4 flex justify-center">
      <OrgPersonCard person={president} large {...TIER.president} />
    </div>
    <div class="org-vline" aria-hidden="true"></div>
    <div class="flex flex-wrap justify-center gap-3">
      {officers.map((p) => <OrgPersonCard person={p} {...TIER.board} />)}
    </div>
  </div>

  {/* ── Paid Staff ── */}
  <div class="org-vline" aria-hidden="true"></div>
  <p class="text-xs font-extrabold tracking-widest text-sky-ink uppercase">Paid Staff</p>
  <p class="mx-auto mt-1 max-w-md text-xs text-ink-muted">
    The teachers and administrator are the school's only paid employees.
  </p>
  <div class="mt-4 flex flex-wrap justify-center gap-3">
    {paidStaff.map((p) => <OrgPersonCard person={p} {...TIER.staff} />)}
  </div>

  {/* ── Cabinet branches ── */}
  <div class="org-vline" aria-hidden="true"></div>
  <p class="text-xs font-extrabold tracking-widest text-amber-ink uppercase">Cabinet</p>
  <p class="mx-auto mt-1 max-w-md text-xs text-ink-muted">
    Chair-level roles split between two Board officers; each chair leads a small team of co-op
    members.
  </p>
  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    {/* Left: the Secretary's cabinet */}
    <div class="rounded-[var(--radius)] border border-border p-4">
      <p class="text-xs font-extrabold tracking-widest text-heading uppercase">
        Reports to Secretary
      </p>
      <div class="mt-4 rounded-xl bg-grey/60 p-3">
        <div class="grid grid-cols-1 justify-items-center gap-3 sm:grid-cols-2">
          {classReps.map((p) => <OrgPersonCard person={p} {...TIER.rep} />)}
        </div>
        <div class="org-vline" aria-hidden="true"></div>
        <p
          class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink dark:bg-surface"
        >
          Teacher's Aides · 2-4 members
        </p>
      </div>
      {
        secretaryBranch.map((s) => (
          <div class="mt-4 rounded-xl bg-grey/60 p-3">
            <div class="flex justify-center">
              <OrgPersonCard person={s.chair} {...TIER.chair} />
            </div>
            {s.teams && s.teams.length > 0 && (
              <>
                <div class="org-vline" aria-hidden="true" />
                <div class="flex flex-wrap justify-center gap-2">
                  {s.teams.map((t) => (
                    <p class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink dark:bg-surface">
                      {t.label} · {t.size}
                    </p>
                  ))}
                </div>
              </>
            )}
          </div>
        ))
      }
    </div>
    {/* Right: the VP's cabinet */}
    <div class="rounded-[var(--radius)] border border-border p-4">
      <p class="text-xs font-extrabold tracking-widest text-heading uppercase">Reports to VP</p>
      {
        vpBranch.map((s) => (
          <div class="mt-4 rounded-xl bg-grey/60 p-3">
            <div class="flex justify-center">
              <OrgPersonCard person={s.chair} {...TIER.chair} />
            </div>
            {s.teams && s.teams.length > 0 && (
              <>
                <div class="org-vline" aria-hidden="true" />
                <div class="flex flex-wrap justify-center gap-2">
                  {s.teams.map((t) => (
                    <p class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink dark:bg-surface">
                      {t.label} · {t.size}
                    </p>
                  ))}
                </div>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>

  {/* ── Everyone ── */}
  <div class="org-vline" aria-hidden="true"></div>
  <a
    href="/family-hub/directory"
    class="inline-flex flex-col items-center gap-1 rounded-[var(--radius)] border border-amber bg-cream/60 px-8 py-4 no-underline transition-shadow hover:shadow-md dark:bg-white/5"
  >
    <img
      src={wcpEmblem.src}
      width={wcpEmblem.width}
      height={wcpEmblem.height}
      alt=""
      aria-hidden="true"
      class="mb-0.5 h-11 w-11 object-contain"
    />
    <span class="font-bold text-heading">All WCP Families</span>
    <span class="text-sm text-ink-muted">
      {
        familyCount
          ? `${familyCount} famil${familyCount === 1 ? 'y' : 'ies'} in the Directory · open it`
          : 'Every enrolled family holds one job · open the Directory'
      }
    </span>
  </a>
</div>

<style>
  /* Short connector line between tiers (decorative). */
  .org-chart :global(.org-vline) {
    width: 2px;
    height: 1.25rem;
    margin: 0.75rem auto;
    background: var(--color-border);
  }
</style>
