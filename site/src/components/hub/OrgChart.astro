---
/* ============================================================================
   OrgChart — how WCP's co-op roles report to one another
   ============================================================================
   A vertical, indented tree (file-tree style) so it stays readable on a phone
   and reads correctly as a nested list to screen readers. Structure mirrors the
   reporting lines in src/data/hub/coop-roles.ts (reportsTo). Role descriptions
   live in the section below; this is just the shape of the org.
   ============================================================================ */
import OrgNode, { type OrgNodeData } from './OrgNode.astro';

const tree: OrgNodeData = {
  name: 'President',
  icon: 'award',
  children: [
    {
      name: 'Vice President',
      icon: 'shield-check',
      children: [
        {
          name: 'Facilities Chair',
          icon: 'building-2',
          children: [
            { name: 'Playground Committee', icon: 'trees' },
            { name: 'Laundry', icon: 'house' },
          ],
        },
        {
          name: 'Family Activities Chair',
          icon: 'party-popper',
          children: [{ name: 'Family Activities Committee', icon: 'gift' }],
        },
        {
          name: 'Fundraising Chair',
          icon: 'hand-heart',
          children: [{ name: 'Fundraising Committee', icon: 'coins' }],
        },
      ],
    },
    { name: 'Treasurer', icon: 'piggy-bank' },
    {
      name: 'Secretary',
      icon: 'notebook-pen',
      children: [
        {
          name: 'Publicity Chair',
          icon: 'megaphone',
          children: [{ name: 'Publicity Assistants', icon: 'camera' }],
        },
        { name: 'Enrichment Coordinator', icon: 'sparkles' },
        { name: 'Class Representatives', icon: 'users' },
        { name: 'Copy Room Helper', icon: 'file-text' },
      ],
    },
  ],
};
---

<div class="org-chart mx-auto max-w-2xl overflow-x-auto">
  <ul class="org-root">
    <OrgNode node={tree} />
  </ul>
</div>

<style>
  .org-chart :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .org-chart :global(.org-children) {
    margin-left: 1.1rem;
    border-left: 2px solid var(--color-border);
    padding-left: 1.25rem;
  }
  .org-chart :global(.org-node) {
    position: relative;
    padding: 0.3rem 0;
  }
  /* horizontal tick from the vertical line to each child card */
  .org-chart :global(.org-children) > :global(.org-node)::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 1.35rem;
    width: 1rem;
    height: 2px;
    background: var(--color-border);
  }
  .org-chart :global(.org-card) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.2;
  }
</style>
