---
/* ============================================================================
   HubHeader — dedicated chrome for the gated Family Hub
   ============================================================================
   Replaces the public marketing header on hub pages, and folds the old
   pill-band navigation INTO the header itself. A solid navy bar: logo → hub
   home, the section nav (Home + Information / Community / Classes dropdowns),
   one "Main site" link back to the public site, and Sign out. Reuses the shared
   nav script (src/scripts/nav.ts) for dropdown + mobile-panel behavior, matching
   the marketing header's interaction and a11y.
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { hubNav } from '@/data/hub-nav';
import { cn } from '@/lib/utils';
import wcpLogoWhite from '@/assets/brand/wcp-logo-white.png';
import { site } from '@/data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(href) === path;
const groupActive = (links: { href: string; external?: boolean }[]) =>
  links.some((l) => !l.external && isActive(l.href));

// hubNav[0] is the single "Home" entry; the rest are dropdown groups.
const homeLink = hubNav[0].links[0];
const groups = hubNav.slice(1);
---

<header data-header class="sticky top-0 z-40 border-b border-white/10 bg-navy">
  {/* ---------------------------------------------------------------- Desktop */}
  <div class="hidden lg:block">
    <div class="wcp-container flex items-center justify-between gap-6 py-2.5">
      <a href="/family-hub" class="inline-flex shrink-0 items-center" aria-label="Family Hub home">
        <Image src={wcpLogoWhite} alt={site.name} width={240} height={160} class="h-11 w-auto" />
      </a>

      <nav aria-label="Family Hub" class="flex items-center gap-1">
        <a
          href={homeLink.href}
          class="hub-link"
          data-active={isActive(homeLink.href) ? '' : undefined}
        >
          <Icon name={homeLink.icon} class="h-4 w-4" />
          {homeLink.label}
        </a>
        {
          groups.map((group, i) => (
            <div class="relative">
              <button
                type="button"
                class="hub-link"
                aria-expanded="false"
                aria-controls={`hub-menu-${i}`}
                data-dropdown-trigger
                data-active={groupActive(group.links) ? '' : undefined}
              >
                {group.label}
                <Icon name="chevron-down" class="h-4 w-4" />
              </button>
              <ul
                id={`hub-menu-${i}`}
                data-dropdown-menu
                class="absolute top-full left-0 z-50 mt-1.5 min-w-52 rounded-lg border border-border bg-white p-2 shadow-lg"
              >
                {group.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="flex items-center gap-2 rounded-md px-3 py-2 font-semibold text-navy hover:bg-grey hover:text-orange-ink"
                      aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
                      {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      <Icon name={l.icon} class="h-4 w-4 text-sky-ink" />
                      <span class="flex-1">{l.label}</span>
                      {l.external && (
                        <Icon name="external-link" class="h-3.5 w-3.5 text-ink-muted" />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold text-white/80 transition-colors hover:bg-white/10 hover:text-white"
        >
          <Icon name="external-link" class="h-4 w-4" />
          Main site
        </a>
        <form method="POST" action="/api/hub-logout">
          <button
            type="submit"
            class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-bold text-white transition-colors hover:bg-white/20"
          >
            <Icon name="log-out" class="h-4 w-4" />
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>

  {/* ----------------------------------------------------------------- Mobile */}
  <div class="lg:hidden">
    <div class="wcp-container flex items-center justify-between gap-3 py-2.5">
      <a href="/family-hub" class="inline-flex items-center" aria-label="Family Hub home">
        <Image src={wcpLogoWhite} alt={site.name} width={240} height={160} class="h-10 w-auto" />
      </a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md text-white hover:bg-white/10"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
        data-nav-toggle
      >
        <Icon name="menu" class="menu-icon h-6 w-6" />
        <Icon name="x" class="close-icon hidden h-6 w-6" />
      </button>
    </div>

    <div id="mobile-nav" hidden class="border-t border-white/10 bg-navy">
      <nav aria-label="Family Hub" class="wcp-container py-4">
        <a
          href={homeLink.href}
          class="flex items-center gap-2 rounded-md px-2 py-2.5 font-semibold text-white hover:bg-white/10"
          aria-current={isActive(homeLink.href) ? 'page' : undefined}
        >
          <Icon name={homeLink.icon} class="h-4 w-4" />
          {homeLink.label}
        </a>
        {
          groups.map((group) => (
            <div class="mt-2">
              <p class="px-2 pt-2 text-xs font-bold tracking-wide text-amber uppercase">
                {group.label}
              </p>
              {group.links.map((l) => (
                <a
                  href={l.href}
                  class="flex items-center gap-2 rounded-md px-2 py-2.5 font-semibold text-white hover:bg-white/10"
                  aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
                  {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <Icon name={l.icon} class="h-4 w-4 text-white/70" />
                  <span class="flex-1">{l.label}</span>
                  {l.external && <Icon name="external-link" class="h-3.5 w-3.5 text-white/50" />}
                </a>
              ))}
            </div>
          ))
        }
        <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-4">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 font-semibold text-white/80 hover:text-white"
          >
            <Icon name="external-link" class="h-4 w-4" />
            Main site
          </a>
          <form method="POST" action="/api/hub-logout">
            <button
              type="submit"
              class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 font-bold text-white hover:bg-white/20"
            >
              <Icon name="log-out" class="h-4 w-4" />
              Sign out
            </button>
          </form>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  import '@/scripts/nav';
</script>

<style>
  /* Navy-header nav link/trigger (white on navy). Rendered by THIS component,
     so the styles must live here (Astro scopes <style> per component). */
  .hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    padding: 0.5rem 0.85rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .hub-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
  }
  .hub-link[data-active] {
    color: var(--color-navy);
    background-color: #ffffff;
  }

  /* Dropdown menus — hidden until nav.ts sets data-open on the same element. */
  [data-dropdown-menu] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }
  [data-dropdown-menu][data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* Hamburger <-> X swap. */
  [data-nav-toggle][aria-expanded='true'] .menu-icon {
    display: none;
  }
  [data-nav-toggle][aria-expanded='true'] .close-icon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-dropdown-menu] {
      transition: none;
    }
  }
</style>
