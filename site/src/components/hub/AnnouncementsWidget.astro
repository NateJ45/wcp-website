---
/* ============================================================================
   AnnouncementsWidget — pinned + most-recent `update` docs (the same source
   as the full Updates page). Pinned first, then newest, capped at 6 (enough to
   fill the card's height beside taller widgets rather than leaving dead space).
   Meeting minutes are `update` docs too (category "minutes") — they belong to
   the Meeting Minutes widget, so they're filtered out here. `coalesce` keeps
   older docs (written before the category field existed) counting as
   announcements.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import { sanityFetch } from '@/lib/sanity';
import { EVENT_TZ } from '@/lib/events';
import { formatShortDate } from '@/lib/hub-dashboard-dates';

interface UpdateDoc {
  _id: string;
  title: string;
  publishedAt: string;
  pinned?: boolean;
  slug?: string;
}
let updates: UpdateDoc[] = [];
try {
  updates = await sanityFetch<UpdateDoc[]>(
    // `showUntil` lets a pinned announcement (e.g. a snow-day notice) drop off
    // the home on its own; it still lives in the full Updates list.
    `*[_type == "update" && coalesce(category, "announcement") == "announcement" && (!defined(showUntil) || showUntil >= now())] | order(pinned desc, publishedAt desc)[0...6]{ _id, title, publishedAt, pinned, "slug": slug.current }`,
  );
} catch {
  updates = [];
}

const fmt = (iso: string) => formatShortDate(iso, EVENT_TZ);
---

<HomeWidgetCard
  icon="newspaper"
  title="Announcements"
  seeAllHref="/family-hub/updates"
  postit
  empty={updates.length === 0}
  emptyText="Board and administrator announcements will list here once posted."
>
  {
    /* Two columns on sm+ so the wide (col-span-8) home slot fills its width
      instead of stranding a thin list beside a big empty gap. */
  }
  <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
    {
      updates.map((u) => (
        /* data-published feeds the "new since your last visit" pills
           (src/scripts/hub-fresh.ts). */
        <li data-published={u.publishedAt}>
          {u.slug ? (
            <a
              href={`/family-hub/updates/${u.slug}`}
              class="font-semibold text-heading hover:underline"
            >
              {u.pinned && (
                <span class="mr-1 text-orange-ink" aria-hidden="true">
                  •
                </span>
              )}
              {u.pinned && <span class="sr-only">Pinned: </span>}
              {u.title}
            </a>
          ) : (
            <p class="font-semibold text-heading">
              {u.pinned && (
                <span class="mr-1 text-orange-ink" aria-hidden="true">
                  •
                </span>
              )}
              {u.pinned && <span class="sr-only">Pinned: </span>}
              {u.title}
            </p>
          )}
          <p class="text-sm text-ink-muted">{fmt(u.publishedAt)}</p>
        </li>
      ))
    }
  </ul>
</HomeWidgetCard>
