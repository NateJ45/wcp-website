---
/* ============================================================================
   ClassRepCard — the class parent rep, beside the teacher card
   ============================================================================
   Mirrors TeacherCard's layout (photo/icon ring + name + contact) so the class
   page opens with the people who run the room: the teacher, then one parent rep
   per class. Each class elects ONE rep in the fall, so until then the card is a
   designed placeholder ("To be announced") that reserves the seat. Reps live in
   src/data/hub/org-holders.ts (`classReps`, code-owned so a name/email can be
   filled in even while the Studio is unavailable); pass the `role` that matches
   a classReps entry. Always renders — the empty seat is the point.

   WHO the rep is, and how to reach her, both come from the Studio (Family Hub →
   "Who's who this year"), read per request behind the gate and merged over the
   committed fallback by src/lib/hub-org.ts. Her email and phone are never typed
   here: the role document LINKS to her Directory entry and the query resolves
   them from it, so they live in exactly one place and this public repo holds
   none of them. Contact links mirror TeacherCard's row ("Say hi" / "Call or
   text"). No document, no Directory link, or a family who opted out all degrade
   to a card with the name and no links.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { classReps } from '@/data/hub/org-holders';
import { classStyles } from '@/lib/class-colors';
import { urlForImage, type SanityImageSource } from '@/lib/image';
import { telHref, applyHolder, type Holder } from '@/lib/hub-org';

interface Props {
  /** Class slug for the accent color (e.g. 'pre-k-am', 'twos'). */
  slug: string;
  /** Role label to look up in `classReps`, e.g. 'Pre-K AM Rep'. */
  role: string;
  /** Subtitle under the name, e.g. 'Morning class rep · 2026-27'. */
  label: string;
  /** Role holders from the page's single read, keyed by role label. */
  holders?: Map<string, Holder>;
}
const { slug, role, label, holders } = Astro.props;

const fallback = classReps.find((r) => r.role === role);
const person = fallback ? applyHolder(fallback, holders) : undefined;
const cc = classStyles(slug);
const named = Boolean(person?.name);

const email = person?.email;
const tel = telHref(person?.phone);
// A headshot the Board uploaded to the role document. Sized through the Sanity
// CDN, not astro:assets — this is an SSR page and the adapter cannot resize at
// request time (it would serve the full-size upload into an 80px circle).
const photoUrl = person?.sanityPhoto?.asset
  ? urlForImage(person.sanityPhoto as SanityImageSource)
      .width(160)
      .url()
  : null;
---

<div
  class="hub-note flex h-full items-center gap-4 rounded-[var(--radius)] border border-border bg-white p-6 shadow-sm dark:bg-surface"
>
  {
    photoUrl ? (
      <img
        src={photoUrl}
        alt={`${person!.name}, class rep`}
        width="80"
        height="80"
        loading="lazy"
        class={`h-20 w-20 shrink-0 rounded-full border-4 object-cover object-top ${cc.border}`}
      />
    ) : (
      <span
        class={`flex h-20 w-20 shrink-0 items-center justify-center rounded-full ${cc.iconChip}`}
        aria-hidden="true"
      >
        <Icon name="hand-heart" class="h-8 w-8" />
      </span>
    )
  }
  <div class="min-w-0">
    <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Class rep</p>
    {
      named ? (
        <p class="font-display text-xl text-heading">{person!.name}</p>
      ) : (
        <p class="font-display text-xl text-ink-muted">To be announced</p>
      )
    }
    <p class="text-sm text-ink-muted">{label}</p>
    {
      named && (email || tel) && (
        <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
          {email && (
            <a
              href={`mailto:${email}`}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-ink hover:underline"
            >
              <Icon name="mail" class="h-3.5 w-3.5" aria-hidden="true" />
              Say hi
            </a>
          )}
          {tel && (
            <a
              href={tel}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-ink hover:underline"
            >
              <Icon name="phone" class="h-3.5 w-3.5" aria-hidden="true" />
              Call or text
            </a>
          )}
        </div>
      )
    }
  </div>
</div>
