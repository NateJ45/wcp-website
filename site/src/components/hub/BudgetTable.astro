---
/* ============================================================================
   BudgetTable — the member-approved operating budget, as a polished hub table
   ============================================================================
   A summary trio (target revenue / total expenses / net) with a
   revenue-vs-expenses balance bar, then one card per budget section with every
   line's this-year figure, last-year comparison, and note, plus a subtotal.
   Revenue groups accent green, expenses navy. Full width (fills the doc column
   — no dangling reading-cap gap), responsive by flex rows (no fixed table
   columns), reduced-motion-safe.

   The budget is Board-editable in the Studio (Money & payments → Operating
   budget), read here per request; src/data/hub/budget.ts is the committed
   fallback for when Sanity has nothing or is unreachable. It used to be the only
   source, which meant the Treasurer could not update her own approved budget
   without a developer.

   EVERY total is derived from the lines by src/lib/budget.ts — group subtotals
   and all three headline figures. Nothing here is typed twice, so the summary
   cannot contradict the table under it.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import HubCard from '@/components/hub/HubCard.astro';
import { budgetGroups as budgetGroupsFallback, budgetMeta } from '@/data/hub/budget';
import { cn } from '@/lib/utils';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { OPERATING_BUDGET_QUERY } from '@/lib/queries';
import { budgetTotals, groupTotal, groupPriorTotal, type BudgetGroup } from '@/lib/budget';

const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const signed = (n: number) => (n < 0 ? `−${money(Math.abs(n))}` : money(n));

interface BudgetDoc {
  year?: string;
  enrollment?: string;
  netNote?: string;
  source?: string;
  groups?: BudgetGroup[];
}
// No PII here, so it rides the shared Board-content cache like the other
// singletons — the budget changes about once a year.
let doc: BudgetDoc | null = null;
try {
  doc = await sanityFetch<BudgetDoc | null>(
    OPERATING_BUDGET_QUERY,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
} catch {
  doc = null;
}

// Per field, so a half-filled document still renders rather than blanking the
// page: Studio value, else the committed budget.
const groups: BudgetGroup[] =
  doc?.groups && doc.groups.length > 0 ? doc.groups : (budgetGroupsFallback as BudgetGroup[]);
const meta = {
  year: doc?.year || budgetMeta.year,
  enrollment: doc?.enrollment || budgetMeta.enrollment,
  netNote: doc?.netNote || budgetMeta.netNote,
  source: doc?.source || budgetMeta.source,
};

const { revenue: targetRevenue, expenses: totalExpenses, net } = budgetTotals(groups);
// Guard the balance bar's divisor: an empty budget would divide by zero and
// render width:NaN%.
const barMax = Math.max(targetRevenue, totalExpenses) || 1;

// Per-group accent + icon (kind drives the color; key picks the glyph).
const GROUP_ICON: Record<string, string> = {
  revenue: 'circle-dollar-sign',
  fundraising: 'party-popper',
  operating: 'building-2',
  programs: 'graduation-cap',
};
const accentFor = (kind: 'revenue' | 'expense') =>
  kind === 'revenue'
    ? { chip: 'bg-green/20 text-green-ink', dot: 'bg-green', tint: 'var(--color-green)' }
    : { chip: 'bg-sky/15 text-sky-ink', dot: 'bg-navy dark:bg-sky', tint: 'var(--color-navy)' };
---

<section aria-labelledby="budget-heading" class="mt-12">
  <h2 id="budget-heading" class="text-xl font-extrabold text-heading">The full budget</h2>
  <p class="mt-1 max-w-2xl text-ink-muted">
    Our member-approved {meta.year} operating budget, line by line, with last year for comparison.
    {meta.enrollment}; every extra summer enrollment moves us further into the black.
  </p>

  {/* Summary — target revenue / total expenses / net, plus a balance bar. */}
  <HubCard class="mt-6" style="--note-accent: var(--color-green)">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl bg-grey/60 p-4 dark:bg-white/5">
        <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Target revenue</p>
        <p class="mt-1 font-display text-3xl text-heading tabular-nums">{money(targetRevenue)}</p>
        <p class="mt-0.5 text-xs text-ink-muted">Tuition, fees & fundraising</p>
      </div>
      <div class="rounded-xl bg-grey/60 p-4 dark:bg-white/5">
        <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Total expenses</p>
        <p class="mt-1 font-display text-3xl text-heading tabular-nums">{money(totalExpenses)}</p>
        <p class="mt-0.5 text-xs text-ink-muted">Operations, payroll & programs</p>
      </div>
      <div class="rounded-xl bg-amber/15 p-4">
        <p class="text-xs font-semibold tracking-wide text-orange-ink uppercase">Net position</p>
        <p class="mt-1 font-display text-3xl text-orange-ink tabular-nums">{signed(net)}</p>
        <p class="mt-0.5 text-xs text-ink-muted">{meta.netNote}</p>
      </div>
    </div>

    {/* Balance bar: revenue vs expenses, near-identical by design. */}
    <div class="mt-5 space-y-2" aria-hidden="true">
      <div class="flex items-center gap-3">
        <span class="w-20 shrink-0 text-xs font-semibold text-ink-muted">Revenue</span>
        <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-grey dark:bg-white/10">
          <span
            class="block h-full rounded-full bg-green"
            style={`width:${(targetRevenue / barMax) * 100}%`}></span>
        </span>
        <span class="w-20 shrink-0 text-right text-xs font-bold text-heading tabular-nums"
          >{money(targetRevenue)}</span
        >
      </div>
      <div class="flex items-center gap-3">
        <span class="w-20 shrink-0 text-xs font-semibold text-ink-muted">Expenses</span>
        <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-grey dark:bg-white/10">
          <span
            class="block h-full rounded-full bg-navy dark:bg-sky"
            style={`width:${(totalExpenses / barMax) * 100}%`}></span>
        </span>
        <span class="w-20 shrink-0 text-right text-xs font-bold text-heading tabular-nums"
          >{money(totalExpenses)}</span
        >
      </div>
    </div>
  </HubCard>

  {/* One card per budget group. */}
  <div class="mt-4 grid gap-4">
    {
      groups.map((g) => {
        const a = accentFor(g.kind === 'revenue' ? 'revenue' : 'expense');
        const now = groupTotal(g);
        const was = groupPriorTotal(g);
        return (
          <HubCard class="min-w-0 overflow-hidden p-0" style={`--note-accent: ${a.tint}`}>
            <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
              <span class="flex min-w-0 items-center gap-2.5">
                <span
                  class={cn(
                    'flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                    a.chip,
                  )}
                  aria-hidden="true"
                >
                  <Icon
                    name={
                      g.icon ||
                      GROUP_ICON[(g as { key?: string }).key ?? ''] ||
                      'circle-dollar-sign'
                    }
                    class="h-4.5 w-4.5"
                  />
                </span>
                <span class="font-display text-lg leading-tight text-heading">{g.label}</span>
              </span>
              <span class="shrink-0 text-right">
                <span class="block font-display text-xl text-heading tabular-nums">
                  {money(now)}
                </span>
                <span class="block text-xs text-ink-muted tabular-nums">was {money(was)}</span>
              </span>
            </div>
            <ul class="divide-y divide-border px-5">
              {(g.lines ?? []).map((l) => (
                <li class="flex items-start justify-between gap-4 py-3">
                  <span class="min-w-0">
                    <span class="block font-semibold text-heading">{l.label}</span>
                    {l.note && (
                      <span class="mt-0.5 block text-xs leading-relaxed text-ink-muted">
                        {l.note}
                      </span>
                    )}
                  </span>
                  <span class="shrink-0 text-right">
                    <span class="block font-bold text-heading tabular-nums">
                      {money(l.now ?? 0)}
                    </span>
                    {/* A brand-new line has no prior figure — show nothing
                        rather than "was $0", which reads as a real number. */}
                    {typeof l.was === 'number' && (
                      <span class="block text-xs text-ink-muted tabular-nums">
                        was {money(l.was)}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </HubCard>
        );
      })
    }
  </div>
</section>
