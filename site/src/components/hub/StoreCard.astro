---
/* ============================================================================
   StoreCard — the flair-forward "official store" panel on the hub home
   ============================================================================
   A deep, textured navy banner at the bottom of the Family Hub dashboard that
   links out to the merch store. It pulls the catalog LIVE from Fourthwall
   (src/lib/fourthwall.ts):
     - getStoreCollections() → the store's categories, shown as a CSS-only tab
       row (radio inputs + :has() — no JS, so it works inside the server
       island). Pick a category and its products swap in.
     - getStoreProducts(slug) → up to 12 products per category, in a carousel
       with prev/next arrows (hub-store.ts; the native scrollbar is hidden, the
       next tile peeks). "Featured" leads and is the default-open tab.
   Falls back to the whole catalog, or the Board-curated Site Settings tiles, as
   a single rail if no collections come back, and shows a "supporting our co-op"
   sales stat (aggregate order totals, no PII). Rendered as a server island (see
   index.astro) so its fetches never block the dashboard. Renders nothing
   without a store URL. Motion is reduced-motion-safe.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { hubEditAttr } from '@/lib/hub-preview';
import HubWatermark from '@/components/hub/HubWatermark.astro';
import { getStoreProducts, getStoreCollections, getMerchStats } from '@/lib/fourthwall';

interface Product {
  title?: string;
  price?: string;
  url?: string;
  image?: string;
}
interface Props {
  url?: string;
  headline?: string;
  tagline?: string;
  products?: Product[];
}
const { url, headline, tagline, products = [] } = Astro.props;

const heading = headline || 'The Official WCP Store';
const blurb =
  tagline ||
  'Every purchase supports our co-op. Tees, hoodies, hats, and more, all in West Chester Preschool colors.';

// Categories + their products + the sales stat, all fetched CONCURRENTLY (every
// call cached with its own timeout + graceful fallback, so none stalls the card).
// Real store collections only (no synthetic "Everything"); "Featured" leads and
// is the default-open tab.
const collections = await getStoreCollections(5);
const catDefs = [...collections].sort(
  (a, b) => (/featured/i.test(a.title) ? 0 : 1) - (/featured/i.test(b.title) ? 0 : 1),
);
const [productsByCat, stats] = await Promise.all([
  Promise.all(catDefs.map((c) => getStoreProducts(c.slug, 12))),
  getMerchStats(),
]);

// One tab per category that actually has products. If no live collections come
// back, fall back to the whole catalog (or the Board-curated tiles) as one rail.
let tabs: { slug: string; title: string; products: Product[] }[] = catDefs
  .map((c, i) => ({ slug: c.slug, title: c.title, products: productsByCat[i] as Product[] }))
  .filter((t) => t.products.length > 0);
if (!tabs.length) {
  const live = await getStoreProducts('all', 12);
  const base = live.length ? live : (products ?? []).filter((p) => p?.url && p?.image).slice(0, 12);
  if (base.length) tabs = [{ slug: 'all', title: 'Shop', products: base }];
}
const hasTabs = tabs.length > 1;

// CSS-only category switching: hide every panel, show the one whose radio is
// checked (:has on the wrapper). One tab → always show the single panel.
// The hide + reveal pair lives inside @supports selector(:has(*)): a bare
// `display:none` here left the ENTIRE product area empty in :has()-less
// browsers (Firefox ESR 115, Safari <=15.3), since only a :has() rule ever
// showed a panel. Without support, every rail simply renders stacked —
// content over choreography.
const panelCss = hasTabs
  ? '@supports selector(:has(*)){\n.wcp-store-panel{display:none}\n' +
    tabs
      .map(
        (_, i) => `.wcp-store-tabs:has(#wcp-cat-${i}:checked) [data-panel="${i}"]{display:block}`,
      )
      .join('\n') +
    '\n}'
  : '.wcp-store-panel{display:block}';

const salesLine =
  stats && stats.orderCount > 0
    ? `${stats.orderCount} order${stats.orderCount === 1 ? '' : 's'} · $${stats.grossSales.toLocaleString()} in WCP gear so far`
    : null;

// Fourthwall serves every product image at a signed 1920px (~140KB) URL — 12x
// bigger than the ~160px tile, which is what causes the downscaling artifacts
// AND wastes bandwidth. We can't rewrite the signed URL, and workers.dev has no
// Cloudflare Image Resizing, so route it through wsrv.nl (a free image proxy):
// ~400px webp, ~17KB. The tile keeps the ORIGINAL as data-img-full so
// hub-store.ts can fall back to it if the proxy ever fails.
const SIZED = 400;
const sized = (u?: string): string | undefined => {
  if (!u || !/^https?:\/\//.test(u)) return u;
  // Sanity-hosted product photos size natively on the Sanity CDN — no
  // third-party resizer needed (field audit 2026-08-23).
  if (u.includes('cdn.sanity.io')) return `${u}?w=${SIZED}&h=${SIZED}&fit=crop&auto=format&q=80`;
  return `https://wsrv.nl/?url=${encodeURIComponent(u)}&w=${SIZED}&h=${SIZED}&fit=cover&output=webp&q=80`;
};
---

{
  url && tabs.length > 0 && (
    <section
      aria-labelledby="hub-store-heading"
      class="mt-4"
      data-reveal
      style="--reveal-delay: 60ms"
      data-sanity={hubEditAttr(Astro.locals, 'hubStore', 'hubStore', 'storeHeadline')}
    >
      <div class="wcp-store relative isolate overflow-hidden rounded-[var(--radius)] bg-gradient-to-br from-navy via-navy to-[#0d4d78] text-white shadow-[0_24px_60px_-24px_rgba(11,58,90,0.65)] ring-1 ring-white/10">
        <HubWatermark icon="shopping-bag" opacityClass="opacity-[0.06]" />
        {/* Decorative depth stack (all aria-hidden): brand glows, a lit-from-
            above highlight, a dot grid, the hand-drawn doodle tile, a slow
            shine sweep, and a couple of floating brand shapes. */}
        <div
          class="wcp-glow wcp-glow-amber -top-24 -right-10 h-72 w-96 opacity-50"
          aria-hidden="true"
        />
        <div
          class="wcp-glow wcp-glow-sky -bottom-28 -left-10 h-72 w-96 opacity-50"
          aria-hidden="true"
        />
        <span
          class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/[0.08] via-transparent to-black/10"
          aria-hidden="true"
        />
        <span class="wcp-store-dots pointer-events-none absolute inset-0" aria-hidden="true" />
        <span class="wcp-store-doodles pointer-events-none absolute inset-0" aria-hidden="true" />
        <span class="wcp-store-shine pointer-events-none" aria-hidden="true" />
        <Icon
          name="star"
          class="wcp-store-float absolute top-5 right-6 h-6 w-6 text-amber/50"
          aria-hidden="true"
        />
        <Icon
          name="sparkles"
          class="wcp-store-float wcp-store-float--b absolute right-1/3 bottom-6 h-5 w-5 text-sky/50"
          aria-hidden="true"
        />

        <div class="relative grid gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:items-center">
          {/* Pitch + CTA */}
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-extrabold tracking-wide uppercase">
              <Icon name="shopping-bag" class="h-3.5 w-3.5" aria-hidden="true" />
              Store
            </span>
            <h2
              id="hub-store-heading"
              class="mt-3 font-display text-3xl leading-tight text-white sm:text-4xl"
            >
              {heading}
            </h2>
            <p class="mt-2 max-w-md text-sm text-white/80">{blurb}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber/20 px-3 py-1 text-xs font-semibold text-white">
                <Icon name="package" class="h-3.5 w-3.5 shrink-0 text-amber" aria-hidden="true" />
                Free shipping on orders $100+
              </span>
              {salesLine && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/85">
                  <Icon name="heart" class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  {salesLine}
                </span>
              )}
            </div>
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="wcp-sheen group mt-5 inline-flex items-center gap-2 rounded-pill bg-amber px-5 py-2.5 font-bold text-navy shadow-md transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
            >
              Shop the store
              <Icon
                name="arrow-right"
                class="h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
                aria-hidden="true"
              />
            </a>
          </div>

          {/* Category tabs + flickable product carousel */}
          <div class="wcp-store-tabs min-w-0">
            {hasTabs && (
              <fieldset class="wcp-store-tabrow -mx-1 flex gap-2 overflow-x-auto px-1 pb-3">
                <legend class="sr-only">Shop by category</legend>
                {tabs.map((t, i) => (
                  <span class="contents">
                    <input
                      type="radio"
                      name="wcp-store-cat"
                      id={`wcp-cat-${i}`}
                      class="wcp-store-radio"
                      checked={i === 0}
                    />
                    <label
                      for={`wcp-cat-${i}`}
                      class="wcp-store-tab shrink-0 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-bold whitespace-nowrap text-white/90 transition-colors hover:bg-white/20"
                    >
                      {t.title}
                    </label>
                  </span>
                ))}
              </fieldset>
            )}

            <div class="wcp-store-panels relative">
              {tabs.map((t, i) => (
                <div class="wcp-store-panel relative" data-panel={i}>
                  <ul class="wcp-store-rail -mx-1 flex gap-3 overflow-x-auto px-1 pb-1">
                    {t.products.map((p) => (
                      <li class="w-36 shrink-0 sm:w-40">
                        <a
                          href={p.url}
                          target="_blank"
                          rel="noopener"
                          class="wcp-store-tile group block overflow-hidden rounded-2xl bg-white text-navy shadow-sm ring-1 ring-black/5 transition-all hover:-translate-y-1 hover:shadow-xl motion-reduce:hover:translate-y-0"
                        >
                          {/* Fixed light grey (not theme-reactive bg-grey): the
                              tile is a theme-stable white card, and Fourthwall
                              product images are transparent — a flipping grey
                              would make them float against a dark square in dark
                              mode. Pinned so both themes match. */}
                          <span class="block aspect-square overflow-hidden bg-[#eff0f1]">
                            <img
                              src={sized(p.image)}
                              data-img-full={p.image}
                              alt={p.title ?? 'Store product'}
                              loading="lazy"
                              width="200"
                              height="200"
                              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:group-hover:scale-100"
                            />
                          </span>
                          <span class="flex items-center justify-between gap-2 px-3 py-2">
                            <span class="truncate text-xs font-bold">{p.title}</span>
                            {p.price && (
                              <span class="shrink-0 text-xs font-extrabold text-sky-ink">
                                {p.price}
                              </span>
                            )}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {/* Prev/next arrows (JS-wired, desktop only — touch users swipe).
                      hub-store.ts hides the native scrollbar and toggles these. */}
                  <button
                    type="button"
                    data-store-arrow="-1"
                    aria-label="Scroll to previous products"
                    class="wcp-store-arrow wcp-store-arrow--prev"
                    hidden
                  >
                    <Icon name="arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
                  </button>
                  <button
                    type="button"
                    data-store-arrow="1"
                    aria-label="Scroll to more products"
                    class="wcp-store-arrow wcp-store-arrow--next"
                    hidden
                  >
                    <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  /* CSS-only category switching + flickable-rail mechanics (generated per tab
    count). is:inline so it stays global and un-scoped — the :has() panel
    toggle must not pick up Astro's scoping attribute. */
}
<style is:inline set:html={panelCss}></style>

<style>
  /* Hide the radios but keep them focusable (keyboard tabs + :checked state). */
  .wcp-store-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .wcp-store-tab {
    cursor: pointer;
  }
  /* Active category: solid amber pill, navy text (AA on amber). */
  .wcp-store-radio:checked + .wcp-store-tab {
    background: var(--color-amber);
    color: var(--color-navy);
  }
  /* Windows High Contrast strips backgrounds — without this the selected
     category is indistinguishable. Outline (kept by forced colors) marks it
     with no layout shift. */
  @media (forced-colors: active) {
    .wcp-store-radio:checked + .wcp-store-tab {
      outline: 2px solid SelectedItem;
      outline-offset: -2px;
    }
  }
  .wcp-store-radio:focus-visible + .wcp-store-tab {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .wcp-store-tabrow {
    /* A <fieldset> defaults to min-inline-size: min-content, so it grows to fit
       every category pill and overflows the card instead of scrolling (the last
       tab, e.g. "Youth", ends up cut off with no way to reach it). Force it to 0
       so overflow-x-auto engages and the row flick-scrolls like the product rail
       below. */
    min-inline-size: 0;
    scrollbar-width: none;
  }
  .wcp-store-tabrow::-webkit-scrollbar {
    display: none;
  }
  /* Flickable product rail: snap points. Without JS it keeps an on-brand slim
     scrollbar (translucent white on the navy card); hub-store.ts adds
     `wcp-rail-js` to hide it and drive the prev/next arrows instead. */
  .wcp-store-rail {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.45) rgba(255, 255, 255, 0.12);
  }
  .wcp-store-rail > li {
    scroll-snap-align: start;
  }
  .wcp-store-rail::-webkit-scrollbar {
    height: 6px;
  }
  .wcp-store-rail::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }
  .wcp-store-rail::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.45);
    border-radius: 999px;
  }
  .wcp-store-rail::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.65);
  }
  .wcp-store-rail.wcp-rail-js {
    scrollbar-width: none;
  }
  .wcp-store-rail.wcp-rail-js::-webkit-scrollbar {
    display: none;
  }

  /* Prev/next carousel arrows — white pills, navy chevron, amber on hover.
     Desktop only (touch users swipe); JS toggles [hidden] at each end. */
  .wcp-store-arrow {
    position: absolute;
    top: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: 9999px;
    background: #fff;
    color: var(--color-navy);
    box-shadow: 0 6px 16px rgba(11, 58, 90, 0.35);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
    z-index: 2;
  }
  .wcp-store-arrow--prev {
    left: 0;
    transform: translate(-50%, -50%);
  }
  .wcp-store-arrow--next {
    right: 0;
    transform: translate(50%, -50%);
  }
  .wcp-store-arrow:hover {
    background: var(--color-amber);
  }
  @media (min-width: 640px) {
    .wcp-store-arrow:not([hidden]) {
      display: flex;
    }
  }

  /* Slow diagonal shine sweeping across the panel. */
  .wcp-store-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.09) 50%,
      transparent 60%
    );
    background-size: 250% 100%;
    background-position: 150% 0;
  }
  /* Fine dot grid — reads as a printed texture under the doodles. */
  .wcp-store-dots {
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.5px);
    background-size: 22px 22px;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 40%, transparent 85%);
    mask-image: radial-gradient(ellipse at center, #000 40%, transparent 85%);
  }
  .wcp-store-doodles {
    background-image: var(--wcp-doodles-dark);
    background-size: 300px;
    opacity: 0.6;
  }
  /* The shine animates background-position — paint work every frame, not a
     compositor transform — so like .wcp-hub-wash it only runs on pointer:fine
     devices; phones keep the gradient painted once, static. The floats are
     transform-only and stay on everywhere motion is allowed. */
  @media (prefers-reduced-motion: no-preference) and (pointer: fine) {
    .wcp-store-shine {
      animation: wcp-store-shine 6s ease-in-out infinite;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .wcp-store-float {
      animation: wcp-store-float 7s ease-in-out infinite;
    }
    .wcp-store-float--b {
      animation-delay: -2.5s;
    }
  }
  @keyframes wcp-store-shine {
    0%,
    100% {
      background-position: 150% 0;
    }
    50% {
      background-position: -50% 0;
    }
  }
  @keyframes wcp-store-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(6deg);
    }
  }
</style>
