---
/* ============================================================================
   StoreCard — the flair-forward "official store" panel on the hub home
   ============================================================================
   A navy, doodle-dusted banner at the bottom of the Family Hub dashboard that
   links out to the merch store, with a row of clickable product tiles pulled
   from Site Settings (Board-curated: storeProducts). Renders nothing without a
   store URL; the tiles are optional (just the banner shows when none are set).
   All motion is gated behind prefers-reduced-motion.
   ============================================================================ */
import Icon from '@/components/Icon.astro';

interface Product {
  title?: string;
  price?: string;
  url?: string;
  image?: string;
}
interface Props {
  url?: string;
  headline?: string;
  tagline?: string;
  products?: Product[];
}
const { url, headline, tagline, products = [] } = Astro.props;

const heading = headline || 'The Official WCP Store';
const blurb =
  tagline ||
  'Every purchase supports our co-op. Tees, hoodies, hats, and more, all in West Chester Preschool colors.';
const tiles = (products ?? []).filter((p) => p?.url && p?.image).slice(0, 8);
---

{
  url && (
    <section
      aria-labelledby="hub-store-heading"
      class="mt-4"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      <div class="wcp-store relative overflow-hidden rounded-[var(--radius)] bg-navy text-white shadow-sm">
        {/* Decorative: brand glows + a slow shine sweep + floating doodles. */}
        <div
          class="wcp-glow wcp-glow-amber -top-24 -right-10 h-72 w-96 opacity-40"
          aria-hidden="true"
        />
        <div
          class="wcp-glow wcp-glow-sky -bottom-28 -left-10 h-72 w-96 opacity-40"
          aria-hidden="true"
        />
        <span class="wcp-store-shine" aria-hidden="true" />
        {/* Hand-drawn doodle texture (same tile as the hub canvas, light-on-dark). */}
        <span class="wcp-store-doodles pointer-events-none absolute inset-0" aria-hidden="true" />
        {/* A couple of floating brand shapes for life. */}
        <Icon
          name="star"
          class="wcp-store-float absolute top-5 right-6 h-6 w-6 text-amber/50"
          aria-hidden="true"
        />
        <Icon
          name="sparkles"
          class="wcp-store-float wcp-store-float--b absolute right-1/3 bottom-6 h-5 w-5 text-sky/50"
          aria-hidden="true"
        />

        <div class="relative grid gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
          {/* Pitch + CTA */}
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-extrabold tracking-wide uppercase">
              <Icon name="shopping-bag" class="h-3.5 w-3.5" aria-hidden="true" />
              WCP Co-op
            </span>
            <h2 id="hub-store-heading" class="mt-3 font-display text-3xl leading-tight sm:text-4xl">
              {heading}
            </h2>
            <p class="mt-2 max-w-md text-sm text-white/80">{blurb}</p>
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="wcp-sheen group mt-5 inline-flex items-center gap-2 rounded-pill bg-amber px-5 py-2.5 font-bold text-navy shadow-md transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
            >
              Shop the store
              <Icon
                name="arrow-right"
                class="h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
                aria-hidden="true"
              />
            </a>
          </div>

          {/* Product tiles */}
          {tiles.length > 0 && (
            <ul class="wcp-store-rail -mx-1 flex gap-3 overflow-x-auto px-1 pb-1 lg:grid lg:grid-cols-4 lg:overflow-visible">
              {tiles.map((p) => (
                <li class="w-36 shrink-0 lg:w-auto">
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    class="wcp-store-tile group block overflow-hidden rounded-2xl bg-white text-navy shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg motion-reduce:hover:translate-y-0"
                  >
                    <span class="block aspect-square overflow-hidden bg-grey">
                      <img
                        src={p.image}
                        alt={p.title ?? 'Store product'}
                        loading="lazy"
                        width="200"
                        height="200"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:group-hover:scale-100"
                      />
                    </span>
                    <span class="flex items-center justify-between gap-2 px-3 py-2">
                      <span class="truncate text-xs font-bold">{p.title}</span>
                      {p.price && (
                        <span class="shrink-0 text-xs font-extrabold text-sky-ink">{p.price}</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Slow diagonal shine sweeping across the panel. */
  .wcp-store-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.09) 50%,
      transparent 60%
    );
    background-size: 250% 100%;
    background-position: 150% 0;
  }
  .wcp-store-doodles {
    background-image: var(--wcp-doodles-dark);
    background-size: 300px;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wcp-store-shine {
      animation: wcp-store-shine 6s ease-in-out infinite;
    }
    .wcp-store-float {
      animation: wcp-store-float 7s ease-in-out infinite;
    }
    .wcp-store-float--b {
      animation-delay: -2.5s;
    }
  }
  @keyframes wcp-store-shine {
    0%,
    100% {
      background-position: 150% 0;
    }
    50% {
      background-position: -50% 0;
    }
  }
  @keyframes wcp-store-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(6deg);
    }
  }
  /* Thin, unobtrusive scrollbar on the mobile product rail. */
  .wcp-store-rail {
    scrollbar-width: thin;
  }
</style>
