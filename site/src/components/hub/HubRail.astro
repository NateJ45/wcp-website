---
/* ============================================================================
   HubRail — the Family Hub's persistent navigation.
   ============================================================================
   Rendered as the sticky left rail on desktop (with `collapsible`) and as the
   slide-in drawer's contents on mobile (see BaseLayout hub branch +
   hub-drawer.ts). One flat, grouped list built from src/data/hub-nav.ts.

   COLLAPSIBLE (desktop only): the `collapsible` instance renders a toggle that
   flips `data-rail-collapsed` on <html> (persisted, pre-paint — see BaseLayout +
   hub-rail.ts). The collapse CSS (globals.css, scoped to `.hub-rail-aside`)
   shrinks the rail to icons only: labels become sr-only (kept as accessible
   names), group headers hide, icons center. Every link carries `title` so the
   hidden label shows as a native tooltip when collapsed.

   Sign out posts to /api/hub-logout. The ThemeToggle here is the hub's only
   light/dark control. Theme-aware via brand tokens; no hardcoded hex except the
   active-link fill (a fixed navy island — see the style note below).
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { resolveHubNav, type HubNavDoc } from '@/lib/hub-nav-doc';
import { getHubClassrooms } from '@/lib/hub-classes';
import { classTiles } from '@/lib/hub-classrooms';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { HUB_NAV_MENU_QUERY, HUB_SOCIAL_QUERY } from '@/lib/queries';
import { site } from '@/data/site';
// Pre-sized webp + plain <img> (not astro:assets): SSR pages can't resize at
// request time on the Cloudflare adapter, so <Image> served the 4.1MB
// original here (Lighthouse, 2026-07-14). See the same note in HubTopBar.
import wcpLogoWhite from '@/assets/brand/wcp-logo-white-sm.webp';

interface Props {
  /** Desktop rail: render the collapse toggle. The mobile drawer omits it. */
  collapsible?: boolean;
}
const { collapsible = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(href) === path;

// The menu is Board-editable (Studio → Family Hub menu), resolved over the
// committed fallback in src/data/hub-nav.ts. The rail renders TWICE per page
// (desktop rail + the drawer's copy), so this read must stay cheap: no PII,
// changes rarely, and it rides the shared Board-content cache, which is an
// in-isolate Map — the second render is free. Any failure (or an empty doc)
// leaves the committed rail exactly as it is.
let navDoc: HubNavDoc | null = null;
try {
  navDoc = await sanityFetch<HubNavDoc | null>(
    HUB_NAV_MENU_QUERY,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
} catch {
  navDoc = null;
}
// The Classes section fills itself from the `class` documents, so a class the
// Board adds is in the rail the moment it publishes. Same cache, so the second
// render of the rail (the mobile drawer) is free.
const classrooms = await getHubClassrooms();
const nav = resolveHubNav(navDoc, classrooms);

// The classes and the page each one lives on, for the device-local my-classes
// personalization (src/scripts/my-class.ts). That script runs on EVERY hub
// page, and its class list used to be hardcoded — which is what made the hub
// blind to a class the Board added. Printed once per page: only the DESKTOP
// rail carries it, because the drawer renders a second copy of this component
// and two JSON blocks would be one too many. The desktop rail is always in the
// DOM (it is hidden with CSS below `lg`, not skipped), so a phone still gets it.
const classJson = collapsible
  ? JSON.stringify(
      classTiles(classrooms).map((c) => ({ slug: c.slug, label: c.label, page: c.page })),
    )
  : null;

// Follow WCP! — the same Site settings socials the public footer shows, so
// the Board edits one place (Studio → Site settings → Facebook/Instagram,
// with the same show-socials switch). Board-content cache: the drawer's
// second render is free, and a failed read falls back to the committed links.
interface SocialDoc {
  facebook?: string;
  instagram?: string;
  showSocials?: boolean;
}
let socialDoc: SocialDoc | null = null;
try {
  socialDoc = await sanityFetch<SocialDoc | null>(
    HUB_SOCIAL_QUERY,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
} catch {
  socialDoc = null;
}
const social = socialDoc ?? {
  facebook: site.social.facebook,
  instagram: site.social.instagram,
  showSocials: site.show.socials,
};
// An unset switch means "show" — same reading as the footer's site.show.
const showSocials = (social.showSocials ?? true) && Boolean(social.facebook || social.instagram);

const homeLink = nav[0].links[0];
const groups = nav.slice(1);
---

{classJson && <script type="application/json" data-hub-classes is:inline set:html={classJson} />}

<div class="flex h-full flex-col gap-1 bg-navy px-3 py-4 text-white/85">
  <div class="mb-1 px-2 pb-2" data-rail-top>
    {
      collapsible && (
        <div class="flex justify-end" data-rail-toggle-row>
          <button
            type="button"
            data-rail-toggle
            aria-expanded="true"
            aria-label="Collapse navigation"
            class="rail-icon-btn"
          >
            <Icon name="chevrons-left" class="rail-toggle-icon h-5 w-5" />
          </button>
        </div>
      )
    }
    {/* Full-width brand moment — the logo spans the rail (hidden when collapsed). */}
    <a href="/family-hub" class="mt-1 block" aria-label="Family Hub home" data-rail-logo>
      <img
        src={wcpLogoWhite.src}
        alt={site.name}
        width={wcpLogoWhite.width}
        height={wcpLogoWhite.height}
        class="h-auto w-full"
      />
    </a>
  </div>

  {
    /* min-h-0 is load-bearing: without it this flex child refuses to shrink,
       the whole rail (logo + footer included) becomes the scroller, and the
       browser paints its chunky default scrollbar over the navy ("ugly
       vertical scroll", 2026-07-14). With it, the logo and Sign out stay
       PINNED and only this middle list scrolls, behind the hairline thumb
       styled below. */
  }
  <nav
    aria-label="Family Hub"
    class="hub-rail-scroll flex min-h-0 flex-1 flex-col gap-0.5 overflow-y-auto pr-1"
  >
    {/* Search lives in the top bar (⌘K) — no rail entry needed. */}
    <a
      href={homeLink.href}
      class="hub-rail-link"
      title={homeLink.label}
      aria-current={isActive(homeLink.href) ? 'page' : undefined}
    >
      <Icon name={homeLink.icon} class="h-4 w-4 shrink-0" />
      <span class="flex-1" data-rail-label>{homeLink.label}</span>
    </a>

    {
      groups.map((group) => (
        <div class="mt-2.5">
          {/* Group accent: label + link icons pick up the group's brand tint
              (per-link override for the class colors). AA note in hub-nav.ts. */}
          <p
            class="px-3 pb-1 text-[0.62rem] font-extrabold tracking-wider uppercase"
            style={`color: ${group.accent ?? '#ffa334'}`}
            data-rail-group
          >
            {group.label}
          </p>
          {group.links.map((l) => (
            <a
              href={l.href}
              class="hub-rail-link"
              title={l.label}
              style={`--rail-accent: ${l.iconColor ?? group.accent ?? 'currentColor'}`}
              aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
              {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icon name={l.icon} class="rail-link-icon h-4 w-4 shrink-0" />
              <span class="flex-1" data-rail-label>
                {l.label}
              </span>
              {l.external && (
                <Icon
                  name="external-link"
                  class="h-3.5 w-3.5 shrink-0 text-white/50"
                  data-rail-label
                />
              )}
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  {
    showSocials && (
      <div
        class="mt-3 flex items-center justify-between gap-1 border-t border-white/10 px-2 pt-3"
        data-rail-social
      >
        <span class="text-sm font-semibold text-white/85" data-rail-label>
          Follow WCP!
        </span>
        <div class="flex items-center gap-1" data-rail-social-icons>
          {social.facebook && (
            <a
              href={social.facebook}
              target="_blank"
              rel="noopener"
              aria-label={`${site.name} on Facebook`}
              title="WCP on Facebook"
              class="rail-icon-btn"
            >
              <Icon name="facebook" class="h-4 w-4" />
            </a>
          )}
          {social.instagram && (
            <a
              href={social.instagram}
              target="_blank"
              rel="noopener"
              aria-label={`${site.name} on Instagram`}
              title="WCP on Instagram"
              class="rail-icon-btn"
            >
              <Icon name="instagram" class="h-4 w-4" />
            </a>
          )}
        </div>
      </div>
    )
  }

  <div
    class="mt-3 flex items-center justify-between gap-1 border-t border-white/10 pt-3"
    data-rail-footer
  >
    <form method="POST" action="/api/hub-logout" class="flex-1">
      <button type="submit" class="hub-rail-link w-full" title="Sign out">
        <Icon name="log-out" class="h-4 w-4 shrink-0" />
        <span class="flex-1 text-left" data-rail-label>Sign out</span>
      </button>
    </form>
    <ThemeToggle tone="onNavy" />
  </div>
</div>

<style>
  /* Rail link. Active = white-on-orange-ink (5.4:1 AA); bright orange only
     measures ~4.19:1 with navy text at this size, so it can't be the fill. */
  .hub-rail-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .hub-rail-link:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }
  /* Category-colored icons (decorative — the white label carries contrast). */
  .hub-rail-link :global(.rail-link-icon) {
    color: var(--rail-accent, currentColor);
  }
  /* On the active orange fill the accent tints don't read — go white. */
  .hub-rail-link[aria-current='page'] :global(.rail-link-icon) {
    color: #ffffff;
  }
  .hub-rail-link[aria-current='page'] {
    /* Hardcoded, not var(--color-orange-ink): that token is redefined to
       bright orange in dark mode (it's meant for TEXT on a dark page, see
       globals.css's dark-mode note), but this rail is a fixed navy island
       that must look identical in both themes. White-on-orange-ink is
       5.4:1 AA; navy-on-bright-orange only measures ~4.19:1 at this
       size/weight and fails. */
    background-color: #a85300;
    color: #ffffff;
    font-weight: 800;
  }
  .rail-icon-btn {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .rail-icon-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-rail-link,
    .rail-icon-btn {
      transition: none;
    }
  }

  /* Hairline scrollbar for the nav's scroll region: a translucent white
     thumb on a transparent track reads as part of the navy instead of the
     OS-default grey gutter. Firefox via scrollbar-width/color, WebKit via
     the pseudo-elements. */
  .hub-rail-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }
  .hub-rail-scroll::-webkit-scrollbar {
    width: 5px;
  }
  .hub-rail-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
  }
  .hub-rail-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.4);
  }
  .hub-rail-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
</style>
