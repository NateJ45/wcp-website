---
/* ============================================================================
   HubRail — the Family Hub's persistent navigation.
   ============================================================================
   Rendered as the sticky left rail on desktop (with `collapsible`) and as the
   slide-in drawer's contents on mobile (see BaseLayout hub branch +
   hub-drawer.ts). One flat, grouped list built from src/data/hub-nav.ts.

   COLLAPSIBLE (desktop only): the `collapsible` instance renders a toggle that
   flips `data-rail-collapsed` on <html> (persisted, pre-paint — see BaseLayout +
   hub-rail.ts). The collapse CSS (globals.css, scoped to `.hub-rail-aside`)
   shrinks the rail to icons only: labels become sr-only (kept as accessible
   names), group headers hide, icons center. Every link carries `title` so the
   hidden label shows as a native tooltip when collapsed.

   Sign out posts to /api/hub-logout. The ThemeToggle here is the hub's only
   light/dark control. Theme-aware via brand tokens; no hardcoded hex except the
   active-link fill (a fixed navy island — see the style note below).
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { hubNav } from '@/data/hub-nav';
import { site } from '@/data/site';
import wcpLogoWhite from '@/assets/brand/wcp-logo-white.png';

interface Props {
  /** Desktop rail: render the collapse toggle. The mobile drawer omits it. */
  collapsible?: boolean;
}
const { collapsible = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(href) === path;

const homeLink = hubNav[0].links[0];
const groups = hubNav.slice(1);
---

<div class="flex h-full flex-col gap-1 bg-navy px-3 py-4 text-white/85">
  <div class="mb-2 px-2 pb-3" data-rail-top>
    {
      collapsible && (
        <div class="flex justify-end" data-rail-toggle-row>
          <button
            type="button"
            data-rail-toggle
            aria-expanded="true"
            aria-label="Collapse navigation"
            class="rail-icon-btn"
          >
            <Icon name="chevrons-left" class="rail-toggle-icon h-5 w-5" />
          </button>
        </div>
      )
    }
    {/* Full-width brand moment — the logo spans the rail (hidden when collapsed). */}
    <a href="/family-hub" class="mt-1 block" aria-label="Family Hub home" data-rail-logo>
      <Image src={wcpLogoWhite} alt={site.name} width={480} height={320} class="h-auto w-full" />
    </a>
  </div>

  <nav aria-label="Family Hub" class="flex flex-1 flex-col gap-0.5 overflow-y-auto">
    <a
      href={homeLink.href}
      class="hub-rail-link"
      title={homeLink.label}
      aria-current={isActive(homeLink.href) ? 'page' : undefined}
    >
      <Icon name={homeLink.icon} class="h-4 w-4 shrink-0" />
      <span class="flex-1" data-rail-label>{homeLink.label}</span>
    </a>

    {
      groups.map((group) => (
        <div class="mt-3">
          {/* Group accent: label + link icons pick up the group's brand tint
              (per-link override for the class colors). AA note in hub-nav.ts. */}
          <p
            class="px-3 pb-1 text-[0.62rem] font-extrabold tracking-wider uppercase"
            style={`color: ${group.accent ?? '#ffa334'}`}
            data-rail-group
          >
            {group.label}
          </p>
          {group.links.map((l) => (
            <a
              href={l.href}
              class="hub-rail-link"
              title={l.label}
              style={`--rail-accent: ${l.iconColor ?? group.accent ?? 'currentColor'}`}
              aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
              {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icon name={l.icon} class="rail-link-icon h-4 w-4 shrink-0" />
              <span class="flex-1" data-rail-label>
                {l.label}
              </span>
              {l.external && (
                <Icon
                  name="external-link"
                  class="h-3.5 w-3.5 shrink-0 text-white/50"
                  data-rail-label
                />
              )}
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  <div
    class="mt-3 flex items-center justify-between gap-1 border-t border-white/10 pt-3"
    data-rail-footer
  >
    <form method="POST" action="/api/hub-logout" class="flex-1">
      <button type="submit" class="hub-rail-link w-full" title="Sign out">
        <Icon name="log-out" class="h-4 w-4 shrink-0" />
        <span class="flex-1 text-left" data-rail-label>Sign out</span>
      </button>
    </form>
    <ThemeToggle tone="onNavy" />
  </div>
</div>

<style>
  /* Rail link. Active = white-on-orange-ink (5.4:1 AA); bright orange only
     measures ~4.19:1 with navy text at this size, so it can't be the fill. */
  .hub-rail-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .hub-rail-link:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }
  /* Category-colored icons (decorative — the white label carries contrast). */
  .hub-rail-link :global(.rail-link-icon) {
    color: var(--rail-accent, currentColor);
  }
  /* On the active orange fill the accent tints don't read — go white. */
  .hub-rail-link[aria-current='page'] :global(.rail-link-icon) {
    color: #ffffff;
  }
  .hub-rail-link[aria-current='page'] {
    /* Hardcoded, not var(--color-orange-ink): that token is redefined to
       bright orange in dark mode (it's meant for TEXT on a dark page, see
       globals.css's dark-mode note), but this rail is a fixed navy island
       that must look identical in both themes. White-on-orange-ink is
       5.4:1 AA; navy-on-bright-orange only measures ~4.19:1 at this
       size/weight and fails. */
    background-color: #a85300;
    color: #ffffff;
    font-weight: 800;
  }
  .rail-icon-btn {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .rail-icon-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-rail-link,
    .rail-icon-btn {
      transition: none;
    }
  }
</style>
