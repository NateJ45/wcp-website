---
/* ============================================================================
   HubTopBar — the Family Hub's top chrome (both breakpoints)
   ============================================================================
   Two bars, one component (2026-07-14 app-elevation Track A):

   - Desktop (lg+): a FLOATING sticky bar (m-2 gutter + rounded + shadow, to
     match the lifted rail) over the content column. On the left, quick links
     to the things a parent wants on any page: helper schedule (personalized to
     the device's class by hub-quicklinks.ts), pay tuition, the next event, and
     the latest update. On the right a search "field" (really a button — the
     Cmd/Ctrl+K palette affordance) and the what's-new bell. The rail keeps
     "where am I"; this bar owns "what can I do / get to right now". Total sticky
     height stays ~56px (h-10 + gutter) so HubTable's lg:top-14 sticky column
     headers still slide under it.
   - Phone (< lg): the existing navy strip (menu, title, search, bell, theme,
     logo). Not sticky; the tab bar owns persistent nav on phones.

   The bell's data is fetched HERE once (cached, BOARD_CONTENT_CACHE tier) and
   passed to both HubBell instances so the two never double-fetch. Any failure
   degrades to an empty bell, never a broken bar.

   Menus are native <details> (keyboard + no-JS friendly); hub-menus.ts adds
   outside-click/Esc closing, hub-fresh.ts adds the unseen-count badge.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import HubBell, { type BellItem } from '@/components/hub/HubBell.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { getUpcomingEvents, fmtEventMonth, fmtEventDay, type HubEvent } from '@/lib/hub-calendar';
import { calendarFeedUrlFallback, helperScheduleFallback } from '@/data/hub/live-links';
import { payUrl } from '@/data/classes';
import { site, familyHandbookUrl } from '@/data/site';
// Pre-sized webp, NOT the 9000x6000 original via astro:assets <Image>: hub
// pages are SSR, and the Cloudflare adapter can't resize at request time, so
// /_image passes the ORIGINAL through — Lighthouse caught the 4.1MB logo
// serving a 38px slot (2026-07-14). Chrome assets on SSR surfaces use
// committed pre-sized files and a plain <img>.
import wcpLogoWhite from '@/assets/brand/wcp-logo-white-sm.webp';

interface Props {
  title: string;
}
const { title } = Astro.props;

// What's-new feed: recent updates (with the Board's highlight flag) + the
// latest documents. Board highlights are fetched separately so an important
// notice stays in the bell even after newer posts push it out of the recents.
interface UpdateRow {
  title?: string;
  slug?: string;
  publishedAt?: string;
  highlight?: boolean;
  category?: string;
}
interface DocRow {
  title?: string;
  publishedAt?: string;
}
let bellItems: BellItem[] = [];
let latestUpdate: { title: string; href: string } | null = null;
try {
  const feed = await sanityFetch<{
    updates: UpdateRow[];
    highlights: UpdateRow[];
    documents: DocRow[];
  }>(
    `{
      "updates": *[_type == "update" && defined(publishedAt) && publishedAt < now()] | order(publishedAt desc)[0...6]{ title, "slug": slug.current, publishedAt, highlight, category },
      "highlights": *[_type == "update" && highlight == true && defined(publishedAt)] | order(publishedAt desc)[0...3]{ title, "slug": slug.current, publishedAt, highlight, category },
      "documents": *[_type == "hubDocument"] | order(_createdAt desc)[0...3]{ title, "publishedAt": _createdAt }
    }`,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
  const toItem = (u: UpdateRow): BellItem => ({
    title: u.title ?? 'Update',
    href: u.slug ? `/family-hub/updates/${u.slug}` : '/family-hub/updates',
    publishedAt: u.publishedAt ?? '',
    highlight: u.highlight === true,
    meta: u.category === 'minutes' ? 'Meeting minutes' : 'Announcement',
  });
  const seen = new Set<string>();
  const merged: BellItem[] = [];
  for (const u of [...(feed.highlights ?? []), ...(feed.updates ?? [])]) {
    const item = toItem(u);
    if (seen.has(item.href + item.title)) continue;
    seen.add(item.href + item.title);
    merged.push(item);
  }
  for (const d of feed.documents ?? []) {
    merged.push({
      title: d.title ?? 'Document',
      href: '/family-hub/documents',
      publishedAt: d.publishedAt ?? '',
      meta: 'Document',
    });
  }
  // Highlights pin inside HubBell; the rest reads newest-first.
  bellItems = merged
    .sort((a, b) => Number(b.highlight ?? false) - Number(a.highlight ?? false))
    .slice(0, 9);
  // The single most recent announcement / meeting minute, for the quick link.
  const u0 = feed.updates?.[0];
  if (u0?.title) {
    latestUpdate = {
      title: u0.title,
      href: u0.slug ? `/family-hub/updates/${u0.slug}` : '/family-hub/updates',
    };
  }
} catch {
  bellItems = []; // bell still renders; the panel shows its caught-up state
}

// Next upcoming event, for the quick link. Cached feed (shared with the home
// widget), so this is a cache hit on every page after the first; degrades to no
// event (the chip just points at the calendar) on any failure.
let nextEvent: HubEvent | null = null;
try {
  const feedUrl =
    (await sanityFetch<string | null>(`*[_type == "siteSettings"][0].calendarFeedUrl`)) ||
    calendarFeedUrlFallback;
  nextEvent = (await getUpcomingEvents(feedUrl))[0] ?? null;
} catch {
  nextEvent = null;
}

// Per-class helper-schedule + pay-tuition URLs, so the "Helper schedule" and
// "Pay tuition" quick links personalize to the device's class(es)
// (hub-quicklinks.ts, reading wcp-my-classes): one class → a direct link, two
// classes → a small dropdown with a link per class.
const helperMap: Record<string, string> = {};
const payMap: Record<string, string> = {};
try {
  const rows = await sanityFetch<{ slug?: string; helperScheduleUrl?: string; payId?: string }[]>(
    `*[_type == "class"]{ "slug": slug.current, helperScheduleUrl, payId }`,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
  for (const r of rows ?? []) {
    if (!r.slug) continue;
    const helper = r.helperScheduleUrl || helperScheduleFallback[r.slug];
    if (helper) helperMap[r.slug] = helper;
    if (r.payId) payMap[r.slug] = payUrl(r.payId);
  }
} catch {
  /* leave both maps empty — the quick links fall back to their default hrefs */
}
// Ordered class labels for the multi-class dropdowns.
const CLASS_LABELS: Record<string, string> = {
  twos: 'Twos',
  threes: 'Threes',
  'pre-k-am': 'Pre-K AM',
  'pre-k-pm': 'Pre-K PM',
};
const linksFor = (map: Record<string, string>) =>
  Object.keys(CLASS_LABELS)
    .filter((s) => map[s])
    .map((s) => ({ slug: s, label: CLASS_LABELS[s], url: map[s] }));
const helperLinks = linksFor(helperMap);
const payLinks = linksFor(payMap);

const nextEventLabel = nextEvent
  ? `Next: ${fmtEventMonth(nextEvent)} ${fmtEventDay(nextEvent)}`
  : 'Calendar';
const nextEventTitle = nextEvent ? `Next event: ${nextEvent.title}` : 'Upcoming events';
---

{/* ---- Desktop bar (lg+) ---- */}
{
  /* A <header> so its content lives in a landmark (axe `region`). The phone
    strip below is a <header> too, but only one is ever displayed, so the
    duplicate-banner rule never sees both. */
}
<header data-hub-topbar class="sticky top-0 z-30 hidden lg:block">
  {
    /* Floating bar (m-2 gutter + rounded + shadow) to match the lifted rail.
      Total sticky height stays ~56px (h-10 + the gutter), so HubTable's
      lg:top-14 sticky headers still slide under it. */
  }
  <div
    class="m-2 flex h-10 items-center gap-1.5 rounded-2xl border border-border bg-white/85 px-2.5 shadow-md backdrop-blur dark:border-white/10 dark:bg-surface/85"
  >
    {
      /* Quick links — the things a parent wants on any page. Icon-only on lg,
        icon + label on xl. hub-quicklinks.ts personalizes the helper link to
        the device's class. */
    }
    <nav aria-label="Quick links" class="flex min-w-0 items-center gap-0.5">
      {
        /* Flagship call to action — becoming a certified Super Helper is a top
         priority, so it leads the bar as a filled amber pill (navy text, AA),
         dressed up to read as genuinely inviting rather than just another
         chip: a breathing glow ring at rest (wcp-glow-pulse, on the pill
         itself) and two small sparkles standing just outside its edges
         (wcp-twinkle) — all decorative, all reduced-motion-safe, and the only
         CTA in the bar that gets this treatment on purpose. The hover light
         sweep (wcp-sheen) lives on an INNER wrapper, not the pill: wcp-sheen
         clips to overflow-hidden, which would cut off the sparkles poking
         outside the pill's edge. */
      }
      <a
        href="/family-hub/super-helper"
        class="wcp-glow-pulse relative mr-1.5 -ml-1.5 inline-flex items-center rounded-full text-sm font-extrabold whitespace-nowrap text-navy"
        title="Become a Super Helper"
      >
        <span
          class="wcp-sheen flex items-center gap-1.5 rounded-full bg-amber px-3 py-1.5 shadow-sm transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
        >
          <Icon name="star" class="h-4 w-4 shrink-0" />
          <span class="hidden sm:inline">Become a Super Helper</span>
        </span>
        <Icon
          name="sparkles"
          class="wcp-twinkle pointer-events-none absolute -top-1.5 -right-1 h-3 w-3 text-amber"
          style="--twinkle-delay: 0s"
          aria-hidden="true"
        />
        <Icon
          name="sparkles"
          class="wcp-twinkle pointer-events-none absolute -bottom-1 left-4 h-2 w-2 text-amber"
          style="--twinkle-delay: 1.3s"
          aria-hidden="true"
        />
      </a>
      {
        /* Helper schedule — direct link for 0-1 classes, dropdown for 2+
          (hub-quicklinks.ts swaps them from wcp-my-classes). */
      }
      <a
        data-quick-multi="helper"
        data-map={JSON.stringify(helperMap)}
        href="/family-hub/coop-jobs"
        class="hub-quick"
        title="Your helper schedule"
      >
        <Icon name="clipboard-list" class="h-4 w-4 shrink-0" />
        <span class="sr-only xl:not-sr-only xl:inline">Helper schedule</span>
      </a>
      <details class="relative" data-quick-multi-menu="helper" data-hub-menu hidden>
        <summary
          class="hub-quick cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          title="Your helper schedules"
        >
          <Icon name="clipboard-list" class="h-4 w-4 shrink-0" />
          <span class="sr-only xl:not-sr-only xl:inline">Helper schedules</span>
        </summary>
        <div
          class="absolute top-full left-0 z-40 mt-1 w-60 rounded-[var(--radius)] border border-border bg-white p-2 shadow-lg dark:bg-surface"
        >
          {
            helperLinks.map((l) => (
              <a
                data-multi-class={l.slug}
                href={l.url}
                target="_blank"
                rel="noopener"
                hidden
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-heading no-underline hover:bg-grey dark:hover:bg-white/5"
              >
                <Icon name="clipboard-list" class="h-4 w-4 shrink-0 text-sky-ink" />
                {l.label} helper schedule
              </a>
            ))
          }
        </div>
      </details>

      {/* Pay tuition — same pattern: one class → direct pay link, two → dropdown. */}
      <a
        data-quick-multi="tuition"
        data-map={JSON.stringify(payMap)}
        href="/family-hub/tuition"
        class="hub-quick"
        title="Pay tuition"
      >
        <Icon name="circle-dollar-sign" class="h-4 w-4 shrink-0" />
        <span class="sr-only xl:not-sr-only xl:inline">Pay tuition</span>
      </a>
      <details class="relative" data-quick-multi-menu="tuition" data-hub-menu hidden>
        <summary
          class="hub-quick cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          title="Pay tuition"
        >
          <Icon name="circle-dollar-sign" class="h-4 w-4 shrink-0" />
          <span class="sr-only xl:not-sr-only xl:inline">Pay tuition</span>
        </summary>
        <div
          class="absolute top-full left-0 z-40 mt-1 w-60 rounded-[var(--radius)] border border-border bg-white p-2 shadow-lg dark:bg-surface"
        >
          {
            payLinks.map((l) => (
              <a
                data-multi-class={l.slug}
                href={l.url}
                target="_blank"
                rel="noopener"
                hidden
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-heading no-underline hover:bg-grey dark:hover:bg-white/5"
              >
                <Icon name="circle-dollar-sign" class="h-4 w-4 shrink-0 text-sky-ink" />
                Pay {l.label} tuition
              </a>
            ))
          }
        </div>
      </details>
      <a href="/family-hub/calendar" class="hub-quick" title={nextEventTitle}>
        <Icon name="calendar-days" class="h-4 w-4 shrink-0" />
        <span class="sr-only xl:not-sr-only xl:inline">{nextEventLabel}</span>
      </a>
      {
        /* Family Handbook — the year's reference doc, one tap from any hub page.
         Carries a visible "Handbook" label at xl (sr-only below), like every
         other quick link, so the book glyph is never a mystery icon; the full
         "Family Handbook (PDF)" stays in the tooltip + aria-label. */
      }
      <a
        href={familyHandbookUrl}
        target="_blank"
        rel="noopener"
        class="hub-quick"
        title="Family Handbook (PDF)"
        aria-label="Family Handbook (PDF)"
      >
        <Icon name="book-open" class="h-4 w-4 shrink-0" />
        <span class="sr-only xl:not-sr-only xl:inline">Handbook</span>
      </a>
      {
        /* min-w-0 makes THIS chip the one that gives when the bar runs out of
         room: on a wide screen it shows the full title, and only on a narrow
         desktop does its label truncate (every other chip holds its size), so
         the title is never needlessly clipped and the bar never overflows. */
      }
      <a
        href={latestUpdate?.href ?? '/family-hub/updates'}
        class="hub-quick min-w-0"
        aria-label={latestUpdate ? `Latest: ${latestUpdate.title}` : 'Latest updates'}
        title={latestUpdate ? `Latest: ${latestUpdate.title}` : 'Latest updates'}
      >
        <Icon name="newspaper" class="h-4 w-4 shrink-0" />
        {
          /* max-w is a generous ceiling (fits "Apr. 13, 2026 Meeting Minutes");
           min-w-0 lets it truncate below that only when space is tight. */
        }
        <span
          class="hidden max-w-[17rem] min-w-0 truncate align-middle xl:inline-block"
          aria-hidden="true"
        >
          {latestUpdate ? latestUpdate.title : 'Updates'}
        </span>
      </a>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="flex h-9 w-40 cursor-pointer items-center gap-2 rounded-full border border-border bg-grey/60 px-3 text-sm text-ink-muted transition-colors hover:border-navy/30 xl:w-56 dark:border-white/20 dark:bg-white/5 dark:hover:border-white/30"
        data-hub-search-open
      >
        <Icon name="search" class="h-4 w-4 shrink-0" />
        <span>Search the hub</span>
        <kbd
          class="ml-auto rounded border border-border px-1 text-[0.65rem] font-semibold text-ink-muted"
          >⌘K</kbd
        >
      </button>

      <HubBell items={bellItems} tone="bar" />
    </div>
  </div>
</header>

<script>
  import '@/scripts/hub-quicklinks';
</script>

{/* ---- Phone strip (< lg) ---- */}
<header
  data-hub-topstrip
  class="relative z-30 flex items-center gap-1.5 border-b border-white/10 bg-navy px-4 py-2.5 text-white lg:hidden"
>
  {
    /* h-10 visual, but a 44px HIT area (after:-inset-0.5): four adjacent 40px
      targets in one strip is where small-iPhone mis-taps happen. -inset-0.5
      stays inside the strip's gap-1.5, so neighboring hit areas never overlap. */
  }
  <button
    type="button"
    class="relative inline-flex h-10 w-10 items-center justify-center rounded-md text-white after:absolute after:-inset-0.5 after:content-[''] hover:bg-white/10"
    aria-label="Open menu"
    aria-controls="hub-drawer"
    aria-expanded="false"
    data-hub-drawer-toggle
  >
    <Icon name="menu" class="h-6 w-6" />
  </button>
  <span class="truncate font-bold">{title}</span>
  <button
    type="button"
    class="relative ml-auto inline-flex h-10 w-10 items-center justify-center rounded-md text-white after:absolute after:-inset-0.5 after:content-[''] hover:bg-white/10"
    aria-label="Search the Family Hub"
    data-hub-search-open
  >
    <Icon name="search" class="h-5 w-5" />
  </button>
  <HubBell items={bellItems} tone="navy" />
  <ThemeToggle tone="onNavy" />
  <a href="/family-hub" class="inline-flex items-center" aria-label="Family Hub home">
    <img
      src={wcpLogoWhite.src}
      alt={site.name}
      width={wcpLogoWhite.width}
      height={wcpLogoWhite.height}
      class="h-8 w-auto"
    />
  </a>
</header>
