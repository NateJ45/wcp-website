---
/* ============================================================================
   BudgetSnapshotWidget — live numbers from the treasurer's Google Sheet
   ============================================================================
   Reads the "Budget" tab of the Budget Sheet (Board-editable sheet id on
   siteSettings, working fallback in live-links.ts) server-side behind the
   gate: cash balance + a health badge, revenue/expense progress vs budget,
   and the year-to-date net. The treasurer edits the sheet; the hub updates
   on the next visit. Any fetch/parse failure falls back to the designed
   empty state — never a broken card.

   Health badge is a THEME-STABLE solid fill (hardcoded dark hexes + white
   text, like classStyles().badge) — the -ink tokens flip bright in dark mode
   and white-on-bright fails AA. Deliberately no celebratory styling: the
   card must read the same in strong and stressed months.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import HubStat from '@/components/hub/HubStat.astro';
import { sanityFetch } from '@/lib/sanity';
import { getBudgetSnapshot, budgetHealth, type BudgetSnapshot } from '@/lib/gsheets';
import { budgetSheetIdFallback } from '@/data/hub/live-links';

let sheetId = budgetSheetIdFallback;
try {
  sheetId =
    (await sanityFetch<string | null>(`*[_type == "hubSettings"][0].budgetSheetId`)) ||
    budgetSheetIdFallback;
} catch {
  sheetId = budgetSheetIdFallback;
}

const snap: BudgetSnapshot | null = await getBudgetSnapshot(sheetId);

const money = (n: number) => `$${Math.round(Math.abs(n)).toLocaleString('en-US')}`;
const net = snap ? snap.revenueActual - snap.expensesActual : 0;

const health = snap ? budgetHealth(snap.cash) : null;
interface Props {
  /** Board wording override (hubPage.widgetText — see src/lib/hub-widgets.ts).
      Undefined = the shipped title. */
  heading?: string;
}
const { heading } = Astro.props;
---

<HomeWidgetCard
  icon="piggy-bank"
  title={heading ?? 'Budget Snapshot'}
  seeAllHref="/family-hub/documents"
  seeAllLabel="Full reports"
  empty={!snap}
  emptyText="A budget summary will appear here once the treasurer's tracking sheet is connected."
>
  {
    snap && health && (
      <div>
        <div class="flex items-start justify-between gap-3">
          <HubStat
            value={money(snap.cash)}
            label="School account balance"
            footnote={`As of ${snap.monthLabel}`}
          />
          <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold text-white ${health.fill}`}>
            {health.label}
          </span>
        </div>

        <div class="mt-4 space-y-3">
          <div>
            <div class="flex items-center justify-between text-xs font-semibold">
              <span class="text-ink-muted">Revenue</span>
              <span class="text-heading">
                {money(snap.revenueActual)}
                <span class="font-normal text-ink-muted"> / {money(snap.revenueBudgeted)}</span>
              </span>
            </div>
            <HubProgress
              class="mt-1"
              height="h-2"
              value={snap.revenueActual}
              max={snap.revenueBudgeted}
              fill="bg-green"
              label="Revenue collected vs budget"
              valueText={`${money(snap.revenueActual)} of ${money(snap.revenueBudgeted)} collected`}
            />
          </div>
          <div>
            <div class="flex items-center justify-between text-xs font-semibold">
              <span class="text-ink-muted">Expenses</span>
              <span class="text-heading">
                {money(snap.expensesActual)}
                <span class="font-normal text-ink-muted"> / {money(snap.expensesBudgeted)}</span>
              </span>
            </div>
            <HubProgress
              class="mt-1"
              height="h-2"
              value={snap.expensesActual}
              max={snap.expensesBudgeted}
              fill="bg-orange"
              label="Expenses spent vs budget"
              valueText={`${money(snap.expensesActual)} of ${money(snap.expensesBudgeted)} spent`}
            />
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-border pt-3 text-sm">
          <span class="font-semibold text-ink-muted">Year to date</span>
          <span class={`font-bold ${net >= 0 ? 'text-green-ink' : 'text-orange-ink'}`}>
            {net >= 0 ? '+' : '-'}
            {money(net)} {net >= 0 ? 'surplus' : 'deficit'}
          </span>
        </div>
      </div>
    )
  }
</HomeWidgetCard>
