---
/* ============================================================================
   ClassHubBody — shared content for a Family Hub class page
   ============================================================================
   Given a class slug, renders the class facts (schedule/age/tuition), the pay
   button, a class-updates empty-state (fills from Sanity later), and a link to
   the public class page for the full program description. Keeps the four class
   pages down to a few lines each.
   ============================================================================ */
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { payUrl, type WcpClass } from '@/data/classes';
import { getHubClass } from '@/lib/hub-classes';
import { sanityFetch } from '@/lib/sanity';
import { renderPortableText } from '@/lib/portable-text';
import { site } from '@/data/site';
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
  slug: WcpClass['slug'];
  // Optional editable sections from the class's hubPage doc (rendered below the
  // fixed facts + notes). Undefined/empty renders nothing.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
}
const { slug, sections } = Astro.props;
// Class facts + PayPal tuition button id from Sanity (data-file fallback).
const c = await getHubClass(slug);

interface ClassNote {
  _id: string;
  title: string;
  publishedAt: string;
  body?: PortableTextBlock[];
}
let notes: ClassNote[] = [];
try {
  notes = await sanityFetch<ClassNote[]>(
    `*[_type == "classNote" && class == $slug] | order(publishedAt desc){ _id, title, publishedAt, body }`,
    { slug },
  );
} catch {
  notes = [];
}
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Both Pre-K classes share one public marketing page.
const publicHref =
  slug === 'pre-k-am' || slug === 'pre-k-pm' ? '/classes/pre-k' : `/classes/${slug}`;

const facts = [
  { icon: 'calendar-days', label: 'Days', value: c.days },
  { icon: 'clock', label: 'Time', value: c.time },
  { icon: c.icon, label: 'Ages', value: c.age },
  { icon: 'circle-dollar-sign', label: 'Monthly tuition', value: `${c.monthly} / month` },
  { icon: 'coins', label: 'Annual tuition', value: c.annual },
  { icon: 'palette', label: 'Student fee', value: `${c.studentFee} / year` },
];
---

<Section bg="white" label={`${c.name} class details`}>
  <div class="mx-auto max-w-3xl">
    {/* Facts */}
    <div data-reveal>
      <h2 class="text-xl font-extrabold text-heading">At a glance</h2>
      <dl class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          facts.map((f) => (
            <div class="flex items-center gap-3 rounded-[var(--radius)] border border-border bg-white p-4 dark:bg-surface">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
                aria-hidden="true"
              >
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <div>
                <dt class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                  {f.label}
                </dt>
                <dd class="font-bold text-heading">{f.value}</dd>
              </div>
            </div>
          ))
        }
      </dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={payUrl(c.payId)} target="_blank" rel="noopener" variant="primary" size="md">
          Pay {c.name} Tuition
        </Button>
        <Button href={publicHref} variant="outline" size="md">
          See the full {c.name} program
        </Button>
      </div>
    </div>

    {/* Class-specific updates (Sanity later) */}
    <div class="mt-14" data-reveal>
      <h2 class="text-xl font-extrabold text-heading">Class notes & updates</h2>
      <p class="mt-2 text-ink">
        Notes from your teacher — supply reminders, special days, and what’s happening in the {
          c.name
        }
        room.
      </p>
      {
        notes.length === 0 ? (
          <HubEmptyState
            icon="megaphone"
            title="No class notes posted yet"
            source="sanity"
            class="mt-6"
          />
        ) : (
          <ul class="mt-6 space-y-4">
            {notes.map((n) => (
              <li class="wcp-lift rounded-[var(--radius)] border border-border bg-white p-5 shadow-sm hover:shadow-md dark:bg-surface">
                <p class="text-sm text-ink-muted">{fmtDate(n.publishedAt)}</p>
                <h3 class="mt-1 text-lg font-extrabold text-heading">{n.title}</h3>
                {n.body && (
                  <div class="prose-sm mt-2 max-w-none leading-relaxed text-ink [&_a]:text-navy [&_a]:underline dark:[&_a]:text-sky">
                    <Fragment set:html={renderPortableText(n.body)} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Section>

{/* Editable section(s) from the class's hubPage doc (Board-managed). */}
<SectionRenderer sections={sections} site={site} />
