---
/* ============================================================================
   HubSectionedBody — handbook body as a stack of cards + a right "on this page" TOC
   ============================================================================
   The class handbooks + Getting Started render their body through the SAME
   marketing sections the public site uses (Section + SectionHeader). Left as-is
   they read as "a web page dropped into the app": full-bleed color bands, each
   re-centering in its own container at a different width from the page header.

   Here we re-frame that run as one dashboard/Confluence-style document column:
     - Everything sits inside the page's shared max-w-6xl container (the pages
       render this component INSIDE the same <Section>/container as the header),
       so the header, body, and TOC all share one left/right rail.
     - Each Board section is wrapped in a `.hub-doc-block` with a TREATMENT that
       decides its chrome (see below), so block-like sections get a white card
       and long-form prose flows on the surface — the "hybrid" look.
     - A `card` section gets a small type-derived icon chip so it reads as a
       labelled panel and ties into the hub's icon-chip vocabulary.
     - On xl+ the column is paired with a sticky vertical TOC on the RIGHT
       (HubSectionIndex); below xl the TOC hides and the cards run full-width.
     - hub-doc.ts adds copy-link anchors on headings, a two-level TOC when a
       section has subheads, and scrollspy.

   Treatments (hybrid card model):
     - flow  — prose/long-form: no card, text flows on the app surface.
     - card  — a discrete block (FAQ, schedule, table, quick facts, quote, form,
               step list, …): white card chrome, matching HubCard.
     - bleed — sections that already carry their own cards or a full color band
               (card grids, class cards, CTAs, galleries, stat bands): no outer
               card, so we never nest a card in a card.
   The actual card/flow/bleed styling lives in globals.css, keyed off
   `data-treatment` — see the "Handbook document column" block there.

   `tint` (a class slug) tints the doc column to that class's brand color — the
   card icon chips and the active TOC accent — so a class handbook feels like
   its class. Omitted on Getting Started, which stays neutral sky.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
// TEMPORARY (Sanity write quota): the class-pet blurb + photo. Delete with
// src/lib/hub-stopgaps.ts once the section is a real splitMediaSection.
import ClassPetSection from '@/components/sections/ClassPetSection.astro';
import HubSectionIndex from '@/components/hub/HubSectionIndex.astro';
import HubEmptyState from '@/components/hub/HubEmptyState.astro';
import { classColor, classStyles } from '@/lib/class-colors';
import { cn } from '@/lib/utils';
import { site } from '@/data/site';

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
  /** Accessible name for the TOC, e.g. "Handbook sections". */
  label: string;
  /** Class slug to tint the column (card icons + active TOC accent). */
  tint?: string;
  /** Class slug whose teacher signs off the closing CTA (headshot + contact
      pills). Set on the class handbooks; omitted on Getting Started. */
  signoff?: string;
  /** Extra classes on the grid root (e.g. top margin from the page). */
  class?: string;
}
const { sections, label, tint, signoff, class: className } = Astro.props;

const items = sections ?? [];

// Only lay out the TOC column when there's a TOC worth showing (>1 heading).
const tocCount = items.filter((s) => s?.header?.title && s?._key).length;

// Section types that already render their OWN cards or a full color band —
// wrapping these in another card would nest a card in a card, so they bleed.
const BLEED = new Set([
  'cardGridSection',
  'classCardsSection',
  'ctaSection',
  'enrollmentCtaSection',
  'statBandSection',
  'gallerySection',
  'albumSection',
  'programCardsSection',
  'boardMembersSection',
  'latestPostsSection',
  'upcomingEventsSection',
  'logoStripSection',
  'campaignSection',
  'jobsSection',
  'splitMediaSection',
  'instagramSection',
  'teacherSection',
  // Renders its own image + text band, exactly like splitMediaSection.
  'classPetSection',
]);
// Long-form / prose-like sections: text flows on the surface, no card chrome.
const FLOW = new Set(['proseSection', 'storyTimelineSection']);
// Everything else is a discrete block that reads well as a white card.
const treatmentFor = (type: string): 'flow' | 'card' | 'bleed' =>
  FLOW.has(type) ? 'flow' : BLEED.has(type) ? 'bleed' : 'card';

// A card section's label icon, derived from its _type (no Sanity field — stays
// brand-locked). Undefined = no chip (a plain titled card, still fine).
const CARD_ICON: Record<string, string> = {
  faqSection: 'message-circle',
  scheduleSection: 'clock',
  countdownSection: 'clock',
  stepListSection: 'list-checks',
  quickFactsSection: 'list',
  accordionSection: 'list',
  tabsSection: 'folder',
  compareSection: 'scale',
  tuitionTableSection: 'circle-dollar-sign',
  tuitionCalculatorSection: 'calculator',
  mapSection: 'map-pin',
  downloadsSection: 'file-text',
  formSection: 'file-pen',
  reviewFormSection: 'file-pen',
  newsletterSignupSection: 'mail',
  contactDetailsSection: 'contact',
  noticeBarSection: 'megaphone',
  schoolYearSection: 'calendar-days',
};

// The teacher signs off only the CLOSING CTA (the LAST ctaSection), so a
// mid-handbook ctaSection the Board might add never gets a teacher signature.
const lastCtaKey = signoff
  ? [...items].reverse().find((s) => s?._type === 'ctaSection')?._key
  : undefined;

// Tint: class iconChip for the card icons, and a CSS accent color for the TOC
// active state. Neutral sky when there's no class (Getting Started).
const iconChip = tint ? classStyles(tint).iconChip : 'bg-sky/15 text-sky-ink';
const accentStyle = tint ? `--hub-doc-accent: var(--color-${classColor(tint)})` : undefined;
---

{
  items.length === 0 ? (
    /* No sections yet: a designed "this is being written" panel beats a blank
       column — the handbook body is entirely Board-editable, so an unseeded
       page shouldn't read as broken. */
    <div class:list={['hub-doc', className]}>
      <HubEmptyState spot="documents" title="This handbook is being written." source="sanity" />
    </div>
  ) : (
    <div
      class:list={['hub-doc', tocCount > 1 && 'hub-doc-grid', className]}
      style={accentStyle}
      data-hub-doc
    >
      {/* Below xl the sticky TOC column is hidden, which left a 10k px handbook
           with no way to skip ahead on a phone — this collapsed "On this page"
           jump list is the mobile answer (xl:hidden inside the component). */}
      <HubSectionIndex sections={sections} label={label} variant="inline" />
      {/* Content column FIRST (natural reading order, content-first for screen
           readers) — the TOC follows and is placed in the right grid column.
           Inside `.hub-prose` the shared marketing sections are re-skinned as
           app content (left-aligned, denser, no marketing eyebrow); see
           globals.css. */}
      <div class="hub-prose min-w-0">
        {items.map((section) => {
          const treatment = treatmentFor(section?._type);
          const icon = treatment === 'card' ? CARD_ICON[section?._type] : undefined;
          // The closing CTA on a class handbook becomes a signed sign-off card
          // (teacher headshot + contact pills). Rendered via CtaSection directly
          // so it can take the extra teacherSlug prop SectionRenderer doesn't
          // forward; every other section goes through SectionRenderer as before.
          const isSignoffCta =
            Boolean(signoff) && section?._type === 'ctaSection' && section?._key === lastCtaKey;
          return (
            <div class="hub-doc-block" data-treatment={treatment}>
              {icon && (
                <span class={cn('hub-doc-card-icon', iconChip)} aria-hidden="true">
                  <Icon name={icon} class="h-5 w-5" />
                </span>
              )}
              {section?._type === 'classPetSection' ? (
                <ClassPetSection section={section} />
              ) : isSignoffCta ? (
                <CtaSection section={section} teacherSlug={signoff} />
              ) : (
                <SectionRenderer sections={[section]} site={site} cardWatermark hub />
              )}
            </div>
          );
        })}
      </div>
      <HubSectionIndex sections={sections} label={label} />
    </div>
  )
}

<script>
  import '@/scripts/hub-doc';
</script>
