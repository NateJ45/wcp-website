---
/* ============================================================================
   WeatherWeekWidget — 7-day forecast, so parents can plan ahead
   ============================================================================
   Answers "does Thursday need a coat?" before it's Thursday morning. Each day
   tile carries a colour-coded condition icon + one-word label, the high/low, a
   temperature RANGE BAR (the day's span within the week's, so the days compare
   at a glance), the rain CHANCE (%), and pack hints (coat / umbrella). A
   horizontally-scrolling strip below sm (stays clean to 320px), a 7-column grid
   above. Empty (no card) when the forecast is unavailable — a stale week-old
   forecast would mislead, unlike the greeting's curated fallback. Condition
   copy + thresholds live in src/lib/hub-weather.ts.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import Icon from '@/components/Icon.astro';
import { getWeekAheadForecast, type WeatherIcon } from '@/lib/hub-weather';

const days = await getWeekAheadForecast();
const empty = days.length === 0;

// Colour each condition icon by what it means (sun warm, rain sky-blue, storm
// orange caution, snow icy-blue). Icons are aria-hidden decoration, so colour
// carries no contrast requirement; the tile's text stays neutral.
const ICON_COLOR: Record<WeatherIcon, string> = {
  sun: 'text-amber',
  'cloud-sun': 'text-amber',
  cloud: 'text-ink-muted',
  'cloud-rain': 'text-sky-ink',
  'cloud-lightning': 'text-orange-ink',
  'cloud-fog': 'text-ink-muted',
  snowflake: 'text-sky',
};

// Temperature range bar: plot each day's low→high as a segment within the
// WEEK's span, so a warm day's bar visibly sits right of a cool day's.
const weekMax = days.length ? Math.max(...days.map((d) => d.high)) : 0;
const weekMin = days.length ? Math.min(...days.map((d) => d.low)) : 0;
const span = Math.max(1, weekMax - weekMin);
const pctOf = (t: number) => ((t - weekMin) / span) * 100;
---

<HomeWidgetCard
  icon="cloud-sun"
  title="Week ahead"
  empty={empty}
  emptyText="The 7-day forecast isn't available right now."
>
  <p class="text-sm text-ink-muted">Plan ahead for outdoor play, coats, boots, and all.</p>
  {
    /* Phone: a horizontal scroll strip (fixed-width tiles, shrink-0) so it
       stays clean down to 320px. sm+ (where this card is a full-width band):
       a 7-column grid so the days spread across the whole width. */
  }
  <ul
    class="wcp-week-scroll mt-3 flex gap-2 overflow-x-auto pt-1 pb-1 sm:grid sm:grid-cols-7 sm:overflow-x-visible sm:pt-0 sm:pb-0"
  >
    {
      days.map((d, i) => {
        const isToday = i === 0;
        const leftPct = pctOf(d.low);
        const widthPct = Math.max(10, pctOf(d.high) - leftPct);
        return (
          <li
            class:list={[
              'flex w-[4.6rem] shrink-0 flex-col items-center gap-1.5 rounded-xl p-2.5 text-center transition-transform hover:-translate-y-0.5 hover:shadow-sm motion-reduce:hover:translate-y-0 sm:w-auto',
              // ring-inset: an OUTSIDE ring on the leftmost "today" tile gets
              // clipped by the scroll strip's overflow (overflow-x-auto also
              // clips the y axis); an inset ring draws inside the tile, so no
              // edge is ever cut.
              isToday
                ? 'bg-sky/10 ring-2 ring-sky/50 ring-inset dark:bg-sky/15'
                : 'bg-grey dark:bg-navy/30',
            ]}
          >
            <span
              class:list={[
                'text-[0.66rem] font-bold tracking-wide uppercase',
                isToday ? 'text-heading' : 'text-ink-muted',
              ]}
            >
              {d.dayLabel}
            </span>
            <Icon name={d.icon} class:list={['h-6 w-6', ICON_COLOR[d.icon]]} aria-hidden="true" />
            <span class="text-xs font-semibold text-ink-muted">{d.label}</span>
            <span class="text-sm font-bold text-heading">
              {d.high}°<span class="font-semibold text-ink-muted">/{d.low}°</span>
            </span>
            {/* Temperature range bar — the day's low→high within the week span. */}
            <div
              class="relative h-1.5 w-full overflow-hidden rounded-full bg-black/5 dark:bg-white/10"
              aria-hidden="true"
            >
              <span
                class="absolute inset-y-0 rounded-full"
                style={`left:${leftPct}%;width:${widthPct}%;background:linear-gradient(90deg,var(--color-sky),var(--color-amber))`}
              />
            </div>
            {/* Rain chance + pack hints (min-height keeps tiles aligned). */}
            <div class="flex min-h-[1.15rem] items-center gap-1.5" aria-hidden="true">
              {d.precipChance >= 10 && (
                <span class="inline-flex items-center gap-0.5 text-[0.7rem] font-bold text-heading">
                  <Icon name="droplet" class="h-3.5 w-3.5 text-sky-ink" />
                  {d.precipChance}%
                </span>
              )}
              {d.needsCoat && <Icon name="shirt" class="h-3.5 w-3.5 text-orange-ink" />}
              {d.needsRainGear && <Icon name="umbrella" class="h-3.5 w-3.5 text-sky-ink" />}
              {d.needsSunscreen && <Icon name="sun" class="h-3.5 w-3.5 text-amber" />}
            </div>
            <span class="sr-only">
              {d.dayLabel}: {d.line}
              {d.precipChance >= 10 && ` ${d.precipChance}% chance of rain.`}
              {d.needsCoat && ' Pack a warm coat.'}
              {d.needsRainGear && ' Pack rain gear.'}
              {d.needsSunscreen && ' High UV, pack sun protection.'}
            </span>
          </li>
        );
      })
    }
  </ul>
</HomeWidgetCard>

<style>
  /* WCP-branded horizontal scrollbar for the phone day-strip (only scrolls
     below sm — sm+ is a grid). A sky-blue pill thumb on a faint sky track:
     hints "more days over here" in the brand's own blue instead of the OS
     grey. Firefox uses scrollbar-color; Chromium/Safari the ::-webkit pseudos.
     --color-sky already aliases correctly in dark mode, so one set of tokens
     reads AA in both themes. */
  .wcp-week-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-sky) color-mix(in oklab, var(--color-sky) 14%, transparent);
  }
  .wcp-week-scroll::-webkit-scrollbar {
    height: 0.5rem;
  }
  .wcp-week-scroll::-webkit-scrollbar-track {
    background: color-mix(in oklab, var(--color-sky) 14%, transparent);
    border-radius: 9999px;
  }
  .wcp-week-scroll::-webkit-scrollbar-thumb {
    background: var(--color-sky);
    border-radius: 9999px;
  }
  .wcp-week-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-sky-ink);
  }
</style>
