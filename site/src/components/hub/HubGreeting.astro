---
/* ============================================================================
   HubGreeting — the Home command strip: greeting, live stats, school-year bar
   ============================================================================
   The dashboard's HERO TILE and (since the 2026-07-14 app-elevation Track B)
   the hub's ONE hero-tier DATA surface: time-of-day greeting, ambient chips
   (date, weather, air quality), then a row of live, deep-linking stats — next
   school event, days 'til school, families, and the fundraising-year ring —
   over the school-year progress bar. Every number is real (Sanity, the
   treasurer's sheet, the calendar feed, Open-Meteo, NWS) and every stat links
   to its page. A stat whose source is empty simply omits itself ("designed
   absence, not a broken zero").

   Weather (src/lib/hub-weather.ts) and air quality (hub-air-quality.ts) are
   free/keyless Open-Meteo reads for the school's fixed coordinates. A NWS
   weather alert (hub-alerts.ts), when one is active and school-relevant,
   breaks out of the chip row as its own banner — the one thing on this tile
   urgent enough to warrant it.

   Server-rendered only. The calendar + fundraising reads ride the same
   SWR-cached helpers the widgets below already call, so within a request the
   in-isolate cache dedupes them — no new blocking reads on first paint; the
   three new external reads run concurrently with the Sanity settings read for
   the same reason. Greeting uses America/New_York wall-clock time via Intl
   (NOT Date#getHours, which is UTC in the Workers runtime).

   THEME-STABLE ISLAND: like the hub rail, this navy tile looks identical in
   light and dark mode, so the gradient's sky end hardcodes the light-mode
   sky-ink hex (#166fa8, white text 5.4:1 AA) — the token flips to bright sky
   in dark mode, where white text would fail. Chips are white-on-white/15;
   stats/ring use HubStat/HubRing's navy tone (white on navy — never colored
   ink on a tint, see the CLAUDE.md dark-tint gotcha).
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import HubStat from '@/components/hub/HubStat.astro';
import HubRing from '@/components/hub/HubRing.astro';
// Pre-sized webp + plain <img>: SSR pages can't resize at request time on the
// Cloudflare adapter, so <Image> served the 3.6MB original emblem here
// (Lighthouse, 2026-07-14). See the same note in HubTopBar.
import wcpEmblem from '@/assets/brand/wcp-emblem-sm.webp';
import { daysUntil, greetingForHour, nyHour, yearProgressPercent } from '@/lib/hub-dashboard-dates';
import { getUpcomingEvents, eventDate, type HubEvent } from '@/lib/hub-calendar';
import { getFundraisers } from '@/lib/gsheets';
import { getWeather } from '@/lib/hub-weather';
import { getAirQuality } from '@/lib/hub-air-quality';
import { getActiveAlert } from '@/lib/hub-alerts';
import { sanityFetch } from '@/lib/sanity';
import {
  budgetSheetIdFallback,
  calendarFeedUrlFallback,
  pastFundraisingTotalsFallback,
} from '@/data/hub/live-links';

interface Props {
  yearStart?: string;
  yearEnd?: string;
  firstDay?: string;
  familyCount?: number;
}
const { yearStart, yearEnd, firstDay, familyCount } = Astro.props;

const now = new Date();
// Greeting: Eastern wall-clock hour, not server UTC.
const greeting = greetingForHour(nyHour(now));

const todayLabel = now.toLocaleDateString('en-US', {
  timeZone: 'America/New_York',
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});

const daysToFirstDay = daysUntil(firstDay, now);
const daysToYearEnd = daysUntil(yearEnd, now);

// Post-year: a gentle chip — unless the countdown stat to the NEXT first day
// is already showing (both true in summer once next year's dates are set).
const countingDown = daysToFirstDay !== null && daysToFirstDay > 0;
const summerChip = daysToYearEnd !== null && daysToYearEnd <= 0 && !countingDown;

// Progress bar: only when both bounds form a real span (yearProgressPercent
// guards the divide-by-zero/inverted cases and clamps stale dates).
const yearPct = yearProgressPercent(yearStart, yearEnd, now);

// --- Live stats (same settings-fallback pattern as the widgets below) ------
// Weather/air-quality/alert are independent of the Sanity read, so they run
// concurrently with it — keeps this tile's "no new blocking reads on first
// paint" promise even with three more external fetches.
const [settings, weather, airQuality, alert] = await Promise.all([
  (async () => {
    try {
      return await sanityFetch<{
        calendarFeedUrl?: string;
        budgetSheetId?: string;
        pastFundraisingTotals?: { yearLabel?: string; amount?: number }[] | null;
      } | null>(
        `*[_type == "siteSettings"][0]{ calendarFeedUrl, budgetSheetId, pastFundraisingTotals }`,
      );
    } catch {
      return null;
    }
  })(),
  getWeather(),
  getAirQuality(),
  getActiveAlert(),
]);

// Next school event (SWR-cached feed; the Upcoming Events widget re-uses it).
const events: HubEvent[] = await getUpcomingEvents(
  settings?.calendarFeedUrl || calendarFeedUrlFallback,
);
const nextEvent = events[0] ?? null;
const nextEventDate = nextEvent
  ? eventDate(nextEvent.start).toLocaleDateString('en-US', {
      timeZone: 'America/New_York',
      month: 'short',
      day: 'numeric',
    })
  : null;

// Fundraising year total (SWR-cached sheet; the Fundraising widget re-uses it).
const fundraisers = await getFundraisers(settings?.budgetSheetId || budgetSheetIdFallback);
const raised = fundraisers.reduce((s, f) => s + f.raised, 0);
const goal = fundraisers.reduce((s, f) => s + f.goal, 0);
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;

// SEASON-AWARE fundraising slot: a 0% ring is worse than no ring (a stalled
// meter reads as a dying campaign), so before any money lands the same slot
// looks FORWARD instead: how many fundraisers are lined up, plus last year's
// grand total as social proof (Board-editable "Past fundraising totals" on
// Site Settings, same source as the Fundraising page's band).
const fundraisersComing = fundraisers.filter((f) => f.status !== 'complete').length;
const cmsPastTotals = (settings?.pastFundraisingTotals ?? []).filter(
  (t): t is { yearLabel: string; amount: number } =>
    Boolean(t.yearLabel) && typeof t.amount === 'number',
);
const lastYearRaised = (cmsPastTotals[0] ?? pastFundraisingTotalsFallback[0])?.amount ?? 0;

// First-day sub-line under the countdown (date-only ISO string — anchor via
// eventDate's noon-UTC rule, never `new Date('YYYY-MM-DD')`, see CLAUDE.md).
const firstDayLabel =
  countingDown && firstDay
    ? eventDate(firstDay).toLocaleDateString('en-US', {
        timeZone: 'America/New_York',
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      })
    : null;
---

<div
  class="flex h-full flex-col rounded-[var(--radius)] bg-gradient-to-br from-navy to-[#166fa8] p-6 text-white shadow-sm sm:p-8"
  data-reveal
>
  <div class="flex items-start justify-between gap-6">
    <div class="min-w-0">
      {/* The greeting is the page h1 (Home uses HubShell `bare`, no navy band). */}
      <h1 id="hub-page-title" class="font-display text-3xl text-balance text-white sm:text-4xl">
        {greeting}, WCP family!
      </h1>
      <p class="mt-2 max-w-xl text-white/90">Welcome to the WCP Family Hub!</p>

      {
        /* Active weather alert — the one thing on this tile urgent enough to
           break out of the quiet chip row. Only school-relevant NWS alerts
           (winter/ice/flood/extreme temps, or anything NWS flags Severe or
           Extreme) reach here; see src/lib/hub-alerts.ts. */
        alert && (
          <div class="mt-3 flex items-start gap-2 rounded-lg border border-amber/40 bg-amber/20 px-3 py-2 text-sm font-semibold text-white">
            <Icon
              name="triangle-alert"
              class="mt-0.5 h-4 w-4 shrink-0 text-amber"
              aria-hidden="true"
            />
            <span>{alert.headline}</span>
          </div>
        )
      }

      <ul class="mt-5 flex flex-wrap gap-2">
        <li
          class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
        >
          <Icon name="calendar-days" class="h-4 w-4" />
          {todayLabel}
        </li>
        {
          /* Weather moved from a top chip to the richer "today" ribbon at the
             foot of this tile (below) — one weather element, more detail, and it
             fills the tile's foot. AQI stays a chip (distinct info). */
        }
        {
          airQuality && (
            <li class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold">
              <Icon name={airQuality.icon} class="h-4 w-4" />
              AQI {airQuality.aqi} · {airQuality.line}
            </li>
          )
        }
        {
          summerChip && (
            <li class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold">
              <Icon name="sun" class="h-4 w-4 text-amber" />
              Enjoy your summer!
            </li>
          )
        }
        {
          /* Reopen pill for the President's welcome letter — hidden until
             note-modal.ts confirms the modal is on the page (JS running), so a
             dismissed letter is never lost behind its one-time auto-open. */
        }
        <li hidden data-note-open-wrap>
          <button
            type="button"
            data-note-open
            hidden
            class="inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-white/25"
          >
            <Icon name="mail" class="h-4 w-4 text-amber" />
            A note from your President
          </button>
        </li>
      </ul>
    </div>

    {/* Sun-and-cloud brand emblem — the hero's one decorative accent. */}
    <img
      src={wcpEmblem.src}
      alt=""
      width={wcpEmblem.width}
      height={wcpEmblem.height}
      class="wcp-float-slow hidden h-24 w-auto shrink-0 sm:block lg:h-28"
    />
  </div>

  {/* Command-strip stats: every figure live, every stat a deep link. */}
  <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-5">
    {
      daysToFirstDay !== null && daysToFirstDay > 0 && (
        <a href="/family-hub/calendar" class="wcp-strip-stat">
          <HubStat
            tone="navy"
            countUp
            value={String(daysToFirstDay)}
            label={`day${daysToFirstDay === 1 ? '' : 's'} 'til school`}
          />
          {firstDayLabel && <p class="mt-0.5 text-xs text-white/85">First day: {firstDayLabel}</p>}
        </a>
      )
    }
    {
      nextEvent && nextEventDate && (
        <a href="/family-hub/calendar" class="wcp-strip-stat max-w-56">
          <HubStat tone="navy" value={nextEventDate} label="next up" />
          <p class="mt-0.5 line-clamp-2 text-xs text-white/85">{nextEvent.title}</p>
        </a>
      )
    }
    {
      familyCount && familyCount > 0 ? (
        <a href="/family-hub/directory" class="wcp-strip-stat">
          <HubStat
            tone="navy"
            countUp
            value={String(familyCount)}
            label={`famil${familyCount === 1 ? 'y' : 'ies'}`}
          />
        </a>
      ) : null
    }
    {
      /* Money in → the live ring. Nothing raised yet (pre-season) → look
         forward instead of showing a dead 0% meter. Neither → omit. */
      goal > 0 && raised > 0 ? (
        <a href="/family-hub/fundraising" class="wcp-strip-stat flex items-center gap-3">
          <HubRing
            tone="navy"
            size="sm"
            value={raised}
            max={goal}
            label="Fundraising progress this year"
            valueText={`${money(raised)} of ${money(goal)} raised`}
          />
          <span class="text-sm leading-tight">
            <span class="block font-bold">{money(raised)} raised</span>
            <span class="block text-white/85">of {money(goal)} goal</span>
          </span>
        </a>
      ) : goal > 0 && fundraisersComing > 0 ? (
        <a href="/family-hub/fundraising" class="wcp-strip-stat">
          <HubStat
            tone="navy"
            countUp
            value={String(fundraisersComing)}
            label={`fundraiser${fundraisersComing === 1 ? '' : 's'} lined up`}
          />
          {lastYearRaised > 0 && (
            <p class="mt-0.5 text-xs text-white/85">{money(lastYearRaised)} raised last year</p>
          )}
        </a>
      ) : null
    }
  </div>

  {
    /* Foot of the hero tile: the school-year progress bar (in-season only —
       "0%" in July is noise) sits above a "today" weather ribbon that fills the
       foot year-round. The events tile beside this column makes the row taller
       than the greeting's own text, so without a foot element the tile had a
       big empty gap under the stats. */
  }
  <div class="mt-auto pt-6">
    {
      yearPct !== null && yearPct > 0 && (
        <div class="max-w-xl">
          <div class="flex items-center justify-between text-xs font-semibold text-white/90">
            <span>School year progress</span>
            <span>{yearPct}%</span>
          </div>
          <HubProgress
            class="mt-1.5"
            value={yearPct}
            label="School year progress"
            fill="bg-amber"
            track="bg-white/20"
          />
        </div>
      )
    }
    {
      weather && (
        <div
          class:list={[
            'flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/15 pt-4 text-sm',
            yearPct !== null && yearPct > 0 && 'mt-4',
          ]}
        >
          <span class="inline-flex items-center gap-2">
            <Icon name={weather.icon} class="h-5 w-5 text-amber" aria-hidden="true" />
            <span class="text-xs font-bold tracking-wide text-white/70 uppercase">Today</span>
            <span class="font-bold">
              {weather.high}°<span class="font-semibold text-white/70">/{weather.low}°</span>
            </span>
          </span>
          <span class="text-white/90">{weather.line}</span>
          {weather.precipChance >= 10 && (
            <span class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold">
              <Icon name="droplet" class="h-3.5 w-3.5 text-sky" aria-hidden="true" />
              {weather.precipChance}% rain
            </span>
          )}
        </div>
      )
    }
  </div>
</div>

<style>
  /* Stat links: quiet at rest, obvious on interaction, keyboard-visible. */
  .wcp-strip-stat {
    display: inline-block;
    text-decoration: none;
    color: inherit;
    border-radius: 0.5rem;
    transition: opacity 0.15s ease;
  }
  .wcp-strip-stat:hover {
    opacity: 0.85;
  }
  .wcp-strip-stat:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .wcp-strip-stat {
      transition: none;
    }
  }
</style>
