---
/* ============================================================================
   HubGreeting — Family Hub home hero: greeting, chips, school-year bar
   ============================================================================
   The dashboard's HERO TILE: a navy→sky gradient card with the sun-and-cloud
   emblem, the time-of-day greeting in the display font, community chips, and
   the school-year progress bar. The bento layout's dominant-color anchor —
   every other tile stays a white card, so this is the one saturated moment
   (restrained-color principle: one dominant color, sharp accents).

   Server-rendered only (no client JS, no ticking countdown). Greeting uses
   America/New_York wall-clock time via Intl (NOT Date#getHours, which is UTC
   in the Workers runtime with no local TZ data). Chips and the progress bar
   each read optional siteSettings fields and simply omit themselves when
   unset ("designed absence, not a broken zero").

   THEME-STABLE ISLAND: like the hub rail, this navy tile looks identical in
   light and dark mode, so the gradient's sky end hardcodes the light-mode
   sky-ink hex (#166fa8, white text 5.4:1 AA) — the token flips to bright sky
   in dark mode, where white text would fail. Chips are white-on-white/15
   (never colored ink on a tint — see the CLAUDE.md dark-tint gotcha).
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import wcpEmblem from '@/assets/brand/wcp-emblem.png';

interface Props {
  tagline: string;
  yearStart?: string;
  yearEnd?: string;
  firstDay?: string;
  familyCount?: number;
}
const { tagline, yearStart, yearEnd, firstDay, familyCount } = Astro.props;

// Greeting: Eastern wall-clock hour, not server UTC. hourCycle 'h23' avoids the
// "24" some ICU implementations return for midnight under hour12:false.
const nyHour = Number(
  new Date().toLocaleString('en-US', {
    timeZone: 'America/New_York',
    hour: 'numeric',
    hourCycle: 'h23',
  }),
);
const greeting = nyHour < 12 ? 'Good morning' : nyHour < 17 ? 'Good afternoon' : 'Good evening';

const todayLabel = new Date().toLocaleDateString('en-US', {
  timeZone: 'America/New_York',
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});

// Whole-calendar-day math on UTC-normalized date-only strings (Sanity `date`
// fields are "YYYY-MM-DD", no time component) — a day off at most near a
// midnight boundary, which is fine for an at-a-glance chip, not a precise
// instant.
const todayUTC = new Date(`${new Date().toISOString().slice(0, 10)}T00:00:00Z`);
const daysUntil = (iso?: string): number | null => {
  if (!iso) return null;
  const target = new Date(`${iso}T00:00:00Z`);
  return Math.ceil((target.getTime() - todayUTC.getTime()) / 86_400_000);
};

const daysToFirstDay = daysUntil(firstDay);
const daysToYearEnd = daysUntil(yearEnd);

// Third chip: "N days 'til school" before the first day, a gentle end-of-year
// note once the year has ended, otherwise nothing (mid-year has no single
// glanceable number worth showing here — the progress bar covers that).
let statusChip: { icon: string; text: string } | null = null;
if (daysToFirstDay !== null && daysToFirstDay > 0) {
  statusChip = {
    icon: 'party-popper',
    text: `${daysToFirstDay} day${daysToFirstDay === 1 ? '' : 's'} 'til school`,
  };
} else if (daysToYearEnd !== null && daysToYearEnd <= 0) {
  statusChip = { icon: 'sun', text: 'Enjoy your summer!' };
}

// Progress bar: only when both bounds are set AND form a real span (yearEnd
// strictly after yearStart) — an equal or inverted pair would divide by zero
// (or a negative span), so guard the denominator before dividing, matching
// fundraising.astro's `pctOf` guard pattern. Clamps outside the range so a
// stale date never produces a negative width either.
const yearSpanMs =
  yearStart && yearEnd
    ? new Date(`${yearEnd}T00:00:00Z`).getTime() - new Date(`${yearStart}T00:00:00Z`).getTime()
    : 0;
const yearPct =
  yearStart && yearEnd && yearSpanMs > 0
    ? Math.min(
        100,
        Math.max(
          0,
          Math.round(
            ((todayUTC.getTime() - new Date(`${yearStart}T00:00:00Z`).getTime()) / yearSpanMs) *
              100,
          ),
        ),
      )
    : null;

const familiesLabel =
  familyCount && familyCount > 0 ? `${familyCount} famil${familyCount === 1 ? 'y' : 'ies'}` : null;
---

<div
  class="flex h-full flex-col rounded-[var(--radius)] bg-gradient-to-br from-navy to-[#166fa8] p-6 text-white shadow-sm sm:p-8"
  data-reveal
>
  <div class="flex items-start justify-between gap-6">
    <div class="min-w-0">
      {/* The greeting is the page h1 (Home uses HubShell `bare`, no navy band). */}
      <h1 id="hub-page-title" class="font-display text-3xl text-balance text-white sm:text-4xl">
        {greeting}, WCP family!
      </h1>
      <p class="mt-2 max-w-xl text-white/90">{tagline}</p>

      <ul class="mt-5 flex flex-wrap gap-2">
        <li
          class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
        >
          <Icon name="calendar-days" class="h-4 w-4" />
          {todayLabel}
        </li>
        {
          familiesLabel && (
            <li class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold">
              <Icon name="users" class="h-4 w-4" />
              {familiesLabel}
            </li>
          )
        }
        {
          statusChip && (
            <li class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold">
              <Icon name={statusChip.icon} class="h-4 w-4 text-amber" />
              {statusChip.text}
            </li>
          )
        }
      </ul>
    </div>

    {/* Sun-and-cloud brand emblem — the hero's one decorative accent. */}
    <Image src={wcpEmblem} alt="" class="hidden h-24 w-auto shrink-0 sm:block lg:h-28" />
  </div>

  {
    yearPct !== null && (
      <div class="mt-auto max-w-xl pt-6">
        <div class="flex items-center justify-between text-xs font-semibold text-white/90">
          <span>School year progress</span>
          <span>{yearPct}%</span>
        </div>
        <HubProgress
          class="mt-1.5"
          value={yearPct}
          label="School year progress"
          fill="bg-amber"
          track="bg-white/20"
        />
      </div>
    )
  }
</div>
