---
/* ============================================================================
   HubSpark — tiny inline sparkline (decorative, honest data only)
   ============================================================================
   A 64x24 SVG mini bar/line chart for the few real series the hub has
   (updates per month via _createdAt, events per month from the calendar feed,
   per-campaign totals). ALWAYS aria-hidden with the real numbers adjacent in
   text: the spark is texture, never the only carrier of the information.
   Never feed it invented data (2026-07-14 app-elevation kit, "data is
   honest"). Color rides currentColor: set a text-* class on it or a parent.
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Props {
  data: number[];
  type?: 'bar' | 'line';
  class?: string;
}
const { data, type = 'bar', class: className } = Astro.props;

const W = 64;
const H = 24;
const peak = Math.max(...data, 1);
const n = Math.max(data.length, 1);

// Bars: even slots with a 2px gutter, 2px minimum height so zero months
// still show a baseline tick instead of vanishing.
const slot = W / n;
const bars = data.map((v, i) => {
  const h = Math.max(2, Math.round((Math.max(0, v) / peak) * (H - 2)));
  return { x: +(i * slot + 1).toFixed(1), y: H - h, w: +Math.max(1, slot - 2).toFixed(1), h };
});

const points = data
  .map((v, i) => {
    const x = n === 1 ? W / 2 : (i / (n - 1)) * (W - 2) + 1;
    const y = H - 2 - (Math.max(0, v) / peak) * (H - 4);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class={cn('inline-block h-6 w-16 shrink-0', className)}
  aria-hidden="true"
>
  {
    type === 'bar' ? (
      bars.map((b, i) => (
        <rect
          x={b.x}
          y={b.y}
          width={b.w}
          height={b.h}
          rx="1"
          class="wcp-spark-bar fill-current opacity-70"
          style={`--i:${i}`}
        />
      ))
    ) : (
      <polyline
        points={points}
        pathLength="1"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="wcp-spark-line"
      />
    )
  }
</svg>

<style>
  /* Draw-on: bars grow up from the baseline with a short left-to-right stagger;
     the line strokes itself in. Decorative + aria-hidden, so this is pure
     texture — reduced-motion users get the finished chart with no motion, and
     it runs on plain CSS so it still plays for a spark inserted inside a
     server-deferred widget island (where a one-shot script would miss it).
     `backwards` holds the pre-animation state during the stagger delay; with no
     `forwards` fill each mark settles back to its natural, fully drawn value. */
  @media (prefers-reduced-motion: no-preference) {
    .wcp-spark-bar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: wcp-spark-grow 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: calc(var(--i, 0) * 45ms);
    }
    @keyframes wcp-spark-grow {
      from {
        transform: scaleY(0);
      }
    }
    .wcp-spark-line {
      animation: wcp-spark-draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    @keyframes wcp-spark-draw {
      from {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
      }
      to {
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
      }
    }
  }
</style>
