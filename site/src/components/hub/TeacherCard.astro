---
/* ============================================================================
   TeacherCard — the class teacher, up top where families expect a face
   ============================================================================
   Reads the class's teacherNote doc (same source as the first-visit welcome
   modal — photo, name, role, email are already board-editable there, so this
   card costs the Studio nothing new). Renders nothing when no note exists or
   it has no name — designed absence. The photo ring rides the class color; when
   the note has no headshot the card shows a class-colored icon instead.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { urlForImage, type SanityImageSource } from '@/lib/image';
import { colorStyles } from '@/lib/class-colors';
import { TEACHER_NOTE_CARD_QUERY, pickNote, telHref as toTel } from '@/lib/hub-teacher-note';
import { teacherPhoneFallback } from '@/data/hub/live-links';

interface Props {
  /** Note keys for this classroom, most specific first (teacherNoteKeys()). */
  keys: string[];
  /** The classroom's brand colour, from the class document. */
  color?: string;
}
const { keys, color } = Astro.props;

interface TeacherDoc {
  key?: string;
  signName?: string;
  signRole?: string;
  email?: string;
  phone?: string;
  photo?: { asset?: unknown; alt?: string } | null;
}
let teacher: TeacherDoc | null = null;
try {
  teacher = pickNote(
    await sanityFetch<TeacherDoc[]>(
      TEACHER_NOTE_CARD_QUERY,
      { keys },
      { cache: BOARD_CONTENT_CACHE },
    ),
    keys,
  );
} catch {
  teacher = null;
}

const cc = colorStyles(color);
// Portrait-preserving (no forced square crop): the browser crops the circle
// with `object-top`, so a head sitting high in the frame is never sliced off.
// The card renders an 80px (h-20 w-20) circle, so 160px covers 2x/retina.
// Portrait-preserving (width only), then object-cover crops it to the circle.
const photoUrl = teacher?.photo?.asset
  ? urlForImage(teacher.photo as SanityImageSource)
      .width(160)
      .url()
  : null;
// Studio value wins; fall back to the committed number until the field is set.
const phone = teacher?.phone || keys.map((k) => teacherPhoneFallback[k]).find(Boolean);
const telHref = toTel(phone);
---

{
  teacher?.signName && (
    <div class="hub-note flex h-full items-center gap-4 rounded-[var(--radius)] border border-border bg-white p-6 shadow-sm dark:bg-surface">
      {photoUrl ? (
        <img
          src={photoUrl}
          alt={teacher.photo?.alt || `${teacher.signName}, teacher`}
          width="80"
          height="80"
          loading="lazy"
          class={`h-20 w-20 shrink-0 rounded-full border-4 object-cover object-top ${cc.border}`}
        />
      ) : (
        <span
          class={`flex h-20 w-20 shrink-0 items-center justify-center rounded-full ${cc.iconChip}`}
          aria-hidden="true"
        >
          <Icon name="heart" class="h-8 w-8" />
        </span>
      )}
      <div class="min-w-0">
        <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Your teacher</p>
        <p class="font-display text-xl text-heading">{teacher.signName}</p>
        {teacher.signRole && <p class="text-sm text-ink-muted">{teacher.signRole}</p>}
        <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
          {teacher.email && (
            <a
              href={`mailto:${teacher.email}`}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-ink hover:underline"
            >
              <Icon name="mail" class="h-3.5 w-3.5" aria-hidden="true" />
              Say hi
            </a>
          )}
          {telHref && (
            <a
              href={telHref}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-ink hover:underline"
            >
              <Icon name="phone" class="h-3.5 w-3.5" aria-hidden="true" />
              Call or text
            </a>
          )}
          {/* Reopen pill for the teacher's welcome letter (note-modal.ts
              unhides it when the letter modal is on this page), so the
              first-visit auto-open is never the only way to read it. */}
          <button
            type="button"
            data-note-open
            hidden
            class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-bold text-sky-ink hover:underline"
          >
            <Icon name="newspaper" class="h-3.5 w-3.5" aria-hidden="true" />
            Welcome letter
          </button>
        </div>
      </div>
    </div>
  )
}
