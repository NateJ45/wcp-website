---
/* ============================================================================
   UpcomingEventsWidget — the next ~3 months of events, live from the school
   Google Calendar (Apps Script feed; Board-editable URL on siteSettings,
   working fallback in live-links.ts), with Sanity `event` docs as the fallback
   source — see src/lib/hub-calendar.ts. It fills the bento's tall side tile
   (row-span-2), so we show everything within a rolling 3-month horizon (capped
   at 12 so a busy season can't run away) rather than a fixed few — a short list
   left a big empty gap under it. "See all" points at the hub's Calendar page.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import { sanityFetch } from '@/lib/sanity';
import {
  getUpcomingEvents,
  eventDate,
  eventType,
  eventId,
  toEventDetail,
  EVENT_TYPE_META,
  fmtEventMonth,
  fmtEventDay,
  fmtEventWeekday,
  fmtEventTime,
  type HubEvent,
} from '@/lib/hub-calendar';
import { calendarFeedUrlFallback } from '@/data/hub/live-links';
import { deEmDash } from '@/lib/portable-text';

let feedUrl = calendarFeedUrlFallback;
try {
  feedUrl =
    (await sanityFetch<string | null>(`*[_type == "hubSettings"][0].calendarFeedUrl`)) ||
    calendarFeedUrlFallback;
} catch {
  feedUrl = calendarFeedUrlFallback;
}

// Everything in the next ~3 months (92 days), capped at 12. getUpcomingEvents
// already returns future events sorted ascending; we just trim the far tail.
const HORIZON = Date.now() + 92 * 24 * 60 * 60 * 1000;
const events: HubEvent[] = (await getUpcomingEvents(feedUrl))
  .filter((e) => eventDate(e.start).getTime() <= HORIZON)
  .slice(0, 12);

// On PHONES the single-column stack means every extra event pushes the rest of
// the dashboard down a screen — 12 events cost ~4 screens before any personal
// content (2026-07-16 audit). Show the first 5 and fold the tail behind a
// "+N more" calendar link; on lg+ the tall row-span-2 tile still wants the
// full list, so the cap is CSS-only (hidden lg:flex on the tail items).
const MOBILE_CAP = 5;
const foldedCount = Math.max(0, events.length - MOBILE_CAP);

// Each row opens the shared HubEventDialog (rendered page-level in
// index.astro), same as the Calendar page. This widget is a server:defer
// island, so it ships its OWN [data-hub-events] blob with its markup —
// hub-event-dialog.ts merges every blob it finds at click time (its load-time
// scan would run before this island streams in). "<" escaped so a title can
// never break out of the script context.
const detailsJson = JSON.stringify(events.map(toEventDetail)).replace(/</g, '\\u003c');
---

<HomeWidgetCard
  icon="calendar-days"
  title="Upcoming Events"
  seeAllHref="/family-hub/calendar"
  empty={events.length === 0}
  emptyText="Upcoming events will list here once they're added."
>
  <ul class="space-y-3">
    {
      events.map((e, i) => {
        // Colour the date chip by event type — same brand mapping as the
        // Calendar page (meetings navy, volunteer sky, milestones orange,
        // events green).
        const meta = EVENT_TYPE_META[eventType(e.title)];
        return (
          <li class={i < MOBILE_CAP ? 'block' : 'hidden lg:block'}>
            {/* A real link (calendar page = the no-JS/new-tab destination);
                hub-event-dialog.ts upgrades a plain click to the details
                dialog via data-event-id, exactly like the Calendar page's
                agenda cards. Negative margin keeps the hover fill flush with
                the card edge without shifting the resting layout. */}
            <a
              href="/family-hub/calendar"
              data-event-id={eventId(e)}
              class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-1 no-underline transition-colors hover:bg-grey/70 focus-visible:bg-grey/70 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
            >
              <span
                class={`flex w-11 shrink-0 flex-col items-center rounded-lg py-1.5 ${meta.chipBg}`}
              >
                <span class={`text-[0.62rem] font-bold uppercase ${meta.chipText}`}>
                  {fmtEventMonth(e)}
                </span>
                <span class="text-lg leading-tight font-extrabold text-heading">
                  {fmtEventDay(e)}
                </span>
              </span>
              <div class="min-w-0">
                <p class="line-clamp-2 font-semibold text-heading">{deEmDash(e.title)}</p>
                <p class="text-sm text-ink-muted">
                  {fmtEventWeekday(e)} · {fmtEventTime(e)}
                  {e.location ? ` · ${e.location}` : ''}
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
    {
      foldedCount > 0 && (
        <li class="lg:hidden">
          <a
            href="/family-hub/calendar"
            class="inline-flex items-center gap-1.5 font-bold text-sky-ink hover:underline"
          >
            +{foldedCount} more on the calendar
            <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      )
    }
  </ul>
  {
    events.length > 0 && (
      <script type="application/json" data-hub-events set:html={detailsJson} is:inline />
    )
  }
</HomeWidgetCard>
