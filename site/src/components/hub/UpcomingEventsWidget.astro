---
/* ============================================================================
   UpcomingEventsWidget — the next 5 events, live from the school Google
   Calendar (Apps Script feed; Board-editable URL on siteSettings, working
   fallback in live-links.ts), with Sanity `event` docs as the fallback
   source — see src/lib/hub-calendar.ts. Five, not three: this widget fills
   the bento's tall side tile (row-span-2) and a tall tile with only three
   rows reads sparse. "See all" points at the hub's Calendar page, which
   lists the same feed above its embed.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import { sanityFetch } from '@/lib/sanity';
import {
  getUpcomingEvents,
  fmtEventMonth,
  fmtEventDay,
  fmtEventWeekday,
  fmtEventTime,
  type HubEvent,
} from '@/lib/hub-calendar';
import { calendarFeedUrlFallback } from '@/data/hub/live-links';

let feedUrl = calendarFeedUrlFallback;
try {
  feedUrl =
    (await sanityFetch<string | null>(`*[_type == "siteSettings"][0].calendarFeedUrl`)) ||
    calendarFeedUrlFallback;
} catch {
  feedUrl = calendarFeedUrlFallback;
}

const events: HubEvent[] = (await getUpcomingEvents(feedUrl)).slice(0, 5);
---

<HomeWidgetCard
  icon="calendar-days"
  title="Upcoming Events"
  seeAllHref="/family-hub/calendar"
  empty={events.length === 0}
  emptyText="Upcoming events will list here once they're added."
>
  <ul class="space-y-3">
    {
      events.map((e) => (
        <li class="flex items-center gap-3">
          <span class="flex w-11 shrink-0 flex-col items-center rounded-lg bg-grey py-1.5">
            <span class="text-[0.62rem] font-bold text-sky-ink uppercase">{fmtEventMonth(e)}</span>
            <span class="text-lg leading-tight font-extrabold text-heading">{fmtEventDay(e)}</span>
          </span>
          <div class="min-w-0">
            <p class="truncate font-semibold text-heading" title={e.title}>
              {e.title}
            </p>
            <p class="text-sm text-ink-muted">
              {fmtEventWeekday(e)} · {fmtEventTime(e)}
              {e.location ? ` · ${e.location}` : ''}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</HomeWidgetCard>
