---
/* ============================================================================
   PresidentNoteModal — the Board President's welcome letter (first visit)
   ============================================================================
   Reads the `presidentNote` singleton live behind the gate and renders a
   hidden modal; src/scripts/president-note.ts opens it once per version
   stamp (localStorage remembers the dismissal, bumping `version` in the
   Studio re-shows it to everyone). Renders nothing at all when the note is
   off or missing, so the hub home pays no cost.

   A11y: role="dialog" + aria-modal, focus moves to the close button on open
   and returns to the page on close, Esc / backdrop / X all close, body
   scroll locks while open, Tab is trapped inside. Entrance is a gentle
   fade+rise, disabled under prefers-reduced-motion.
   ============================================================================ */
// Great Vibes (signature script) is lazy-loaded by note-modal.ts when the
// modal OPENS — a static import here shipped it as render-blocking page CSS
// for a font nothing visible-at-load uses (Lighthouse, 2026-07-14).
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import SanityImage from '@/components/SanityImage.astro';
import { sanityFetch } from '@/lib/sanity';
import { renderPortableText } from '@/lib/portable-text';
import type { PortableTextBlock } from '@portabletext/types';

interface PresidentNote {
  active?: boolean;
  version?: string;
  heading?: string;
  dateLabel?: string;
  salutation?: string;
  body?: PortableTextBlock[];
  signName?: string;
  signoff?: string;
  signRole?: string;
  email?: string;
  photo?: { asset?: unknown; alt?: string } | null;
}

let note: PresidentNote | null = null;
try {
  note = await sanityFetch<PresidentNote | null>(
    `*[_type == "presidentNote"][0]{ active, version, heading, dateLabel, salutation, body, signName, signoff, signRole, email, photo }`,
  );
} catch {
  note = null;
}

const show = Boolean(note?.active && note?.version && note?.heading && note?.body?.length);
const bodyHtml = show ? renderPortableText(note!.body) : '';
const initial = (note?.signName ?? 'W').trim().charAt(0).toUpperCase();
// "Board President, 2026-27" must never wrap between "2026-" and "27": swap
// hyphens between digits for non-breaking hyphens (U+2011) before rendering.
const role = note?.signRole?.replace(/(\d)-(?=\d)/g, '$1‑');
---

{
  show && (
    <div
      hidden
      data-note-modal
      data-storage-key="wcp-president-note-seen"
      data-version={note!.version}
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
    >
      {/* Backdrop — a tap anywhere on it closes the note. */}
      <div data-note-close class="absolute inset-0 bg-navy/60" />

      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="president-note-heading"
        class="president-note-box relative flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-[var(--radius)] bg-white shadow-2xl dark:bg-surface"
        style="max-height: 92dvh"
      >
        <button
          type="button"
          data-note-close
          aria-label="Close note"
          class="absolute top-3 right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy text-white shadow-md transition-colors hover:bg-navy/85"
        >
          <Icon name="x" class="h-5 w-5" />
        </button>

        <div class="overflow-y-auto overscroll-contain p-6 pt-14 sm:p-10 sm:pt-12">
          <div class="flex flex-col gap-6 sm:flex-row sm:gap-8">
            {/* Photo + signer */}
            <div class="flex shrink-0 items-center gap-4 sm:w-40 sm:flex-col sm:text-center">
              {note!.photo?.asset ? (
                <SanityImage
                  source={note!.photo as never}
                  alt={note!.photo!.alt ?? note!.signName ?? 'Board President'}
                  widths={[160, 320]}
                  sizes="10rem"
                  class="h-20 w-20 rounded-full border-4 border-amber object-cover sm:h-32 sm:w-32"
                />
              ) : (
                <span
                  class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-4 border-amber bg-grey font-display text-3xl text-heading sm:h-32 sm:w-32"
                  aria-hidden="true"
                >
                  {initial}
                </span>
              )}
              <div class="min-w-0">
                <p class="font-bold text-heading">{note!.signName}</p>
                {role && <p class="text-sm text-ink-muted">{role}</p>}
              </div>
            </div>

            {/* Letter */}
            <div class="min-w-0 flex-1">
              <h2
                id="president-note-heading"
                class="font-display text-2xl text-heading sm:text-3xl"
              >
                {note!.heading}
              </h2>
              {note!.dateLabel && <p class="mt-1 text-sm text-ink-muted">{note!.dateLabel}</p>}
              {note!.salutation && <p class="mt-4 font-bold text-heading">{note!.salutation}</p>}
              <Prose class="mt-3">
                <Fragment set:html={bodyHtml} />
              </Prose>
              <div class="mt-6 border-t border-border pt-4">
                <p class="text-sm text-ink-muted">{note?.signoff?.trim() || 'With warmth,'}</p>
                {/* Handwritten-signature moment — Great Vibes runs small for its
                    em size, so the jump to text-4xl reads as normal sign-off
                    scale. -rotate-2 gives it the slight off-axis of a real pen
                    stroke. */}
                <p class="w-fit -rotate-2 pt-1 pl-1 font-signature text-4xl text-heading">
                  {note!.signName}
                </p>
                <p class="text-sm text-ink-muted">
                  {role}
                  {note!.email && (
                    <>
                      {role ? ' · ' : ''}
                      <a
                        href={`mailto:${note!.email}`}
                        class="font-semibold text-sky-ink hover:underline"
                      >
                        {note!.email}
                      </a>
                    </>
                  )}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

{show && <script>import '@/scripts/note-modal';</script>}

<style>
  /* Gentle entrance — state-conveying, short, reduced-motion-safe. */
  @media (prefers-reduced-motion: no-preference) {
    [data-note-modal]:not([hidden]) .president-note-box {
      animation: president-note-in 0.25s ease-out both;
    }
  }
  @keyframes president-note-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
