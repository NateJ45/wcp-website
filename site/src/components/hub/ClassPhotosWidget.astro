---
/* ============================================================================
   ClassPhotosWidget — this year's Google Photos album for each class
   ============================================================================
   One tile per class, from the `class` documents (src/lib/hub-classrooms.ts),
   so a class the Board adds gets a tile by itself. Album links are
   Board-editable on each `class` doc (`photoAlbumUrl`); a class with no link
   is left out rather than shown as a dead tile. Class color rides on the icon
   chip only — labels stay neutral text (the dark-mode tint AA rule).
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import Icon from '@/components/Icon.astro';
import { colorStyles } from '@/lib/class-colors';
import { getHubClassrooms } from '@/lib/hub-classes';
import { classTiles } from '@/lib/hub-classrooms';

// One tile per CLASS, from the `class` documents — a class the Board adds gets
// its album tile with no code change. A class with no album link is skipped.
const albums = classTiles(await getHubClassrooms()).filter((c) => c.photoAlbumUrl);
const empty = albums.length === 0;
---

<HomeWidgetCard
  icon="camera"
  title="Class Photos"
  empty={empty}
  emptyText="Class photos will appear here once the photo gallery is set up."
>
  <p class="text-sm text-ink-muted">This year's album for each class, on Google Photos.</p>
  {
    /* Column count follows how wide the card actually is, so the class label
       never truncates: single column below 360px (two-up clips "Pre-K AM" at
       320 — 2026-07-16 mobile audit), two-up on phones, then back to one in the
       1024–1100 band where the dashboard sidebar squeezes the card to ~240px
       ("Tw… / VIEW ALBU M", 2026-07 responsive audit), and two-up again at xl
       where the column is wide. */
  }
  <div class="mt-3 grid grid-cols-1 gap-2 min-[360px]:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    {
      albums.map((a) => (
        <a
          href={a.photoAlbumUrl}
          target="_blank"
          rel="noopener"
          data-class-album={a.slug}
          class="flex items-center gap-2.5 rounded-lg bg-grey p-2.5 no-underline transition-colors hover:bg-navy/10 dark:hover:bg-white/10"
        >
          <span
            class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${colorStyles(a.color).iconChip}`}
            aria-hidden="true"
          >
            <Icon name={a.icon} class="h-4 w-4" />
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-bold text-heading">{a.label}</span>
            <span class="block text-[0.68rem] font-semibold tracking-wide text-ink-muted uppercase">
              View album
            </span>
          </span>
        </a>
      ))
    }
  </div>
</HomeWidgetCard>
