---
/* ============================================================================
   ClassAskGuide — "not sure who to ask?" split for a class page
   ============================================================================
   A compact two-column guide pairing the two people at the top of the page
   (TeacherCard + ClassRepCard): what belongs to the teacher vs. the class rep.
   Grounded in the co-op role definitions (src/data/hub/coop-roles.ts) and the
   class handbooks: the teacher owns the child, curriculum, classroom routines,
   attendance, and health-in-class; the Class Rep sets the helping schedule,
   relays class updates and coordinates class social life + Teacher
   Appreciation. Content is class-agnostic, so both class pages
   share it verbatim.

   The two lists are Board-editable in the Studio (Family Hub → How the co-op
   works), read per request; the arrays below are the committed fallback. Moving
   a topic from one column to the other is exactly the kind of edit that should
   not need a developer, and it used to.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { cn } from '@/lib/utils';
import { sanityFetch, BOARD_CONTENT_CACHE } from '@/lib/sanity';
import { COOP_GUIDANCE_QUERY } from '@/lib/queries';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const teacherAsksFallback = [
  'How your child is doing, and what they’re learning',
  'A worry about your child, or extra support they need',
  'Drop-off, pick-up, running late, or an absence',
  'Allergies, health, or anything they need in class',
];
const repAsksFallback = [
  'Your classroom helping schedule, or swapping a day',
  'Getting to know the other families in the class',
  'Class parties and Teacher Appreciation Week',
  'Your co-op job, or passing something to the Board',
];

// No PII, changes about once a year — rides the shared Board-content cache.
// A blank list in the Studio falls back rather than rendering an empty column:
// half a "who to ask" guide is worse than the committed one.
interface Guidance {
  teacherAsks?: string[];
  repAsks?: string[];
}
let guidance: Guidance | null = null;
try {
  guidance = await sanityFetch<Guidance | null>(
    COOP_GUIDANCE_QUERY,
    {},
    { cache: BOARD_CONTENT_CACHE },
  );
} catch {
  guidance = null;
}
const teacherAsks = guidance?.teacherAsks?.length ? guidance.teacherAsks : teacherAsksFallback;
const repAsks = guidance?.repAsks?.length ? guidance.repAsks : repAsksFallback;
---

<div
  class={cn(
    'hub-note rounded-[var(--radius)] border border-border bg-white p-5 shadow-sm sm:p-6 dark:bg-surface',
    className,
  )}
>
  <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Not sure who to ask?</p>
  <div class="mt-3 grid gap-5 sm:grid-cols-2 sm:gap-8">
    <div>
      <p class="flex items-center gap-2 font-bold text-heading">
        <span
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sky/15 text-sky-ink"
          aria-hidden="true"
        >
          <Icon name="graduation-cap" class="h-4 w-4" />
        </span>
        Your teacher
      </p>
      <p class="mt-1 text-sm font-medium text-ink-muted">Your child and the classroom</p>
      <ul class="mt-2.5 space-y-1.5">
        {
          teacherAsks.map((item) => (
            <li class="flex gap-2 text-sm text-ink">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-ink" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:border-l sm:border-border sm:pl-8">
      <p class="flex items-center gap-2 font-bold text-heading">
        <span
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber/25 text-orange-ink"
          aria-hidden="true"
        >
          <Icon name="hand-heart" class="h-4 w-4" />
        </span>
        Your class rep
      </p>
      <p class="mt-1 text-sm font-medium text-ink-muted">The co-op and the class community</p>
      <ul class="mt-2.5 space-y-1.5">
        {
          repAsks.map((item) => (
            <li class="flex gap-2 text-sm text-ink">
              <span
                class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-ink"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
