---
/* ============================================================================
   HubSectionIndex — "on this page" jump nav for long editorial pages
   ============================================================================
   Premium-screens primitive: persistent in-page context for pages whose body
   is a long run of Board-edited page-builder sections (the class handbooks,
   Getting Started). Derives one entry per section that has a heading, using the
   SAME id scheme SectionRenderer's bridges emit (titleIdFor → `sec-<_key>`), so
   the anchors always match without touching the Board's editing surface.

   Two variants:
     - `sidebar` (default): a VERTICAL sticky sidebar in the RIGHT column of
       HubSectionedBody's two-column grid on wide screens (xl+), with the
       current section highlighted (scrollspy, hub-doc.ts). Right side
       (GitBook/Notion-style) so it doesn't sit next to the hub rail as a
       second left-hand nav column. Hidden below xl.
     - `inline`: a collapsed <details> "On this page" jump list shown ONLY
       below xl, placed above the doc column — the phone answer to a 10,000px
       handbook with no way to skip ahead (2026-07-16 audit). STICKY below xl
       (2026-07-17) so it stays reachable however far down the page you are:
       pins near the top (clearing the floating desktop topbar on lg, same
       offset story as HubTable's sticky headers). Collapsed by default so it
       costs one row; the open list caps to the viewport and scrolls; closes
       itself after a jump. No scrollspy (that stays a sidebar affordance), so
       no data-hub-toc here — hub-doc.ts must keep binding the sidebar.
   Pure links otherwise (shareable, no-JS-safe).
   ============================================================================ */
import Icon from '@/components/Icon.astro';

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
  /** Accessible name, e.g. "Handbook sections". */
  label: string;
  /** `sidebar` (xl+ sticky column, default) or `inline` (<xl details list). */
  variant?: 'sidebar' | 'inline';
}
const { sections, label, variant = 'sidebar' } = Astro.props;

const entries = (sections ?? [])
  .filter((s) => s?.header?.title && s?._key)
  .map((s) => ({ id: `sec-${s._key}`, title: s.header.title as string }));
---

{
  entries.length > 1 && variant === 'sidebar' && (
    <nav aria-label={label} class="hub-toc hidden xl:block" data-hub-toc>
      <p class="mb-2 px-3 text-xs font-bold tracking-wide text-ink-muted uppercase">On this page</p>
      <ul>
        {entries.map((e) => (
          <li>
            <a href={`#${e.id}`} data-toc-link={e.id} class="hub-toc-link">
              {e.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  entries.length > 1 && variant === 'inline' && (
    /* Sticky on phones/tablet so it stays reachable however far down a 10k px
       handbook you are (2026-07-17). Below lg the phone strip is `relative`
       (scrolls away) so it pins near the very top; on lg (1024–1280px) the
       floating desktop topbar is `sticky top-0` (~56px), so clear it there —
       same offset story HubTable's sticky headers use (`lg:top-14`). Collapsed
       by default → a single pinned row; the script below closes it after a jump
       so it never sits open over the content it navigated to. z-20 keeps the
       open list above the doc cards; print drops it as chrome (below). */
    <nav
      data-hub-toc-inline-nav
      aria-label={label}
      class="sticky top-2 z-20 mb-6 lg:top-16 xl:hidden"
    >
      <details
        data-hub-toc-inline
        class="rounded-[var(--radius)] border border-border bg-white shadow-sm dark:bg-surface"
      >
        <summary class="flex cursor-pointer items-center gap-2 px-4 py-3 text-sm font-bold text-heading [&::-webkit-details-marker]:hidden">
          <Icon name="list" class="h-4 w-4 shrink-0 text-sky-ink" />
          On this page
          <Icon name="chevron-down" class="ml-auto h-4 w-4 shrink-0 text-ink-muted" />
        </summary>
        {/* Cap the open list to the viewport (minus the fixed tab bar) and let
            it scroll internally — a pinned details with 10+ entries would
            otherwise run off the bottom of the screen. */}
        <ul class="max-h-[70dvh] overflow-y-auto border-t border-border px-2 py-2">
          {entries.map((e) => (
            <li>
              <a
                href={`#${e.id}`}
                class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink no-underline hover:bg-grey dark:hover:bg-white/5"
              >
                {e.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

{
  /* Close the inline list after a jump so it never sits open over the content
    the reader just navigated to. Hoisted once per page (Astro dedupes); a
    sidebar-only page simply finds no [data-hub-toc-inline] and does nothing. */
}
<script>
  import { onPageLoad } from '@/scripts/_page-load';
  onPageLoad(() => {
    document.querySelectorAll<HTMLDetailsElement>('details[data-hub-toc-inline]').forEach((d) => {
      d.addEventListener('click', (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest('a[href^="#"]')) d.removeAttribute('open');
      });
    });
  });
</script>

{
  /* Anchor targets clear the sticky topbar when jumped to. The root scroller
    already sets scroll-padding-top: 4.5rem (globals.css) to clear the chrome,
    and the two ADD — 6rem here landed a jumped heading ~168px down, past the
    scrollspy's 140px line, so at rest it highlighted the section ABOVE. Keep
    this small: 4.5rem padding + 1.5rem margin = ~6rem, comfortably above the
    line. (Change hub-toc.ts's OFFSET too if this ever grows past it.) */
}
<style is:global>
  [id^='sec-'] {
    scroll-margin-top: 1.5rem;
  }
</style>
