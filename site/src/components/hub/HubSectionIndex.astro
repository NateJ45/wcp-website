---
/* ============================================================================
   HubSectionIndex — "on this page" jump nav for long editorial pages
   ============================================================================
   Premium-screens primitive: persistent in-page context for pages whose body
   is a long run of Board-edited page-builder sections (the class handbooks,
   Getting Started). Derives one entry per section that has a heading, using the
   SAME id scheme SectionRenderer's bridges emit (titleIdFor → `sec-<_key>`), so
   the anchors always match without touching the Board's editing surface.

   Rendered as a VERTICAL sticky sidebar in the RIGHT column of HubSectionedBody's
   two-column grid on wide screens (xl+), with the current section highlighted
   (scrollspy, hub-toc.ts). Right side (GitBook/Notion-style) so it doesn't sit
   next to the hub rail as a second left-hand nav column. Hidden below xl — no
   cramped scroller on phones; the page just scrolls. Pure links otherwise
   (shareable, no-JS-safe).
   ============================================================================ */
interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  sections?: any[];
  /** Accessible name, e.g. "Handbook sections". */
  label: string;
}
const { sections, label } = Astro.props;

const entries = (sections ?? [])
  .filter((s) => s?.header?.title && s?._key)
  .map((s) => ({ id: `sec-${s._key}`, title: s.header.title as string }));
---

{
  entries.length > 1 && (
    <nav aria-label={label} class="hub-toc hidden xl:block" data-hub-toc>
      <p class="mb-2 px-3 text-xs font-bold tracking-wide text-ink-muted uppercase">On this page</p>
      <ul>
        {entries.map((e) => (
          <li>
            <a href={`#${e.id}`} data-toc-link={e.id} class="hub-toc-link">
              {e.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{entries.length > 1 && <script>import '@/scripts/hub-toc';</script>}

{
  /* Anchor targets clear the sticky topbar when jumped to. The root scroller
    already sets scroll-padding-top: 4.5rem (globals.css) to clear the chrome,
    and the two ADD — 6rem here landed a jumped heading ~168px down, past the
    scrollspy's 140px line, so at rest it highlighted the section ABOVE. Keep
    this small: 4.5rem padding + 1.5rem margin = ~6rem, comfortably above the
    line. (Change hub-toc.ts's OFFSET too if this ever grows past it.) */
}
<style is:global>
  [id^='sec-'] {
    scroll-margin-top: 1.5rem;
  }
</style>
