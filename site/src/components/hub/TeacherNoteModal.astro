---
/* ============================================================================
   TeacherNoteModal — the teacher's welcome letter on a class hub page
   ============================================================================
   The class-page twin of PresidentNoteModal: reads that class's `teacherNote`
   doc live behind the gate and renders a hidden modal; src/scripts/note-modal
   opens it once per version stamp (localStorage key is per class, so a Twos
   family still sees the Pre-K letter when they visit that page). Renders
   nothing when the note is off or missing. Same a11y contract as the
   President's note: role=dialog, focus trap, Esc/backdrop/X, scroll lock.
   The photo ring picks up the class brand color.
   ============================================================================ */
import '@fontsource/great-vibes/index.css'; // signature script — loads only where this modal renders
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import SanityImage from '@/components/SanityImage.astro';
import { sanityFetch } from '@/lib/sanity';
import { renderPortableText } from '@/lib/portable-text';
import { classStyles } from '@/lib/class-colors';
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

interface TeacherNote {
  active?: boolean;
  version?: string;
  heading?: string;
  dateLabel?: string;
  salutation?: string;
  body?: PortableTextBlock[];
  signName?: string;
  signRole?: string;
  email?: string;
  photo?: { asset?: unknown; alt?: string } | null;
}

let note: TeacherNote | null = null;
try {
  note = await sanityFetch<TeacherNote | null>(
    `*[_type == "teacherNote" && class == $slug][0]{ active, version, heading, dateLabel, salutation, body, signName, signRole, email, photo }`,
    { slug },
  );
} catch {
  note = null;
}

const show = Boolean(note?.active && note?.version && note?.heading && note?.body?.length);
const bodyHtml = show ? renderPortableText(note!.body) : '';
const initial = (note?.signName ?? 'W').trim().charAt(0).toUpperCase();
const cc = classStyles(slug);
// Year labels like "2026-27" must never wrap mid-year (see PresidentNoteModal).
const role = note?.signRole?.replace(/(\d)-(?=\d)/g, '$1‑');
---

{
  show && (
    <div
      hidden
      data-note-modal
      data-storage-key={`wcp-teacher-note-${slug}`}
      data-version={note!.version}
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
    >
      {/* Backdrop — a tap anywhere on it closes the note. */}
      <div data-note-close class="absolute inset-0 bg-navy/60" />

      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="teacher-note-heading"
        class="teacher-note-box relative flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-[var(--radius)] bg-white shadow-2xl dark:bg-surface"
        style="max-height: 92dvh"
      >
        <button
          type="button"
          data-note-close
          aria-label="Close note"
          class="absolute top-3 right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy text-white shadow-md transition-colors hover:bg-navy/85"
        >
          <Icon name="x" class="h-5 w-5" />
        </button>

        <div class="overflow-y-auto overscroll-contain p-6 pt-14 sm:p-10 sm:pt-12">
          <div class="flex flex-col gap-6 sm:flex-row sm:gap-8">
            {/* Photo + signer */}
            <div class="flex shrink-0 items-center gap-4 sm:w-40 sm:flex-col sm:text-center">
              {note!.photo?.asset ? (
                <SanityImage
                  source={note!.photo as never}
                  alt={note!.photo!.alt ?? note!.signName ?? 'Teacher'}
                  widths={[160, 320]}
                  sizes="10rem"
                  class={`h-20 w-20 rounded-full border-4 object-cover sm:h-32 sm:w-32 ${cc.border}`}
                />
              ) : (
                <span
                  class={`flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-4 bg-grey font-display text-3xl text-heading sm:h-32 sm:w-32 ${cc.border}`}
                  aria-hidden="true"
                >
                  {initial}
                </span>
              )}
              <div class="min-w-0">
                <p class="font-bold text-heading">{note!.signName}</p>
                {role && <p class="text-sm text-ink-muted">{role}</p>}
              </div>
            </div>

            {/* Letter */}
            <div class="min-w-0 flex-1">
              <h2 id="teacher-note-heading" class="font-display text-2xl text-heading sm:text-3xl">
                {note!.heading}
              </h2>
              {note!.dateLabel && <p class="mt-1 text-sm text-ink-muted">{note!.dateLabel}</p>}
              {note!.salutation && <p class="mt-4 font-bold text-heading">{note!.salutation}</p>}
              <Prose class="mt-3">
                <Fragment set:html={bodyHtml} />
              </Prose>
              <div class="mt-6 border-t border-border pt-4">
                <p class="text-sm text-ink-muted">With warmth,</p>
                {/* Handwritten-signature moment — see PresidentNoteModal. */}
                <p class="w-fit -rotate-2 pt-1 pl-1 font-signature text-4xl text-heading">
                  {note!.signName}
                </p>
                <p class="text-sm text-ink-muted">
                  {role}
                  {note!.email && (
                    <>
                      {role ? ' · ' : ''}
                      <a
                        href={`mailto:${note!.email}`}
                        class="font-semibold text-sky-ink hover:underline"
                      >
                        {note!.email}
                      </a>
                    </>
                  )}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

{show && <script>import '@/scripts/note-modal';</script>}

<style>
  /* Gentle entrance — state-conveying, short, reduced-motion-safe. */
  @media (prefers-reduced-motion: no-preference) {
    [data-note-modal]:not([hidden]) .teacher-note-box {
      animation: teacher-note-in 0.25s ease-out both;
    }
  }
  @keyframes teacher-note-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
