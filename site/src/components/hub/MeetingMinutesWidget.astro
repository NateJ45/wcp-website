---
/* ============================================================================
   MeetingMinutesWidget — the latest Board meeting minutes.
   ============================================================================
   Primary source: `update` posts in the "minutes" category (the migrated
   Squarespace minutes live there, with their own hub pages). If none exist,
   falls back to `hubDocument` docs in the "minutes" category (file/link
   minutes, the Documents page's group) so the widget still works if the
   Board switches to posting minutes as files. "See all" goes to Updates,
   where minute posts live alongside announcements.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import { hubEditAttr } from '@/lib/hub-preview';
import Icon from '@/components/Icon.astro';
import { sanityFetch } from '@/lib/sanity';
import { EVENT_TZ } from '@/lib/events';
import { formatShortDate } from '@/lib/hub-dashboard-dates';

interface MinuteRow {
  docId?: string;
  docType?: string;
  title: string;
  href?: string;
  dateLabel?: string;
}
let minutes: MinuteRow[] = [];
try {
  const posts = await sanityFetch<
    { _id: string; title: string; publishedAt?: string; slug?: string }[]
  >(
    `*[_type == "update" && category == "minutes"] | order(publishedAt desc)[0...3]{ _id, title, publishedAt, "slug": slug.current }`,
  );
  minutes = (posts ?? []).map((p) => ({
    docId: p._id,
    docType: 'update',
    title: p.title,
    href: p.slug ? `/family-hub/updates/${p.slug}` : undefined,
    dateLabel: p.publishedAt ? formatShortDate(p.publishedAt, EVENT_TZ) : undefined,
    publishedAt: p.publishedAt,
  }));
} catch {
  minutes = [];
}
if (minutes.length === 0) {
  try {
    const docs = await sanityFetch<{ title: string; href?: string }[]>(
      `*[_type == "hubDocument" && category == "minutes" && (defined(link) || defined(file.asset))] | order(coalesce(orderRank, "~") asc, order asc)[0...3]{
        title,
        "href": select(sourceType == "file" => file.asset->url, link)
      }`,
    );
    minutes = (docs ?? []).filter((d) => d.href);
  } catch {
    minutes = [];
  }
}
---

<HomeWidgetCard
  icon="file-text"
  title="Meeting Minutes"
  seeAllHref="/family-hub/updates"
  postit
  empty={minutes.length === 0}
  emptyText="Board meeting minutes will list here once posted."
>
  <ul class="space-y-3">
    {
      minutes.map((m) => (
        /* data-published feeds the "new" pills (src/scripts/hub-fresh.ts). */
        <li
          data-published={('publishedAt' in m && m.publishedAt) || undefined}
          data-sanity={hubEditAttr(Astro.locals, m.docId, m.docType ?? 'update', 'title')}
        >
          {m.href ? (
            <a
              href={m.href}
              class="flex items-center gap-2 font-semibold text-heading hover:underline"
            >
              <Icon name="file-text" class="h-4 w-4 shrink-0 text-sky-ink" />
              <span class="line-clamp-2" title={m.title}>
                {m.title}
              </span>
            </a>
          ) : (
            <p class="flex items-center gap-2 font-semibold text-heading">
              <Icon name="file-text" class="h-4 w-4 shrink-0 text-sky-ink" />
              <span class="line-clamp-2" title={m.title}>
                {m.title}
              </span>
            </p>
          )}
          {m.dateLabel && <p class="pl-6 text-sm text-ink-muted">{m.dateLabel}</p>}
        </li>
      ))
    }
  </ul>
</HomeWidgetCard>
