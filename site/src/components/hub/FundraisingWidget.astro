---
/* ============================================================================
   FundraisingWidget — the year's running total, live from the treasurer's
   Fundraising sheet tab (same Board-editable sheet id as the Budget widget).
   Falls back to the most recent active Sanity `campaign` doc if the sheet is
   unreachable, then to the designed empty state — never a broken card.
   ============================================================================ */
import HomeWidgetCard from '@/components/hub/HomeWidgetCard.astro';
import HubProgress from '@/components/hub/HubProgress.astro';
import HubRing from '@/components/hub/HubRing.astro';
import HubStat from '@/components/hub/HubStat.astro';
import HubPill from '@/components/hub/HubPill.astro';
import { sanityFetch } from '@/lib/sanity';
import { ACTIVE_CAMPAIGN_QUERY } from '@/lib/queries';
import { getFundraisers, type Fundraiser } from '@/lib/gsheets';
import { getStoreProfit } from '@/lib/fourthwall';
import { budgetSheetIdFallback, storeSalesGoalFallback } from '@/data/hub/live-links';

let sheetId = budgetSheetIdFallback;
try {
  sheetId =
    (await sanityFetch<string | null>(`*[_type == "siteSettings"][0].budgetSheetId`)) ||
    budgetSheetIdFallback;
} catch {
  sheetId = budgetSheetIdFallback;
}

const fundraisers: Fundraiser[] = await getFundraisers(sheetId);

// Store Sales is live from Fourthwall (net profit) and folds into the year
// total — same rule as the Fundraising page, so the two rings agree. When the
// live total is available, drop any hand-kept shirt/store-sales sheet row so it
// isn't double-counted; the store has no goal, so it lifts raised only.
const storeProfit = await getStoreProfit();
const isStoreRow = (f: Fundraiser) => /\b(shirt|store)\s+sales\b/i.test(f.name);
const shown = storeProfit ? fundraisers.filter((f) => !isStoreRow(f)) : fundraisers;
const storeNet = storeProfit?.netProfit ?? 0;
// Keep the replaced row's goal (the budget's merch line) in the total so the
// year goal doesn't drop — same rule as the Fundraising page.
const storeGoal = storeProfit
  ? fundraisers.filter(isStoreRow).reduce((s, f) => s + f.goal, 0) || storeSalesGoalFallback
  : 0;
const totalGoal = shown.reduce((s, f) => s + f.goal, 0) + storeGoal;
const totalRaised = shown.reduce((s, f) => s + f.raised, 0) + storeNet;
const activeCount = shown.filter((f) => f.status === 'active').length;
const upcomingCount = shown.filter((f) => f.status === 'upcoming').length;

// Sheet unreachable → the old Sanity-campaign path.
interface Campaign {
  title?: string;
  goalAmount?: number;
  raisedAmount?: number;
}
let campaign: Campaign | null = null;
if (fundraisers.length === 0) {
  try {
    campaign = await sanityFetch<Campaign | null>(ACTIVE_CAMPAIGN_QUERY);
  } catch {
    campaign = null;
  }
}

const money = (n?: number) => `$${Math.round(n ?? 0).toLocaleString('en-US')}`;
const campaignPct =
  campaign?.goalAmount && campaign.goalAmount > 0
    ? Math.min(100, Math.round(((campaign.raisedAmount ?? 0) / campaign.goalAmount) * 100))
    : 0;
---

<HomeWidgetCard
  icon="party-popper"
  title="Fundraising"
  seeAllHref="/family-hub/fundraising"
  empty={fundraisers.length === 0 && !campaign}
  emptyText="Current campaigns and totals will show here once one is active."
>
  {
    fundraisers.length > 0 ? (
      <div>
        {/* Ring + stat (2026-07-14 kit): attainment as geometry, the real
            numbers beside it. Ring color: amber-ink measures AA as a graphic
            on white in light mode; dark aliases to bright amber on the dark
            surface, which also clears 3:1. */}
        <div class="flex items-center gap-4">
          <HubRing
            value={totalRaised}
            max={totalGoal}
            color="text-orange-ink dark:text-amber"
            label="Fundraising progress this year"
            valueText={`${money(totalRaised)} of ${money(totalGoal)} raised`}
          />
          <HubStat
            value={money(totalRaised)}
            label="raised this year"
            footnote={`${money(totalGoal)} goal`}
          />
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {activeCount > 0 && <HubPill kind="open">{activeCount} active now</HubPill>}
          {upcomingCount > 0 && <HubPill kind="waitlist">{upcomingCount} coming up</HubPill>}
          {activeCount === 0 && upcomingCount === 0 && (
            <p class="text-sm text-ink-muted">Every dollar goes back to our classrooms.</p>
          )}
        </div>
      </div>
    ) : campaign ? (
      <div>
        <p class="font-semibold text-heading">{campaign.title}</p>
        {campaign.goalAmount && campaign.goalAmount > 0 && (
          <>
            <div class="mt-3 flex items-end justify-between gap-3">
              <p class="text-lg font-bold text-heading">
                {money(campaign.raisedAmount)}
                <span class="text-xs font-normal text-ink-muted"> raised</span>
              </p>
              <p class="text-xs font-semibold text-ink-muted">{money(campaign.goalAmount)} goal</p>
            </div>
            <HubProgress
              class="mt-1.5"
              value={campaignPct}
              fill="bg-amber"
              label={`${campaign.title ?? 'Campaign'} progress`}
              valueText={`${money(campaign.raisedAmount)} of ${money(campaign.goalAmount)} raised`}
            />
          </>
        )}
      </div>
    ) : null
  }
</HomeWidgetCard>
