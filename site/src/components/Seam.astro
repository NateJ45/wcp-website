---
/* ============================================================================
   Seam — the Squarespace-style sweep divider at the TOP of a band
   ============================================================================
   One broad orange-traced arc (the old site's section divider, kept exactly —
   Nathan, 2026-07-19), designed to be dropped INSIDE a band. It positions itself just above the band's top edge
   (absolute +
   translate-y) and overlaps into the section above's bottom padding. Its filled
   scallop is the band's OWN color; everything above the scallop line is
   transparent, so it reveals whatever section sits above — no need to tell it
   the color above. An orange line traces the seam (the logo-warm accent).

   Requirements: the parent band must be `position: relative` (the components
   that use this add it), and the section above needs enough bottom padding for
   the ~30px overlap (our Section padding is generous — safe).

   Use SPARINGLY — only at a real color change. Purely decorative (aria-hidden).
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Props {
  /** The band's own background color (the scallop fills with this). */
  color?: 'white' | 'grey' | 'cream' | 'navy' | 'amber';
  /** Kept for call-site compatibility; every variant renders the one
      Squarespace-style sweep since 2026-07-19 (Nathan's call). */
  variant?: 'cloud' | 'trim';
  class?: string;
}
const { color = 'navy', variant = 'cloud', class: className } = Astro.props;

const fill: Record<string, string> = {
  white: '#ffffff',
  grey: 'var(--color-grey)',
  cream: 'var(--color-cream)',
  navy: 'var(--color-navy)',
  amber: 'var(--color-amber)',
};
// The trace line: orange everywhere except ON amber, where orange-on-amber
// disappears — the amber drench band gets a navy trace instead (decorative).
const stroke = color === 'amber' ? 'var(--color-navy)' : 'var(--color-orange)';

// THE sweep (2026-07-19, Nathan: "make the seams look exactly like the
// squarespace dividers"): one broad, slightly asymmetric arc — the section
// above bulges down into this band, lowest left-of-center, rising toward both
// edges — traced in orange. This replaces the earlier scallop/bulletin-trim
// family; `variant` is kept in the API so call sites don't churn, but every
// variant now renders the same sweep (one divider language site-wide, exactly
// like the old site).
const sweep = 'M0,14 C300,52 700,58 1000,40 C1180,29 1330,16 1440,10';
const line = sweep;
void variant;
---

<svg
  viewBox="0 0 1440 60"
  preserveAspectRatio="none"
  class={cn(
    'wcp-seam pointer-events-none absolute inset-x-0 top-0 block h-8 w-full -translate-y-full sm:h-12',
    className,
  )}
  aria-hidden="true"
>
  <path d={`${line} L1440,60 L0,60 Z`} fill={fill[color]}></path>
  <path d={line} fill="none" stroke={stroke} stroke-width="4" stroke-linecap="round"></path>
</svg>
