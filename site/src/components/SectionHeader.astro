---
/* ============================================================================
   SectionHeader — eyebrow + heading + optional lead
   ============================================================================
   The standard centered heading block that opens most sections. Pass `titleId`
   and wire it to the parent <Section labelledby={...}> so the landmark is named.
   Text color is inherited (navy on light sections, white on navy sections), so
   this reads correctly on any Section background with no per-use color props.
   ============================================================================ */
import Eyebrow from './Eyebrow.astro';
import HeadingAccent from './HeadingAccent.astro';
import { cn } from '@/lib/utils';
import { displayTitleHtml } from '@/lib/typography';
import { splitHeadingAccent } from '@/lib/emphasis';

interface Props {
  eyebrow?: string;
  eyebrowTone?: 'sky' | 'amber' | 'orange' | 'white';
  title: string;
  titleId?: string;
  as?: 'h1' | 'h2' | 'h3';
  lead?: string;
  /** Pre-rendered inline HTML for the lead, from a `leadRich` rich twin.
      When set it REPLACES `lead`; when blank the plain `lead` renders exactly
      as it always has. See src/lib/emphasis.ts. */
  leadHtml?: string;
  /** A word or short phrase from `title` to give the crayon underline. Blank
      (the stored state everywhere today) renders the heading untouched. */
  accent?: string;
  align?: 'center' | 'left';
  class?: string;
}

const {
  eyebrow,
  eyebrowTone = 'sky',
  title,
  titleId,
  as = 'h2',
  lead,
  leadHtml,
  accent,
  align = 'center',
  class: className,
} = Astro.props;

const Heading = as;

// The accent split runs on a stega-CLEANED copy of the title (a preview title
// carries invisible markers that break any search), so an accented heading
// loses click-to-edit inside the Studio preview. That is the accepted trade:
// the heading is still editable from the form, and the live site never encodes.
const accentParts = splitHeadingAccent(title, accent);
---

<div
  class={cn(
    'wcp-section-header max-w-2xl',
    align === 'center' ? 'mx-auto text-center' : 'text-left',
    className,
  )}
  data-reveal
>
  {eyebrow && <Eyebrow tone={eyebrowTone}>{eyebrow}</Eyebrow>}
  {
    /* displayTitleHtml escapes the Board-typed title, then glues hyphenated
      compounds ("Pre-K", "co-op") so display type never breaks at a hyphen.
      Mid-word hyphenation is off in the public layer (globals). */
  }
  {
    accentParts ? (
      <Heading id={titleId} class="text-balance">
        <Fragment set:html={displayTitleHtml(accentParts.before)} />
        <HeadingAccent text={accentParts.accent} />
        <Fragment set:html={displayTitleHtml(accentParts.after)} />
      </Heading>
    ) : (
      <Heading id={titleId} class="text-balance" set:html={displayTitleHtml(title)} />
    )
  }
  {leadHtml && <p class="mt-4 text-lg leading-relaxed" set:html={leadHtml} />}
  {!leadHtml && lead && <p class="mt-4 text-lg leading-relaxed">{lead}</p>}
</div>
