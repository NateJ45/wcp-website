---
/* ============================================================================
   Header — big overlay logo on desktop, slim bar on mobile
   ============================================================================
   FOUNDATION. Three renderings, all sharing one <header> landmark and one
   nav source (src/data/nav.ts via NavList.astro):

     1. Mobile bar (< lg)   — a normal in-flow sticky white bar: small logo +
        hamburger. Simple and safe on small screens.
     2. Big overlay (>= lg) — transparent, `position:absolute` over the page's
        Hero: a large centered logo, social/CTA row, and the primary nav
        below. Out of document flow (0 height), so the Hero starts at the
        true top of the page and this floats on top of it. A gradient scrim
        (independent of the Hero's own scrim) guarantees the logo/nav stay
        legible over any photo or video. Scrolls away normally with the page.
     3. Compact bar (>= lg) — `position:fixed`, hidden until the visitor
        scrolls past the big header (src/scripts/compact-nav.ts toggles
        `data-visible`), then slides in: small logo + inline nav + Enroll.

   Every page starts with a <Hero>, so the overlay pairing always has
   something to sit on top of. (A page that ever used Hero align="center"
   would need to check its text doesn't sit under the overlay's ~150px band.)
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import NavList from '@/components/NavList.astro';
import Button from '@/components/ui/Button.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import wcpLogoNavy from '@/assets/brand/wcp-logo-navy.png';
import wcpLogoWhite from '@/assets/brand/wcp-logo-white.png';
import { site as siteFallback } from '@/data/site';
import { getSiteSettings, getNavigation } from '@/lib/cms';
import { withBase } from '@/lib/utils';

interface Props {
  /** '' in production, '/preview' inside the Presentation preview. */
  linkBase?: string;
}
const { linkBase = '' } = Astro.props;
const b = (h: string) => withBase(h, linkBase);

// Phone/email/social/etc. are edited in Sanity (Site Settings) and merged
// over the static fallback here, so every `site.*` reference below reflects
// the CMS without touching the rest of this file. Menus come from Sanity too
// (Menus doc) with the static nav.ts as fallback.
const site = await getSiteSettings(siteFallback);
const { mainNav } = await getNavigation();

const hasSocial = Boolean(site.social.facebook || site.social.instagram);
// Digits-only tel: target derived from the CMS-editable display number (same
// pattern as Footer.astro), so click-to-call follows Site Settings.
const phoneDigits = site.phone.replace(/[^\d]/g, '');

// "Schedule a Tour" deep-links to the tour-request form on /virtual-tour. The
// anchor is `sec-` + the section's Sanity _key (titleIdFor in
// section-helpers.ts); that _key ("pp-tour-form") is a stable hand-written key
// from the migration script, so the fragment survives rebuilds and edits.
// Tour intent lands ON the form, never on /enroll (the two CTAs used to point
// at the same page, which buried the lower-commitment ask).
const tourHref = '/virtual-tour#sec-pp-tour-form';
---

<header data-header>
  {
    /* ---------------------------------------------------------------------
       1. Mobile bar — in-flow, sticky, solid white. Own hamburger + panel.
     --------------------------------------------------------------------- */
  }
  <div class="sticky top-0 z-40 border-b border-border bg-white lg:hidden dark:bg-surface">
    <div class="wcp-container flex items-center justify-between gap-4 py-3">
      <a href={b('/')} class="inline-flex items-center" aria-label={`${site.name} home`}>
        {
          /* Theme-correct lockup: the navy wordmark was near-invisible on the
            dark bar (Phase 0 audit, every route). Both variants ship; CSS picks. */
        }
        <Image
          src={wcpLogoNavy}
          alt={site.name}
          width={240}
          height={160}
          class="h-11 w-auto dark:hidden"
        />
        <Image
          src={wcpLogoWhite}
          alt={site.name}
          width={240}
          height={160}
          class="hidden h-11 w-auto dark:block"
        />
      </a>
      <div class="flex items-center gap-1">
        {
          /* Click-to-call. Hidden below 368px (min-[23rem]): the row is exactly
            full at 320px today (the logo already absorbs a squeeze), so a fifth
            control would crush the logo on the narrowest screens. Sub-368px
            visitors still get the full-width Call button inside the menu panel
            below, so the affordance is never lost. */
        }
        <a
          href={`tel:${phoneDigits}`}
          aria-label="Call West Chester Preschool"
          class="hidden h-11 w-11 items-center justify-center rounded-md text-heading hover:bg-grey min-[23rem]:inline-flex"
        >
          <Icon name="phone" class="h-5 w-5" />
        </a>
        <a
          href={b('/search')}
          aria-label="Search"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md text-heading hover:bg-grey"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </a>
        <ThemeToggle />
        {
          /* Tour-first doctrine: the one always-visible CTA is the tour ("Tour" keeps
            the 320px row from overflowing; the menu panel carries the full labels). */
        }
        <Button href={b(tourHref)} variant="accent" size="sm">Tour</Button>
        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md text-heading hover:bg-grey"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Menu"
          data-nav-toggle
        >
          <Icon name="menu" class="menu-icon h-6 w-6" />
          <Icon name="x" class="close-icon hidden h-6 w-6" />
        </button>
      </div>
    </div>
    <div id="mobile-nav" hidden class="border-t border-border bg-white dark:bg-surface">
      <nav aria-label="Mobile" class="wcp-container py-4">
        <NavList idPrefix="mobile" variant="mobile" items={mainNav} linkBase={linkBase} />
        <div class="mt-3 grid gap-2 border-t border-border pt-4">
          <Button href={b(tourHref)} variant="accent" class="w-full">Schedule a Tour</Button>
          <Button href={b('/enroll')} variant="outline" class="w-full">Enroll Your Child</Button>
          {
            /* Call affordance for every phone, including the sub-368px screens
              where the bar's phone icon is hidden (see the note above). */
          }
          <Button href={`tel:${phoneDigits}`} variant="outline" class="w-full">
            <Icon name="phone" class="h-4 w-4" />
            Call {site.phone}
          </Button>
          <a
            href={b('/family-hub')}
            class="justify-self-center py-1 text-sm font-semibold text-sky-ink underline underline-offset-2"
          >
            Enrolled families: Family Hub
          </a>
        </div>
      </nav>
    </div>
  </div>

  {
    /* ---------------------------------------------------------------------
       2. Big overlay header — desktop only. Transparent, floats over Hero.
     --------------------------------------------------------------------- */
  }
  <div class="relative z-30 hidden lg:block">
    {
      /* data-big-header lives on THIS element (not the zero-height flow
        wrapper above) because compact-nav.ts reads its real offsetHeight to
        know when the visitor has scrolled past it — an absolutely positioned
        element still reports its own rendered size even though it doesn't
        contribute to the parent's flow height. */
    }
    <div data-big-header class="absolute inset-x-0 top-0">
      {
        /* Scrim: guarantees the logo/nav read over any Hero media, independent
          of the Hero's own scrim. */
      }
      <div
        class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-navy/75 via-navy/30 to-transparent"
        aria-hidden="true"
      >
      </div>

      <div class="wcp-container relative flex items-center justify-between gap-6 pt-6">
        {/* Social + email (only shown when a real URL exists — see site.ts) */}
        <div class="flex w-40 items-center gap-2">
          {
            hasSocial && site.social.facebook && (
              <a
                href={site.social.facebook}
                target="_blank"
                rel="noopener"
                aria-label={`${site.name} on Facebook`}
                class="wcp-icon-btn"
              >
                <Icon name="facebook" class="h-4 w-4" />
              </a>
            )
          }
          {
            hasSocial && site.social.instagram && (
              <a
                href={site.social.instagram}
                target="_blank"
                rel="noopener"
                aria-label={`${site.name} on Instagram`}
                class="wcp-icon-btn"
              >
                <Icon name="instagram" class="h-4 w-4" />
              </a>
            )
          }
          <a
            href={`mailto:${site.email.general}`}
            aria-label="Email West Chester Preschool"
            class="wcp-icon-btn"
          >
            <Icon name="mail" class="h-4 w-4" />
          </a>
          <a href={b('/search')} aria-label="Search the site" class="wcp-icon-btn">
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </a>
          <ThemeToggle tone="onNavy" class="h-9 w-9 hover:bg-white/16" />
        </div>

        {
          /* Big centered logo. Deliberately NOT animated on load: every
           navigation is a real document load (no SPA router), so any entrance
           animation would replay on every page + refresh and read as a jitter.
           The logo just stays put. */
        }
        <a href={b('/')} class="inline-flex shrink-0 items-center" aria-label={`${site.name} home`}>
          <Image
            src={wcpLogoWhite}
            alt={site.name}
            width={220}
            height={147}
            class="h-24 w-auto drop-shadow-[0_2px_10px_rgba(1,20,40,0.35)] xl:h-28"
          />
        </a>

        {
          /* ONE CTA (IA doctrine + the high-end benchmark's one-CTA-per-surface
            habit): the tour ask, accent-filled, deep-linked to the tour form.
            Enroll lives one click away in the funnel nav below. A small
            Family Hub link rides beside it so enrolled families keep a fast
            path without competing with the conversion CTA. shrink-0 is
            load-bearing: wcp-sheen's overflow:hidden strips the flex
            min-content floor (found live 2026-07-17). */
        }
        <div class="flex w-40 items-center justify-end gap-3">
          <a
            href={b('/family-hub')}
            class="shrink-0 text-sm font-semibold whitespace-nowrap text-white/85 underline-offset-4 hover:underline"
          >
            Family Hub
          </a>
          <Button href={b(tourHref)} variant="accent" size="sm" class="shrink-0 whitespace-nowrap">
            Schedule a Tour
          </Button>
        </div>
      </div>

      <nav aria-label="Primary" class="relative mt-3 border-t border-white/15 py-2">
        <NavList idPrefix="big" variant="row" tone="overlay" items={mainNav} linkBase={linkBase} />
      </nav>
    </div>
  </div>

  {
    /* ---------------------------------------------------------------------
       3. Compact bar — desktop only, fixed, hidden until scrolled past #2.
     --------------------------------------------------------------------- */
  }
  <div
    id="compact-nav"
    class="wcp-compact-bar fixed inset-x-0 top-0 z-40 hidden border-b border-border bg-white/95 backdrop-blur lg:block dark:bg-surface/95"
  >
    <div class="wcp-container flex items-center justify-between gap-6 py-2.5">
      <a href={b('/')} class="inline-flex shrink-0 items-center" aria-label={`${site.name} home`}>
        <Image
          src={wcpLogoNavy}
          alt={site.name}
          width={240}
          height={160}
          class="h-10 w-auto dark:hidden"
        />
        <Image
          src={wcpLogoWhite}
          alt={site.name}
          width={240}
          height={160}
          class="hidden h-10 w-auto dark:block"
        />
      </a>
      <nav aria-label="Primary (compact)">
        <NavList idPrefix="compact" variant="compact" items={mainNav} linkBase={linkBase} />
      </nav>
      <div class="flex shrink-0 items-center gap-1">
        {
          /* Click-to-call, styled to sit beside ThemeToggle (same size + hover
            wash as its default tone). */
        }
        <a
          href={`tel:${phoneDigits}`}
          aria-label="Call West Chester Preschool"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-heading transition-colors hover:bg-navy/8 dark:hover:bg-heading/10"
        >
          <Icon name="phone" class="h-5 w-5" />
        </a>
        <ThemeToggle />
        {/* Tour-first doctrine: the compact bar's one CTA is the tour. */}
        <Button href={b(tourHref)} variant="accent" size="sm" class="whitespace-nowrap"
          >Book a Tour</Button
        >
      </div>
    </div>
  </div>
</header>

<script>
  import '@/scripts/nav';
  import '@/scripts/compact-nav';
  import '@/scripts/theme';
</script>

<style>
  /* .nav-link / .nav-link--overlay / [data-dropdown-menu] rules live in
     NavList.astro, NOT here — Astro's per-component style scoping means a
     rule in Header.astro's <style> only matches elements Header.astro itself
     renders. Header.astro only renders the elements below directly. */

  /* Round icon buttons (social/email row in the big header). */
  .wcp-icon-btn {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .wcp-icon-btn:hover {
    background-color: var(--color-amber);
    color: var(--color-navy);
    transform: translateY(-1px);
  }

  /* Hamburger <-> X swap (mobile bar). */
  [data-nav-toggle][aria-expanded='true'] .menu-icon {
    display: none;
  }
  [data-nav-toggle][aria-expanded='true'] .close-icon {
    display: block;
  }

  /* Compact bar: slides down + fades in once scripted `data-visible` is set.
     Starts fully hidden (translated up, not just transparent) so it never
     intercepts clicks/taps while off-screen. */
  .wcp-compact-bar {
    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .wcp-compact-bar[data-visible] {
    transform: translateY(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wcp-compact-bar {
      transition: none;
    }
  }
</style>
