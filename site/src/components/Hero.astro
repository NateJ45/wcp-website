---
/* ============================================================================
   Hero — media-forward (photo or muted video), accessible text overlay
   ============================================================================
   The top-of-page banner. Real photography/video is the point; the headline
   sits over it. To guarantee WCAG AA regardless of the photo, a navy scrim is
   layered between the media and the text (heavier on the text side), so white
   text always clears 4.5:1 no matter how light the image is.

   Media:
     - `image` : background photo. Either a local asset import (src/assets/...
                 — gets Astro's build-time Sharp optimization via <Image>) or
                 a plain string path into /public (e.g. the pre-optimized
                 hero-video poster image). Omit for a labeled navy
                 placeholder, so it's obvious media still needs to go in.
                 When a video is present, this <img> layer IS the poster —
                 see the no-poster-attribute note below.
     - `video` : optional muted-loop video src (a /public path — video isn't
                 run through the image pipeline). Does NOT autoplay from
                 markup — hero-video.ts starts it only when the visitor has
                 not requested reduced motion; everyone else keeps the image.
     - Real media will come from Sanity (with responsive sizing + required alt).

   Layout is editorial/asymmetric by default (text anchored bottom-left), not
   the generic center-stacked hero.
   ============================================================================ */
import { Image } from 'astro:assets';
import { cn } from '@/lib/utils';
import type { ImageMetadata } from 'astro';
import { imageUrl, imageSrcSet, type SanityImageSource } from '@/lib/image';

interface Props {
  eyebrow?: string;
  title: string;
  titleId?: string;
  lead?: string;
  image?: ImageMetadata | string;
  /** A Sanity-hosted background image (page builder). Takes precedence over `image`. */
  sanityImage?: SanityImageSource;
  imageAlt?: string;
  /** Muted-loop video (a /public path OR a Sanity CDN url). The universal fallback source. */
  video?: string;
  /** Optional WebM (VP9) of the same clip — smaller; modern browsers prefer it. */
  videoWebm?: string;
  align?: 'left' | 'center';
  /** Overall hero height. */
  height?: 'tall' | 'medium';
  class?: string;
}
const {
  eyebrow,
  title,
  titleId = 'hero-title',
  lead,
  image,
  sanityImage,
  imageAlt = '',
  video,
  videoWebm,
  align = 'left',
  height = 'tall',
  class: className,
} = Astro.props;

const heightClass =
  height === 'tall' ? 'min-h-[clamp(32rem,74vh,48rem)]' : 'min-h-[clamp(26rem,54vh,36rem)]';
// Only control text alignment here — NOT flex align-items. Leaving the column
// at its default align-items:stretch is what lets the content block take full
// width (then cap via max-width); items-start would shrink it to content.
const alignClass = align === 'center' ? 'text-center' : 'text-left';

// The <video> below deliberately carries NO poster attribute: the media-layer
// <img> rendered under it IS the poster. The video sits on top at opacity-0
// until hero-video.ts starts playback and fades it in, so the image shows
// through in every pre-play state (and forever, for reduced-motion visitors).
// A poster attribute made the browser fetch the same photo a SECOND time —
// worst with a Sanity image, where the fixed-width poster URL never matched
// the srcset candidate the <img> actually chose, so two full hero-sized
// downloads competed for bandwidth at LCP time (removed 2026-07-17).
---

<section
  class={cn('relative isolate overflow-hidden bg-navy', className)}
  aria-labelledby={titleId}
>
  {/* --- Media layer --------------------------------------------------------- */}
  {
    sanityImage ? (
      // Sanity-hosted photo (page builder) — responsive srcset from the CDN.
      <img
        src={imageUrl(sanityImage, 1920)}
        srcset={imageSrcSet(sanityImage)}
        sizes="100vw"
        alt={imageAlt}
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : typeof image === 'string' ? (
      // /public path — already pre-optimized (e.g. the hero-video poster), a
      // plain <img> is correct here; Astro's Image component can't process
      // strings outside its allowlisted remote-image config.
      <img
        src={image}
        alt={imageAlt}
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : image ? (
      // Local src/assets import — runs through Astro's build-time Sharp
      // pipeline (responsive sizes, WebP) via <Image>, same as the logo.
      <Image
        src={image}
        alt={imageAlt}
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      /* No media: the navy doodle drench (2026-07-17 hero doctrine) — deep
         navy with the low-opacity classroom doodles, the same family as the
         framed home hero. Real photos/video come via Sanity. */
      <div class="wcp-hero-drench absolute inset-0 -z-10" aria-hidden="true" />
    )
  }
  {
    video && (
      <video
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-[1200ms] ease-out motion-reduce:transition-none"
        muted
        loop
        playsinline
        preload="none"
        data-hero-video
        aria-hidden="true"
      >
        {/* preload="none": the browser fetches nothing until hero-video.ts
            starts playback (deferred to idle-after-load), so nothing competes
            with the LCP image. That <img> layer carries the hero until the
            video fades in — no poster attribute, see the note in the
            frontmatter. Sources are ordered smallest-first: modern browsers
            take the lighter WebM, everything else falls back to the MP4. */}
        {videoWebm && <source src={videoWebm} type="video/webm" />}
        <source src={video} type="video/mp4" />
      </video>
    )
  }

  {
    /* --- Scrim: guarantees text contrast over any image ---------------------
      The doodle tile rides ON the scrim (topmost layer) so photo heroes join
      the navy-doodle hero family: the white strokes read faintly in the
      scrim's heavy corner and all but vanish over the photo's bright areas —
      unification without defacing the photography. */
  }
  <div
    class={cn(
      'absolute inset-0 -z-10',
      align === 'center'
        ? 'bg-[image:var(--wcp-doodles-dark),linear-gradient(to_top,rgba(1,32,58,.82),rgba(1,32,58,.5)_45%,rgba(1,32,58,.55))]'
        : 'bg-[image:var(--wcp-doodles-dark),linear-gradient(to_top,rgba(1,32,58,.85),rgba(1,32,58,.35)_55%,transparent),linear-gradient(to_right,rgba(1,32,58,.7),transparent_65%)]',
    )}
    aria-hidden="true"
  >
  </div>

  {/* --- Content ------------------------------------------------------------- */}
  <div
    class={cn(
      'wcp-container relative flex flex-col py-[var(--wcp-space-xl)]',
      // Reserve real clearance under the big overlay header (logo + CTA row +
      // nav row) so bottom-anchored content can never collide with it even if
      // the title wraps to 2-3 lines. Measured header height is ~207px at
      // lg — pt-56 (224px) gives a safety margin above that. Only needed at
      // lg+ since the mobile header is a normal in-flow bar, not an overlay.
      'lg:pt-56',
      heightClass,
      alignClass,
      align === 'center' ? 'justify-center' : 'justify-end',
    )}
  >
    <div class={cn('w-full max-w-[42rem]', align === 'center' && 'mx-auto')}>
      {
        eyebrow && (
          <p
            class="mb-3 text-sm font-bold tracking-[0.14em] text-amber uppercase"
            data-reveal="fade"
          >
            {eyebrow}
          </p>
        )
      }
      {
        /* A `title` slot lets a page mark up one accent word (e.g. with the
          crayon <Underline>); the `title` string prop is the fallback and
          still carries the plain-text headline for anything that needs it. */
      }
      <h1 id={titleId} class="text-balance text-white" data-reveal>
        {Astro.slots.has('title') ? <slot name="title" /> : title}
      </h1>
      {
        lead && (
          <p
            class="mt-4 max-w-xl text-lg leading-relaxed text-white/90"
            data-reveal
            style="--reveal-delay: 150ms"
          >
            {lead}
          </p>
        )
      }
      {
        /* Actions cascade in last. Delay sits AFTER the LCP headline (which
          reveals at 0ms), so the staggered entrance never delays first paint. */
      }
      <div
        class={cn(
          'mt-8 flex flex-wrap gap-4',
          align === 'center' ? 'justify-center' : 'justify-start',
        )}
        data-reveal
        style="--reveal-delay: 300ms"
      >
        <slot name="actions" />
      </div>
    </div>
  </div>
</section>

{
  /* Colocated: reduced-motion-aware hero-video autoplay ships only on pages
    that use a Hero. Harmless when the hero has no video. */
}
<script>
  import '@/scripts/hero-video';
</script>
