---
/* ============================================================================
   TeacherCard — a staff bio card with photo, role, and contact
   ============================================================================
   Real named staff, not anonymous candids — headshot + role + years at WCP +
   a short bio + a mailto "Say Hello" link. Photo alt text uses the person's
   name (appropriate for a named public bio, unlike candid kid photos).
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import SanityImage from '@/components/SanityImage.astro';
import { cn } from '@/lib/utils';
import type { ImageMetadata } from 'astro';
import type { SanityImageSource } from '@/lib/image';

interface Props {
  /** Local asset photo (bespoke pages). */
  photo?: ImageMetadata;
  /** Sanity-hosted photo (page builder). Takes precedence over `photo`. */
  sanityImage?: SanityImageSource;
  name: string;
  role: string;
  email: string;
  class?: string;
}
const { photo, sanityImage, name, role, email, class: className } = Astro.props;
---

{
  /* The print frame goes on the PHOTO, not the whole card. Wrapping the card
     made it white paper in both themes while the caption below still used
     theme tokens (text-heading / text-ink / -ink links), so in dark mode light
     text landed on white paper and axe failed 9 routes on colour contrast —
     the documented -ink trap. The card stays theme-reactive; only the photo
     is a physical object.

     No tilt: data-reveal is on this figure and animates transform, which would
     cancel a resting rotate() anyway (the ChooserRows lesson), and headshots
     read better square-on. */
}
<figure
  class={cn(
    'overflow-hidden rounded-[var(--radius)] bg-white shadow-sm dark:bg-surface',
    className,
  )}
  data-reveal
>
  <div class="wcp-photo-print aspect-[4/3] overflow-hidden" style="--print-tilt: 0deg">
    {
      sanityImage ? (
        <SanityImage
          source={sanityImage}
          alt={name}
          class="h-full w-full object-cover"
          sizes="(min-width: 1024px) 33vw, 50vw"
          widths={[320, 480, 640]}
        />
      ) : (
        photo && (
          <Image
            src={photo}
            alt={name}
            class="h-full w-full object-cover"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 33vw, 50vw"
            loading="lazy"
          />
        )
      )
    }
  </div>
  <figcaption class="p-6">
    <p class="font-display text-xl text-heading">{name}</p>
    <p class="mt-0.5 text-sm font-bold tracking-wide text-sky-ink uppercase">{role}</p>
    <div class="mt-3 leading-relaxed text-ink">
      <slot />
    </div>
    <a
      href={`mailto:${email}`}
      class="mt-4 inline-flex items-center gap-1.5 font-bold text-orange-ink underline underline-offset-2"
    >
      <Icon name="mail" class="h-4 w-4" />
      Say Hello
    </a>
  </figcaption>
</figure>
