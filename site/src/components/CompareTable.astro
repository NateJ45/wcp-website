---
/* ============================================================================
   CompareTable — "WCP vs a typical preschool", reflow-safe
   ============================================================================
   An honest side-by-side. Deliberately NOT a raw <table> (an 3-col table can't
   reflow under 320px without horizontal scroll — WCAG 1.4.10). Instead each
   feature is a row that is a 3-col grid at sm+ and STACKS at narrow widths,
   with per-cell labels shown only when stacked. The WCP column is tinted and
   carries a check so the "us" side reads as the strong choice at a glance.

   Semantics: a definition-style list. Each feature is the term; the two values
   are its comparison. Screen readers get "<feature>: WCP — <x>. Typical — <y>."
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { cn } from '@/lib/utils';

interface Row {
  feature: string;
  wcp: string;
  typical: string;
}
interface Props {
  rows: Row[];
  wcpLabel?: string;
  typicalLabel?: string;
  class?: string;
}
const {
  rows,
  wcpLabel = 'WCP',
  typicalLabel = 'Typical preschool',
  class: className,
} = Astro.props;
---

<div class={cn('mx-auto max-w-4xl', className)} data-reveal>
  {/* Column headers — hidden when the rows stack (labels move inline). */}
  <div class="hidden gap-4 px-5 pb-3 sm:grid sm:grid-cols-[1.3fr_1fr_1fr]" aria-hidden="true">
    <span></span>
    <span class="text-center font-display text-xl text-heading">{wcpLabel}</span>
    <span class="text-center font-bold text-ink-muted">{typicalLabel}</span>
  </div>

  <dl class="overflow-hidden rounded-[var(--radius)] border border-border bg-white dark:bg-surface shadow-sm">
    {
      rows.map((r, i) => (
        <div
          class={cn(
            'grid grid-cols-1 gap-x-4 gap-y-2 p-5 sm:grid-cols-[1.3fr_1fr_1fr] sm:items-center',
            i !== 0 && 'border-t border-border',
          )}
        >
          <dt class="font-bold text-heading">{r.feature}</dt>
          {/* WCP value — tinted lane + check. */}
          <dd class="rounded-lg bg-sky-soft px-3 py-2 text-heading sm:text-center">
            <span class="mb-1 block text-xs font-bold tracking-wide text-sky-ink uppercase sm:hidden">
              {wcpLabel}
            </span>
            <span class="inline-flex items-center gap-1.5 font-semibold">
              <Icon name="check" class="h-4 w-4 shrink-0 text-green-ink" />
              {r.wcp}
            </span>
          </dd>
          {/* Typical value — quiet. */}
          <dd class="px-3 py-2 text-ink-muted sm:text-center">
            <span class="mb-1 block text-xs font-bold tracking-wide text-ink-muted uppercase sm:hidden">
              {typicalLabel}
            </span>
            {r.typical}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
