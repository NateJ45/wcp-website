---
/* ============================================================================
   ThemeToggle — light/dark switch
   ============================================================================
   A single icon button: sun in light mode, moon in dark mode (pure CSS swap
   via the dark: variant — no JS needed for the icon itself). Clicking it
   flips the `.dark` class on <html> and remembers the choice in localStorage
   (see the click handler wired up in src/scripts/theme.ts). Light is the
   default for first-time visitors — see the anti-flash script in
   BaseLayout.astro, which is the only place that reads the stored preference
   before paint.

   `tone` lets the button read correctly against either a light header (navy
   icon) or a navy header (white icon) — same as the site's other toggle-y
   controls (hamburger, etc.).
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { cn } from '@/lib/utils';

interface Props {
  tone?: 'default' | 'onNavy';
  class?: string;
}
const { tone = 'default', class: className } = Astro.props;

const toneClass =
  tone === 'onNavy'
    ? 'text-white hover:bg-white/10'
    : 'text-heading hover:bg-navy/8 dark:hover:bg-heading/10';
---

{
  /* aria-label is a STABLE accessible name. It used to swap between "Switch to
     dark mode" and "Switch to light mode" while aria-pressed ALSO flipped, so a
     screen reader announced the state change twice, once via the name and once
     via the pressed state. A toggle button keeps one name and lets aria-pressed
     carry the state.

     aria-pressed="false" is the correct default (the site is light unless a
     visitor has chosen otherwise); theme.ts corrects it on load for a returning
     dark-mode visitor, and globals.css hides this button entirely when JS is
     off, where it would neither work nor be able to correct itself. */
}
<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Dark mode"
  class={cn(
    // h-10 visual + 44px hit area (after:-inset-0.5) — sits beside other 40px
    // buttons in the hub phone strip; see HubTopBar.
    'relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full transition-colors after:absolute after:-inset-0.5 after:content-[""]',
    toneClass,
    className,
  )}
>
  <Icon name="sun" class="h-5 w-5 dark:hidden" />
  <Icon name="moon" class="hidden h-5 w-5 dark:block" />
</button>
