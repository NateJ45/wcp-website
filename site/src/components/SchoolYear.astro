---
/* ============================================================================
   SchoolYear — the year's events as a warm grid of "moments"
   ============================================================================
   Each event is a card with a colored month tab, a Lucide icon, and a short
   description — the rhythm of a WCP year (picnic → parties → graduation).
   Accent rotates per the data so the grid feels lively but disciplined (one
   accent per card). Reflows to a single column at narrow widths.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { cn } from '@/lib/utils';
import type { SchoolYearEvent } from '@/data/school-year';

interface Props {
  events: SchoolYearEvent[];
  class?: string;
}
const { events, class: className } = Astro.props;

const tab: Record<string, string> = {
  orange: 'bg-cream text-orange-ink',
  sky: 'bg-sky-soft text-sky-ink',
  amber: 'bg-amber/15 text-amber-ink',
  green: 'bg-[color-mix(in_oklab,var(--color-green)_12%,white)] text-green-ink',
};
const bar: Record<string, string> = {
  orange: 'bg-orange',
  sky: 'bg-sky',
  amber: 'bg-amber',
  green: 'bg-green',
};
---

<ul class={cn('grid gap-5 sm:grid-cols-2 lg:grid-cols-4', className)} role="list">
  {
    events.map((e, i) => (
      <li data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`}>
        <article class="group flex h-full flex-col overflow-hidden rounded-[var(--radius)] bg-white shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0">
          <div class={cn('h-1.5', bar[e.accent])} aria-hidden="true"></div>
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center justify-between gap-3">
              <span class={cn('rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide', tab[e.accent])}>
                {e.month}
              </span>
              <Icon name={e.icon} class="h-6 w-6 text-navy/70" />
            </div>
            <h3 class="mt-3 text-lg text-navy">{e.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink">{e.body}</p>
          </div>
        </article>
      </li>
    ))
  }
</ul>
