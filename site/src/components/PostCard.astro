---
/* ============================================================================
   PostCard — one News post in a grid (index page + homepage "Latest news")
   ============================================================================
   Cover photo (or a warm fallback band), category chip, date, title, and a
   short excerpt. The whole card is a link to the post; `linkBase` keeps it
   inside /preview/* in the Studio preview.
   ============================================================================ */
import SanityImage from '@/components/SanityImage.astro';
import { withBase, formatDate } from '@/lib/utils';
import type { SanityImageSource, SanityImageValue } from '@/lib/image';

export interface PostSummary {
  title?: string;
  slug?: string;
  publishedAt?: string;
  category?: string;
  excerpt?: string;
  coverImage?: SanityImageValue | null;
  author?: { name?: string; honorific?: string } | null;
}

interface Props {
  post: PostSummary;
  linkBase?: string;
}
const { post, linkBase = '' } = Astro.props;
const href = withBase(`/news/${post.slug}`, linkBase);
const cover = post.coverImage;
const coverAlt = cover?.alt ?? post.title ?? 'News post';
const categoryLabel = post.category
  ? post.category.charAt(0).toUpperCase() + post.category.slice(1)
  : '';
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-white shadow-sm transition-shadow hover:shadow-md dark:bg-surface"
>
  <a href={href} class="flex h-full flex-col focus:outline-none">
    <div class="relative aspect-[16/9] overflow-hidden bg-grey dark:bg-heading/20">
      {
        cover?.asset ? (
          <SanityImage
            source={cover as SanityImageSource}
            alt={coverAlt}
            widths={[400, 640, 960]}
            sizes="(max-width: 768px) 100vw, 400px"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-sky/15 to-amber/15">
            <span class="font-display text-3xl text-navy/40">WCP</span>
          </div>
        )
      }
    </div>
    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-center gap-2 text-xs font-semibold text-ink-muted">
        {
          categoryLabel && (
            <span class="rounded-full bg-sky/15 px-2.5 py-1 text-sky-ink">{categoryLabel}</span>
          )
        }
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      </div>
      <h3
        class="mt-3 font-display text-xl leading-snug text-heading group-hover:text-navy dark:group-hover:text-white"
      >
        {post.title}
      </h3>
      {post.excerpt && <p class="mt-2 line-clamp-3 text-sm text-ink-muted">{post.excerpt}</p>}
      <span
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-navy dark:text-sky"
      >
        Read more
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    </div>
  </a>
</article>
