---
/* ============================================================================
   ClassCard — a class option summary (Twos, Threes, Pre-K AM/PM)
   ============================================================================
   Recolored 2026-07-19 (the closing CTA's move — Nathan ruled out dark text
   on light warm fills): every card is the NAVY sheet with white ink (9.75:1),
   and the class color arrives as ACCENT — the crayon stroke under the name,
   the feature check marks, and the class-colored CTA button (.wcp-cc-btn in
   globals.css, fixed #01203a ink measured 6.45-8.31:1 on the four fills).
   The .wcp-cc-* classes own the fill + accent var; the card is a theme-stable
   chrome island, so nothing inside uses a theme-reactive token. Grain keeps
   the paper feel on the navy.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/utils';

interface Props {
  name: string;
  color?: 'amber' | 'green' | 'orange' | 'sky' | 'navy';
  price?: string;
  cadence?: string;
  schedule?: string;
  age?: string;
  features?: string[];
  href?: string;
  ctaLabel?: string;
  as?: 'li' | 'div';
  headingAs?: 'h3' | 'h4';
  /** Class slug (twos / threes / pre-k-am / pre-k-pm): renders the live
   *  "Spots open / Waitlist" badge, hydrated from /api/availability. */
  availabilitySlug?: string;
  class?: string;
}
const {
  name,
  color = 'sky',
  price,
  cadence,
  schedule,
  age,
  features = [],
  href,
  ctaLabel = 'Learn more',
  as = 'div',
  headingAs = 'h3',
  availabilitySlug,
  class: className,
} = Astro.props;
const Tag = as;
const Heading = headingAs;

// Hyphenated name tokens ("Pre-K") get a nowrap wrapper: in the 4-column band
// the heading shares its row with the price and would otherwise line-break
// after the hyphen ("PRE- / K AM" — found in the 2026-07 responsive audit).
// Wrapping per-token (not the whole name) keeps a long CMS-entered name able
// to wrap between words instead of overflowing the card.
const nameTokens = name.split(' ');

// The drench classes in globals.css own the navy fill + the class ACCENT var
// (these are theme-stable chrome islands, so no theme-reactive tokens inside).
// Full literals so nothing is string-built.
const drench: Record<string, string> = {
  amber: 'wcp-cc-amber',
  green: 'wcp-cc-green',
  orange: 'wcp-cc-orange',
  sky: 'wcp-cc-sky',
  navy: 'wcp-cc-navy',
};
---

<Tag
  class={cn(
    'group wcp-drench flex h-full flex-col rounded-[var(--radius)] p-6 shadow-md',
    'transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-xl',
    'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    drench[color],
    className,
  )}
  data-reveal
>
  {
    /* flex-wrap: when name + price can't share the line, the price drops below
      the name rather than squeezing the heading into mid-word breaks. */
  }
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <Heading class="text-2xl"
      >{
        nameTokens.map((token: string, i: number) => (
          <>
            {i > 0 && ' '}
            {token.includes('-') ? <span class="whitespace-nowrap">{token}</span> : token}
          </>
        ))
      }</Heading
    >
    {
      price && (
        <span class="font-display text-3xl whitespace-nowrap">
          {price}
          {cadence && <span class="wcp-drench-muted text-sm font-normal"> {cadence}</span>}
        </span>
      )
    }
  </div>
  {
    /* The class color's signature moment: a short crayon stroke under the
       name, the same accent language as the closing CTA's underline.
       Decorative (aria-hidden) — identity also rides the CTA button fill. */
  }
  <svg class="mt-1.5 h-2 w-16 shrink-0" viewBox="0 0 64 8" fill="none" aria-hidden="true">
    <path
      d="M2 5.5 C 14 2.5, 30 6.5, 44 4 S 58 3.5, 62 5"
      stroke="var(--cc-accent)"
      stroke-width="4"
      stroke-linecap="round"></path>
  </svg>
  {schedule && <p class="mt-1 font-bold">{schedule}</p>}
  {age && <p class="wcp-drench-muted mt-0.5 text-sm">{age}</p>}
  {
    /* Live availability, filled by src/scripts/availability.ts. Hidden until
       the fetch answers, and stays hidden when no sheet is configured or the
       fetch fails — the card is complete without it. On the drench fill the
       label inherits the card's fixed ink; the dot rides a white backing disc
       so its status color reads on any fill. */
    availabilitySlug && (
      <p
        class="mt-2 hidden items-center gap-2 text-sm font-semibold"
        data-availability={availabilitySlug}
      >
        <span
          class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-white/85"
          aria-hidden="true"
        >
          <span class="h-2.5 w-2.5 rounded-full" data-availability-dot />
        </span>
        <span data-availability-label />
      </p>
    )
  }

  {
    features.length > 0 && (
      <ul class="mt-4 flex-1 space-y-2">
        {features.map((f: string) => (
          <li class="flex gap-2.5">
            <Icon name="check" class="mt-1 h-4 w-4 [color:var(--cc-accent)]" />
            <span class="leading-snug">{f}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    href && (
      <Button href={href} variant="on-navy" class="wcp-cc-btn mt-6 w-full">
        {ctaLabel}
      </Button>
    )
  }
</Tag>

<script>
  import '@/scripts/availability';
</script>
