---
/* ============================================================================
   ClassCard — a class option summary (Twos, Threes, Pre-K AM/PM)
   ============================================================================
   Restyled 2026-07-17 (Phase 2 "Fifty-Five Septembers"): the old border-top
   color strip (a named AI-slop tell) is gone. Class identity now reads from a
   faint class-tinted paper surface (light mode) + a class-color dot beside the
   name + the class-tinted schedule line — the hub's surface-tint approach,
   which is AA-verified in both themes because text stays navy/ink on a
   near-white (light) or plain surface (dark) card. Grain gives the handmade
   paper feel. Optional price, schedule, age, and a CTA button.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/utils';

interface Props {
  name: string;
  color?: 'amber' | 'green' | 'orange' | 'sky' | 'navy';
  price?: string;
  cadence?: string;
  schedule?: string;
  age?: string;
  features?: string[];
  href?: string;
  ctaLabel?: string;
  as?: 'li' | 'div';
  headingAs?: 'h3' | 'h4';
  /** Class slug (twos / threes / pre-k-am / pre-k-pm): renders the live
   *  "Spots open / Waitlist" badge, hydrated from /api/availability. */
  availabilitySlug?: string;
  class?: string;
}
const {
  name,
  color = 'sky',
  price,
  cadence,
  schedule,
  age,
  features = [],
  href,
  ctaLabel = 'Learn more',
  as = 'div',
  headingAs = 'h3',
  availabilitySlug,
  class: className,
} = Astro.props;
const Tag = as;
const Heading = headingAs;

// Hyphenated name tokens ("Pre-K") get a nowrap wrapper: in the 4-column band
// the heading shares its row with the price and would otherwise line-break
// after the hyphen ("PRE- / K AM" — found in the 2026-07 responsive audit).
// Wrapping per-token (not the whole name) keeps a long CMS-entered name able
// to wrap between words instead of overflowing the card.
const nameTokens = name.split(' ');

// Faint class-color paper tint, LIGHT MODE ONLY (mixed toward white so text
// stays AA); dark mode falls back to the plain surface (the .dark rule in
// globals resets --cc-tint). Full literals so nothing is string-built.
const tint: Record<string, string> = {
  amber: 'wcp-cc-amber',
  green: 'wcp-cc-green',
  orange: 'wcp-cc-orange',
  sky: 'wcp-cc-sky',
  navy: 'wcp-cc-navy',
};
const dot: Record<string, string> = {
  amber: 'bg-amber',
  green: 'bg-green',
  orange: 'bg-orange',
  sky: 'bg-sky',
  navy: 'bg-navy',
};
---

<Tag
  class={cn(
    'group wcp-paper-card flex h-full flex-col rounded-[var(--radius)] p-6 shadow-sm dark:border dark:border-border',
    'transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-xl',
    'hover:ring-1 hover:ring-black/5 dark:hover:ring-white/10',
    'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    tint[color],
    className,
  )}
  data-reveal
>
  {
    /* flex-wrap: when name + price can't share the line, the price drops below
      the name rather than squeezing the heading into mid-word breaks. */
  }
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <Heading class="flex items-center gap-2 text-heading"
      ><span class={cn('h-2.5 w-2.5 shrink-0 rounded-full', dot[color])} aria-hidden="true"></span>{
        nameTokens.map((token: string, i: number) => (
          <>
            {i > 0 && ' '}
            {token.includes('-') ? <span class="whitespace-nowrap">{token}</span> : token}
          </>
        ))
      }</Heading
    >
    {
      price && (
        <span class="font-display text-2xl whitespace-nowrap text-heading">
          {price}
          {cadence && <span class="text-sm font-normal text-ink-muted"> {cadence}</span>}
        </span>
      )
    }
  </div>
  {schedule && <p class="mt-1 font-bold text-sky-ink">{schedule}</p>}
  {age && <p class="mt-0.5 text-sm text-ink-muted">{age}</p>}
  {
    /* Live availability, filled by src/scripts/availability.ts. Hidden until
       the fetch answers, and stays hidden when no sheet is configured or the
       fetch fails — the card is complete without it. Colored DOT + neutral
       text (never colored-text-on-tint — the dark-mode AA trap). */
    availabilitySlug && (
      <p
        class="mt-2 hidden items-center gap-2 text-sm font-semibold text-ink"
        data-availability={availabilitySlug}
      >
        <span class="h-2.5 w-2.5 rounded-full" data-availability-dot aria-hidden="true" />
        <span data-availability-label />
      </p>
    )
  }

  {
    features.length > 0 && (
      <ul class="mt-4 flex-1 space-y-2">
        {features.map((f: string) => (
          <li class="flex gap-2.5 text-ink">
            <Icon name="check" class="mt-1 h-4 w-4 text-green-ink" />
            <span class="leading-snug">{f}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    href && (
      <Button href={href} variant="accent" class="mt-6 w-full">
        {ctaLabel}
      </Button>
    )
  }
</Tag>

<script>
  import '@/scripts/availability';
</script>
