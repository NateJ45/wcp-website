---
/* ============================================================================
   FeatureCard — icon + title + body, with a soft lift on hover
   ============================================================================
   The recurring "pillar" card. `icon` is a Lucide icon name (e.g. "users",
   "palette", "piggy-bank"), rendered as inline SVG in a tinted round chip and
   colored with the matching brand-ink tone. Icons are decorative (the title
   carries the meaning), so they're aria-hidden. Hover lift is reduced-motion
   safe.
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import HubWatermark from '@/components/hub/HubWatermark.astro';
import { cn } from '@/lib/utils';

interface Props {
  /** Lucide icon name, e.g. "users". Omit for a text-only card. */
  icon?: string;
  title: string;
  /** Chip tint + icon ink color. */
  chip?: 'sky' | 'orange' | 'amber' | 'green' | 'navy';
  as?: 'li' | 'div';
  /** Optional footer link (e.g. a Google Photos album or a ClassDojo invite). */
  href?: string;
  linkLabel?: string;
  /** Faint corner-icon watermark (the hub card "stamp"). Opt-in — set only by
      the Family Hub (HubSectionedBody), so public marketing cards stay clean. */
  watermark?: boolean;
  class?: string;
}
const {
  icon,
  title,
  chip = 'sky',
  as = 'div',
  href,
  linkLabel,
  watermark = false,
  class: className,
} = Astro.props;
const Tag = as;
const showWatermark = watermark && Boolean(icon);
// http(s) links open in a new tab; mailto:/tel: stay in place.
const external = href?.startsWith('http');

const chipClass: Record<string, string> = {
  sky: 'bg-sky-soft text-sky-ink',
  orange: 'bg-cream text-orange-ink',
  amber: 'bg-amber/15 text-amber-ink',
  green: 'bg-green/12 text-green-ink',
  navy: 'bg-navy/8 text-heading',
};
---

<Tag
  class={cn(
    // dark:border — the card leans on a shadow to separate from the page, but
    // shadows don't read on a dark canvas, so in dark mode add a real edge.
    'group rounded-[var(--radius)] bg-white p-6 shadow-sm transition-[transform,box-shadow] duration-300 dark:border dark:border-border dark:bg-surface',
    'hover:-translate-y-1.5 hover:shadow-xl hover:ring-1 hover:ring-black/5 dark:hover:ring-white/10',
    'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    showWatermark && 'relative isolate overflow-hidden',
    className,
  )}
  data-reveal
>
  {showWatermark && icon && <HubWatermark icon={icon} colorStyle={`color: var(--color-${chip})`} />}
  {
    icon && (
      <span
        class={cn(
          'wcp-pop mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full',
          chipClass[chip],
        )}
      >
        <Icon name={icon} class="h-7 w-7" />
      </span>
    )
  }
  <h3 class="text-heading">{title}</h3>
  <div class="mt-2 leading-relaxed text-ink"><slot /></div>
  {
    href && (
      <a
        href={href}
        class="mt-3 inline-flex items-center gap-1 font-bold text-sky-ink hover:underline"
        {...(external ? { target: '_blank', rel: 'noopener' } : {})}
      >
        {linkLabel ?? 'Open'}
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
        >
          →
        </span>
      </a>
    )
  }
</Tag>
