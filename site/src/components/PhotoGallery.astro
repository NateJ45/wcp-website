---
/* ============================================================================
   PhotoGallery — a simple, accessible photo grid
   ============================================================================
   A real <ul> of <figure>s (not a JS lightbox/carousel — the photos are the
   content, and a plain grid is fully keyboard/screen-reader navigable with
   zero extra JS). Each photo requires alt text; caption is optional. Images
   run through Astro's <Image> for responsive, optimized output.
   ============================================================================ */
import { Image } from 'astro:assets';
import SanityImage from '@/components/SanityImage.astro';
import { cn } from '@/lib/utils';
import type { ImageMetadata } from 'astro';
import type { SanityImageSource } from '@/lib/image';

interface Photo {
  /** Local asset (bespoke pages). */
  src?: ImageMetadata;
  /** Sanity-hosted photo (page builder). Takes precedence over `src`. */
  sanityImage?: SanityImageSource;
  alt: string;
  caption?: string;
}
interface Props {
  photos: Photo[];
  class?: string;
}
const { photos, class: className } = Astro.props;
---

{
  /* content-visibility on each item defers layout/paint of offscreen figures —
     on the ~80-photo A Day gallery that's most of the page's render cost. The
     intrinsic-size placeholder keeps the scrollbar stable before they render. */
}
<ul class={cn('grid gap-4 sm:grid-cols-2 lg:grid-cols-3', className)}>
  {
    photos.map((p, i) => (
      <li
        class="[contain-intrinsic-size:auto_260px] [content-visibility:auto]"
        data-reveal
        style={
          /* Stagger wraps every 6 items (two grid rows) so deep rows never wait
             on a cumulative i*60ms tail — at 96 photos that tail reached 4.7s
             AFTER a row entered the viewport (Phase 0 audit). Motion doctrine:
             stagger inside the group a user sees, never across the whole set. */
          `--reveal-delay: ${(i % 6) * 60}ms`
        }
      >
        {/* Print treatment: data-reveal is on the <li>, so the tilt is safe
            here (on the same node it would be cancelled by reveal's transform).
            Angle cycles by index because nth-of-type sees one figure per li and
            would give the whole gallery a single tilt. Kept under 1deg: a dense
            collage with big angles reads as noise. */}
        <figure
          class="wcp-photo-print group"
          style={`--print-tilt: ${[-0.9, 0.7, -0.4, 0.9][i % 4]}deg`}
        >
          <div class="aspect-[4/3] overflow-hidden">
            {p.sanityImage ? (
              <SanityImage
                source={p.sanityImage}
                alt={p.alt}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                widths={[400, 640, 800]}
              />
            ) : (
              p.src && (
                <Image
                  src={p.src}
                  alt={p.alt}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                />
              )
            )}
          </div>
          {/* No text-white here: the figure is white paper now, not the navy
              tile it used to be. Colour comes from .wcp-photo-print figcaption,
              which uses the theme-stable navy so it holds in dark mode. */}
          {p.caption && <figcaption class="px-3 text-sm">{p.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>
