---
/* ============================================================================
   ChooserRows — self-segmentation ("just looking / comparing / ready")
   ============================================================================
   The 2026 benchmark move (Headspace's chooser): IA as a friendly question.
   Three tappable paths directly under the home hero route each visitor intent
   to its page — the funnel as furniture, zero JS, native links. Code-owned
   copy; this band is NOT a Sanity section, so editing it is a code change.

   Was three ruled rows, which stopped at ~58% of the band and left the right
   half empty (Nathan, 2026-07-19). Now three taped paper cards — the
   Construction Paper register, using the full width. The card treatment lives
   in globals.css as .wcp-chooser-card, including why a 3-up row is allowed
   here when the section grammar pushes card grids toward ruled lists.

   The whole card is the target via a stretched-link ::after on the <a>, so the
   accessible name stays just the link text rather than the whole card.
   ============================================================================ */
const ROWS = [
  { q: 'Just looking?', label: 'See what a morning here is like', href: '/a-day-at-wcp' },
  { q: 'Comparing schools?', label: 'Our tuition is public', href: '/tuition' },
  { q: 'Ready to visit?', label: 'Schedule a tour', href: '/virtual-tour#sec-pp-tour-form' },
];
---

<nav class="wcp-section bg-white dark:bg-surface" aria-label="Start here">
  <div class="wcp-container py-[var(--wcp-space-lg)]">
    <ul role="list" class="grid gap-7 sm:grid-cols-3 sm:gap-6">
      {
        ROWS.map((r, i) => (
          <li class="wcp-chooser-slot" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            {/* The <a> IS the card, so the whole thing is the target with no
                stretched-link trick. It also has to be the element that
                rotates: the <li> owns data-reveal, whose transform would
                otherwise cancel the tilt. */}
            <a href={r.href} class="group wcp-chooser-card wcp-tape-tc">
              {/* Fixed inks, not tokens: this is light paper in both themes. */}
              <span class="block font-display text-lg [color:#01203a]">{r.q}</span>
              <span class="mt-1 block font-semibold [color:#166fa8] group-hover:underline">
                {r.label}
                <span
                  aria-hidden="true"
                  class="ml-1 inline-block transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
                >
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
