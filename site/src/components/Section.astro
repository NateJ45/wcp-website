---
/* ============================================================================
   Section — the vertical rhythm + background primitive
   ============================================================================
   FOUNDATION. Wraps page content in a <section> landmark with a background
   variant and consistent vertical padding, and centers content in the
   standard container. Pass `labelledby` (id of the section's heading) so the
   landmark has an accessible name — important for screen-reader navigation.

   Backgrounds are all AA-safe with their default text color. There is no
   bright-orange variant on purpose (white text on it fails contrast); use
   `cream` for a warm section or `navy` for a dark one.
   ============================================================================ */
import { cn } from '@/lib/utils';
import Seam from '@/components/Seam.astro';

interface Props {
  bg?: 'white' | 'grey' | 'cream' | 'sunshine' | 'sky' | 'navy';
  /** id of the heading that names this section (preferred). */
  labelledby?: string;
  /** literal accessible name, when there is no visible heading to point at. */
  label?: string;
  size?: 'default' | 'compact';
  /** Render a cloud-scallop seam at the top (only at a real color change). */
  seam?: boolean;
  class?: string;
  containerClass?: string;
}

const {
  bg = 'white',
  labelledby,
  label,
  size = 'default',
  seam = false,
  class: className,
  containerClass,
} = Astro.props;

const bgClasses: Record<string, string> = {
  // `white`/`grey`/`cream` are page surfaces, so they get a dark-mode
  // counterpart. `grey`/`cream` route through our own --color-grey/
  // --color-cream tokens (already flipped in globals.css's .dark block,
  // zero extra work here); `white` is Tailwind's own literal color (used
  // elsewhere for text/logos that must stay white on navy bands), so it
  // needs its own dark: companion via the dedicated --color-surface token.
  white: 'bg-white dark:bg-surface',
  grey: 'bg-grey',
  cream: 'bg-cream',
  // The 2026-09-01 bold pass: two saturated bands so public pages stop being
  // white/grey-dominant. Both carry dark ink text (AA-checked), grain, and
  // the strata layer; sunshine also carries the doodles (a warm band).
  sunshine: 'bg-sunshine',
  sky: 'bg-sky-soft',
  // On navy: base text → white, and headings flipped from their default navy to
  // white. Everything else (leads, StatBlock) already inherits white or uses
  // light tones. A SectionHeader eyebrow is the one exception — it uses a dark
  // "-ink" tone by design, so navy sections must pass eyebrowTone="amber". A
  // nested light panel (Callout, card) keeps its own colors — we deliberately
  // do NOT flip descendants, which would turn its text white on its light bg.
  navy: 'bg-navy text-white [&_:is(h1,h2,h3,h4,h5,h6)]:text-white',
};

const pad = size === 'compact' ? 'py-[var(--wcp-space-xl)]' : 'py-[var(--wcp-space-2xl)]';
---

<section
  class={cn('wcp-section', seam && 'relative -mt-px', bgClasses[bg], className)}
  aria-labelledby={labelledby}
  aria-label={label}
>
  {seam && <Seam color={bg} />}
  <div class={cn('wcp-container', pad, containerClass)}>
    <slot />
  </div>
</section>
