---
/* ============================================================================
   Analytics + site verification
   ============================================================================
   FOUNDATION. Emits two things, each only when its env var is set, so local
   dev and preview builds stay clean:

     1. Search-console / Bing verification <meta> (PUBLIC_GSC_VERIFICATION)
     2. Cloudflare Web Analytics beacon (PUBLIC_CF_BEACON_TOKEN) — free,
        privacy-first (no cookies, no consent banner needed). Create the site
        in the Cloudflare dash under Analytics → Web Analytics and paste its
        token into the env.

   The cookie-setting trackers are NOT emitted here: GA4 (PUBLIC_GA_ID), the
   Google Ads tag (PUBLIC_GADS_ID), and the Meta Pixel (PUBLIC_META_PIXEL_ID)
   are all CONSENT-GATED. Setting any of those env vars renders the
   CookieConsent card (BaseLayout, public pages) and src/scripts/consent.ts
   injects only the granted categories — still through Partytown. Nothing
   Google or Meta loads before a grant.

   The IDs are NOT hardcoded — they come from environment variables so they can
   differ per environment (real in production, empty in previews) and are never
   baked into a component. Set them in site/.env (see .env.example) and in the
   Cloudflare project settings for production.
   ============================================================================ */
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{gscToken && <meta name="msvalidate.01" content={gscToken} />}

{
  cfBeacon && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfBeacon })}
    />
  )
}
