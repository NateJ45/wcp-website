---
/* ============================================================================
   CookieConsent — the consent card for the site's ONE optional cookie
   ============================================================================
   Renders only when PUBLIC_GADS_ID is set (there is nothing to consent to
   otherwise — the Cloudflare beacon is cookieless, embeds are click-to-load
   on the nocookie host, and theme/hub-login storage is essential). Ships
   `hidden`; src/scripts/consent.ts reveals it on a first visit, persists the
   choice, and loads the ads tag only after "Allow". No JS → no tag can load,
   so the card correctly never appears.

   Deliberately NOT the three-toggle wall of the generic consent widgets: with
   a single optional category, the two equal-prominence buttons ARE the
   choice, and the expandable list carries the full inventory transparency.
   Copy is code-owned (brand voice, no volunteer knob).
   ============================================================================ */
import Button from '@/components/ui/Button.astro';
import { withBase } from '@/lib/utils';
import { isValidAdsId } from '@/lib/consent-state';

const gadsId = (import.meta.env.PUBLIC_GADS_ID as string | undefined) ?? '';
const enabled = gadsId !== '' && isValidAdsId(gadsId);
---

{
  enabled && (
    <section
      aria-label="Cookie choices"
      data-consent-banner
      data-gads-id={gadsId}
      hidden
      class="wcp-consent-card wcp-paper-card fixed inset-x-3 bottom-3 z-40 rounded-xl border border-navy/15 p-5 shadow-xl sm:right-4 sm:bottom-4 sm:left-auto sm:max-w-sm dark:border-white/15"
    >
      <h2 class="font-display text-lg text-heading">A quick cookie question</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink">
        We would like to set one optional Google cookie that tells us when an ad brought a family
        here. Say no and the site works exactly the same.
      </p>
      <details class="mt-3 text-sm text-ink">
        <summary class="cursor-pointer font-bold text-sky-ink">What the site stores</summary>
        <ul class="mt-2 space-y-1.5 pl-4">
          <li>
            <strong>Essential:</strong> your theme choice and the Family Hub sign-in. On your
            device, never shared.
          </li>
          <li>
            <strong>Visit counts:</strong> Cloudflare tallies page views with no cookies and no
            personal data.
          </li>
          <li>
            <strong>Advertising:</strong> one Google cookie that measures our ads. Off unless you
            allow it.
          </li>
        </ul>
      </details>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button type="button" variant="outline" size="sm" data-consent-deny>
          No thanks
        </Button>
        <Button type="button" variant="primary" size="sm" data-consent-allow>
          Allow cookies
        </Button>
        <a
          href={withBase('/privacy')}
          class="ml-auto text-sm text-ink-muted underline underline-offset-2 hover:text-heading"
        >
          Privacy policy
        </a>
      </div>
    </section>
  )
}

<style>
  /* Gentle rise-in when the card appears ([hidden] removal re-triggers it).
     Reduced-motion visitors get an instant appear. */
  @media (prefers-reduced-motion: no-preference) {
    .wcp-consent-card {
      animation: wcp-consent-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes wcp-consent-in {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
