---
/* ============================================================================
   CtaBanner — the closing call-to-action band
   ============================================================================
   Three AA-safe tones: `navy` (dark, confident solid), `cream` (warm light
   with navy text), and `amber` (boldness pass 2026-07 — the full-color DRENCH
   closer the old Squarespace site ended every page with; every audit group
   called for its return). Amber is a THEME-STABLE island: fixed ink #01203a
   (8.31:1 on amber, measured) and navy-fill buttons, never theme-reactive
   tokens (the documented trap). Put buttons in the `actions` slot; an optional
   `note` line sits below (e.g. a phone number).
   NOTE: still no bright-ORANGE tone (nothing readable passes 4.5 on #ff8c00
   except near-black; amber is the drench that fits the palette). A single
   soft, feathered brand glow gives the navy/cream blocks depth; the amber
   drench carries the grain instead.
   ============================================================================ */
import { cn } from '@/lib/utils';
import Seam from '@/components/Seam.astro';
import { site } from '@/data/site';
import { displayTitleHtml } from '@/lib/typography';

interface Props {
  title: string;
  titleId?: string;
  lead?: string;
  tone?: 'navy' | 'cream' | 'amber';
  /** Cloud seam at the top. On by default — the closing CTA is always a color
      change from the content above. Set false when a same-color band (a navy
      Section) sits directly above, so we don't seam navy into navy. */
  seam?: boolean;
  /** Show the Google-rating trust slip below the actions. On by default so the
      4.8 rating rides every closing CTA (home / tuition / enroll — the pages
      the audit flagged as missing it). Set false for a teacher sign-off CTA. */
  rating?: boolean;
  class?: string;
}
const {
  title,
  titleId = 'cta-title',
  lead,
  tone = 'navy',
  seam = true,
  rating = true,
  class: className,
} = Astro.props;
const isNavy = tone === 'navy';
const isAmber = tone === 'amber';
// Deterministic: callers pass rating={false} for a teacher sign-off CTA.
// (Astro.slots.has() is unreliable for a slot passed inside a {cond && ...}.)
const showRating = rating;
const bandClass = isNavy
  ? 'bg-navy text-white'
  : isAmber
    ? 'wcp-cta-amber' // fixed drench colors live in globals.css
    : 'bg-cream text-heading';
---

<section class={cn('relative -mt-px', bandClass, className)} aria-labelledby={titleId}>
  {seam && <Seam color={tone} variant="trim" />}
  {
    /* Warm brand glow — gives the closing CTA depth so it reads as a lifted
      card, not a flat block. Decorative + aria-hidden; feathered and mostly
      off-canvas so it never fights the centered text (AA unchanged). Amber on
      navy, orange on cream. `wcp-glow-drift` is transform-only, reduced-motion
      safe. The glow lives in its OWN clip layer (inset-0, overflow-hidden) so
      it's contained to the band without clipping the cloud Seam, which sits
      ABOVE the section on the public site. */
  }
  {
    !isAmber && (
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div
          class={cn(
            'wcp-glow wcp-glow-drift -top-24 -right-20 h-72 w-[30rem]',
            isNavy ? 'wcp-glow-amber' : 'wcp-glow-orange',
          )}
          style="opacity: 0.35"
        />
      </div>
    )
  }
  <div class="wcp-container relative py-[var(--wcp-space-xl)] text-center">
    <h2
      id={titleId}
      class={cn('mx-auto max-w-2xl text-balance', isNavy && 'text-white')}
      data-reveal
      set:html={displayTitleHtml(title)}
    />{/* escaped + hyphen-compounds glued — closers say "co-op", never "CO- / OP" */}
    {
      lead && (
        <p
          class={cn(
            'mx-auto mt-4 max-w-xl text-lg leading-relaxed',
            isNavy && 'text-white/90',
            isAmber && 'wcp-drench-muted',
          )}
          data-reveal
          style="--reveal-delay: 120ms"
        >
          {lead}
        </p>
      )
    }
    <div
      class="mt-7 flex flex-wrap items-center justify-center gap-4"
      data-reveal
      style="--reveal-delay: 240ms"
    >
      <slot name="actions" />
    </div>
    {
      /* Google-rating trust slip — a small torn-edge paper slip carrying the
        4.8/19 rating, linked to the listing. This is how the rating finally
        reaches home / tuition / enroll (their closing CTA), per the audit. The
        star + number stay high-contrast on both tones; only the slip fill and
        the "on Google" label shift per tone. Decorative torn edge via clip-path
        with a rounded fallback for no-clip-path browsers. */
      showRating && (
        <a
          href={site.google.url}
          target="_blank"
          rel="noopener"
          class={cn(
            'wcp-rating-slip group mt-6 inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm no-underline shadow-sm transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0',
            isNavy ? 'bg-white/95 text-navy' : 'bg-white text-navy',
          )}
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 20 20"
            fill="var(--color-amber)"
            aria-hidden="true"
          >
            <path
              d="M10 1.6l2.4 5.2 5.7.5-4.3 3.8 1.3 5.6-5.1-3-5.1 3 1.3-5.6L1.9 7.3l5.7-.5z"
              stroke="var(--color-amber-ink)"
              stroke-width="0.8"
            />
          </svg>
          {/* The slip is a THEME-STABLE white card, so its text must use FIXED
              dark colors, never the theme-reactive -ink/-muted tokens (which
              flip light in dark mode and would fail contrast on this white bg —
              the documented CLAUDE.md trap; it bit this slip in CI). */}
          <span class="font-display text-base [color:#01457e]">{site.google.rating}</span>
          <span class="[color:#4c5866]">on Google, {site.google.reviews} reviews</span>
          <span
            aria-hidden="true"
            class="[color:#166fa8] transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
          >
            →
          </span>
        </a>
      )
    }
    {
      /* Optional teacher signature — a headshot + Email / Call-or-text pills
        that turn the closing CTA into a signed sign-off card (class hub pages).
        When present it stands in for the plain-text note. */
      Astro.slots.has('signature') && (
        <div class="mt-8" data-reveal style="--reveal-delay: 300ms">
          <slot name="signature" />
        </div>
      )
    }
    {
      !Astro.slots.has('signature') && Astro.slots.has('note') && (
        <p
          class={cn(
            'mt-5 text-sm [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-2',
            isNavy
              ? 'text-white/70 [&_a]:text-white'
              : isAmber
                ? 'wcp-drench-muted [&_a]:[color:#01203a]'
                : 'text-ink-muted [&_a]:text-navy',
          )}
        >
          <slot name="note" />
        </p>
      )
    }
  </div>
</section>
