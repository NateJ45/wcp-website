---
/* ============================================================================
   StepList — numbered steps joined by a dashed "crayon path"
   ============================================================================
   An ordered walk-through (e.g. a helper day, an enrollment flow). Real <ol>
   for semantics + keyboard/AT order. Each step has a numbered badge; a dashed
   vertical line threads the badges together like a hand-drawn path (a small
   tactile touch, purely decorative / aria-hidden). Optional per-step note and
   a closing footnote (e.g. "Total time: ~2.5 hours").
   ============================================================================ */
import Icon from '@/components/Icon.astro';
import { cn } from '@/lib/utils';

interface Step {
  title: string;
  body: string;
  /** Pre-rendered inline HTML for the step body, from a `bodyRich` rich twin.
      When set it REPLACES `body`. See src/lib/emphasis.ts. */
  bodyHtml?: string;
  note?: string;
}
interface Props {
  steps: Step[];
  footnote?: string;
  class?: string;
}
const { steps, footnote, class: className } = Astro.props;

// The footnote is styled as a short display-font sign-off (centered, e.g.
// "Total time: ~2.5 hours"). Captain Comic is a caps-only face, so a WHOLE
// paragraph typed there (a real heads-up, a policy reminder) renders as a
// centered all-caps shout that's genuinely hard to read (2026-07-17 feedback).
// When the footnote is really a sentence, drop the flourish and render it as a
// readable left-aligned note in the body font instead.
const longFootnote = (footnote?.trim().length ?? 0) > 70;
---

{
  /* The handwritten "start here!" beside the path's first step — the first
     real use of the .wcp-annotation register (it writes itself in on
     scroll-driven browsers; see globals). Decorative, so aria-hidden. */
}
<p class="mx-auto mb-1 max-w-2xl overflow-x-clip" aria-hidden="true">
  <span class="wcp-annotation inline-block -rotate-6">start here!</span>
</p>
{
  /* overflow-x-clip (CI catch 2026-09-01): the settle reveal holds each li at
     a slight rotation until it scrolls into view, and a rotated full-width
     box EXTENDS the scrollable area — /enroll measured 324px in a 320px
     viewport. Clip sideways only; the tape chips overhang vertically and
     are untouched. */
}
<ol class={cn('relative mx-auto max-w-2xl overflow-x-clip', className)}>
  {
    steps.map((s, i) => (
      <li
        class="relative flex gap-5 pb-6 last:pb-0"
        data-reveal="settle"
        style={`--reveal-delay:${i * 70}ms; --print-tilt:${i % 2 === 0 ? '-1deg' : '1deg'}`}
      >
        {/* Dashed connector — drawn between badges, not after the last one. */}
        {i !== steps.length - 1 && (
          <span
            class="absolute top-11 left-5 h-[calc(100%-1.25rem)] w-px border-l-2 border-dashed border-navy/40 dark:border-white/20"
            aria-hidden="true"
          />
        )}
        <span
          class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent font-display text-lg text-accent-foreground shadow-sm"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        {/* Each step is a dealt paper card (the Aardvark move, 2026-09-01):
            settle reveal arcs it in from a slight rotation, and a faint
            resting tilt alternates per card. The tilt lives on THIS inner
            node because data-reveal on the li animates transform and would
            cancel a resting rotate there (the ChooserRows lesson). Tape
            chip pins it to the page. */}
        <div
          class="wcp-tape-tr relative min-w-0 flex-1 rounded-xl bg-white p-4 shadow-md sm:p-5 dark:bg-surface"
          style={`transform: rotate(${i % 2 === 0 ? '-0.5deg' : '0.5deg'})`}
        >
          <h3 class="text-lg break-words text-heading">{s.title}</h3>
          {s.bodyHtml ? (
            <p class="mt-1 leading-relaxed break-words text-ink" set:html={s.bodyHtml} />
          ) : (
            <p class="mt-1 leading-relaxed break-words text-ink">{s.body}</p>
          )}
          {s.note && (
            <p class="mt-2 flex w-fit max-w-full items-start gap-1.5 rounded-2xl bg-cream px-3 py-1 text-sm font-semibold break-words text-orange-ink">
              <Icon name="sparkles" class="mt-0.5 h-4 w-4 shrink-0" />
              <span class="min-w-0">{s.note}</span>
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>
{
  footnote &&
    (longFootnote ? (
      <div
        class="mx-auto mt-8 flex max-w-2xl items-start gap-3 rounded-2xl bg-sky-soft px-4 py-3"
        data-reveal
      >
        <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-sky-ink" />
        <p class="min-w-0 leading-relaxed text-ink">{footnote}</p>
      </div>
    ) : (
      <p class="mx-auto mt-2 max-w-2xl text-center font-display text-lg text-heading" data-reveal>
        {footnote}
      </p>
    ))
}
