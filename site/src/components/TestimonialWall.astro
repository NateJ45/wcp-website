---
/* ============================================================================
   TestimonialWall — a masonry "wall of love" of real parent quotes
   ============================================================================
   A genuine wall (CSS columns, not a JS carousel) so every quote is on the
   page at once — screen-reader and keyboard friendly with zero JS. Cards vary
   in height naturally, which reads like a real family scrapbook rather than a
   uniform grid. Reflows column-count → 1 at narrow widths (320px-safe).

   Each card carries an accessible star rating (visual stars hidden from AT,
   text equivalent announced) and a small quotation-mark flourish.
   ============================================================================ */
import { cn } from '@/lib/utils';
import type { Testimonial } from '@/data/testimonials';

interface Props {
  items: Testimonial[];
  class?: string;
}
const { items, class: className } = Astro.props;

// Rotate the accent line across cards so the wall feels colorful without any
// single card shouting — one accent per card, cycled.
const accents = ['border-t-orange', 'border-t-sky', 'border-t-green', 'border-t-amber'];
---

<ul class={cn('columns-1 gap-5 sm:columns-2 lg:columns-3', className)} role="list">
  {
    items.map((t, i) => (
      <li class="mb-5 break-inside-avoid">
        <figure
          class={cn(
            'relative rounded-[var(--radius)] border-t-4 bg-white p-6 shadow-sm',
            'transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-md',
            'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
            accents[i % accents.length],
          )}
          data-reveal
        >
          {/* Oversized decorative quote mark — pale, behind the text. */}
          <span
            class="pointer-events-none absolute right-4 top-2 font-display text-6xl leading-none text-cream select-none"
            aria-hidden="true"
          >
            &rdquo;
          </span>
          <div class="relative text-amber" aria-hidden="true">{'★★★★★'}</div>
          <span class="sr-only">5 out of 5 stars</span>
          <blockquote class="relative mt-3 leading-relaxed text-ink">{t.quote}</blockquote>
          <figcaption class="mt-4 font-bold text-navy">
            {t.author}
            <span class="mt-0.5 block text-sm font-normal text-ink-muted">{t.role}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
