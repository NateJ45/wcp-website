---
/* ============================================================================
   TestimonialWall — a masonry "wall of love" of real parent quotes
   ============================================================================
   A genuine wall (CSS columns, not a JS carousel) so every quote is on the
   page at once — screen-reader and keyboard friendly with zero JS. Cards vary
   in height naturally, which reads like a real family scrapbook rather than a
   uniform grid. Reflows column-count → 1 at narrow widths (320px-safe).

   Each card carries an accessible star rating (visual stars hidden from AT,
   text equivalent announced) and a small quotation-mark flourish.
   ============================================================================ */
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import { photoFor } from '@/lib/testimonial-photos';
import type { Testimonial } from '@/data/testimonials';

interface Props {
  items: Testimonial[];
  class?: string;
}
const { items, class: className } = Astro.props;

// Hand-drawn 5-star row (matches Testimonial.astro), amber fill + amber-ink edge.
const STAR = 'M10 1.6l2.4 5.2 5.7.5-4.3 3.8 1.3 5.6-5.1-3-5.1 3 1.3-5.6L1.9 7.3l5.7-.5z';
---

<ul class={cn('columns-1 gap-5 sm:columns-2 lg:columns-3', className)} role="list">
  {
    items.map((t) => (
      <li class="mb-5 break-inside-avoid">
        <figure
          class={cn(
            'wcp-testi wcp-tape-tc wcp-note-paper relative rounded-[var(--radius)] px-6 pt-8 pb-5',
            'shadow-[0_1px_2px_rgba(1,32,58,0.14),0_8px_18px_rgba(1,32,58,0.12)]',
          )}
          data-reveal="settle"
        >
          {photoFor(t.author) && (
            <div class="wcp-print wcp-snap mb-4 w-20 shrink-0" aria-hidden="true">
              <Image
                src={photoFor(t.author)!}
                alt=""
                width={160}
                height={160}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover"
              />
            </div>
          )}
          <div class="flex gap-0.5" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="var(--color-amber)">
                <path d={STAR} stroke="var(--color-amber-ink)" stroke-width="0.8" />
              </svg>
            ))}
          </div>
          <span class="sr-only">5 out of 5 stars</span>
          {/* Theme-stable light-paper island: inks come from .wcp-note-paper's
              fixed palette (globals.css dark-mode paper doctrine), never theme
              tokens. */}
          <blockquote class="relative mt-3 leading-relaxed">{t.quote}</blockquote>
          <figcaption class="mt-4">
            <span class="wcp-signature block text-3xl leading-none">{t.author}</span>
            <span class="wcp-note-muted mt-1 block text-sm">{t.role}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<script>
  import '@/scripts/signature-font';
</script>
