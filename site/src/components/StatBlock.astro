---
/* ============================================================================
   StatBlock — a big count-up number with a label + context
   ============================================================================
   For the navy "stats strip" (years running, ages served, tuition from, etc.).
   The number animates from 0 on scroll-in (see src/scripts/countup.ts), which
   respects prefers-reduced-motion by jumping straight to the final value. The
   real value is always in the DOM as text, so it's correct with or without JS.

   `prefix`/`suffix` frame the animated number (e.g. prefix="$", suffix="+").
   ============================================================================ */
interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
  /** Band the block sits on. `navy` (default, the classic strip) keeps the
      amber number + white label; `light` swaps to the theme heading/ink tokens
      so a stat band the navy-adjacency pass flips to white stays readable
      (amber on white is ~1.9:1 — never a text color on light bands). */
  tone?: 'navy' | 'light';
  class?: string;
}
const { value, prefix = '', suffix = '', label, tone = 'navy', class: className } = Astro.props;
const onNavy = tone === 'navy';
---

<div
  class:list={[
    '@container rounded-[var(--radius)] border p-8 text-center',
    onNavy
      ? 'border-white/10 bg-white/[0.06]'
      : 'border-navy/10 bg-navy/[0.04] dark:border-white/20',
    className,
  ]}
  data-reveal
>
  {
    /* nowrap + container-fluid size: a comma-formatted value ("$67,266") is a
       legal line-break point and once wrapped mid-number in a narrow tile
       (caught 2026-07-14 on the fundraising page's Board-added stats band).
       cqi tracks THIS tile's width (the root is a @container), and the clamp
       ceiling is 3rem = the old text-5xl, so wide layouts look identical. */
  }
  <span
    class:list={[
      'block font-display text-[clamp(1.6rem,17cqi,3.75rem)] leading-none whitespace-nowrap tabular-nums',
      onNavy ? 'text-amber' : 'text-heading',
    ]}
  >
    {prefix}<span data-countup data-count={value}>{value}</span>{suffix}
  </span>
  <span
    class:list={[
      'mt-3 block text-sm font-bold tracking-wide uppercase',
      onNavy ? 'text-white' : 'text-heading',
    ]}>{label}</span
  >
  {
    Astro.slots.has('default') && (
      <p class:list={['mt-2 text-sm leading-relaxed', onNavy ? 'text-white/70' : 'text-ink-muted']}>
        <slot />
      </p>
    )
  }
</div>

{
  /* Colocated so the count-up JS only ships on pages that use a StatBlock.
    Astro dedupes this across multiple instances into one bundle include. */
}
<script>
  import '@/scripts/countup';
</script>
