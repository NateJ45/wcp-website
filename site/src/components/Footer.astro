---
/* ============================================================================
   Footer — sitewide contentinfo
   ============================================================================
   Logo + contact + nav columns + a legal/identity bottom bar. Links come from
   src/data/nav.ts; identity from src/data/site.ts.
   ============================================================================ */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import wcpLogoWhite from '@/assets/brand/wcp-logo-white.png';
import { site as siteFallback } from '@/data/site';
import { getSiteSettings, getNavigation } from '@/lib/cms';
import { photosFor } from '@/lib/photo-registry';
import { imageUrl } from '@/lib/image';
import { withBase } from '@/lib/utils';
import { isValidGtagId, isValidMetaPixelId } from '@/lib/consent-state';

interface Props {
  /** '' in production, '/preview' inside the Presentation preview. */
  linkBase?: string;
}
const { linkBase = '' } = Astro.props;
const href = (h: string) => withBase(h, linkBase);

// Phone/email/address/social/etc. are edited in Sanity (Site Settings) and
// merged over the static fallback here. Menus come from Sanity (Menus doc)
// with the static nav.ts as fallback.
const site = await getSiteSettings(siteFallback);
const { footerNav, legalNav } = await getNavigation();
// Seasonal footer decorations (Site Settings → "Seasonal touches"; build-time).
// The old site's footer sat on a navy-tinted classroom photo (Nathan,
// 2026-07-19): one registry pick, heavy navy overlay, degrades to plain navy
// when the registry is empty. (The seasonal sun/cloud art is retired from the
// footer at the same request.)
const [footerPhoto] = await photosFor('footer', 1);

interface Props {
  /** The FINAL band's color on this page — the seam at the footer boundary
   *  fills with it (the band above bulges into the photo, orange-traced,
   *  exactly like every section seam). BaseLayout passes it through. */
  seamAbove?: 'white' | 'grey' | 'cream' | 'navy' | 'amber' | 'sky';
}
const { seamAbove = 'white' } = Astro.props;
const seamFill: Record<string, string> = {
  white: '#ffffff',
  grey: 'var(--color-grey)',
  cream: 'var(--color-cream)',
  navy: 'var(--color-navy)',
  amber: 'var(--color-amber)',
  sky: 'var(--color-sky)',
};
const seamStroke = seamAbove === 'amber' ? 'var(--color-navy)' : 'var(--color-orange)';

const phoneDigits = site.phone.replace(/[^\d]/g, '');
const year = new Date().getFullYear();
// Mirrors CookieConsent.astro's render condition so the "Cookie choices"
// opener never exists without the card it opens: any configured optional
// tracker (GA4, Google Ads tag, Meta Pixel) enables both.
const consentEnv = import.meta.env;
const consentEnabled =
  (typeof consentEnv.PUBLIC_GA_ID === 'string' && isValidGtagId(consentEnv.PUBLIC_GA_ID)) ||
  (typeof consentEnv.PUBLIC_GADS_ID === 'string' && isValidGtagId(consentEnv.PUBLIC_GADS_ID)) ||
  (typeof consentEnv.PUBLIC_META_PIXEL_ID === 'string' &&
    isValidMetaPixelId(consentEnv.PUBLIC_META_PIXEL_ID));
---

<footer class="relative -mt-px overflow-hidden bg-navy text-white">
  {/* The footer sweep: the page's last band arcs into the photo treatment. */}
  <svg
    viewBox="0 0 1440 60"
    preserveAspectRatio="none"
    class="pointer-events-none absolute inset-x-0 top-0 z-10 block h-8 w-full sm:h-12"
    aria-hidden="true"
  >
    <path
      d="M0,14 C300,52 700,58 1000,40 C1180,29 1330,16 1440,10 L1440,0 L0,0 Z"
      fill={seamFill[seamAbove]}></path>
    <path
      d="M0,14 C300,52 700,58 1000,40 C1180,29 1330,16 1440,10"
      fill="none"
      stroke={seamStroke}
      stroke-width="4"
      stroke-linecap="round"></path>
  </svg>
  {
    footerPhoto && (
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <img
          src={imageUrl(footerPhoto.image as never, 1600)}
          alt=""
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-navy/[0.88]" />
        {/* The photo has to START BELOW THE SEAM, not at it. The scrim is a
            uniform 88%, so the classroom photo was showing through right at the
            top edge — which meant the seam (painted a FLAT band colour) met a
            photo-tinted navy a pixel below it, and the step read as a rendering
            fault rather than a transition. Most visible when the last band is
            itself navy: navy, amber line, then a slightly lighter navy.
            This top fade is solid navy where the seam lands and clears within
            ~8rem, so the seam is continuous with what it touches and the photo
            still does its job everywhere below. */}
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy to-transparent" />
      </div>
    )
  }
  {
    /* Two nav columns from the smallest phones up (Nathan 2026-07-19: the
      1-col stack ran ~4 viewports; 2-up halves the scroll). The brand block
      spans the full row until lg, where the 5-track desktop grid takes over. */
  }
  <div
    class="wcp-container relative grid grid-cols-2 gap-x-6 gap-y-8 pt-24 pb-10 sm:pt-28 lg:grid-cols-[1.4fr_repeat(4,1fr)] lg:gap-8"
  >
    {/* Brand + contact */}
    <div class="col-span-2 lg:col-span-1">
      <Image src={wcpLogoWhite} alt={site.name} width={220} height={147} class="h-24 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/80">{site.tagline}</p>
      <address class="mt-4 space-y-2 text-sm text-white/90 not-italic">
        <a href={`tel:${phoneDigits}`} class="inline-flex items-center gap-2 hover:underline">
          <Icon name="phone" class="h-4 w-4 text-amber" />{site.phone}
        </a>
        <br />
        {
          /* The global `a[href^='mailto:'] { overflow-wrap: anywhere }` safety net
            (globals.css) split the address mid-word ("...preschool.o / rg") in the
            lg 5-track grid, where 1.4fr left the brand column ~10px short of the
            address. `break-word` does NOT collapse min-content the way `anywhere`
            does, so the fr track sizes to the full address and it stays on one
            line, borrowing ~3px from each nav column. Scoped to lg on purpose:
            below it the brand block spans the full row (the address fits with
            room to spare at 320), and `anywhere` must stay the fallback there —
            this footer is `overflow-hidden`, so an address too long for a
            viewport-capped column would be silently CLIPPED rather than wrapped. */
        }
        <a
          href={`mailto:${site.email.general}`}
          class="inline-flex items-center gap-2 hover:underline lg:[overflow-wrap:break-word]"
        >
          <Icon name="mail" class="h-4 w-4 shrink-0 text-amber" />{site.email.general}
        </a>
        <div class="flex items-start gap-2 pt-1 text-white/80">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-amber" />
          <span>
            {site.address.street}<br />
            {site.address.city}, {site.address.state}
            {site.address.zip}
          </span>
        </div>
      </address>
      {
        (site.social.facebook || site.social.instagram) && (
          <div class="mt-4 flex items-center gap-2">
            {site.social.facebook && (
              <a
                href={site.social.facebook}
                target="_blank"
                rel="noopener"
                aria-label={`${site.name} on Facebook`}
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-amber hover:text-heading"
              >
                <Icon name="facebook" class="h-5 w-5" />
              </a>
            )}
            {site.social.instagram && (
              <a
                href={site.social.instagram}
                target="_blank"
                rel="noopener"
                aria-label={`${site.name} on Instagram`}
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-amber hover:text-heading"
              >
                <Icon name="instagram" class="h-5 w-5" />
              </a>
            )}
          </div>
        )
      }
    </div>

    {/* Nav columns */}
    {
      footerNav.map((col) => (
        <nav aria-label={col.label}>
          <h2 class="font-display text-lg text-white">{col.label}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {col.children.map((link) => (
              <li>
                <a
                  href={href(link.href)}
                  class="text-white/80 hover:text-white hover:underline"
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  {
    /* A warm, hand-lettered goodbye — ends the visit like a note on the door.
      Left-aligned on phones with the columns above it (Nathan 2026-07-19);
      centered only on the wide layout, where the columns span the row. */
  }
  <div class="wcp-container relative -mt-1 pb-6 text-left lg:text-center">
    <p class="font-display text-2xl text-amber">See you at drop-off!</p>
    <p class="mt-1 text-sm text-white/70">— The WCP Community</p>
  </div>

  <div class="relative border-t border-white/10">
    <div class="wcp-container flex flex-col gap-3 py-6 text-xs text-white/60">
      {/* Legal / policy links */}
      <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2">
        {
          legalNav.map((link) => (
            <a href={href(link.href)} class="text-white/70 hover:text-white hover:underline">
              {link.label}
            </a>
          ))
        }
        {
          /* Reopens the consent card so a past cookie decision can be changed.
             Rendered only when the site HAS an optional cookie (the ads tag);
             ships hidden — consent.ts un-hides it, so no-JS visitors never see
             a dead button. */
          consentEnabled && (
            <button
              type="button"
              data-consent-open
              hidden
              class="cursor-pointer text-white/70 hover:text-white hover:underline"
            >
              Cookie choices
            </button>
          )
        }
      </nav>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; <span data-year>{year}</span> {site.name}. All rights reserved.</p>
        <p>
          A secular, non-discriminatory cooperative preschool. Founded {site.founded}. {
            site.license
          }.
        </p>
      </div>
      {
        /* Left-aligned like every other legal-bar line (it centered on phones
          while everything above sat left — Nathan 2026-07-19). */
      }
      <p>
        Designed by{' '}
        <a
          href="https://nixoncreativestudio.com"
          target="_blank"
          rel="noopener"
          class="font-semibold text-white/70 hover:text-white hover:underline"
        >
          Nixon Creative Studio
        </a>
      </p>
    </div>
  </div>
</footer>

<script>
  // Belt-and-suspenders: `year` above is baked in at build time, so if the
  // static site sits unrebuilt across a New Year the footer would read stale
  // until the next deploy. This corrects it client-side on every page view.
  const yearEl = document.querySelector('[data-year]');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
