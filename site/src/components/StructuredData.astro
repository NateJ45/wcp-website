---
/* ============================================================================
   StructuredData — Preschool (LocalBusiness) JSON-LD for search engines
   ============================================================================
   Emitted once per public page from BaseLayout's site chrome. Google reads
   this for the knowledge panel / local results: name, address, phone, URL,
   social profiles. Data comes from Site Settings (merged over the static
   fallback), so the board's edits flow through on the next rebuild.
   `Preschool` is a schema.org subtype of LocalBusiness — the most specific
   type that fits.
   ============================================================================ */
import { site as siteFallback } from '@/data/site';
import { getSiteSettings } from '@/lib/cms';

const site = await getSiteSettings(siteFallback);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  name: site.name,
  description: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email.general,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  sameAs: [site.social.facebook, site.social.instagram].filter(Boolean),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
