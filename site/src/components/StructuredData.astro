---
/* ============================================================================
   StructuredData — Preschool (LocalBusiness) JSON-LD for search engines
   ============================================================================
   Emitted once per public page from BaseLayout's site chrome. Google reads
   this for the knowledge panel / local results: name, address, phone, URL,
   social profiles, hours, price range, and the exact map pin. Data comes from
   Site Settings (merged over the static fallback), so the board's edits flow
   through on the next rebuild; the local-SEO extras (geo, hours, priceRange,
   areaServed) are code-side fallbacks in src/data/site.ts.
   `Preschool` is a schema.org subtype of LocalBusiness — the most specific
   type that fits.
   Deliberately NO aggregateRating: Google penalizes self-serving review
   markup (ratings the site asserts about itself), so the 4.8 Google rating
   stays visible copy only. Don't add it back.
   ============================================================================ */
import { site as siteFallback } from '@/data/site';
import { cmsFetch } from '@/lib/cms';
import { getSiteSettings } from '@/lib/cms';

const site = await getSiteSettings(siteFallback);

// The same Google Maps search URL the Contact page renders ("Open in Google
// Maps", ContactDetailsSection.astro), so the JSON-LD and the visible site
// agree on the destination.
// The price range Google indexes DERIVES from the class docs' monthly fees
// (min-max), so a tuition change updates search the same build it updates the
// tuition page. The committed site.priceRange is only the read-failed fallback.
let priceRange: string = site.priceRange;
try {
  const monthlies = await cmsFetch<(string | null)[]>(
    `*[_type == "class" && defined(monthly)].monthly`,
    {},
    [],
  );
  const nums = (monthlies ?? [])
    .map((m) => Number(String(m ?? '').replace(/[^0-9.]/g, '')))
    .filter((n) => Number.isFinite(n) && n > 0);
  if (nums.length > 0) {
    priceRange = `$${Math.min(...nums)}-$${Math.max(...nums)} /month`;
  }
} catch {
  /* fallback stands */
}

const mapQuery = encodeURIComponent(
  `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  name: site.name,
  description: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email.general,
  foundingDate: String(site.founded),
  // hours come from Site settings; geo/areaServed stay code by decision (the
  // building rarely moves — PUBLIC_EDITABILITY.md W1.3); priceRange derives
  // from the class docs above.
  priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${mapQuery}`,
  areaServed: { '@type': 'AdministrativeArea', name: site.areaServed },
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  // image: the home page's build-generated share card (a real classroom photo
  // under the branded overlay — see scripts/generate-og.mjs). A stable URL,
  // unlike the content-hashed /_astro/ asset paths. logo: the committed PWA
  // icon (512px, well over Google's 112px minimum), same stability reason.
  image: new URL('/og/home.jpg', site.url).toString(),
  logo: new URL('/icon-512.png', site.url).toString(),
  sameAs: [site.social.facebook, site.social.instagram].filter(Boolean),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
