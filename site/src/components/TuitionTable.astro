---
/* ============================================================================
   TuitionTable — an accessible tuition/fees table
   ============================================================================
   Two renderings of the same data, one visible per breakpoint:

   - lg and up: a real <table> with a caption and proper <th scope> headers
     (screen readers announce the row/column a cell belongs to). The first
     cell of each row is a row header (the class name).
   - below lg: one stacked card per row with a label/value <dl>. The 9-column
     tuition table is wider than a tablet/phone viewport, and the previous
     overflow-x-auto wrapper quietly hid the MONEY columns behind a sideways
     scroll nobody discovered (at 390px only a "$" sliver hinted at them — on
     the page whose whole job is prices; found in the 2026-07 responsive
     audit). Cards show every value with zero scrolling.

   The card title is a styled <p>, not an <h3>, on purpose: the section header
   above this component is optional, and an h3 with no h2 ancestor would trip
   the heading-order a11y gate.
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Props {
  caption: string;
  columns: string[];
  /** Each row: first cell becomes the row header (<th scope="row">). */
  rows: string[][];
  class?: string;
}
const { caption, columns, rows, class: className } = Astro.props;
---

{/* Below lg: a card per class — all columns visible, nothing to scroll. Cards
    are paper with a full hairline edge — the old border-t-4 strip was the
    banned side-stripe idiom (Act II strip purge, Phase 0 detector). */}
<ul class={cn('space-y-4 lg:hidden', className)} aria-label={caption}>
  {
    rows.map((row) => (
      <li class="wcp-paper-card rounded-[var(--radius)] border border-navy/12 p-5 shadow-sm dark:border-border">
        <p class="font-display text-xl text-heading">{row[0]}</p>
        <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3">
          {columns.slice(1).map(
            (label, i) =>
              row[i + 1] && (
                <div>
                  <dt class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                    {label}
                  </dt>
                  <dd class="mt-0.5 font-bold text-heading">{row[i + 1]}</dd>
                </div>
              ),
          )}
        </dl>
      </li>
    ))
  }
</ul>

{
  /* tabindex + region: a scrollable wrapper must be keyboard-reachable so
    Safari users can arrow-scroll the table (axe scrollable-region-focusable —
    caught by the webkit-iphone project). */
}
<div
  class={cn('hidden overflow-x-auto rounded-[var(--radius)] shadow-sm lg:block', className)}
  tabindex="0"
  role="region"
  aria-label={caption}
>
  <table class="w-full border-collapse text-left text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="bg-navy text-white">
        {
          columns.map((c, i) => (
            <th
              scope="col"
              class={cn(
                'px-4 py-3 font-bold tracking-wide uppercase',
                i === 0 ? 'text-left' : 'text-left',
              )}
            >
              {c}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-border last:border-b-0 even:bg-grey/60">
            {row.map((cell, i) =>
              i === 0 ? (
                <th scope="row" class="px-4 py-3 font-bold whitespace-nowrap text-heading">
                  {cell}
                </th>
              ) : (
                <td class="px-4 py-3 text-ink">{cell}</td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
