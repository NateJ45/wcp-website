---
/* ============================================================================
   TuitionTable — an accessible tuition/fees table
   ============================================================================
   A real <table> with a caption and proper <th scope> headers (screen readers
   announce the row/column a cell belongs to). The first cell of each row is a
   row header (the class name). Wrapped in an overflow-x-auto container so on
   narrow screens the TABLE scrolls sideways, never the whole page.
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Props {
  caption: string;
  columns: string[];
  /** Each row: first cell becomes the row header (<th scope="row">). */
  rows: string[][];
  class?: string;
}
const { caption, columns, rows, class: className } = Astro.props;
---

<div class={cn('overflow-x-auto rounded-[var(--radius)] shadow-sm', className)}>
  <table class="w-full border-collapse text-left text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="bg-navy text-white">
        {
          columns.map((c, i) => (
            <th
              scope="col"
              class={cn(
                'px-4 py-3 font-bold uppercase tracking-wide',
                i === 0 ? 'text-left' : 'text-left',
              )}
            >
              {c}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-border last:border-b-0 even:bg-grey/60">
            {row.map((cell, i) =>
              i === 0 ? (
                <th scope="row" class="whitespace-nowrap px-4 py-3 font-bold text-navy">
                  {cell}
                </th>
              ) : (
                <td class="px-4 py-3 text-ink">{cell}</td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
