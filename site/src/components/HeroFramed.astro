---
/* ============================================================================
   HeroFramed — the "living photograph" hero (Phase 2, variant B, Nathan-approved)
   ============================================================================
   The scrapbook home hero: the ambient school film lives in a taped polaroid
   frame BESIDE the headline, not full-bleed behind it. Why this over
   full-bleed (the hero doctrine, 2026-07-17):
     - the ~half-width render downsamples the encode 2-3x, so webm compression
       artifacts disappear (they magnify when a small clip is stretched full-
       bleed);
     - no scrim sits over the film, so it plays at full brightness;
     - the first fold gains the editorial asymmetry the audit asked for;
     - the reduced-motion / data-saver / pre-buffer fallback is a visually
       identical still in the same frame (the <img> poster).
   Interior pages keep the full-bleed photo Hero (stills compress fine); this
   component is selected by PageHero ONLY when the hero has a video.

   Band surface (2026-07-17, Nathan): the DEEP NAVY DRENCH with the low-opacity
   doodle layer (.wcp-hero-drench in globals.css) — the cream paper band was
   judged too quiet next to the interior navy heroes. The white polaroid frame
   pops harder on navy, and the transparent overlay header reads on it without
   the old lg-only masthead gradient (removed with the cream).

   LCP: the headline is white text on navy — it paints immediately, with no wait
   on any image. The poster <img> in the frame is the largest image but is ~half
   the pixels of a full-bleed hero. The video carries NO poster attribute (the
   <img> under it is the poster) and only downloads once hero-video.ts starts it
   after load — same contract as Hero.astro. White-on-navy (9.75:1) and the
   frame captions hold AA in both themes (the drench is theme-stable).
   ============================================================================ */
import { cn } from '@/lib/utils';
import { imageUrl, imageSrcSet, type SanityImageSource } from '@/lib/image';

interface Props {
  eyebrow?: string;
  titleId?: string;
  lead?: string;
  sanityImage?: SanityImageSource;
  imageAlt?: string;
  video?: string;
  videoWebm?: string;
  /** Frame caption; evergreen + code-owned (no Sanity design knob). */
  caption?: string;
  class?: string;
}
const {
  eyebrow,
  titleId = 'hero-title',
  lead,
  sanityImage,
  imageAlt = '',
  video,
  videoWebm,
  caption = 'A morning at WCP',
  class: className,
} = Astro.props;
---

<section
  class={cn('wcp-hero-framed wcp-hero-drench relative overflow-x-clip', className)}
  aria-labelledby={titleId}
>
  <div
    class="wcp-container grid items-center gap-x-10 gap-y-8 pt-[var(--wcp-space-xl)] pb-[var(--wcp-space-lg)] lg:grid-cols-[1.22fr_0.78fr] lg:pt-56 lg:pb-6"
  >
    {/* --- Text column ------------------------------------------------------- */}
    <div class="max-w-[40rem]">
      {
        /* Act II: the eyebrow is a taped paper chip, not a tracked label — the
           first artifact on the page, holding the enrollment status. */
        eyebrow && (
          <p class="wcp-taped-chip wcp-tape-tc relative mb-5" data-reveal="fade">
            {eyebrow}
          </p>
        )
      }
      {
        /* Line-break discipline (the high-end benchmark's #1 lesson: huge type
          must break on 2-4 INTENTIONAL lines, never fragment). Act II raises the
          ceiling toward display courage (the 2026 references run 44-56px at 390
          and ~78px at 1440): the clamp is sized so the longest glued phrase
          ("A front-row seat", article folded into the accent by PageHero) still
          fits the column at 320. Measured after build, not assumed. */
      }
      <h1
        id={titleId}
        class="text-[clamp(1.95rem,5.4vw+0.4rem,3.9rem)] text-balance text-white"
        data-reveal
      >
        <slot name="title" />
      </h1>
      {
        lead && (
          <p
            class="mt-4 max-w-xl text-lg leading-relaxed text-white/90"
            data-reveal
            style="--reveal-delay: 150ms"
          >
            {lead}
          </p>
        )
      }
      <div class="mt-8 flex flex-wrap gap-4" data-reveal style="--reveal-delay: 300ms">
        <slot name="actions" />
      </div>
    </div>

    {
      /* --- Framed living photograph ------------------------------------------
        Desktop composition: the print grows, tilts to its resting 2deg, and is
        taped OVER the hero's bottom seam strip (negative bottom margin + z-10)
        — the first "taped over the edge" moment of the sheet system. Mobile
        keeps it flat in flow, peeking into the first viewport under the CTAs.
        Hover-straighten comes from .wcp-print's own rule. */
    }
    <figure
      class="wcp-print wcp-tape-tl wcp-tape-tr relative z-10 mx-auto w-full max-w-[34rem] justify-self-center lg:-mb-16 lg:max-w-[37rem]"
    >
      <div class="relative isolate overflow-hidden bg-navy" style="aspect-ratio: 16 / 10;">
        {
          sanityImage && (
            <img
              src={imageUrl(sanityImage, 1100)}
              srcset={imageSrcSet(sanityImage)}
              sizes="(min-width: 1024px) 34rem, 92vw"
              alt={imageAlt}
              class="absolute inset-0 h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )
        }
        {
          video && (
            <video
              class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[1200ms] ease-out motion-reduce:transition-none"
              muted
              loop
              playsinline
              preload="none"
              data-hero-video
              aria-hidden="true"
            >
              {videoWebm && <source src={videoWebm} type="video/webm" />}
              <source src={video} type="video/mp4" />
            </video>
          )
        }
      </div>
      <figcaption class="flex items-baseline justify-center gap-2 pt-3">
        {
          /* Fixed inks on the theme-stable white print lip (never -ink tokens
            inside a stable island — they flip bright in dark mode). */
        }
        <span class="font-display text-base text-navy">{caption}</span>
        <span class="wcp-signature text-xl leading-none text-[#a85300]">filmed by our families</span
        >
      </figcaption>
    </figure>
  </div>

  {
    /* The hero's own bottom sheet-edge: a cream wave the desktop print tapes
       over (the overlap stays INSIDE this component, so no following band can
       be covered whatever the Board stacks under the hero). aria-hidden, zero
       CLS (fixed height). */
  }
  <svg
    class="block h-[34px] w-full"
    viewBox="0 0 1440 34"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 34 L0 20 Q 40 6 80 18 T 200 16 T 320 20 T 440 15 T 560 19 T 680 16 T 800 20 T 920 15 T 1040 19 T 1160 16 T 1280 20 T 1400 16 L 1440 18 L 1440 34 Z"
      fill="var(--color-cream)"></path>
  </svg>
</section>

{/* Colocated: hero-video autoplay (reduced-motion-aware) + the on-demand signature font. */}
<script>
  import '@/scripts/hero-video';
  import '@/scripts/signature-font';
</script>
