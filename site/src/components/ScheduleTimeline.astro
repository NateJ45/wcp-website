---
/* ============================================================================
   ScheduleTimeline — a daily schedule as a vertical timeline
   ============================================================================
   Time + activity title + description, connected by a vertical line with dots.
   Rendered as an ordered list (it IS a sequence). Decorative dots/line are
   aria-hidden; the reading order is time -> title -> description.
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Entry {
  time: string;
  /** Optional second time for the same activity (e.g. a PM class), shown beside
      the first in the PM colour with an AM/PM label so it never relies on colour
      alone. */
  timePm?: string;
  title: string;
  desc?: string;
}
interface Props {
  entries: Entry[];
  class?: string;
}
const { entries, class: className } = Astro.props;
---

<ol class={cn('relative mx-auto max-w-2xl', className)}>
  {
    entries.map((e, i) => (
      <li
        class="relative flex gap-5 pb-8 last:pb-0"
        data-reveal
        style={`--reveal-delay: ${i * 70}ms`}
      >
        {/* Connector line (behind the chips), hidden on the last item. */}
        {i < entries.length - 1 && (
          <span class="absolute top-10 bottom-0 left-[19px] w-1 bg-sky/50" aria-hidden="true" />
        )}
        {/* Numbered step chip (boldness pass 2026-07: the old site's chunky
            orange numbered circles). Fixed white numeral on the orange-ink
            fill (5.4:1, theme-stable); decorative because the list IS ordered
            for assistive tech already. */}
        <span
          class="relative z-10 mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white font-display text-base [color:#fff] shadow-[0_0_0_2px_var(--color-sky)] [background:#a85300]"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div class="min-w-0 flex-1">
          {e.timePm ? (
            <p class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-sm font-bold">
              <span class="text-orange-ink">
                <span class="text-[0.7rem] font-extrabold tracking-wide uppercase">AM</span>{' '}
                {e.time}
              </span>
              <span class="text-sky-ink">
                <span class="text-[0.7rem] font-extrabold tracking-wide uppercase">PM</span>{' '}
                {e.timePm}
              </span>
            </p>
          ) : (
            <p class="text-base font-extrabold text-sky-ink">{e.time}</p>
          )}
          {/* h3: these entries sit directly under the section's h2 header, so
              h4 here would skip a level (fails axe/Lighthouse heading-order). */}
          <h3 class="mt-0.5 text-lg text-heading">{e.title}</h3>
          {e.desc && <p class="mt-1 leading-relaxed text-ink">{e.desc}</p>}
        </div>
      </li>
    ))
  }
</ol>
