---
/* ============================================================================
   ScheduleTimeline — a daily schedule as a vertical timeline
   ============================================================================
   Time + activity title + description, connected by a vertical line with dots.
   Rendered as an ordered list (it IS a sequence). Decorative dots/line are
   aria-hidden; the reading order is time -> title -> description.
   ============================================================================ */
import { cn } from '@/lib/utils';

interface Entry {
  time: string;
  title: string;
  desc?: string;
}
interface Props {
  entries: Entry[];
  class?: string;
}
const { entries, class: className } = Astro.props;
---

<ol class={cn('relative mx-auto max-w-2xl', className)}>
  {
    entries.map((e, i) => (
      <li
        class="relative flex gap-5 pb-8 last:pb-0"
        data-reveal
        style={`--reveal-delay: ${i * 70}ms`}
      >
        {/* Connector line (behind the dots), hidden on the last item. */}
        {i < entries.length - 1 && (
          <span
            class="absolute left-[13px] top-7 bottom-0 w-0.5 bg-sky/40"
            aria-hidden="true"
          />
        )}
        {/* Dot */}
        <span
          class="relative z-10 mt-1 h-7 w-7 shrink-0 rounded-full border-4 border-white bg-orange shadow-[0_0_0_2px_var(--color-sky)]"
          aria-hidden="true"
        />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-bold text-sky-ink">{e.time}</p>
          <h4 class="mt-0.5 text-navy">{e.title}</h4>
          {e.desc && <p class="mt-1 leading-relaxed text-ink">{e.desc}</p>}
        </div>
      </li>
    ))
  }
</ol>
