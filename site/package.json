{
  "name": "wcp-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist/client && node scripts/generate-og.mjs && node scripts/rehost-instagram.mjs && node scripts/generate-curriculum.mjs --dist && node scripts/generate-supplies.mjs --dist",
    "preview": "astro preview",
    "studio:dev": "sanity dev --port 3333",
    "typegen": "sanity schema extract --workspace public --path ./schema.json && sanity typegen generate",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "check": "astro check && oxlint src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:hub": "playwright test -c playwright.hub.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:links": "linkinator ./dist/client --recurse --skip \"^(?!http://localhost)\" --skip \"wcp-hero[.](mp4|webm)\" --skip \"/family-hub\"",
    "encode:hero": "node scripts/encode-hero.mjs",
    "gen:curriculum": "node scripts/generate-curriculum.mjs",
    "gen:supplies": "node scripts/generate-supplies.mjs",
    "studio-thumbs": "node scripts/studio-thumbs.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/astro": "^3.4.2",
    "@sanity/client": "^7.23.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.9",
    "@sanity/preview-url-secret": "^4.0.8",
    "@sanity/visual-editing": "^5.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.7",
    "sanity": "^6.4.0",
    "sanity-plugin-documents-pane": "^4.1.8",
    "sanity-plugin-link-checker": "^0.3.2",
    "sanity-plugin-media": "^6.1.7",
    "sharp": "^0.35.4",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/lucide": "^1.2.128",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ffmpeg-static": "^5.3.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "oxlint": "^1.81.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.110.0"
  }
}
