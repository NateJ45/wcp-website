{
  "name": "wcp-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "check": "astro check && oxlint src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:links": "linkinator ./dist/client --recurse --skip \"^(?!http://localhost)\" --skip \"wcp-hero[.](mp4|webm)\" --skip \"/family-hub\"",
    "encode:hero": "node scripts/encode-hero.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/quicksand": "^5.2.10",
    "@portabletext/to-html": "^5.0.2",
    "@sanity/astro": "^3.4.2",
    "@sanity/client": "^7.23.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.0.8",
    "@sanity/visual-editing": "^5.4.5",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "sanity": "^6.4.0",
    "sharp": "^0.35.3",
    "styled-components": "^6.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@iconify-json/lucide": "^1.2.116",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ffmpeg-static": "^5.3.0",
    "http-server": "^14.1.1",
    "linkinator": "^7.6.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
