# =============================================================================
# Local runtime secrets for `astro dev` / `wrangler dev` — TEMPLATE
# =============================================================================
# Copy this to `.dev.vars` (gitignored) and set real values. Unlike PUBLIC_*
# vars, these are SERVER-ONLY secrets and are never inlined into client HTML.
#
# In PRODUCTION, set them as Cloudflare secrets (not in wrangler.jsonc):
#   npx wrangler secret put FAMILY_HUB_PASSWORD
#   npx wrangler secret put SANITY_TOKEN
#   npx wrangler secret put FOURTHWALL_STOREFRONT_TOKEN
#   npx wrangler secret put FOURTHWALL_API_USER
#   npx wrangler secret put FOURTHWALL_API_PASSWORD
#   npx wrangler secret put INSTAGRAM_TOKEN
# =============================================================================

# The single shared password families enter to reach the gated Family Hub.
FAMILY_HUB_PASSWORD="change-me"

# Sanity Editor API token — server-only. Reads (and writes) gated hub content,
# and (via src/lib/cms-preview.ts) reads draft content for the Studio-only
# /preview/* Presentation Tool routes.
# Create one at manage.sanity.io → project → API → Tokens (Editor role).
SANITY_TOKEN="change-me"

# Long-lived Instagram Graph API token — SAME value as the public site's
# build-time INSTAGRAM_TOKEN (site/.env), but set separately here since SSR
# pages (the Family Hub's SocialWallWidget) can't see import.meta.env. Unset =
# the hub's "Life inside WCP" widget falls back to the curated album.
INSTAGRAM_TOKEN="change-me"

# AirNow (EPA) API key for the Family Hub's air-quality chip. Free, from
# https://docs.airnowapi.org/account/request/ (Agency: "Other Agency").
# Unset = the chip falls back to Open-Meteo's forecast MODEL, which on
# 2026-07-19 reported AQI 61 while EPA monitors observed 153 (Unhealthy) and
# the hub told families it was "fine for outside play". Set this.
# Deployed Worker needs it too: npx wrangler secret put AIRNOW_API_KEY
AIRNOW_API_KEY="change-me"
