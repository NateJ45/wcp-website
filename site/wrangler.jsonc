{
  // ===========================================================================
  // Cloudflare Worker config — West Chester Preschool
  // ===========================================================================
  // FOUNDATION, edit with care. Deploys the Astro build as a Worker with a
  // static-assets binding (NOT a Pages project). At build time the
  // @astrojs/cloudflare adapter reads this file and emits the real deploy
  // config into dist/server/wrangler.json, then `wrangler deploy` ships it.
  //
  // When the gated Family Hub is built (Phase 4), the adapter also injects a
  // SESSION KV binding for Astro's Sessions API — that is the plumbing the
  // shared-password gate will use. A real KV namespace id gets added here then.
  // ===========================================================================
  "compatibility_date": "2026-07-10",
  // nodejs_compat polyfills Node globals (process, Buffer, ...) in the workerd
  // runtime. Required so the @astrojs/cloudflare dev runtime — and any module
  // in the render graph that reads process.env (React's dev build does) — does
  // not throw "process is not defined". Correct for production too.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "wcp-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // Session storage for the gated Family Hub (Astro Sessions API). The adapter
  // uses the KV binding named "SESSION" automatically. Local `astro dev` uses a
  // local (miniflare) KV, so no cloud namespace is needed to develop/test.
  // Namespace created 2026-07-10 via `wrangler kv namespace create SESSION`.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "7c54b45ecc2745b68975c21085de1b66",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
