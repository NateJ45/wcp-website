{
  // ===========================================================================
  // Cloudflare Worker config — West Chester Preschool
  // ===========================================================================
  // FOUNDATION, edit with care. Deploys the Astro build as a Worker with a
  // static-assets binding (NOT a Pages project). At build time the
  // @astrojs/cloudflare adapter reads this file and emits the real deploy
  // config into dist/server/wrangler.json, then `wrangler deploy` ships it.
  //
  // The gated Family Hub uses a SESSION KV binding for Astro's Sessions API —
  // that is the plumbing behind the shared-password gate. Live in production.
  // ===========================================================================
  "compatibility_date": "2026-07-10",
  // nodejs_compat polyfills Node globals (process, Buffer, ...) in the workerd
  // runtime. Required so the @astrojs/cloudflare dev runtime — and any module
  // in the render graph that reads process.env (React's dev build does) — does
  // not throw "process is not defined". Correct for production too.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "wcp-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // Session storage for the gated Family Hub (Astro Sessions API). The adapter
  // uses the KV binding named "SESSION" automatically. Local `astro dev` uses a
  // local (miniflare) KV, so no cloud namespace is needed to develop/test.
  // Namespace created 2026-07-10 via `wrangler kv namespace create SESSION`.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "7c54b45ecc2745b68975c21085de1b66",
    },
    // Shared cache for the hub's slow external fetches (Apps Script calendar
    // feed, gviz sheets) — the durable tier under src/lib/hub-cache.ts's
    // in-isolate Map, so the first visitor after a deploy or an idle spell
    // doesn't pay the 3-5s Google round-trips either. Namespace created
    // 2026-07-13 via `wrangler kv namespace create CACHE`.
    {
      "binding": "CACHE",
      "id": "022e00789a4448a79c352a2bb309415b",
    },
    // The family directory. Families' personal data — names, children, contact
    // details, home addresses — lives HERE rather than in Sanity, because the
    // Sanity dataset is PUBLIC (free plan = "2 datasets, public only"), so
    // anything modelled there is readable by anyone holding the project id, no
    // matter what the Family Hub gate does. KV has no public read surface: only
    // the Worker reaches it, on a request that has already passed
    // src/middleware.ts. See src/lib/hub-directory.ts.
    //
    // Create with `npx wrangler kv namespace create DIRECTORY`, paste the id
    // here, then populate with scripts/migrate-directory-to-kv.mjs.
    {
      "binding": "DIRECTORY",
      "id": "REPLACE_WITH_DIRECTORY_NAMESPACE_ID",
    },
  ],
  // Plain (non-secret) runtime values. The account id only NAMES which
  // Cloudflare account /api/stats asks about; it grants nothing on its own and
  // appears in every wrangler config, so it is safe in this public repo. The
  // token that actually reads the analytics is a Worker SECRET
  // (CF_ANALYTICS_TOKEN, set with `npx wrangler secret put`) and is never here.
  "vars": {
    "CF_ACCOUNT_ID": "7e75a15ddc72aae04dca71aca5c7294b",
  },
  "observability": {
    "enabled": true,
  },
}
