# =============================================================================
# Cloudflare | Custom Response Headers
# =============================================================================
# Ships with the deploy; Cloudflare applies these to matching routes.
# https://developers.cloudflare.com/workers/static-assets/headers/
# =============================================================================

# ---- Site-wide security headers (Lighthouse "Trust & Safety" wins) ----------
# Framing is controlled with CSP `frame-ancestors` instead of X-Frame-Options.
# X-Frame-Options only understands SAMEORIGIN/DENY and can't allow a specific
# external origin; frame-ancestors can, and modern browsers prefer it. We allow:
#   'self'                     — the Studio's Presentation Tool iframes /preview/*
#                                (same-origin) to drive click-to-edit.
#   https://*.sanity.io + more — the Sanity Dashboard iframes this project's
#                                /studio cross-origin; with X-Frame-Options set it
#                                failed with "Failed to load iframe due to
#                                X-Frame-Options: SAMEORIGIN".
# Every other origin is still blocked from framing the site (the clickjacking
# risk). This CSP sets ONLY frame-ancestors, so it does not restrict scripts,
# styles, etc.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self' https://*.sanity.io https://sanity.io https://*.sanity.studio
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# ---- Content-hashed build assets — cache for a year, never revalidate -------
# Everything under /_astro/ carries a content hash, so the bytes never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Self-hosted fonts — long cache (bust by renaming if ever replaced) ------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Studio shell: never index the CMS entry point --------------------------
# The embedded Sanity Studio route is PRERENDERED static (it 307s /studio ->
# /studio/ like every static page), so middleware never runs for it and a
# page-level robots meta can't be added to the injected route. This header is
# the durable noindex. The sitemap filter already excludes it from discovery.
/studio
  X-Robots-Tag: noindex
/studio/*
  X-Robots-Tag: noindex

# ---- Re-hosted Instagram tiles (postbuild rehost-instagram.mjs) -------------
# Filenames hash the IG media PATH, so the same photo keeps its name across
# rebuilds. One week matches the deploy.yml freshness cron; not immutable in
# case Instagram ever reuses a path with different bytes.
/ig/*
  Cache-Control: public, max-age=604800
