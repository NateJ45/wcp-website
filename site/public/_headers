# =============================================================================
# Cloudflare | Custom Response Headers
# =============================================================================
# Ships with the deploy; Cloudflare applies these to matching routes.
# https://developers.cloudflare.com/workers/static-assets/headers/
# =============================================================================

# ---- Site-wide security headers (Lighthouse "Trust & Safety" wins) ----------
# X-Frame-Options is SAMEORIGIN, not DENY: the Sanity Studio's Presentation
# Tool embeds pages in a same-origin iframe (/studio's Presentation pane) to
# drive click-to-edit — DENY blocked that with a silent "refused to connect"
# whenever an editor navigated off /preview/* to a real page mid-session.
# SAMEORIGIN still blocks third-party/cross-origin framing (the actual
# clickjacking risk DENY was added for).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# ---- Content-hashed build assets — cache for a year, never revalidate -------
# Everything under /_astro/ carries a content hash, so the bytes never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Self-hosted fonts — long cache (bust by renaming if ever replaced) ------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
